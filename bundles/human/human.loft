// Human — a single playable race (authored CONTENT). One bundle = one race, so a modder
// can compose a limited game by including only the race bundles they want. Uses only the
// engine vocabulary from `races` (the RaceDef record + RF_* flags); no engine source touched.
use races;

pub fn human_race_defs() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  // THE BASELINE, and it is zero on all EIGHT by construction (plan #16 `M3`) — every other
  // race is read against this row, so it states nothing and pays nothing (r_xp 100).
  t += [RaceDef { r_key: "human", r_name: "Human",
    r_might: 0, r_endu: 0, r_dex: 0, r_perc: 0, r_speed: 0, r_will: 0, r_char: 0, r_hand: 0,
    r_hd: 0, r_xp: 100, r_melee: 0, r_bow: 0,
    r_device: 0, r_disarm: 0, r_stealth: 0, r_save: 0, r_infra: 0, r_flags: RF_NONE,
    r_desc: "Balanced and adaptable; the fastest to gain levels." }];
  t
}
