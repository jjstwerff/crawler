// Half-Elf — a single playable race (authored CONTENT). One bundle = one race, so a modder
// can compose a limited game by including only the race bundles they want. Uses only the
// engine vocabulary from `races` (the RaceDef record + RF_* flags); no engine source touched.
use races;

pub fn race_defs() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  t += [RaceDef { r_key: "half_elf", r_name: "Half-Elf", r_str: -1, r_int: 1, r_wis: 0,
    r_dex: 1, r_con: -1, r_chr: 1, r_hd: -1, r_xp: 110, r_melee: 0, r_bow: 2,
    r_device: 3, r_disarm: 2, r_stealth: 1, r_save: 3, r_infra: 2, r_flags: RF_NONE,
    r_desc: "Versatile, with a touch of elven grace." }];
  t
}
