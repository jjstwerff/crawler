// Halfling — a single playable race (authored CONTENT). One bundle = one race, so a modder
// can compose a limited game by including only the race bundles they want. Uses only the
// engine vocabulary from `races` (the RaceDef record + RF_* flags); no engine source touched.
use races;

pub fn halfling_race_defs() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  // ON THE EIGHT (plan #16 `M3`): "nimble" was one axis under the six and it is TWO now —
  // Dexterity (+4, the roster's top) and SPEED (+3, also top) — so the halfling owns the axis
  // that had no predecessor at all. It pays in Might (-2, on top of r_hd -2: it cannot fight)
  // and in WILL (-1), which is the deliberate call that halflings are lucky, not disciplined:
  // there is no halfling archmage, and Will is the one casting axis.
  t += [RaceDef { r_key: "halfling", r_name: "Halfling",
    r_might: -2, r_endu: 1, r_dex: 4, r_perc: 2, r_speed: 3, r_will: -1, r_char: 1, r_hand: 1,
    r_hd: -2, r_xp: 110, r_melee: 0, r_bow: 4,
    r_device: 6, r_disarm: 8, r_stealth: 4, r_save: 5, r_infra: 4,
    r_flags: RF_SUST_DEX | RF_FREE_ACTION,
    r_desc: "Small, nimble and lucky; superb stealth and reflexes." }];
  t
}
