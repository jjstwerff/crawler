// Gnome — a single playable race (authored CONTENT). One bundle = one race, so a modder
// can compose a limited game by including only the race bundles they want. Uses only the
// engine vocabulary from `races` (the RaceDef record + RF_* flags); no engine source touched.
use races;

pub fn race_defs() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  t += [RaceDef { r_key: "gnome", r_name: "Gnome", r_str: -1, r_int: 2, r_wis: 0,
    r_dex: 2, r_con: 1, r_chr: -2, r_hd: -1, r_xp: 115, r_melee: 0, r_bow: 2,
    r_device: 8, r_disarm: 10, r_stealth: 3, r_save: 3, r_infra: 4, r_flags: RF_FREE_ACTION,
    r_desc: "Inquisitive tinkerers; never paralysed, masters of devices." }];
  t
}
