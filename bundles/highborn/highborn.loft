// Highborn — a single playable race (authored CONTENT). One bundle = one race, so a modder
// can compose a limited game by including only the race bundles they want. Uses only the
// engine vocabulary from `races` (the RaceDef record + RF_* flags); no engine source touched.
use races;

pub fn race_defs() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  t += [RaceDef { r_key: "highborn", r_name: "Highborn", r_str: 1, r_int: 2, r_wis: 2,
    r_dex: 1, r_con: 2, r_chr: 2, r_hd: 1, r_xp: 145, r_melee: 4, r_bow: 2,
    r_device: 5, r_disarm: 3, r_stealth: 1, r_save: 5, r_infra: 0, r_flags: RF_SUST_CON,
    r_desc: "Long-lived nobility; well-rounded but slow to advance." }];
  t
}
