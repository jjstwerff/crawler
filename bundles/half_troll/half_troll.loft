// Half-Troll — a single playable race (authored CONTENT). One bundle = one race, so a modder
// can compose a limited game by including only the race bundles they want. Uses only the
// engine vocabulary from `races` (the RaceDef record + RF_* flags); no engine source touched.
use races;

pub fn half_troll_race_defs() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  // ON THE EIGHT (plan #16 `M3`): the roster's extreme — top Might (+5) and top Endurance (+4),
  // worst on five of the other six. "Slow to learn" was a description; SPEED (-2) makes the
  // other half of "slow" a number the distance clock will read (§0). Handiness -3 matches the
  // device -5 / disarm -5 it was already authored with: this race breaks tools.
  t += [RaceDef { r_key: "half_troll", r_name: "Half-Troll",
    r_might: 5, r_endu: 4, r_dex: -4, r_perc: -3, r_speed: -2, r_will: -2, r_char: -6, r_hand: -3,
    r_hd: 4, r_xp: 137, r_melee: 5, r_bow: -5,
    r_device: -5, r_disarm: -5, r_stealth: -2, r_save: 4, r_infra: 3,
    r_flags: RF_REGEN | RF_SUST_MIGHT,
    r_desc: "Huge and regenerating; dim-witted and slow to learn." }];
  t
}
