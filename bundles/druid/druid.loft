// Druid bundle — loading script (the warrior/mage model): the class KIT + a little
// coin. Stats come from the ClassDef (druid_class.loft); spells (if any) ride beside it.
use sim;
use player;

pub fn activate(s: &Sim, p: Player) {
  p.equip(s, "quarterstaff");
  p.equip(s, "cloak");
  p.equip(s, "wooden_torch");
  p.give_item(s, "potion_cure_light");
  p.give_item(s, "book_nature_lore");
  p.grant_gold(s, 20);
}
