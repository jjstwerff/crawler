// Druid — the class DEFINITION (one bundle = one class; merged via class_catalog()).
use classes;

pub fn druid_class_defs() -> vector<ClassDef> {
  t: vector<ClassDef> = [];
  // ON THE EIGHT (plan #16 `M3`): Will +3 to cast and PERCEPTION +3 to read the green — the
  // second nature class, ranked under the ranger on the field and level with the priest on the
  // casting axis. Handiness -1 is the deliberate one: a druid mends nothing that was MADE.
  t += [ClassDef { c_key: "druid", c_name: "Druid", c_hd: 2, c_xp: 125,
    c_might: -1, c_endu: 1, c_dex: 0, c_perc: 3, c_speed: 0, c_will: 3, c_char: 0, c_hand: -1,
    c_melee: 10, c_bow: 14, c_device: 18, c_disarm: 20, c_stealth: 4, c_save: 30,
    c_realm: "nature", c_spell_stat: "will",
    c_desc: "Keeper of the green; nature's magic runs deepest in them." }];
  t
}
