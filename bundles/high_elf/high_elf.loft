// High-Elf — a single playable race (authored CONTENT). One bundle = one race, so a modder
// can compose a limited game by including only the race bundles they want. Uses only the
// engine vocabulary from `races` (the RaceDef record + RF_* flags); no engine source touched.
use races;

pub fn high_elf_race_defs() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  // ON THE EIGHT (plan #16 `M3`): the roster's best sheet, and r_xp 145 is what it costs. It
  // tops PERCEPTION (+4, "see the unseen" made a number) and leads on Will — but it is the
  // race that mends NOTHING (r_hand -1) and it is still elf-frail, so the two negatives are
  // where its identity is, not decoration.
  t += [RaceDef { r_key: "high_elf", r_name: "High-Elf",
    r_might: 1, r_endu: -1, r_dex: 3, r_perc: 4, r_speed: 1, r_will: 3, r_char: 1, r_hand: -1,
    r_hd: 0, r_xp: 145, r_melee: 0, r_bow: 6,
    r_device: 10, r_disarm: 5, r_stealth: 2, r_save: 8, r_infra: 4,
    r_flags: RF_SEE_INVIS | RF_RES_LIGHT,
    r_desc: "Ancient and powerful; see the unseen, but costly to level." }];
  t
}
