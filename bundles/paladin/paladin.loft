// Paladin bundle — loading script (the warrior/mage model): the class KIT + a little
// coin. Stats come from the ClassDef (paladin_class.loft); spells (if any) ride beside it.
use sim;
use player;

pub fn activate(s: &Sim, p: Player) {
  p.equip(s, "short_sword");
  p.equip(s, "hard_leather_armor");
  p.equip(s, "small_shield");
  p.equip(s, "wooden_torch");
  p.grant_gold(s, 25);
}
