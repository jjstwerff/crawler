// desert_surprise bundle — ROOM STENCILS (authored content). A stencil is a room template the
// engine stamps; this one is the naga throne. Uses only the engine's RoomStencil vocabulary. The legend
// (boss/guard) references monster keys the bundle defined in ds_enemies.loft — resolved at stamp
// time through the merged catalog, so it all stays bundle-side.
use worldtypes;

pub fn room_stencils() -> vector<RoomStencil> {
  t: vector<RoomStencil> = [];
  // naga_throne — a round throne-cave (a hex disc of floor), Ssirath coiled at the centre around HER
// POOL (pool: 1 — the water she nested on; it hums with whatever made her what she was), a ring of
  // sand adders guarding. The placement rule stamps it around the depth-3 stair-down so the crown
  // gates the descent.
  t += [RoomStencil { sk: "naga_throne", shape: "round", radius: 4, boss: "ssirath", guard: "sand_adder", guards: 6, pool: 1 }];
  t
}
