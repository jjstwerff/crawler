// Warrior — the class DEFINITION (authored content; one bundle = one class). Merged into
// class_catalog() via the generated class_defs_gen.loft; the loadout script (warrior.loft) grants
// the kit, this row owns the numbers. Uses only the engine vocabulary from `classes`.
use classes;

pub fn warrior_class_defs() -> vector<ClassDef> {
  t: vector<ClassDef> = [];
  // ON THE EIGHT (plan #16 `M3`): force, soak and the reach to close (Speed +1 — a trained
  // fighter is not slow, only the armour is). It keeps its own kit mended (Hand +1) and it
  // watches the enemy in front rather than the field (Perc -1), which is the trade against the
  // ranger. Charisma moved from -1 to 0 on purpose: under the eight that axis is leadership,
  // and a master of arms leads — the six had it as a likeability score, which is not the same
  // reading of the same number.
  t += [ClassDef { c_key: "warrior", c_name: "Warrior", c_hd: 9, c_xp: 100,
    c_might: 3, c_endu: 2, c_dex: 2, c_perc: -1, c_speed: 1, c_will: -2, c_char: 0, c_hand: 1,
    c_melee: 30, c_bow: 25, c_device: 5, c_disarm: 25, c_stealth: 1, c_save: 18,
    c_realm: "none", c_spell_stat: "none",
    c_desc: "Master of arms. No magic, highest hit points, best melee." }];
  t
}
