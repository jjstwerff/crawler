// Necromancer — the class DEFINITION (one bundle = one class; merged via class_catalog()).
use classes;

pub fn necromancer_class_defs() -> vector<ClassDef> {
  t: vector<ClassDef> = [];
  t += [ClassDef { c_key: "necromancer", c_name: "Necromancer", c_hd: 0, c_xp: 135,
    c_str: -4, c_int: 3, c_wis: -3, c_dex: 1, c_con: -1, c_chr: -3,
    c_melee: 6, c_bow: 4, c_device: 30, c_disarm: 28, c_stealth: 3, c_save: 26,
    c_realm: "arcane", c_spell_stat: "int",
    c_desc: "Scholar of the grave; frail, feared, arcane to the bone." }];
  t
}
