// mergetest — the EdgeSet merge's PRECONDITION, gated before any storage moves.
//
// The migration plan (STATE.md) rests on one claim: crawler's `EdgeCollider` and
// `hex_field::EdgeSet` "already agree on the edge key, the canonical slot set {0,2,3}
// and the type widths — so the merge is a lift, not a redesign." Reading the two index
// functions side by side says that is true. Reading is not a gate.
//
// THE INVARIANT: the two index maps are the SAME PERMUTATION from (cell, direction) to
// storage slot. Not "both look right" — identical, so re-pointing crawler's physics at
// the library's storage cannot move a single wall.
//
// WHY IT IS TESTED THIS WAY:
//   * over a chunk that SPANS THE ORIGIN — a -1 sentinel once collided with real cells
//     in any chunk crossing q = 0, and reported "no hit" for every wall there.
//   * INCLUDING THE HALO — `edgeset_count` walks only in-chunk cells, which leaves 74 of
//     a 3x3 layer's 75 slots unverified; hex_field's own comment records that a negative
//     control failed to fail exactly there.
//   * reading back from BOTH directions of every edge, so a symmetry break in one
//     implementation and not the other shows up rather than cancelling.
//   * with a DISTINCT value per edge, so two edges colliding into one slot is visible.
//     A hash would collide by birthday; a counter in canonical order cannot.
//
// And per the standing rule — state what would have to break for this to go red, and
// check that is reachable — it ends by corrupting ONE edge and asserting the comparison
// reports exactly that one. A comparison that cannot go red is not a gate.
use hex_field;
use hexedge;

// The chunk under test: small enough that one distinct u8 value fits every edge
// (7*7 haloed cells * 3 canonical slots = 147 <= 255), and offset so it spans q = 0.
const MQ0 = -3;
const MR0 = -2;
const MW  = 5;
const MH  = 5;

// The canonical direction for slot `si` — the set {0,2,3}, one per opposite pair.
fn canon_dir(si: integer) -> integer {
  d = 0;
  if si == 1 { d = 2; }
  if si == 2 { d = 3; }
  d
}

// How many (cell, direction) reads disagree between the two layers?  Walks all SIX
// directions of every haloed cell, so each edge is read from both of its cells.
fn mismatches(ec: EdgeCollider, eg: EdgeSet) -> integer {
  bad = 0;
  for r in MR0 - 1..MR0 + MH + 1 {
    for q in MQ0 - 1..MQ0 + MW + 1 {
      for d in 0..6 {
        nq = nb_q(q, r, d);
        nr = nb_r(q, r, d);
        if edge_material(ec, q, r, nq, nr) != edge_mat(eg, q, r, nq, nr) { bad = bad + 1; }
      }
    }
  }
  bad
}

fn main() {
  println("=== EdgeCollider vs hex_field::EdgeSet — the same permutation? ===");
  println("chunk ({MQ0},{MR0}) {MW}x{MH}, walked with its one-cell halo, spanning q=0");

  ec = collider_new(MQ0, MR0, MW, MH);
  eg = edgeset_new(MQ0, MR0, MW, MH);

  // ── PASS 1: write one distinct value per edge, through BOTH layers ──────────
  // Canonical enumeration visits each edge at most once, so the counter never
  // reuses a value and an overwrite can only come from a slot COLLISION.
  v = 0;
  landed = 0;
  for r in MR0 - 1..MR0 + MH + 1 {
    for q in MQ0 - 1..MQ0 + MW + 1 {
      for si in 0..3 {
        d = canon_dir(si);
        nq = nb_q(q, r, d);
        nr = nb_r(q, r, d);
        v = v + 1;
        edge_block_full(ec, q, r, nq, nr, 1, v);
        edge_set_mat(eg, q, r, nq, nr, v);
        // Did it land, or is this edge's canonical owner outside the haloed grid?
        if edge_mat(eg, q, r, nq, nr) == v { landed = landed + 1; }
      }
    }
  }
  println("wrote {v} distinct values; {landed} landed inside the haloed grid");

  // ── A: the index maps agree, both directions, halo included ────────────────
  bad = mismatches(ec, eg);
  println("A. read-back disagreements over every cell x every direction: {bad}");
  a_ok = bad == 0;

  // ── B: injectivity — distinct edges must not share a slot ──────────────────
  // If two edges collided, the later write buried the earlier one and the count of
  // non-zero slots falls short of what landed.
  nz = edgeset_count_all(eg);
  println("B. non-zero slots {nz} vs writes that landed {landed}  (short => a slot collision)");
  b_ok = nz == landed;

  // ── C: NEGATIVE CONTROL — corrupt ONE edge and demand the comparison see it ──
  // Without this, A reporting 0 proves nothing: a comparison that reads the same
  // storage twice, or walks an empty range, also reports 0.
  cq = MQ0 + 2;
  cr = MR0 + 2;
  dq = nb_q(cq, cr, 0);
  dr = nb_r(cq, cr, 0);
  before = edge_material(ec, cq, cr, dq, dr);
  edge_block_full(ec, cq, cr, dq, dr, 1, before + 1);
  fired = mismatches(ec, eg);
  println("C. one edge corrupted ({before} -> {before + 1}); comparison now reports {fired}");
  // The edge is read from BOTH of its cells, so exactly two reads must change.
  c_ok = fired == 2;
  println("   negative control fired: {c_ok}  (0 would mean the comparison is blind)");

  if a_ok && b_ok && c_ok {
    println("=== MERGE OK ===");
  } else {
    println("=== FAIL ===");
  }
}
