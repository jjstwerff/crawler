// gpuatlas — R2 proof (RENDER.md): pack the game's token glyphs into ONE SpriteSheet
// atlas (canvas + draw_text per cell → Window.sprites) and draw every sprite from it
// by index via Painter.sprite. Captured to PNG. Dev harness; run under xvfb.

use graphics;

GLYPHS = ["|", "[", "~", "!", "?", "-", "=", "$", "(", ")", ",", "_", "*", "@", ">", "<"];

fn main() {
  win = graphics::open_window(800, 600, "gpu atlas");
  if win == null {
    println("gpuatlas: no window");
    return;
  }
  win.disable(graphics::GL_DEPTH_TEST);
  win.enable(graphics::GL_BLEND);
  win.blend(graphics::BLEND_SRC_ALPHA, graphics::BLEND_ONE_MINUS_SRC_ALPHA);
  painter = win.painter() ?? return;
  // load_font resolves a relative path against this file's directory (src/), so the
  // repo's font is one level up — whatever the process cwd is.
  font = graphics::load_font("../assets/DejaVuSans-Bold.ttf");
  if font == null {
    println("gpuatlas: no font");
    return;
  }

  // Build a 4×4 atlas (64px cells), one glyph per cell.
  cols = 4;
  rows = 4;
  cell = 64;
  atlas = graphics::canvas(cols * cell, rows * cell, 0);
  for i in 0..len(GLYPHS) {
    col = i % cols ?? 0;
    row = i / cols ?? 0;
    g = GLYPHS[i] ?? "*";
    atlas.draw_text(font, g, 40.0, col * cell + 18, row * cell + 6, graphics::rgba(225, 215, 175, 255));
  }
  sheet = win.sprites(atlas, cols, rows);
  if sheet == null {
    println("gpuatlas: the sprite shader did not compile");
    return;
  }

  _alive = win.poll();
  win.clear(graphics::rgba(20, 24, 34, 255));
  // Draw every atlas sprite in a row by index.
  for i in 0..len(GLYPHS) {
    x = 30.0 + (i as float) * 46.0;
    painter.sprite(win, sheet, x, 280.0, 40.0, 40.0, i);
  }
  ok = win.capture().save_png("/tmp/gpu_atlas.png");
  println("gpuatlas: atlas={sheet.texture.width()}x{sheet.texture.height()} cells={sheet.cols}x{sheet.rows} shot={ok}");
  win.close();
}
