// playtest — WALK THE WORLD AND ASSERT WHILE WALKING.
//
// The 89 other gates test the kernel a function at a time: build a Sim by hand, poke one
// routine, check one number. That misses the class of defect that only exists across a
// CONTINUOUS session — the clock not ticking on a blocked step, a pickup that works alone
// and not after a descent, a respawn that loses the kit. moros validates its editor exactly
// this way (`tools/scripts/*.keys` + `tools/script.mjs`): drive the real thing through a
// scripted sequence of gestures, and probe the world BETWEEN them. That method is not
// editor-specific, and the seam it needs already exists here.
//
// ⚠ THE DRIVER IS THE SHIPPED ONE, WHICH IS THE WHOLE POINT. Every row goes through
// `flow_move` / `flow_action` — the same intents the host applies and an observer replays
// (K2, gameflow.loft). A script therefore exercises the path the game actually runs, and a
// bug it finds is a bug a player could reach. `replaytest` already drove a world from a
// `vector<text>` of wire lines to prove host == replica; this makes that driver ADDRESSABLE
// FROM A FILE and lets assertions sit between the steps rather than only at the end.
//
// ── THE SCRIPT LANGUAGE ─────────────────────────────────────────────────────────────
//
//   # …                     a comment. ⚠ Say WHY the row is there — in moros' scripts the
//                           prose is the durable half; the rows rot without it.
//   echo <text>             narration, printed in order (the log reads as a playthrough)
//   genesis <seed> <depth>  boot a world (must come first)
//   move <fwd> <turn> <n>   n movement ticks; fwd/turn are -1|0|1
//   wait <n>                n forced clock ticks in place
//   act <kind> <a1> <a2>    an action intent (2 = pick up, 4 = raise stat, …)
//   expect <probe> <op> <v> assert; op is one of  ==  !=  >=  <=  >  <
//   note <probe>            print a probe's value without asserting (for authoring)
//   remember <name> <probe> snapshot a value now, to compare against later
//
// ── WORLD POKES — these are NOT intents, and a row using one is ARRANGING A SITUATION
// rather than claiming a player path. Say so in the comment above it, or the script
// quietly starts asserting things about a state no play can produce.
//
//   teleport <q> <r>        put the player somewhere (no walk, no clock)
//   findstair               scan for a DOWN stair ('>' or a cave mouth) and go there
//   hurt <n>                apply n physical damage
//   findloot                stand on the first live, non-gold floor item
//   charge <n>              n frames of "aim at the nearest live foe and glide in"
//   xp <n>                  award n experience
//   anchor <kind>           set the respawn anchor at the player's hex
//
// ⚠ A POKE MUST NOT DO THE THING UNDER TEST. `findstair` teleports ONTO the stair and
// stops; the descent itself is left to the next `move`, so the claim being tested is
// still flow_move's walk-onto rule and not a direct `sim_descend`. The same for death:
// `hurt` empties the pool, and `move` is what discovers it and respawns.
//
// Probes: hp hpmax depth gold clevel xp inv enemies msgs q r alive
//         stair savedepth anchor gravegold gravedepth statpts floor livefloor livefoes
//
// ⚠ PREFER A RELATION TO A GOLDEN NUMBER. `expect hp <= hpmax` survives a content change;
// `expect hp == 47` fails on the next tuning pass and teaches the reader to delete rows. Use
// an exact value only where the exact value IS the claim, and say so in the comment above it.
use sim;
use gameflow;
use items;
use catalog;

DT = 0.016666;   // the K1 fixed quantum — the same one the host steps with

// One probe of the live world. Unknown names return a sentinel the caller reports, rather
// than 0 — a typo'd probe silently reading 0 would make `expect gold >= 0` pass forever.
fn probe(s: Sim, name: text) -> integer {
  if name == "hp" { return sim_player_hp(s); }
  if name == "hpmax" { return sim_player_hp_max(s); }
  if name == "depth" { return sim_depth(s); }
  if name == "gold" { return sim_gold(s); }
  if name == "clevel" { return sim_clevel(s); }
  if name == "xp" { return sim_xp(s); }
  if name == "inv" { return sim_inv_count(s); }
  if name == "enemies" { return sim_enemy_count(s); }
  if name == "msgs" { return sim_msg_total(s); }
  if name == "alive" { if sim_over(s) { return 0; } return 1; }
  if name == "q" { (pq, _pr) = sim_player_hex(s); return pq; }
  if name == "r" { (_pq, pr) = sim_player_hex(s); return pr; }
  if name == "stair" { return sim_stair_under(s); }
  if name == "savedepth" { return sim_save_depth(s); }
  if name == "anchor" { return sim_anchor_kind(s); }
  if name == "gravegold" { return sim_grave_gold(s); }
  if name == "gravedepth" { return sim_grave_depth(s); }
  if name == "statpts" { return sim_stat_points(s); }
  if name == "floor" { return sim_floor_count(s); }
  if name == "livefloor" {
    n = 0;
    for i in 0..sim_floor_count(s) { if sim_floor_live(s, i) { n += 1; } }
    return n;
  }
  if name == "livefoes" {
    n = 0;
    for i in 0..sim_enemy_count(s) { if sim_enemy_alive(s, i) { n += 1; } }
    return n;
  }
  -999999
}

// Find a DOWN stair by scanning the level, and answer where it is. 2 = a built '>' and
// 6 = a natural cave mouth; flow_move treats both as down, so a script that wants "the
// way down" must accept either or it passes on dungeons and fails on caves.
//
// ⚠ SCANNING, NOT A CONSTANT. A stair's coordinates are a property of the generated
// level, so a script naming one would be a golden number for a world nobody chose. The
// scan is generous and cheap (tile_at answers "solid" outside the level, so no bounds
// are needed) and it keeps the script readable: `findstair` says what it wants.
fn find_down_stair(s: Sim) -> (integer, integer) {
  for q in 0..140 {
    for r in 0..140 {
      t = tile_at(s, q, r);
      if t == 2 || t == 6 { return (q, r); }
    }
  }
  (-1, -1)
}

fn cmp(a: integer, op: text, b: integer) -> boolean {
  if op == "==" { return a == b; }
  if op == "!=" { return a != b; }
  if op == ">=" { return a >= b; }
  if op == "<=" { return a <= b; }
  if op == ">" { return a > b; }
  if op == "<" { return a < b; }
  false
}

// Split a line into up to 4 space-separated words (no vector<text> literal — loft#336).
fn word(t: text, n: integer) -> text {
  cur = 0;
  start = 0;
  i = 0;
  while i <= len(t) {
    at_end = i == len(t);
    ch = "";
    if !at_end { ch = t[i..i + 1]; }
    if at_end || ch == " " {
      if i > start {
        if cur == n { return t[start..i]; }
        cur += 1;
      }
      start = i + 1;
    }
    i += 1;
  }
  ""
}

fn num(t: text) -> integer { t as integer ?? 0 }

fn main() {
  // ⚠ ABSOLUTE, from $PWD. A relative path in loft resolves against the SCRIPT's
  // directory, not the cwd — so "scripts/walk.play" would be looked for under src/.
  // genbundles builds its paths the same way for the same reason.
  root = env_variable("PWD") ?? "";
  path = "{root}/scripts/walk.play";
  // arguments() is 0-indexed and holds only the PROGRAM's arguments — the .loft path
  // is not element 0. (Measured; the off-by-one silently ran the default script.)
  args = arguments();
  if len(args) > 0 { path = "{root}/{args[0] ?? \"scripts/walk.play\"}"; }

  println("=== story play test (walk the world, assert while walking) ===");
  println("  script: {path}");
  if !exists(path) { println("FAIL: no script at {path}"); println("=== FAIL ==="); return; }

  // content()+split, NOT lines(): a second sequential .lines() read returns empty
  // (the same upstream defect genbundles works around).
  two = `x
y`;
  nl = two[1..2];
  rows = file(path).content().split_text(nl);

  mem_name: vector<text> = [];
  mem_val: vector<integer> = [];
  ok = true;
  booted = false;
  checks = 0;
  s = flow_genesis(1, 1);      // replaced by the script's own genesis row
  sq = 0;
  sr = 0;

  for li in 0..len(rows) {
    raw = trim(rows[li] ?? "");
    if len(raw) == 0 { continue; }
    if raw[0..1] == "#" { continue; }
    verb = word(raw, 0);

    if verb == "echo" {
      println("  {raw[5..len(raw)]}");
    } else if verb == "genesis" {
      s = flow_genesis(num(word(raw, 1)), num(word(raw, 2)));
      (sq, sr) = sim_player_hex(s);
      booted = true;
      println("  genesis seed {word(raw, 1)} depth {word(raw, 2)} -> hp {sim_player_hp(s)}/{sim_player_hp_max(s)}, inv {sim_inv_count(s)}, enemies {sim_enemy_count(s)}");
    } else if !booted {
      println("FAIL line {li + 1}: `{raw}` before any `genesis` row");
      ok = false;
    } else if verb == "move" {
      fwd = num(word(raw, 1));
      turn = num(word(raw, 2));
      n = num(word(raw, 3));
      for _k in 0..n {
        (s2, nq, nr, _chg) = flow_move(s, fwd, turn, DT, sq, sr);
        s = s2; sq = nq; sr = nr;
      }
    } else if verb == "wait" {
      for _k in 0..num(word(raw, 1)) { _r = flow_action(s, 1, 0, 0); }
    } else if verb == "act" {
      _r = flow_action(s, num(word(raw, 1)), num(word(raw, 2)), num(word(raw, 3)));
    } else if verb == "teleport" {
      sim_teleport(s, num(word(raw, 1)), num(word(raw, 2)));
    } else if verb == "findstair" {
      (fq, fr) = find_down_stair(s);
      if fq < 0 {
        println("FAIL line {li + 1}: no down stair on this level — the script cannot proceed");
        ok = false;
      } else {
        sim_teleport(s, fq, fr);
        println("  findstair -> {fq},{fr} (tile {sim_stair_under(s)})");
      }
    } else if verb == "findloot" {
      // Stand on the first LIVE, non-gold floor item. Gold is skipped because it is
      // collected by walking over it, not by the pickup verb — a script aiming at the
      // itemfx seam would otherwise "pick up" a coin pile and prove nothing.
      fi = -1;
      for i in 0..sim_floor_count(s) {
        if fi < 0 && sim_floor_live(s, i) && !sim_floor_is_gold(s, i) { fi = i; }
      }
      if fi < 0 {
        println("FAIL line {li + 1}: no live non-gold floor item on this level");
        ok = false;
      } else {
        (fx, fy) = sim_floor_pos(s, fi);
        s.px = fx; s.py = fy;      // a poke: the walk there is not what is under test
        println("  findloot -> item {fi} (category {sim_floor_cat(s, fi)})");
      }
    } else if verb == "charge" {
      // combattest's idiom, through flow_move: re-aim at the nearest live enemy each
      // frame and glide in, letting BUMP-MELEE do the fighting. The aim is a poke (a
      // precise heading is not an intent); the movement and every blow are the shipped
      // path. Coordinate-agnostic, so it survives a change of hex layout.
      for _k in 0..num(word(raw, 1)) {
        tgt = -1;
        for ei in 0..sim_enemy_count(s) {
          if tgt < 0 && sim_enemy_alive(s, ei) { tgt = ei; }
        }
        if tgt >= 0 {
          (ex, ey) = sim_enemy_pos(s, tgt);
          s.heading = atan2(ey - s.py, ex - s.px);
        }
        (s2, nq, nr, _chg) = flow_move(s, 1, 0, DT, sq, sr);
        s = s2; sq = nq; sr = nr;
      }
    } else if verb == "xp" {
      sim_award_xp(s, num(word(raw, 1)));
    } else if verb == "hurt" {
      sim_damage(s, num(word(raw, 1)), "physical");
    } else if verb == "anchor" {
      sim_anchor_here(s, num(word(raw, 1)));
    } else if verb == "remember" {
      // ⚠ THE CLAIM THAT MATTERS IS USUALLY "IT DID NOT CHANGE", and that cannot be
      // written against a literal without pinning this week's content. `remember inv0
      // inv` then `expect inv == inv0` says the real thing — the kit crossed intact —
      // and stays true when the kit is retuned. moros' scripts take a BASELINE row for
      // the same reason, and call it a claim rather than a warm-up.
      mem_name += [word(raw, 1)];
      mem_val += [probe(s, word(raw, 2))];
      println("  remember {word(raw, 1)} = {probe(s, word(raw, 2))}  (from {word(raw, 2)})");
    } else if verb == "note" {
      println("  note {word(raw, 1)} = {probe(s, word(raw, 1))}");
    } else if verb == "expect" {
      pname = word(raw, 1);
      op = word(raw, 2);
      rhs = word(raw, 3);
      // ⚠ THE RIGHT-HAND SIDE MAY BE ANOTHER PROBE, and that is what makes a script
      // survive tuning: `expect hp == hpmax` states the real claim (an untouched
      // character is at full) where `expect hp == 70` states this week's pool and
      // teaches the next reader to delete the row. A bare integer still works.
      want = rhs as integer?;
      if want == null {
        for mi in 0..len(mem_name) {
          if (mem_name[mi] ?? "") == rhs { want = mem_val[mi]; }
        }
      }
      if want == null {
        want = probe(s, rhs);
        if want == -999999 {
          println("FAIL line {li + 1}: `{rhs}` is neither a number nor a probe");
          ok = false;
          continue;
        }
      }
      got = probe(s, pname);
      checks += 1;
      if got == -999999 {
        println("FAIL line {li + 1}: unknown probe `{pname}`");
        ok = false;
      } else if !cmp(got, op, want ?? 0) {
        println("FAIL line {li + 1}: {pname} is {got}, expected {op} {want ?? 0} ({rhs})");
        println("       row: {raw}");
        ok = false;
      }
    } else {
      println("FAIL line {li + 1}: unknown verb `{verb}`");
      ok = false;
    }
  }

  println("  {checks} assertion(s) over the walk; final: depth {sim_depth(s)} hp {sim_player_hp(s)}/{sim_player_hp_max(s)} gold {sim_gold(s)} inv {sim_inv_count(s)} msgs {sim_msg_total(s)}");
  if ok && checks > 0 { println("=== PLAY OK ==="); } else { println("=== FAIL ==="); }
}
