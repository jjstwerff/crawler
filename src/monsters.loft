  t += [MonsterDef { m_key: "ogre", m_name: "ogre", m_glyph: "O", m_cr: 160, m_cg: 110, m_cb: 70, m_depth: 8, m_rarity: 1, m_hp: 40, m_ac: 16, m_speed: 0, m_dam: 10, m_vision: 10, m_xp: 14, m_flags: MF_NONE }];
  t += [MonsterDef { m_key: "harpy", m_name: "harpy", m_glyph: "H", m_cr: 200, m_cg: 170, m_cb: 90, m_depth: 8, m_rarity: 2, m_hp: 22, m_ac: 14, m_speed: 10, m_dam: 5, m_vision: 11, m_xp: 10, m_flags: MF_GROUP | MF_ERRATIC }];
  t += [MonsterDef { m_key: "dark_elf", m_name: "dark elf", m_glyph: "h", m_cr: 150, m_cg: 90, m_cb: 200, m_depth: 9, m_rarity: 2, m_hp: 26, m_ac: 15, m_speed: 5, m_dam: 6, m_vision: 12, m_xp: 14, m_flags: MF_CASTER }];
  t += [MonsterDef { m_key: "wraith", m_name: "wraith", m_glyph: "W", m_cr: 90, m_cg: 90, m_cb: 140, m_depth: 10, m_rarity: 2, m_hp: 30, m_ac: 16, m_speed: 0, m_dam: 7, m_vision: 12, m_xp: 18, m_flags: MF_CASTER }];
