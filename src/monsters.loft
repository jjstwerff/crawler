  t += [MonsterDef { m_key: "basilisk", m_name: "basilisk", m_glyph: "R", m_cr: 110, m_cg: 200, m_cb: 110, m_depth: 16, m_rarity: 2, m_hp: 80, m_ac: 24, m_speed: 0, m_dam: 12, m_vision: 12, m_xp: 55, m_flags: MF_CASTER , m_habitat: HB_SCREE * HB_T2 }];
  t += [MonsterDef { m_key: "stone_giant", m_name: "stone giant", m_glyph: "P", m_cr: 160, m_cg: 160, m_cb: 160, m_depth: 18, m_rarity: 2, m_hp: 120, m_ac: 26, m_speed: 0, m_dam: 20, m_vision: 12, m_xp: 80, m_flags: MF_NONE , m_habitat: HB_SNOW | HB_ICE | (HB_SNOW | HB_ICE) * HB_T2 }];
  t += [MonsterDef { m_key: "lich", m_name: "lich", m_glyph: "L", m_cr: 180, m_cg: 120, m_cb: 220, m_depth: 20, m_rarity: 3, m_hp: 110, m_ac: 28, m_speed: 5, m_dam: 14, m_vision: 16, m_xp: 140, m_flags: MF_CASTER }];
  // ── uniques (original names; rarity 0) ──
  t += [MonsterDef { m_key: "skarn_rat_king", m_name: "Skarn, the Rat King", m_glyph: "r", m_cr: 200, m_cg: 60, m_cb: 60, m_depth: 3, m_rarity: 0, m_hp: 30, m_ac: 10, m_speed: 5, m_dam: 5, m_vision: 12, m_xp: 25, m_flags: MF_UNIQUE | MF_GROUP | MF_BREEDER }];
  t += [MonsterDef { m_key: "grix_gravecaller", m_name: "Grix the Gravecaller", m_glyph: "h", m_cr: 150, m_cg: 80, m_cb: 210, m_depth: 11, m_rarity: 0, m_hp: 90, m_ac: 18, m_speed: 0, m_dam: 10, m_vision: 16, m_xp: 200, m_flags: MF_UNIQUE | MF_CASTER }];
  t += [MonsterDef { m_key: "vohl_hollow_crown", m_name: "Vohl, the Hollow Crown", m_glyph: "W", m_cr: 120, m_cg: 120, m_cb: 200, m_depth: 17, m_rarity: 0, m_hp: 200, m_ac: 26, m_speed: 10, m_dam: 16, m_vision: 18, m_xp: 600, m_flags: MF_UNIQUE | MF_CASTER }];
