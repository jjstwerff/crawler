  t
}

// ── Helpers (pass the table to avoid rebuilding) ─────────────────────

pub fn mon_has_flag(m: MonsterDef, flag: integer) -> boolean {
  (m.m_flags & flag) != 0
}

// A monster that LIVES HERE: terrain kind + danger tier -> a fitting def from
// the merged catalog (deterministic via salt; mon_none when nothing fits —
// an empty land stays silent, never crashes). Uniques (rarity 0) never roam.
pub fn mon_choose_habitat(table: vector<MonsterDef>, kind: integer, tier: integer, salt: integer) -> MonsterDef {
  bit = 1 << kind;
  if tier >= 2 { bit = bit * HB_T2; }
  n = 0;
  for mi in 0..len(table) {
    m = table[mi] ?? mon_none();
    if m.m_hp > 0 && m.m_rarity > 0 && ((m.m_habitat ?? 0) & bit) != 0 { n += 1; }
  }
  if n == 0 { return mon_none(); }
  pick = salt % n ?? 0;
  k = 0;
  for mj in 0..len(table) {
    m2 = table[mj] ?? mon_none();
    if m2.m_hp > 0 && m2.m_rarity > 0 && ((m2.m_habitat ?? 0) & bit) != 0 {
      if k == pick { return m2; }
      k += 1;
    }
  }
  mon_none()
}

// A monster that FILLS THIS ROLE (ruin nest, grave, roost, ...). Same contract.
pub fn mon_pick_tag(table: vector<MonsterDef>, tag: integer, salt: integer) -> MonsterDef {
  n = 0;
  for mi in 0..len(table) {
    m = table[mi] ?? mon_none();
    if m.m_hp > 0 && ((m.m_tags ?? 0) & tag) != 0 { n += 1; }
  }
  if n == 0 { return mon_none(); }
  pick = salt % n ?? 0;
  k = 0;
  for mj in 0..len(table) {
    m2 = table[mj] ?? mon_none();
    if m2.m_hp > 0 && ((m2.m_tags ?? 0) & tag) != 0 {
      if k == pick { return m2; }
      k += 1;
    }
  }
  mon_none()
}

pub fn mon_find(table: vector<MonsterDef>, key: text) -> MonsterDef {
  for mi in 0..len(table) {
    m = table[mi] ?? mon_none();
    if m.m_key == key { return m; }
  }
  mon_none()
}

// Monsters whose native depth is at or above the surface and no deeper than
// `depth` — the eligible spawn pool for that dungeon level.
pub fn mon_for_depth(table: vector<MonsterDef>, depth: integer) -> vector<MonsterDef> {
  out: vector<MonsterDef> = [];
  for mi in 0..len(table) {
    m = table[mi] ?? mon_none();
    if m.m_depth > 0 && m.m_depth <= depth { out += [m]; }
  }
  out
}

// Deterministically pick a non-unique monster from `pool` (keyed by seed + i).
// Returns mon_none() (m_hp == 0) if the pool is empty / all uniques.
pub fn mon_pick(pool: vector<MonsterDef>, seed: integer, i: integer) -> MonsterDef {
  n = len(pool);
  res = mon_none();
  if n > 0 {
    base = ((seed * 1103515245 + i * 12345) & 2147483647) % n ?? 0;
    hit = false;
    for j in 0..n {
      if !hit {
        idx = (base + j) % n ?? 0;
        if idx < len(pool) {
          m = pool[idx];
          if !mon_has_flag(m, MF_UNIQUE) { res = m; hit = true; }
        }
      }
    }
  }
  res
}

// Selection weight ∝ 1/rarity (common monsters far likelier than rare ones).
fn mon_weight(rarity: integer) -> integer {
  rr = rarity;
  if rr < 1 { rr = 1; }
  64 / rr ?? 1
}

// Eligible, non-unique monsters at or above the floor depth (built like
// mon_for_depth — the table-iteration form the interpreter handles safely).
fn mon_pool(table: vector<MonsterDef>, eff: integer) -> vector<MonsterDef> {
  out: vector<MonsterDef> = [];
  for mi in 0..len(table) {
    m = table[mi] ?? mon_none();
    if m.m_hp > 0 && m.m_depth >= 1 && m.m_depth <= eff && !mon_has_flag(m, MF_UNIQUE) {
      out += [m];
    }
  }
  out
}

// One rarity-weighted pick from the pool (cumulative-weight scan, guarded
// direct index — the mon_pick form the interpreter handles safely).
fn mon_one(table: vector<MonsterDef>, eff: integer, salt: integer) -> MonsterDef {
  pool = mon_pool(table, eff);
  np = len(pool);
  chosen = mon_none();
  if np > 0 {
    total = 0;
    for wi in 0..np {
      if wi < np { m = pool[wi]; total += mon_weight(m.m_rarity); }
    }
    if total > 0 {
      s = (((salt & 2147483647) | 1) * 1103515245 + 12345) & 2147483647;
      roll = s % total ?? 0;
      acc = 0;
      hit = false;
      for wj in 0..np {
        if !hit && wj < np {
          m = pool[wj];
          acc += mon_weight(m.m_rarity);
          if roll < acc { chosen = m; hit = true; }
        }
      }
    }
  }
  chosen
}

// Angband get_mon_num: rarity-weighted, depth-filtered draw with a deepen bias
// (keep the deepest of 3 draws). Excludes uniques. Returns mon_none() (m_hp==0)
// only if nothing is eligible. `salt` makes each call independent + reproducible.
pub fn mon_choose(table: vector<MonsterDef>, eff: integer, salt: integer) -> MonsterDef {
  best = mon_none();
  bestdepth = -1;
  d = 0;
  while d < 3 {
    cand = mon_one(table, eff, salt * 131 + d * 17);
    if cand.m_hp > 0 && cand.m_depth > bestdepth {
      bestdepth = cand.m_depth;
      best = cand;
    }
    d += 1;
  }
  best
}
