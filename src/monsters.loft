  t += [MonsterDef { m_key: "wyvern", m_name: "wyvern", m_glyph: "w", m_cr: 120, m_cg: 140, m_cb: 200, m_depth: 14, m_rarity: 2, m_hp: 70, m_ac: 22, m_speed: 10, m_dam: 12, m_vision: 14, m_xp: 40, m_flags: MF_NONE }];
