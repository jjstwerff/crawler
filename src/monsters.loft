  t += [MonsterDef { m_key: "giant_spider", m_name: "giant spider", m_glyph: "S", m_cr: 140, m_cg: 80, m_cb: 200, m_depth: 13, m_rarity: 2, m_hp: 45, m_ac: 18, m_speed: 10, m_dam: 8, m_vision: 12, m_xp: 28, m_flags: MF_CASTER , m_habitat: HB_FOREST | HB_FOREST * HB_T2 }];
