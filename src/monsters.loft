  t += [MonsterDef { m_key: "troll", m_name: "troll", m_glyph: "T", m_cr: 90, m_cg: 170, m_cb: 90, m_depth: 12, m_rarity: 1, m_hp: 65, m_ac: 20, m_speed: 0, m_dam: 14, m_vision: 12, m_xp: 30, m_flags: MF_NONE }];
