  t += [MonsterDef { m_key: "jackal", m_name: "jackal", m_glyph: "C", m_cr: 180, m_cg: 140, m_cb: 70, m_depth: 3, m_rarity: 1, m_hp: 6, m_ac: 7, m_speed: 5, m_dam: 3, m_vision: 10, m_xp: 3, m_flags: MF_GROUP }];
