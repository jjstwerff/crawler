  t += [MonsterDef { m_key: "kobold", m_name: "kobold", m_glyph: "k", m_cr: 120, m_cg: 180, m_cb: 80, m_depth: 2, m_rarity: 1, m_hp: 6, m_ac: 8, m_speed: 0, m_dam: 3, m_vision: 8, m_xp: 3, m_flags: MF_GROUP }];
