  t += [MonsterDef { m_key: "stone_giant", m_name: "stone giant", m_glyph: "P", m_cr: 160, m_cg: 160, m_cb: 160, m_depth: 18, m_rarity: 2, m_hp: 120, m_ac: 26, m_speed: 0, m_dam: 20, m_vision: 12, m_xp: 80, m_flags: MF_NONE }];
  t += [MonsterDef { m_key: "lich", m_name: "lich", m_glyph: "L", m_cr: 180, m_cg: 120, m_cb: 220, m_depth: 20, m_rarity: 3, m_hp: 110, m_ac: 28, m_speed: 5, m_dam: 14, m_vision: 16, m_xp: 140, m_flags: MF_CASTER }];
  // ── uniques (original names; rarity 0) ──
  t += [MonsterDef { m_key: "skarn_rat_king", m_name: "Skarn, the Rat King", m_glyph: "r", m_cr: 200, m_cg: 60, m_cb: 60, m_depth: 3, m_rarity: 0, m_hp: 30, m_ac: 10, m_speed: 5, m_dam: 5, m_vision: 12, m_xp: 25, m_flags: MF_UNIQUE | MF_GROUP | MF_BREEDER }];
