// reloadprobe — K3 verification: a single-file windowed kernel program whose
// draw color is LIVE-EDITED while it runs (the smoke seds the literal below,
// the reload swaps tick_draw, the pixels change). Esc / close to exit.
use graphics;
use engine_host;

// The window and its painter, as the ONE link the tick closure captures (each is a
// value that releases its GL object when its owner goes — story.loft's GameWorld shape).
struct Probe {
  win:     graphics::Window,
  painter: graphics::Painter,
}

fn tick_draw(p: const Probe) {
  if !p.win.poll() || p.win.key_down(27) {
    engine_host::client_stop();
    return;
  }
  p.win.clear(graphics::rgba(10, 10, 10, 255));
  p.painter.rect(200.0, 150.0, 400.0, 300.0, 0.90, 0.15, 0.15, 1.0);
  p.win.swap();
}

fn main() {
  win = graphics::open_window(800, 600, "reload probe") ?? return;
  painter = win.painter() ?? return;
  win.disable(graphics::GL_DEPTH_TEST);
  p = Probe { win: win, painter: painter };
  engine_host::run_local(16666, fn(_ev: engine_host::Event) {}, fn() {
    tick_draw(p);
  });
  p.win.close();
}
