// scenemesh — turn the FIELD into triangles, so it can be looked at.
//
// Plans #5 and #9 verified everything numerically. This is the other half: the field is
// converted to geometry exactly as the physics holds it — a quad per blocked EDGE, a box
// per canopy CELL, a taper per skeleton BRANCH — and rendered. Nothing is prettified on the
// way out, because the point is to see what the model actually says, not what a renderer
// could make of it.
//
// Materials are single flat colours on purpose. Anything more would let shading hide a
// shape error, which is precisely what this is meant to catch.
use hex_field;
use hexedge;
use hexcanopy;
use hexskel;
use hexmatch;
use mesh3d;

fn wx(k: integer) -> float { (k as float) * 0.8660254037844386 }
fn wy(m: integer) -> float { (m as float) * 0.5 }

// A vertical quad between two ground points, from z0 to z1.
fn wall_quad(ms: Mesh, ax: float, ay: float, bx: float, by: float, z0: float, z1: float) {
  dx = bx - ax; dy = by - ay;
  L = sqrt(dx * dx + dy * dy) ?? 1.0;
  nx = 0.0 - dy / L ?? 0.0;
  ny = dx / L ?? 0.0;
  n = vec3(nx, ny, 0.0);
  u = vec2(0.0, 0.0);
  i0 = add_vertex(ms, vertex(vec3(ax, ay, z0), n, u));
  i1 = add_vertex(ms, vertex(vec3(bx, by, z0), n, u));
  i2 = add_vertex(ms, vertex(vec3(bx, by, z1), n, u));
  i3 = add_vertex(ms, vertex(vec3(ax, ay, z1), n, u));
  add_quad(ms, i0, i1, i2, i3);
}

// The two lattice corners an edge shares.  Found by INTERSECTING the two cells' corner
// sets rather than by trusting a direction-index convention to line up — the corner order
// is canonical (hex_grid) but the neighbour indexing is this module's own, and a mismatch
// there would be a silent one-corner rotation.
fn shared_corners(qa: integer, ra: integer, qb: integer, rb: integer,
                  out: vector<integer>) -> integer {
  ka = lattice_k(qa, ra); ma = lattice_m(qa, ra);
  kb = lattice_k(qb, rb); mb = lattice_m(qb, rb);
  n = 0;
  for i in 0..6 {
    ck = ka + corner_k(i);
    cm = ma + corner_m(i);
    for j in 0..6 {
      if ck == kb + corner_k(j) && cm == mb + corner_m(j) && n < 4 {
        out[n * 2] = ck;
        out[n * 2 + 1] = cm;
        n = n + 1;
      }
    }
  }
  n
}

// Every blocked edge becomes a wall panel — this IS the collision layer, drawn.
pub fn mesh_walls(e: EdgeSet, q0: integer, r0: integer, w: integer, h: integer,
                  z0: float, z1: float) -> Mesh {
  ms = mesh("walls");
  cor: vector<integer> = [];
  for i in 0..8 { cor += [0]; }
  for r in r0..r0 + h {
    for q in q0..q0 + w {
      for d in 0..6 {
        nq = nb_q(q, r, d);
        nr = nb_r(q, r, d);
        // each edge once: only from the lexicographically smaller cell
        if r < nr || (r == nr && q < nq) {
          if edge_blocked(e, q, r, nq, nr) {
            n = shared_corners(q, r, nq, nr, cor);
            if n == 2 {
              wall_quad(ms, wx(cor[0] ?? 0), wy(cor[1] ?? 0),
                            wx(cor[2] ?? 0), wy(cor[3] ?? 0), z0, z1);
            }
          }
        }
      }
    }
  }
  ms
}

// A flat hexagon at height z for each cell of a set — floors, decks, platform tops.
pub fn mesh_floor(s: HexSet, z: float, nm: text) -> Mesh {
  ms = mesh(nm);
  n = vec3(0.0, 0.0, 1.0);
  u = vec2(0.0, 0.0);
  for r in hexset_r0(s)..hexset_r0(s) + hexset_h(s) {
    for q in hexset_q0(s)..hexset_q0(s) + hexset_w(s) {
      if hexset_get(s, q, r) {
        k = lattice_k(q, r);
        m = lattice_m(q, r);
        c = add_vertex(ms, vertex(vec3(wx(k), wy(m), z), n, u));
        for i in 0..6 {
          j = i + 1;
          if j > 5 { j = 0; }
          a = add_vertex(ms, vertex(vec3(wx(k + corner_k(i)), wy(m + corner_m(i)), z), n, u));
          b = add_vertex(ms, vertex(vec3(wx(k + corner_k(j)), wy(m + corner_m(j)), z), n, u));
          add_triangle(ms, c, a, b);
        }
      }
    }
  }
  ms
}

// The canopy as a box per cell, spanning its own (base, top).  Crude on purpose: it draws
// the INTERVAL the physics holds, so a wrong crown profile shows as a wrong silhouette.
pub fn mesh_canopy(lb: Labels, s: HexSet, top: Heights, base: Heights, id: integer) -> Mesh {
  ms = mesh("canopy");
  u = vec2(0.0, 0.0);
  for r in hexset_r0(s)..hexset_r0(s) + hexset_h(s) {
    for q in hexset_q0(s)..hexset_q0(s) + hexset_w(s) {
      if label_get(lb, q, r) == id {
        zb = height_get(base, q, r);
        zt = height_get(top, q, r);
        if zt > zb + 0.01 {
          k = lattice_k(q, r);
          m = lattice_m(q, r);
          nn = vec3(0.0, 0.0, 1.0);
          c = add_vertex(ms, vertex(vec3(wx(k), wy(m), zt), nn, u));
          for i in 0..6 {
            j = i + 1;
            if j > 5 { j = 0; }
            ax = wx(k + corner_k(i)); ay = wy(m + corner_m(i));
            bx = wx(k + corner_k(j)); by = wy(m + corner_m(j));
            // the cap
            a = add_vertex(ms, vertex(vec3(ax, ay, zt), nn, u));
            b = add_vertex(ms, vertex(vec3(bx, by, zt), nn, u));
            add_triangle(ms, c, a, b);
            // the skirt down to the crown base
            wall_quad(ms, ax, ay, bx, by, zb, zt);
          }
        }
      }
    }
  }
  ms
}

// ── WALLS FROM RECOVERED SURFACES ───────────────────────────────────────────
//
// Drawing one quad per blocked edge renders the hex boundary LITERALLY, and the result is a
// row of fins at 60 degrees to each other rather than a wall. The first render of scene1
// showed exactly that.
//
// The fix is the one this whole project keeps arriving at: cells are storage, the recovered
// surface is the truth. hexmatch already turns a traced boundary into straights and arcs
// (plan #5 P2); the wall is built from THOSE, so a straight wall is one flat panel and a
// round tower is a smooth ring — regardless of how the cells beneath them zigzag.
//
// It is the same statement as "draw the cone, not the hexes" (plan #5 section 14), one
// dimension down, and it is not cosmetic: the fins were a misrepresentation of what the
// collision layer actually holds, which is a straight surface.

fn vkx(v: VecMap, i: integer) -> float { ((v.vm_k[i] ?? 0) as float) * 0.8660254037844386 }
fn vmy(v: VecMap, i: integer) -> float { ((v.vm_m[i] ?? 0) as float) * 0.5 }

pub fn mesh_walls_fitted(v: VecMap, z0: float, z1: float, minrun: integer) -> Mesh {
  ms = mesh("walls");
  for li in 0..v.vm_loops {
    base = v.vm_start[li] ?? 0;
    endi = v.vm_start[li + 1] ?? 0;
    cnt = endi - base;
    if cnt >= minrun {
      f = fit_new();
      match_loop(v, li, f, minrun);
      for i in 0..f.ft_n {
        a0 = f.ft_from[i] ?? 0;
        a1 = f.ft_to[i] ?? 0;
        if (f.ft_kind[i] ?? 0) == 1 {
          // a straight run: one panel, from the run's first vertex to its last, both
          // projected onto the fitted line so the panel is exactly flat
          nx = f.ft_a[i] ?? 0.0;
          ny = f.ft_b[i] ?? 0.0;
          cc = f.ft_c[i] ?? 0.0;
          ia = base + (a0 % cnt);
          ib = base + ((a1 - 1) % cnt);
          ax = vkx(v, ia); ay = vmy(v, ia);
          bx = vkx(v, ib); by = vmy(v, ib);
          da = nx * ax + ny * ay - cc;
          db = nx * bx + ny * by - cc;
          wall_quad(ms, ax - nx * da, ay - ny * da, bx - nx * db, by - ny * db, z0, z1);
        } else {
          // an arc: walk it in short chords so it reads round rather than faceted
          cx = f.ft_a[i] ?? 0.0;
          cy = f.ft_b[i] ?? 0.0;
          rr = f.ft_c[i] ?? 0.0;
          ia = base + (a0 % cnt);
          ib = base + ((a1 - 1) % cnt);
          // The sweep is ACCUMULATED along the run's own vertices, not taken from the
          // first and last. A run that covers a closed loop spans nearly 2*pi, and
          // deriving the sweep from the endpoints wraps it into +/-pi — which collapses a
          // whole round tower into one sliver. Found by looking at the render; the numbers
          // had said nothing about it.
          sa = atan2(vmy(v, ia) - cy, vkx(v, ia) - cx);
          d = 0.0;
          prev = sa;
          for t in 1..(a1 - a0) {
            it = base + ((a0 + t) % cnt);
            cur = atan2(vmy(v, it) - cy, vkx(v, it) - cx);
            st = cur - prev;
            while st > 3.141592653589793 { st = st - 6.283185307179586; }
            while st < 0.0 - 3.141592653589793 { st = st + 6.283185307179586; }
            d = d + st;
            prev = cur;
          }
          steps = ((a1 - a0) as integer);
          if steps < 2 { steps = 2; }
          for s in 0..steps {
            t0 = sa + d * ((s as float) / (steps as float) ?? 0.0);
            t1 = sa + d * (((s + 1) as float) / (steps as float) ?? 0.0);
            wall_quad(ms, cx + rr * cos(t0), cy + rr * sin(t0),
                          cx + rr * cos(t1), cy + rr * sin(t1), z0, z1);
          }
        }
      }
    }
  }
  ms
}

// The crown as its RECOVERED FORM rather than a stack of per-cell boxes.
//
// The first render of scene1 drew mesh_canopy literally and the tree came out as a green
// staircase. Same error as the wall fins, same fix: the cells are how the crown is STORED,
// the paraboloid is what it IS (plan #9 I-EXACT chose that profile). So the crown is drawn
// from the profile — which is exactly plan #5 section 14's rule, "interpolate planar roofs,
// recover only cones", applied to the one curved-in-plan form the canopy has.
pub fn mesh_crown(cx: float, cy: float, bole: float, peak: float, radius: float,
                  rings: integer, sectors: integer) -> Mesh {
  ms = mesh("crown");
  u = vec2(0.0, 0.0);
  for i in 0..rings {
    r0f = radius * ((i as float) / (rings as float) ?? 0.0);
    r1f = radius * (((i + 1) as float) / (rings as float) ?? 0.0);
    t0 = 1.0 - (r0f * r0f) / (radius * radius) ?? 0.0;
    t1 = 1.0 - (r1f * r1f) / (radius * radius) ?? 0.0;
    z0 = bole + (peak - bole) * t0;
    z1 = bole + (peak - bole) * t1;
    for s in 0..sectors {
      a0 = 6.283185307179586 * ((s as float) / (sectors as float) ?? 0.0);
      a1 = 6.283185307179586 * (((s + 1) as float) / (sectors as float) ?? 0.0);
      x00 = cx + r0f * cos(a0); y00 = cy + r0f * sin(a0);
      x01 = cx + r0f * cos(a1); y01 = cy + r0f * sin(a1);
      x10 = cx + r1f * cos(a0); y10 = cy + r1f * sin(a0);
      x11 = cx + r1f * cos(a1); y11 = cy + r1f * sin(a1);
      nz = vec3(0.0, 0.0, 1.0);
      v00 = add_vertex(ms, vertex(vec3(x00, y00, z0), nz, u));
      v01 = add_vertex(ms, vertex(vec3(x01, y01, z0), nz, u));
      v11 = add_vertex(ms, vertex(vec3(x11, y11, z1), nz, u));
      v10 = add_vertex(ms, vertex(vec3(x10, y10, z1), nz, u));
      add_quad(ms, v00, v01, v11, v10);
    }
  }
  ms
}

// The meshed branches, drawn — a tapered box per skeleton segment, radius from the pipe
// model at each end.  This is what the spoke defect was hiding in: the crown covers it, so
// nothing showed until the branches themselves were drawn.
pub fn mesh_branches(sk: Skeleton, top: Heights, base: Heights,
                     nmin: integer, k: float) -> Mesh {
  ms = mesh("branches");
  u = vec2(0.0, 0.0);
  for j in 1..sk.sk_n {
    if (sk.sk_load[j] ?? 0) >= nmin {
      p = sk.sk_par[j] ?? -1;
      if p >= 0 {
        ax = node_x(sk, p); ay = node_y(sk, p);
        bx = node_x(sk, j); by = node_y(sk, j);
        az = height_get(base, sk.sk_q[p] ?? 0, sk.sk_r[p] ?? 0)
           + (height_get(top, sk.sk_q[p] ?? 0, sk.sk_r[p] ?? 0)
            - height_get(base, sk.sk_q[p] ?? 0, sk.sk_r[p] ?? 0)) * 0.45;
        bz = height_get(base, sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0)
           + (height_get(top, sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0)
            - height_get(base, sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0)) * 0.45;
        ra = node_radius(sk, p, k);
        rb = node_radius(sk, j, k);
        dx = bx - ax; dy = by - ay;
        L = sqrt(dx * dx + dy * dy) ?? 1.0;
        nx = 0.0 - dy / L ?? 0.0;
        ny = dx / L ?? 0.0;
        nz = vec3(nx, ny, 0.0);
        v0 = add_vertex(ms, vertex(vec3(ax - nx * ra, ay - ny * ra, az), nz, u));
        v1 = add_vertex(ms, vertex(vec3(ax + nx * ra, ay + ny * ra, az), nz, u));
        v2 = add_vertex(ms, vertex(vec3(bx + nx * rb, by + ny * rb, bz), nz, u));
        v3 = add_vertex(ms, vertex(vec3(bx - nx * rb, by - ny * rb, bz), nz, u));
        add_quad(ms, v0, v1, v2, v3);
        vt = vec3(0.0, 0.0, 1.0);
        w0 = add_vertex(ms, vertex(vec3(ax - nx * ra, ay - ny * ra, az + ra), vt, u));
        w1 = add_vertex(ms, vertex(vec3(ax + nx * ra, ay + ny * ra, az + ra), vt, u));
        w2 = add_vertex(ms, vertex(vec3(bx + nx * rb, by + ny * rb, bz + rb), vt, u));
        w3 = add_vertex(ms, vertex(vec3(bx - nx * rb, by - ny * rb, bz + rb), vt, u));
        add_quad(ms, w0, w1, w2, w3);
      }
    }
  }
  ms
}

// ── PLACING THE SKELETON IN 3D ──────────────────────────────────────────────
//
// The skeleton is a PLAN-VIEW structure: its nodes are cells, and it says what connects to
// what, not where anything sits vertically. The first render laid every node at the local
// canopy height, so the branches followed the crown SURFACE and the tree read as a spider —
// no trunk, legs drooping outward.
//
// The whorl model supplies the missing height. A branch leaves the TRUNK AXIS at its whorl
// height and runs outward to the canopy surface at its tip, so:
//
//     z(node) = lerp( z_attach(its branch), crown surface at the node, how far out it is )
//
// and a branch reaching far out — which serves low crown — necessarily attaches low, while
// a short branch near the top attaches high. That is the arrangement that makes a tree look
// like a tree, and none of it is authored: it falls out of the crown profile and the
// branch's own reach.
//
// Height is a PLACEMENT decision, so it lives here in the geometry layer rather than in the
// skeleton, which stays a pure topology.
pub fn branch_heights(sk: Skeleton, top: Heights, base: Heights) -> vector<float> {
  n = sk.sk_n;
  z: vector<float> = [];
  anc: vector<integer> = [];
  rad: vector<float> = [];
  for j in 0..n { z += [0.0]; anc += [0]; rad += [0.0]; }
  tx = node_x(sk, 0);
  ty = node_y(sk, 0);
  // the tree's full height, at the trunk
  H = height_get(top, sk.sk_q[0] ?? 0, sk.sk_r[0] ?? 0);
  for j in 0..n {
    dx = node_x(sk, j) - tx;
    dy = node_y(sk, j) - ty;
    rad[j] = sqrt(dx * dx + dy * dy) ?? 0.0;
  }
  // first-order ancestor: the child of the root that this node hangs from
  for j in 1..n {
    a = j;
    guard = 0;
    while (sk.sk_par[a] ?? -1) > 0 && guard < n { a = sk.sk_par[a] ?? 0; guard = guard + 1; }
    anc[j] = a;
  }
  // each branch's reach, and the crown height where it ends
  rmax: vector<float> = [];
  ztip: vector<float> = [];
  for j in 0..n { rmax += [0.0]; ztip += [0.0]; }
  for j in 1..n {
    a = anc[j] ?? 0;
    if (rad[j] ?? 0.0) > (rmax[a] ?? 0.0) {
      rmax[a] = rad[j] ?? 0.0;
      ztip[a] = height_get(top, sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0);
    }
  }
  // WHERE EACH BRANCH LEAVES THE TRUNK.
  //
  // Deriving it from the branch's own reach put every branch at one height — an isolated
  // crown is round, so every first-order branch reaches about the same distance, and they
  // all landed in a single plate. The growth story gives the answer instead: a branch's
  // LOAD is its age, because it has been accumulating crown since it formed. So the
  // heaviest branch is the oldest, formed when the tree was shortest, and sits LOWEST —
  // and the whorl budget is what stopped them all forming at once in the first place.
  zlo = H * 0.22;
  zhi = H * 0.86;
  nb = 0;
  for j in 1..n { if (sk.sk_par[j] ?? -1) == 0 { nb = nb + 1; } }
  zatt_of: vector<float> = [];
  for j in 0..n { zatt_of += [H * 0.5]; }
  for j in 1..n {
    if (sk.sk_par[j] ?? -1) == 0 {
      // rank by load: how many first-order branches carry more than this one
      rank = 0;
      for o in 1..n {
        if (sk.sk_par[o] ?? -1) == 0 && (sk.sk_load[o] ?? 0) > (sk.sk_load[j] ?? 0) {
          rank = rank + 1;
        }
      }
      f = 0.0;
      if nb > 1 { f = (rank as float) / ((nb - 1) as float) ?? 0.0; }
      zatt_of[j] = zlo + (zhi - zlo) * f;
    }
  }
  z[0] = H;
  for j in 1..n {
    a = anc[j] ?? 0;
    zatt = zatt_of[a] ?? (H * 0.5);
    rm = rmax[a] ?? 0.0;
    t = 0.0;
    if rm > 0.0001 { t = (rad[j] ?? 0.0) / rm ?? 0.0; }
    if t > 1.0 { t = 1.0; }
    zs = height_get(top, sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0);
    z[j] = zatt + (zs - zatt) * t;
  }
  z
}

// Branches drawn from those heights, each segment starting where its parent sits.  The
// first segment of every branch starts ON the trunk axis, which is what gives the tree a
// centre to hang from.
pub fn mesh_branches_3d(sk: Skeleton, z: vector<float>, nmin: integer, k: float) -> Mesh {
  ms = mesh("branches");
  u = vec2(0.0, 0.0);
  tx = node_x(sk, 0);
  ty = node_y(sk, 0);
  for j in 1..sk.sk_n {
    if (sk.sk_load[j] ?? 0) >= nmin {
      p = sk.sk_par[j] ?? -1;
      if p >= 0 {
        ax = node_x(sk, p); ay = node_y(sk, p);
        if p == 0 { ax = tx; ay = ty; }
        bx = node_x(sk, j); by = node_y(sk, j);
        az = z[p] ?? 0.0;
        bz = z[j] ?? 0.0;
        ra = node_radius(sk, p, k);
        rb = node_radius(sk, j, k);
        dx = bx - ax; dy = by - ay;
        L = sqrt(dx * dx + dy * dy) ?? 1.0;
        nx = 0.0 - dy / L ?? 0.0;
        ny = dx / L ?? 0.0;
        nz = vec3(nx, ny, 0.0);
        v0 = add_vertex(ms, vertex(vec3(ax - nx * ra, ay - ny * ra, az), nz, u));
        v1 = add_vertex(ms, vertex(vec3(ax + nx * ra, ay + ny * ra, az), nz, u));
        v2 = add_vertex(ms, vertex(vec3(bx + nx * rb, by + ny * rb, bz), nz, u));
        v3 = add_vertex(ms, vertex(vec3(bx - nx * rb, by - ny * rb, bz), nz, u));
        add_quad(ms, v0, v1, v2, v3);
        vt = vec3(0.0, 0.0, 1.0);
        w0 = add_vertex(ms, vertex(vec3(ax - nx * ra, ay - ny * ra, az + ra * 1.4), vt, u));
        w1 = add_vertex(ms, vertex(vec3(ax + nx * ra, ay + ny * ra, az + ra * 1.4), vt, u));
        w2 = add_vertex(ms, vertex(vec3(bx + nx * rb, by + ny * rb, bz + rb * 1.4), vt, u));
        w3 = add_vertex(ms, vertex(vec3(bx - nx * rb, by - ny * rb, bz + rb * 1.4), vt, u));
        add_quad(ms, w0, w1, w2, w3);
      }
    }
  }
  ms
}

// The trunk itself: a tapered column on the axis, from the ground to the crown top, its
// radius the pipe model's at the root.
pub fn mesh_trunk(sk: Skeleton, ztop: float, k: float, sides: integer) -> Mesh {
  ms = mesh("trunk");
  u = vec2(0.0, 0.0);
  tx = node_x(sk, 0);
  ty = node_y(sk, 0);
  r0f = node_radius(sk, 0, k);
  for s in 0..sides {
    a0 = 6.283185307179586 * ((s as float) / (sides as float) ?? 0.0);
    a1 = 6.283185307179586 * (((s + 1) as float) / (sides as float) ?? 0.0);
    // taper: full at the base, a third at the top
    for seg in 0..6 {
      f0 = (seg as float) / 6.0 ?? 0.0;
      f1 = ((seg + 1) as float) / 6.0 ?? 0.0;
      z0 = ztop * f0;
      z1 = ztop * f1;
      ra = r0f * (1.0 - 0.66 * f0);
      rb = r0f * (1.0 - 0.66 * f1);
      n0 = vec3(cos(a0), sin(a0), 0.0);
      p0 = add_vertex(ms, vertex(vec3(tx + ra * cos(a0), ty + ra * sin(a0), z0), n0, u));
      p1 = add_vertex(ms, vertex(vec3(tx + ra * cos(a1), ty + ra * sin(a1), z0), n0, u));
      p2 = add_vertex(ms, vertex(vec3(tx + rb * cos(a1), ty + rb * sin(a1), z1), n0, u));
      p3 = add_vertex(ms, vertex(vec3(tx + rb * cos(a0), ty + rb * sin(a0), z1), n0, u));
      add_quad(ms, p0, p1, p2, p3);
    }
  }
  ms
}

// ── THE FOLIAGE CARDS ───────────────────────────────────────────────────────
//
// T9 places one card per node below the mesh threshold: a position inside the canopy
// interval, an OUTWARD heading, and a size taken from the canopy depth at that cell. Drawn,
// each is a quad whose plane contains the outward direction and the vertical — so the
// branch spray printed on it lies in the plane and reads edge-on from the side, which is
// why the heading could never be camera-facing.
//
// Flat single colour, as everywhere in this verification: shading must not be able to hide
// a placement error.
pub fn mesh_cards(cd: Cards, wscale: float, hscale: float) -> Mesh {
  ms = mesh("cards");
  u = vec2(0.0, 0.0);
  for j in 0..cd.cd_n {
    px = cd.cd_x[j] ?? 0.0;
    py = cd.cd_y[j] ?? 0.0;
    pz = cd.cd_z[j] ?? 0.0;
    dx = cd.cd_dx[j] ?? 1.0;
    dy = cd.cd_dy[j] ?? 0.0;
    sz = cd.cd_size[j] ?? 1.0;
    w = wscale;
    h = sz * hscale;
    if h > wscale * 2.0 { h = wscale * 2.0; }
    if h < wscale * 0.4 { h = wscale * 0.4; }
    // the card's plane: outward x vertical.  Its normal is horizontal, across the spray.
    nx = 0.0 - dy;
    ny = dx;
    n = vec3(nx, ny, 0.0);
    ax = px - dx * w * 0.5;
    ay = py - dy * w * 0.5;
    bx = px + dx * w * 0.5;
    by = py + dy * w * 0.5;
    v0 = add_vertex(ms, vertex(vec3(ax, ay, pz - h * 0.5), n, u));
    v1 = add_vertex(ms, vertex(vec3(bx, by, pz - h * 0.5), n, u));
    v2 = add_vertex(ms, vertex(vec3(bx, by, pz + h * 0.5), n, u));
    v3 = add_vertex(ms, vertex(vec3(ax, ay, pz + h * 0.5), n, u));
    add_quad(ms, v0, v1, v2, v3);
    // a second card across the first, so a spray has volume from every angle — the
    // standard cross-quad, and the reason a single plane never reads as foliage
    c0 = add_vertex(ms, vertex(vec3(px - nx * w * 0.5, py - ny * w * 0.5, pz - h * 0.5), vec3(dx, dy, 0.0), u));
    c1 = add_vertex(ms, vertex(vec3(px + nx * w * 0.5, py + ny * w * 0.5, pz - h * 0.5), vec3(dx, dy, 0.0), u));
    c2 = add_vertex(ms, vertex(vec3(px + nx * w * 0.5, py + ny * w * 0.5, pz + h * 0.5), vec3(dx, dy, 0.0), u));
    c3 = add_vertex(ms, vertex(vec3(px - nx * w * 0.5, py - ny * w * 0.5, pz + h * 0.5), vec3(dx, dy, 0.0), u));
    add_quad(ms, c0, c1, c2, c3);
  }
  ms
}
