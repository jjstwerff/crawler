// postprobe — R6 probe scene (PLAN-RENDER P4): the light-cone + vignette pass
// over a UNIFORM mid-gray world, so the probes measure the falloff itself with
// zero scene interference. Expected values are generated by
// tools/blueprints/light_cone.py (the same constants as view's POSTFRAG).
use graphics;
use view;

fn main() {
  if !graphics::gl_create_window(800, 600, "post r6 probe") {
    println("postprobe: no window");
    return;
  }
  graphics::gl_disable(graphics::GL_DEPTH_TEST);

  postprog = make_post_shader();
  (postfbo, posttex) = make_post_target();

  graphics::gl_poll_events();
  graphics::gl_bind_framebuffer(postfbo);
  graphics::gl_clear(graphics::rgba(128, 128, 128, 255));   // the uniform scene
  graphics::gl_bind_framebuffer(0);
  graphics::gl_use_shader(postprog);
  graphics::gl_bind_texture(posttex, 0);
  graphics::gl_set_uniform_int(postprog, "uScene", 0);
  graphics::gl_draw_fullscreen_quad();
  ok = graphics::gl_screenshot(800, 600, "/tmp/probe_post.png");
  println("postprobe: shot={ok}");
  graphics::gl_destroy_window();
}
