// postprobe — R6 probe scene (plan #7 P4): the light-cone + vignette pass
// over a UNIFORM mid-gray world, so the probes measure the falloff itself with
// zero scene interference. Expected values are generated by
// tools/blueprints/light_cone.py (the same constants as view's POSTFRAG).
use graphics;
use view::*;

fn main() {
  win = graphics::open_window(800, 600, "post r6 probe");
  if win == null {
    println("postprobe: no window");
    return;
  }
  win.disable(graphics::GL_DEPTH_TEST);

  postprog = make_post_shader(win) ?? return;
  post = make_post_target(win);

  _alive = win.poll();
  win.render_to(post.fbo);
  win.clear(graphics::rgba(128, 128, 128, 255));   // the uniform scene
  win.render_to_window();
  post.tex.bind(0);
  postprog.set_int("uScene", 0);
  post.quad.draw(postprog);
  ok = win.capture().save_png("/tmp/probe_post.png");
  println("postprobe: shot={ok}");
  win.close();
}
