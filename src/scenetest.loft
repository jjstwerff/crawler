// scenetest — the camera contract (plan #11 P3, invariant I-STAND).
//
// THE GATE the plan names: a hex centre projected to a pixel, unprojected back, must land
// in the SAME hex. Pure maths — no GL context, no window, no Xvfb. That is the point of
// keeping the camera free of `graphics`: the invariant that decides whether the world is
// drawn where the kernel says it is can be checked headlessly, every run.
//
// The round-trip is only DEFINED for pixels below the horizon (a ray above it never meets
// the ground ahead of the camera). The test therefore skips those explicitly and counts
// what it skipped, so "0 failures" can never mean "0 tested".
use hexscene;
use hex_grid;

fn main() {
  println("=== story scene test (plan #11 P3: hex -> pixel -> the same hex) ===");

  tested = 0;
  behind = 0;
  above = 0;
  bad = 0;
  worst = 0.0;

  // A spread of cameras: eye height 1.6 m (0.866 world units per metre => 1.847), a few
  // headings, and pitches from level to steeply down. Level is the interesting one — most
  // of the screen is then above the horizon and the defined region is a thin band.
  for ci in 0..12 {
    ex = 20.0 + (ci as float) * 0.37;
    ey = 15.0 - (ci as float) * 0.29;
    yaw = (ci as float) * 0.5235987755982988;          // 30 deg apart
    pitch = 0.0 - (((ci % 4 ?? 0) as float) * 0.15);   // 0, -0.15, -0.30, -0.45 rad
    c = camera_new(ex, ey, 1.847, yaw, pitch, 1.0471975511965976, 1024.0, 576.0);

    for r in 0..24 {
      for q in 0..24 {
        (hx, hy) = hex_to_px(q, r);
        (sx, sy, depth) = project(c, hx, hy, 0.0);
        if depth <= 0.0 {
          behind += 1;
        } else if sx < 0.0 || sx >= 1024.0 || sy < 0.0 || sy >= 576.0 {
          behind += 1;                                  // off-screen: not this gate's claim
        } else if sy <= horizon_y(c) {
          above += 1;                                   // no ground hit: correctly undefined
        } else {
          (bx, by, t) = unproject_plane(c, sx, sy, 0.0);
          if t <= 0.0 {
            above += 1;
          } else {
            tested += 1;
            (rq, rr) = px_to_hex(bx, by);
            if rq != q || rr != r { bad += 1; }
            e = sqrt((bx - hx) * (bx - hx) + (by - hy) * (by - hy)) ?? 0.0;
            if e > worst { worst = e; }
          }
        }
      }
    }
  }

  println("round-trip: tested={tested} same-hex-failures={bad} worst position error={worst}");
  println("  (skipped: {behind} behind/off-screen, {above} above the horizon — both correctly undefined)");

  // ── NEGATIVE CONTROL ──────────────────────────────────────────────────────
  // A round trip through the SAME camera is nearly self-proving, so perturb it: unproject
  // through a camera turned away and require the hexes to stop matching. Without this the
  // gate would pass for an identity function.
  //
  // The FIRST attempt used 0.02 rad and fired on 0 of 172 hexes — at these distances that
  // shifts the ground point by ~0.2 units against a hex circumradius of 1.0, so almost
  // every point rounds back into the hex it came from. A control has to perturb by more
  // than the quantisation it is being read through, or it reports "no change" for a
  // camera that genuinely moved.
  cc = camera_new(20.0, 15.0, 1.847, 0.4, 0.0 - 0.25, 1.0471975511965976, 1024.0, 576.0);
  cw = camera_new(20.0, 15.0, 1.847, 0.4 + 0.15, 0.0 - 0.25, 1.0471975511965976, 1024.0, 576.0);
  ctl_tested = 0;
  ctl_moved = 0;
  for r2 in 0..24 {
    for q2 in 0..24 {
      (hx2, hy2) = hex_to_px(q2, r2);
      (sx2, sy2, d2) = project(cc, hx2, hy2, 0.0);
      if d2 > 0.0 && sx2 >= 0.0 && sx2 < 1024.0 && sy2 > horizon_y(cc) && sy2 < 576.0 {
        (bx2, by2, t2) = unproject_plane(cw, sx2, sy2, 0.0);
        if t2 > 0.0 {
          ctl_tested += 1;
          (rq2, rr2) = px_to_hex(bx2, by2);
          if rq2 != q2 || rr2 != r2 { ctl_moved += 1; }
        }
      }
    }
  }
  println("negative control: camera turned 0.15 rad -> {ctl_moved}/{ctl_tested} hexes move");

  // The camera must also PLACE things at true metric size (the other half of I-STAND):
  // two posts of equal height at equal distance must subtend equal pixel spans, and one
  // twice as far must subtend half. Checked against the projection, not assumed.
  cm = camera_new(0.0, 0.0, 1.847, 0.0, 0.0, 1.0471975511965976, 1024.0, 576.0);
  (_, ay1, _) = project(cm, 8.0, 0.0, 0.0);
  (_, ay2, _) = project(cm, 8.0, 0.0, 1.0);
  (_, by1, _) = project(cm, 16.0, 0.0, 0.0);
  (_, by2, _) = project(cm, 16.0, 0.0, 1.0);
  span_near = abs(ay1 - ay2);
  span_far = abs(by1 - by2);
  ratio = span_near / span_far ?? 0.0;
  metric_ok = ratio > 1.999 && ratio < 2.001;
  println("metric parity: 1-unit post spans {span_near}px at 8u, {span_far}px at 16u — ratio {ratio}");

  // ── THE MATRIX MUST AGREE WITH THE MATHS ──────────────────────────────────
  // The GPU never runs project(); it runs cam_mat4(). If the two disagree, every check
  // above is a proof about code the renderer does not use — the renderer would be holding
  // a second opinion about where things are, which is exactly what I-STAND forbids. So
  // push points through the matrix by hand, divide, map to pixels, and demand the same
  // answer project() gives.
  mm_bad = 0;
  mm_tested = 0;
  mm_worst = 0.0;
  for mi in 0..8 {
    mc = camera_new(3.0 + (mi as float) * 1.1, 2.0 - (mi as float) * 0.7, 1.847,
                    (mi as float) * 0.7853981633974483, 0.0 - (((mi % 3 ?? 0) as float) * 0.2),
                    1.0471975511965976, 1024.0, 576.0);
    m = cam_mat4(mc, 0.05, 500.0);
    for pj in 0..40 {
      wx = 10.0 + (((pj * 7) % 23 ?? 0) as float) * 1.3;
      wy = 4.0 + (((pj * 13) % 19 ?? 0) as float) * 1.1;
      wz = (((pj * 5) % 4 ?? 0) as float) * 0.9;
      (psx, psy, pdepth) = project(mc, wx, wy, wz);
      if pdepth > 0.01 {
        clw = (m[3] ?? 0.0) * wx + (m[7] ?? 0.0) * wy + (m[11] ?? 0.0) * wz + (m[15] ?? 0.0);
        if clw > 0.01 {
          cxx = (m[0] ?? 0.0) * wx + (m[4] ?? 0.0) * wy + (m[8] ?? 0.0) * wz + (m[12] ?? 0.0);
          cyy = (m[1] ?? 0.0) * wx + (m[5] ?? 0.0) * wy + (m[9] ?? 0.0) * wz + (m[13] ?? 0.0);
          mx = ((cxx / clw ?? 0.0) + 1.0) * 0.5 * 1024.0;
          my = (1.0 - (cyy / clw ?? 0.0)) * 0.5 * 576.0;
          mm_tested += 1;
          de = sqrt((mx - psx) * (mx - psx) + (my - psy) * (my - psy)) ?? 0.0;
          if de > mm_worst { mm_worst = de; }
          if de > 0.0001 { mm_bad += 1; }
        }
      }
    }
  }
  println("matrix agrees with project(): tested={mm_tested} disagreements={mm_bad} worst {mm_worst}px");

  // ── P4: A BOARD AND A WALL OF THE SAME HEIGHT MUST COVER THE SAME PIXELS ───
  // The plan's P4 gate, computed rather than photographed (no xvfb here, and the claim is
  // about the projection anyway).
  //
  // The FIRST version of this check was a tautology and reported "worst 0px": it compared
  // project(dist,0,hgt) against project(dist,0,0.0+hgt) — two spellings of one expression,
  // so it would have passed for any projection whatsoever. It now runs the REAL board
  // geometry through `present_boards` and reads the corners back out of the emitted
  // buffer, which is what makes it capable of failing: a board sized in pixels, scaled by
  // a fudge factor, or built along camera-up instead of world-up all change these numbers.
  cb = camera_new(0.0, 0.0, 1.847, 0.0, 0.0, 1.0471975511965976, 1024.0, 576.0);
  bp_bad = 0;
  bp_tested = 0;
  bp_worst = 0.0;
  for hi in 1..5 {
    hgt = (hi as float) * 0.8;                 // 0.8 .. 3.2 world units
    for di in 1..9 {
      dist = (di as float) * 3.0;              // 3 .. 24 units ahead
      // the BOARD: emitted by the seam itself, then measured from its own vertices
      bviews: vector<ActorView> = [];
      bv = ActorView { av_x: dist, av_y: 0.0, av_z: 0.0, av_w: 1.0, av_h: hgt,
                       av_yaw: 0.0, av_r: 0.5, av_g: 0.5, av_b: 0.5, av_tex: 0 };
      bviews += [bv];
      bbuf: vector<single> = [];
      bn = present_boards(cb, bviews, bbuf);
      // vertex 0 is a base corner, vertex 2 the corner above it (stride 6)
      b0x = (bbuf[0] ?? 0.0 as single) as float;
      b0y = (bbuf[1] ?? 0.0 as single) as float;
      b0z = (bbuf[2] ?? 0.0 as single) as float;
      b2z = (bbuf[14] ?? 0.0 as single) as float;
      (_, bbot, _) = project(cb, b0x, b0y, b0z);
      (_, btop, _) = project(cb, b0x, b0y, b2z);
      // the WALL: a vertical edge of the same metric height at the same stand point
      (_, wtop, _) = project(cb, b0x, b0y, hgt);
      (_, wbot, _) = project(cb, b0x, b0y, 0.0);
      wspan = abs(wtop - wbot);
      bspan = abs(btop - bbot);
      bp_tested += 1;
      dspan = abs(wspan - bspan);
      if dspan > bp_worst { bp_worst = dspan; }
      if dspan > 0.0001 { bp_bad += 1; }
      if bn != 6 { bp_bad += 1; }              // the seam must emit one quad per actor
      if wspan < 1.0 { bp_bad += 1; }          // and the span must be real, not degenerate
    }
  }
  println("P4 metric parity: board vs wall at equal height, {bp_tested} pairs, {bp_bad} differ (worst {bp_worst}px)");

  // NEGATIVE CONTROL for the parity check: a board asked for HALF the height must NOT
  // match the wall. Without this, "0 differ" is just as consistent with a check that
  // measures nothing.
  hviews: vector<ActorView> = [];
  hv = ActorView { av_x: 9.0, av_y: 0.0, av_z: 0.0, av_w: 1.0, av_h: 1.0,
                   av_yaw: 0.0, av_r: 0.5, av_g: 0.5, av_b: 0.5, av_tex: 0 };
  hviews += [hv];
  hbuf: vector<single> = [];
  _ = present_boards(cb, hviews, hbuf);
  hz = (hbuf[14] ?? 0.0 as single) as float;
  (_, hhtop, _) = project(cb, 9.0, 0.0, hz);
  (_, hhbot, _) = project(cb, 9.0, 0.0, 0.0);
  (_, hwtop, _) = project(cb, 9.0, 0.0, 2.0);
  parity_ctl = abs(abs(hhtop - hhbot) - abs(hwtop - hhbot)) > 1.0;
  println("  control: a 1-unit board vs a 2-unit wall differ = {parity_ctl}");

  ok = bad == 0 && tested > 500 && ctl_tested > 50 && ctl_moved > (ctl_tested / 2 ?? 0)
    && metric_ok && worst < 0.000001 && mm_bad == 0 && mm_tested > 100
    && bp_bad == 0 && bp_tested > 20 && parity_ctl;
  if ok { println("=== SCENE OK ==="); } else { println("=== FAIL ==="); }
}
