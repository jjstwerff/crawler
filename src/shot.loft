// shot — render one framed frame and capture it via Window.capture, so the
// glyph/text rendering can be verified headlessly (run under xvfb). Not part
// of the game; a development aid.

use graphics;
use hex_grid::*;
use sim::*;
use wallgeo::*;
use view::*;

fn main() {
  win = graphics::open_window(800, 600, "story — shot");
  if win == null {
    println("shot: no window");
    return;
  }
  painter = win.painter() ?? return;
  win.disable(graphics::GL_DEPTH_TEST);
  win.enable(graphics::GL_BLEND);
  win.blend(graphics::BLEND_SRC_ALPHA, graphics::BLEND_ONE_MINUS_SRC_ALPHA);

  s = sim_new_gen(1337, 5);
  walls = build_walls(s);
  hud = build_hud(win, s);
  wprog = make_world_shader_inst(win) ?? return;   // R7 instanced terrain shader
  wvao = build_hex_vao(win);               // base hexagon (built once)
  // floor instances (shot has one level — no update). Held, not used again: the mesh
  // reads the buffer at every draw, so it must live as long as the mesh does.
  wivbo = build_world_ivbo(win, wvao, s);
  wallprog = make_wall_shader(win) ?? return;
  postprog = make_post_shader(win) ?? return;
  post = make_post_target(win);
  wallvao = build_walls_vbo(win, s, walls);
  walln = len(walls) * 6;
  sim_award_xp(s, 35);   // (shot only) show the XP bar partway + a higher CL

  // Frame the down-stair: stand on a FLOOR neighbor of it (gen-proof — a fixed
  // offset can land in rock or off the level as the generator evolves).
  (dq, dr) = sim_down_hex(s);
  for nb in 0..6 {
    (nq, nr) = hex_neighbor(dq, dr, nb);
    if tile_at(s, nq, nr) == 0 {
      (nx, ny) = hex_to_px(nq, nr);
      s.px = nx;
      s.py = ny;
    }
  }
  sim_compute_fov(s);   // FOV gates the view now; without this everything renders hidden

  for _ in 0..2 {
    _alive = win.poll();
    view_draw(win, painter, s, hud, wprog, wvao, wivbo, wallprog, wallvao, walln, postprog, post);
    win.swap();
  }
  _alive2 = win.poll();
  view_draw(win, painter, s, hud, wprog, wvao, wivbo, wallprog, wallvao, walln, postprog, post);
  ok = win.capture().save_png("/tmp/story_frame.png");   // the frame just drawn: before any swap
  println("shot: screenshot ok={ok}");
  win.close();
}
