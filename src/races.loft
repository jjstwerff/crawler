// races.loft — clean-room playable-race database (renderer-agnostic data).
//
// Generic fantasy races (no IP — "halfling" not "hobbit"; "highborn" is an
// original long-lived-human race). Stat modifiers + skill modifiers stack on
// top of the chosen class. r_hd = hit-die modifier; r_xp = % experience
// factor; r_infra = infravision range (tens of feet); r_flags = ability
// bitmask (RF_*).

pub const RF_NONE        = 0;
pub const RF_FREE_ACTION = 1;
pub const RF_SEE_INVIS   = 2;
pub const RF_REGEN       = 4;
pub const RF_HOLD_LIFE   = 8;
pub const RF_SUST_MIGHT  = 16;
pub const RF_SUST_ENDU   = 32;
pub const RF_SUST_DEX    = 64;
pub const RF_RES_DARK    = 128;
pub const RF_RES_LIGHT   = 256;
pub const RF_RES_BLIND   = 512;
pub const RF_RES_POISON  = 1024;

pub struct RaceDef {
  r_key: text, r_name: text,
  // The EIGHT (CATALOG.md §0), in `stat_name`'s order — the field name IS the stat key, so
  // `r_<k>` and `sim_stat(s, "<k>")` cannot drift apart. NAMED fields, not a vector, on purpose:
  // a ninth axis must make all 10 race bundles fail to COMPILE. A positional vector would
  // zero-pad them silently, which is the exact flattening plan #16 `M0` warned about.
  r_might: integer not null, r_endu: integer not null, r_dex: integer not null,
  r_perc: integer not null,  r_speed: integer not null, r_will: integer not null,
  r_char: integer not null,  r_hand: integer not null,
  r_hd: integer not null,    // hit-die modifier
  r_xp: integer not null,    // % experience factor
  r_melee: integer not null, r_bow: integer not null, r_device: integer not null,
  r_disarm: integer not null, r_stealth: integer not null, r_save: integer not null,
  r_infra: integer not null, // infravision (tens of feet)
  r_flags: integer not null,
  r_desc: text,
}

fn race_none() -> RaceDef {
  RaceDef { r_key: "", r_name: "", r_might: 0, r_endu: 0, r_dex: 0, r_perc: 0,
    r_speed: 0, r_will: 0, r_char: 0, r_hand: 0,
    r_hd: 0, r_xp: 100, r_melee: 0, r_bow: 0, r_device: 0,
    r_disarm: 0, r_stealth: 0, r_save: 0, r_infra: 0, r_flags: 0, r_desc: "" }
}

// The base race table is now EMPTY: the 10 playable races moved to one-per-bundle kind:"race"
// bundles (bundles/<race>/), merged via race_catalog() (catalog.loft). races.loft keeps only the
// engine MECHANISM -- the RaceDef record, the RF_* ability vocabulary, and the helpers below.
pub fn race_table() -> vector<RaceDef> {
  t: vector<RaceDef> = [];
  t
}

pub fn race_find(table: vector<RaceDef>, key: text) -> RaceDef {
  for ri in 0..len(table) {
    r = table[ri] ?? race_none();
    if r.r_key == key { return r; }
  }
  race_none()
}

pub fn race_has_flag(r: RaceDef, flag: integer) -> boolean {
  (r.r_flags & flag) != 0
}
