// worldtypes — engine VOCABULARY for world bundles: the record types a bundle authors instances of.
// A `RoomStencil` is a room template (a shape + a legend referencing monster keys); a `Placement` says
// where a bundle injects its content onto a linked place. Pure types, no behavior — the engine's
// stamp/placer (in sim.loft, where the &Sim mutation is C4-safe) executes them. Dependency-free so
// the bundle modules AND the engine consumer can both use it without an import cycle.

// NAMED `RoomStencil`, NOT `Stencil` (ADOPTION.md P2). `hex_field::Stencil` is the geometry
// stamp — cells, heights, labels, edges — and it is in crawler's dependency graph, so a bare
// `Stencil` here shadowed it and a reader meaning the field one silently got a room recipe.
// STENCILS.md's scheduled design makes crawler's real stencil a small FIELD, i.e. that very
// type; this placeholder was squatting on the name its successor needs.
pub struct RoomStencil {
  pub sk:      text,                  // stencil key (a placement rule references it)
  pub shape:   text,                  // "round" — a hex disc of floor; later: "grid" with explicit cells
  pub radius:  integer not null,      // round-shape radius in hexes
  pub boss:    text,                  // legend: monster seated at the centre ("" = none)
  pub guard:   text,                  // legend: monster ringing the centre ("" = none)
  pub guards:  integer not null,      // how many guards to place around the boss
  pub pool:    integer,               // radius of a MAGICAL POOL around the centre (null/0 = none):
                                  //   shallow, walkable water (tile 9) a phial can be filled from
}

pub struct Placement {
  pub setpiece_stencil: text,             // which stencil to stamp...
  pub setpiece_depth:   integer not null, // ...at which depth (on the linked place)
  pub boss_drop:        text,             // item key the set-piece boss drops on death ("" = none)
  pub quest_item:       text,             // a keepsake handed to the player ("" = none)...
  pub quest_depth:      integer not null, // ...on first entering this depth
  pub infest_trigger:   text,             // "boss_slain" = release the brood once the set-piece boss dies
  pub infest_a:         text,             // first infestation monster key
  pub infest_b:         text,             // second infestation monster key (alternated with the first)
  pub infest_d1:        integer not null, // how many to spawn at depth 1 (crawling)
  pub infest_d2:        integer not null, // how many at depth 2 (some)
}
