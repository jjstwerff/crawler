// observe — the K2 observer (plan #6): a read-only live view of a running
// story host. Connects to ws://host:18099, receives the intent log (genesis +
// history), replays it onto a fresh replica Sim, then applies the live
// broadcasts — the replica stays scene_key-identical to the host's world
// (replaytest pins the invariant), and the FULL renderer draws it: same view,
// same FOV, same light cone the player sees.
//
//   make play          # the host (terminal 1)
//   loft --interpret <libs> src/observe.loft   # the spectator (terminal 2)
//
// Esc / window close leaves. The window title shows the replica's tick count.
use graphics;
use sim::*;
use view::*;
use wallgeo::*;
use engine_host;
use gameflow::*;
use framekey::*;
use hex_grid;

OBS_PORT = 18099;     // = story's STORY_PORT
TICK_US  = 16666;
FIXED_DT = (TICK_US as float) / 1000000.0;

struct ObsWorld {
  win:     graphics::Window,           // the window and what it owns ride the one link
  painter: graphics::Painter,          //   the closures capture (story.loft's GameWorld shape)
  wprog:   graphics::Shader,           // R7 instanced terrain shader
  wallprog: graphics::Shader,
  postprog: graphics::Shader,
  post:    PostTarget,
  s:       Sim not null,
  live:    boolean not null,           // genesis received — the replica exists
  walls:   vector<WallSeg> not null,
  hud:     Hud not null,
  ml:      vector<graphics::Texture> not null,
  last_total: integer not null,
  wvao:    graphics::GpuMesh,          // base-hexagon mesh (built once; R7 instanced floor)
  wivbo:   graphics::InstanceBuffer?,  // per-level floor instance buffer (null until genesis)
  wallvao: graphics::GpuMesh?,         // the level's wall strokes (null until genesis)
  walln:   integer not null,
  sq:      integer not null,
  sr:      integer not null,
  last_key: integer not null,
  tsteps:  integer not null,           // movement intents applied
  frames_drawn: integer not null,
}

// (Re)build everything visual from the replica — genesis and every level change.
fn obs_rebuild(w: ObsWorld) {
  w.walls = build_walls(w.s);
  w.hud = build_hud(w.win, w.s);
  // R7 instanced floor: the base hexagon is built once (in main); the first level
  // binds a per-hex instance buffer to it and each later one re-uploads that buffer
  // in place (plan #7 P6).
  ivbo = w.wivbo;
  if ivbo == null {
    w.wivbo = build_world_ivbo(w.win, w.wvao, w.s);
  } else {
    update_world_ivbo(ivbo, w.s);
  }
  w.wallvao = build_walls_vbo(w.win, w.s, w.walls);   // releases the previous level's mesh
  w.walln = len(w.walls) * 6;
  (w.sq, w.sr) = sim_player_hex(w.s);
}

// One wire line from the host: genesis / movement tick / action.
fn obs_event(w: ObsWorld, ev: engine_host::Event) {
  if ev.kind != 1 { return; }
  tag = ev.payload.byte_at(0);
  (a, b, c) = wire3(ev.payload);
  if tag == 83 {                         // 'S' — genesis: build the replica
    w.s = flow_genesis(a, b);
    obs_rebuild(w);
    w.live = true;
  } else if tag == 84 && w.live {        // 'T' — one movement tick
    (s2, nsq, nsr, chg) = flow_move(w.s, a, b, FIXED_DT, w.sq, w.sr);
    w.s = s2;
    w.sq = nsq;
    w.sr = nsr;
    w.tsteps += 1;
    if chg == 1 { obs_rebuild(w); }
  } else if tag == 65 && w.live {        // 'A' — an action
    _r = flow_action(w.s, a, b, c);
  }
}

// One kernel tick = one frame: render-only — the replica advances ONLY on wire
// lines, never on local time (the host's clock is the one clock).
fn obs_tick(w: ObsWorld) {
  if !w.win.poll() || w.win.key_down(27) {
    engine_host::client_stop();
    return;
  }
  if !w.live { return; }
  wallvao = w.wallvao;
  if wallvao == null { return; }   // live implies obs_rebuild ran; this only narrows the type
  key = scene_key(w.s, 0, 0, 0, 0, 0, 0);
  if key != w.last_key {
    w.last_key = key;
    w.frames_drawn += 1;
    sim_compute_fov(w.s);
    tot = sim_msg_total(w.s);
    if tot != w.last_total {
      w.ml = build_msglog(w.win, w.s, w.hud.font);   // the old lines' textures go with the old vector
      w.last_total = tot;
    }
    view_draw(w.win, w.painter, w.s, w.hud, w.wprog, w.wvao, w.wallprog, wallvao, w.walln,
              w.postprog, w.post);
    draw_msglog(w.painter, w.s, w.hud, w.ml);
    w.win.swap();
  }
}

fn main() {
  win = graphics::open_window(800, 600, "story — observer");
  if win == null {
    println("observe: failed to create window");
    return;
  }
  painter = win.painter() ?? return;
  win.disable(graphics::GL_DEPTH_TEST);
  win.enable(graphics::GL_BLEND);
  win.blend(graphics::BLEND_SRC_ALPHA, graphics::BLEND_ONE_MINUS_SRC_ALPHA);
  wprog = make_world_shader_inst(win) ?? return;   // R7 instanced terrain shader
  wallprog = make_wall_shader(win) ?? return;
  postprog = make_post_shader(win) ?? return;
  post = make_post_target(win);
  wvao = build_hex_vao(win);   // the base hexagon: level-independent, built once

  // a placeholder replica until genesis arrives (kept tiny; replaced on 'S')
  s0 = sim_new_gen(1, 1);   // placeholder only — genesis replaces it
  hud0 = build_hud(win, s0);
  w = ObsWorld {
    win: win, painter: painter, wprog: wprog, wallprog: wallprog, postprog: postprog, post: post,
    s: s0, live: false, walls: [], hud: hud0, ml: [], last_total: 0,
    wvao: wvao, wivbo: null, wallvao: null, walln: 0, sq: 0, sr: 0,
    last_key: 0, tsteps: 0, frames_drawn: 0,
  };
  println("observe: connecting to ws://127.0.0.1:{OBS_PORT} ...");
  engine_host::run_client("127.0.0.1", OBS_PORT, TICK_US, fn(ev: engine_host::Event) {
    obs_event(w, ev);
  }, fn() {
    obs_tick(w);
  });
  println("observe: drew {w.frames_drawn} frames over {w.tsteps} T-steps; key={w.last_key}");
  w.win.close();
}
