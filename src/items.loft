  t += [ItemDef { i_key: "halberd", i_name: "Halberd", i_glyph: "|", i_cr: 190, i_cg: 180, i_cb: 150, i_cat: IT_WEAPON, i_slot: SLOT_WEAPON, i_depth: 12, i_rarity: 2, i_weight: 190, i_cost: 430, i_dd: 3, i_ds: 4, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "A fearsome bladed polearm." }];
