  // ── bows (i_power = launch multiplier) ──
  t += [ItemDef { i_key: "sling", i_name: "Sling", i_glyph: "}}", i_cr: 160, i_cg: 120, i_cb: 80, i_cat: IT_BOW, i_slot: SLOT_BOW, i_depth: 1, i_rarity: 1, i_weight: 30, i_cost: 5, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 2, i_flags: IF_NONE, i_desc: "Hurls shots; humble but cheap." }];
