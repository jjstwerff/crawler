  t += [ItemDef { i_key: "ring_strength", i_name: "Ring of Strength", i_glyph: "=", i_cr: 220, i_cg: 120, i_cb: 90, i_cat: IT_RING, i_slot: SLOT_RING, i_depth: 10, i_rarity: 3, i_weight: 2, i_cost: 1000, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 1, i_flags: IF_NONE, i_desc: "Increases strength." }];
  t += [ItemDef { i_key: "amulet_slow_digestion", i_name: "Amulet of Slow Digestion", i_glyph: "\"", i_cr: 180, i_cg: 180, i_cb: 220, i_cat: IT_AMULET, i_slot: SLOT_AMULET, i_depth: 3, i_rarity: 2, i_weight: 3, i_cost: 200, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "Slows hunger." }];
  t += [ItemDef { i_key: "amulet_resist_fire", i_name: "Amulet of Resist Fire", i_glyph: "\"", i_cr: 230, i_cg: 120, i_cb: 70, i_cat: IT_AMULET, i_slot: SLOT_AMULET, i_depth: 5, i_rarity: 2, i_weight: 3, i_cost: 300, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "Resists fire." }];
  // ── food / books ──
  t += [ItemDef { i_key: "ration_of_food", i_name: "Ration of Food", i_glyph: ",", i_cr: 180, i_cg: 150, i_cb: 100, i_cat: IT_FOOD, i_slot: SLOT_NONE, i_depth: 1, i_rarity: 1, i_weight: 100, i_cost: 3, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 5000, i_flags: IF_STACKABLE, i_desc: "A filling meal." }];
  t += [ItemDef { i_key: "book_arcane_primer", i_name: "Arcane Primer", i_glyph: "+", i_cr: 120, i_cg: 120, i_cb: 220, i_cat: IT_BOOK, i_slot: SLOT_NONE, i_depth: 1, i_rarity: 1, i_weight: 30, i_cost: 25, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "First book of arcane magic." }];
  t += [ItemDef { i_key: "book_holy_litany", i_name: "Holy Litany", i_glyph: "+", i_cr: 220, i_cg: 220, i_cb: 140, i_cat: IT_BOOK, i_slot: SLOT_NONE, i_depth: 1, i_rarity: 1, i_weight: 30, i_cost: 25, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "First book of divine prayers." }];
  t += [ItemDef { i_key: "book_nature_lore", i_name: "Nature Lore", i_glyph: "+", i_cr: 120, i_cg: 200, i_cb: 120, i_cat: IT_BOOK, i_slot: SLOT_NONE, i_depth: 1, i_rarity: 1, i_weight: 30, i_cost: 25, i_dd: 0, i_ds: 0, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "First book of nature magic." }];
  t
}

pub fn item_find(table: vector<ItemDef>, key: text) -> ItemDef {
  for ii in 0..len(table) {
    it = table[ii] ?? item_none();
    if it.i_key == key { return it; }
  }
  item_none()
}

pub fn items_by_cat(table: vector<ItemDef>, cat: integer) -> vector<ItemDef> {
  out: vector<ItemDef> = [];
  for ii in 0..len(table) {
    it = table[ii] ?? item_none();
    if it.i_cat == cat { out += [it]; }
  }
  out
}

pub fn item_stackable(i: ItemDef) -> boolean {
  (i.i_flags & IF_STACKABLE) != 0
}

// Selection weight ∝ 1/rarity.
fn item_weight(rarity: integer) -> integer {
  rr = rarity;
  if rr < 1 { rr = 1; }
  64 / rr ?? 1
}

// Rarity-weighted pick among items eligible at depth `eff` (i_depth in [1,eff]).
// Returns a table index, or -1 if none. Reads the struct table only via the
// proven-safe filter shape; the weighting runs over plain int vectors.
pub fn item_choose_idx(table: vector<ItemDef>, eff: integer, salt: integer) -> integer {
  pidx: vector<integer> = [];
  prar: vector<integer> = [];
  for ii in 0..len(table) {
    m = table[ii] ?? item_none();
    if m.i_depth >= 1 && m.i_depth <= eff {
      pidx += [ii];
      prar += [item_weight(m.i_rarity)];
    }
  }
  np = len(pidx);
  res = -1;
  if np > 0 {
    total = 0;
    for wi in 0..np { total += prar[wi] ?? 0; }
    if total > 0 {
      s = (((salt & 2147483647) | 1) * 1103515245 + 12345) & 2147483647;
      roll = s % total ?? 0;
      acc = 0;
      hit = false;
      for wj in 0..np {
        if !hit {
          acc += prar[wj] ?? 0;
          if roll < acc {
            res = pidx[wj] ?? -1;
            hit = true;
          }
        }
      }
    }
  }
  res
}

// Category (IT_*) of item `idx`, or 0 if out of range.
pub fn item_cat(table: vector<ItemDef>, idx: integer) -> integer {
  c = 0;
  if idx >= 0 && idx < len(table) { m = table[idx]; c = m.i_cat; }
  c
}
