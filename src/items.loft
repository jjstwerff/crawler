// items.loft — clean-room base-item database (renderer-agnostic data).
//
// Base item "kinds" across all categories (generic fantasy names, no IP).
// Fields the sim/inventory read: cat/slot/weight/cost/depth/rarity, weapon
// dice (i_dd×i_ds), armour i_ac, and a generic i_power (heal amount, wand
// damage proxy, light radius, food nutrition, bow multiplier, ring bonus…).
// The view reads glyph/colour. Magic "ego" items / artifacts come later.

pub const IT_WEAPON = 1;
pub const IT_BOW    = 2;
pub const IT_AMMO   = 3;
pub const IT_ARMOR  = 4;
pub const IT_LIGHT  = 5;
pub const IT_POTION = 6;
pub const IT_SCROLL = 7;
pub const IT_WAND   = 8;
pub const IT_STAFF  = 9;
pub const IT_RING   = 10;
pub const IT_AMULET = 11;
pub const IT_FOOD   = 12;
pub const IT_BOOK   = 13;

pub const SLOT_NONE   = 0;
pub const SLOT_WEAPON = 1;
pub const SLOT_BOW    = 2;
pub const SLOT_BODY   = 3;
pub const SLOT_SHIELD = 4;
pub const SLOT_HEAD   = 5;
pub const SLOT_HANDS  = 6;
pub const SLOT_FEET   = 7;
pub const SLOT_CLOAK  = 8;
pub const SLOT_LIGHT  = 9;
pub const SLOT_RING   = 10;
pub const SLOT_AMULET = 11;

pub const IF_NONE      = 0;
pub const IF_STACKABLE = 1;

pub struct ItemDef {
  i_key: text, i_name: text, i_glyph: text,
  i_cr: integer not null, i_cg: integer not null, i_cb: integer not null,
  i_cat: integer not null, i_slot: integer not null,
  i_depth: integer not null, i_rarity: integer not null,
  i_weight: integer not null,   // tenths of a pound
  i_cost: integer not null,     // base gold value
  i_dd: integer not null, i_ds: integer not null,   // damage dice (weapons/ammo)
  i_ac: integer not null,       // base armour class
  i_power: integer not null,    // generic magnitude (see header)
  i_flags: integer not null,
  i_desc: text,
}

fn item_none() -> ItemDef {
  ItemDef { i_key: "", i_name: "", i_glyph: "", i_cr: 0, i_cg: 0, i_cb: 0,
    i_cat: 0, i_slot: 0, i_depth: 0, i_rarity: 0, i_weight: 0, i_cost: 0,
    i_dd: 0, i_ds: 0, i_ac: 0, i_power: 0, i_flags: 0, i_desc: "" }
}

pub fn item_table() -> vector<ItemDef> {
  t: vector<ItemDef> = [];
  // ── melee weapons ──
  t += [ItemDef { i_key: "dagger", i_name: "Dagger", i_glyph: "|", i_cr: 200, i_cg: 200, i_cb: 210, i_cat: IT_WEAPON, i_slot: SLOT_WEAPON, i_depth: 1, i_rarity: 1, i_weight: 12, i_cost: 10, i_dd: 1, i_ds: 4, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "A light, fast blade." }];
  t += [ItemDef { i_key: "short_sword", i_name: "Short Sword", i_glyph: "|", i_cr: 200, i_cg: 200, i_cb: 210, i_cat: IT_WEAPON, i_slot: SLOT_WEAPON, i_depth: 2, i_rarity: 1, i_weight: 75, i_cost: 90, i_dd: 1, i_ds: 7, i_ac: 0, i_power: 0, i_flags: IF_NONE, i_desc: "A reliable one-handed sword." }];
