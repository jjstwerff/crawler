// GENERATED by tools/gen_bundles.py -- DO NOT EDIT BY HAND.
// Spell defs + the effect-id -> routine dispatch, aggregated from the "spells" section of
// the owning class/race bundles. The engine never names a spell; bundles ship def AND
// routine (the routine-by-id seam -- SCRIPTING.md). See BUNDLE.md.
use sim;
use player;
use spells;
use mage_spells;

pub fn bundle_spells() -> vector<SpellDef> {
  t: vector<SpellDef> = [];
  s_mage_spells = mage_spells::mage_spells_defs();
  for i in 0..len(s_mage_spells) { if i < len(s_mage_spells) { t += [s_mage_spells[i]]; } }
  t
}

pub fn spell_effect(s: &Sim, p: Player, effect: text, power: integer) -> boolean {
  if effect == "magic_dart" { return mage_spells::fx_magic_dart(s, p, power); }
  if effect == "blink" { return mage_spells::fx_blink(s, p, power); }
  if effect == "sense_creatures" { return mage_spells::fx_sense_creatures(s, p, power); }
  false
}
