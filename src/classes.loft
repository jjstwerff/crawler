// classes.loft — clean-room character-class database (renderer-agnostic data).
//
// Generic fantasy class names (no IP). Stat modifiers use the six core stats
// STR/INT/WIS/DEX/CON/CHR. Skill aptitudes are forward-looking placeholders
// (the skill *system* is still TBD); the sim will read hit-die/xp/realm, the
// character sheet reads the rest. c_hd = HP per level bonus; c_xp = % of
// normal experience needed (100 = normal, higher = slower).

pub struct ClassDef {
  c_key: text, c_name: text,
  c_hd: integer not null,    // hit-die bonus
  c_xp: integer not null,    // % experience factor
  c_str: integer not null, c_int: integer not null, c_wis: integer not null,
  c_dex: integer not null, c_con: integer not null, c_chr: integer not null,
  c_melee: integer not null, c_bow: integer not null, c_device: integer not null,
  c_disarm: integer not null, c_stealth: integer not null, c_save: integer not null,
  c_realm: text,             // "none" / "arcane" / "divine" / "nature"
  c_spell_stat: text,        // "none" / "int" / "wis"
  c_desc: text,
}

fn class_none() -> ClassDef {
  ClassDef { c_key: "", c_name: "", c_hd: 0, c_xp: 100,
    c_str: 0, c_int: 0, c_wis: 0, c_dex: 0, c_con: 0, c_chr: 0,
    c_melee: 0, c_bow: 0, c_device: 0, c_disarm: 0, c_stealth: 0, c_save: 0,
    c_realm: "none", c_spell_stat: "none", c_desc: "" }
}

// The engine class table is now EMPTY: all 8 classes live in one-class-per-bundle
// kind:"character" bundles (bundles/<class>/), merged via class_catalog() (catalog.loft).
// classes.loft keeps only the MECHANISM — the ClassDef record + class_none/class_find.
pub fn class_table() -> vector<ClassDef> {
  t: vector<ClassDef> = [];
  t
}

pub fn class_find(table: vector<ClassDef>, key: text) -> ClassDef {
  for ci in 0..len(table) {
    c = table[ci] ?? class_none();
    if c.c_key == key { return c; }
  }
  class_none()
}
