// viewer — @PLN2 S5: the chunked-LOD terrain viewer (native GL).
//
// S5e (this step): the DUAL split view with ONE SHARED camera — both panes show the same
// DETAIL-tier view (gl_viewport split), so WASD/QE drives BOTH together; the panes differ only in
// DATA (the A/B): LEFT = plain model, RIGHT = the S6 talus (VIEWER_TALUS=1) or identical to left.
// (A single camera requires both panes at the same scale; the original A=real-from-seed / B=model
// split reuses this exact machinery once @PLN1's real-height seed is ported into loft.)
// VIEWER_SMOKE=1 renders one dual frame -> /tmp/viewer_s5e.png (the `make viewer-gold` gate).
// Design: plans/2-chunked-lod-world/s5-viewer-design.md
use chunk;
use chunkgen;
use chunkmesh;
use talus;
use overland;
use graphics;
use math;

const KEY_W = 119;
const KEY_S = 115;
const KEY_A = 97;
const KEY_D = 100;
const KEY_Q = 113;
const KEY_E = 101;
const KEY_ESC = 27;

const MAXLOAD = 64;
const DETAIL_RAD = 1;          // detail tier: 3x3 chunks around the focal
const OVERWORLD_RAD = 0;       // overworld tier: one 32x32-hex chunk covers this 9x7 world

const VERT = `
#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aCol;
uniform mat4 uMVP;
out vec3 vCol;
void main() {{
    vCol = aCol;
    gl_Position = uMVP * vec4(aPos, 1.0);
}}
`;

const FRAG = `
#version 330 core
in vec3 vCol;
out vec4 FragColor;
void main() {{
    FragColor = vec4(vCol, 1.0);
}}
`;

struct ViewerCam {
  focal_x: float not null,
  focal_y: float not null,
  focal_z: float not null,
  zoom:    float not null,
}

fn build_indices() -> vector<integer> {
  idx: vector<integer> = [];
  for j in 0..32 {
    for i in 0..32 {
      v = j * 33 + i;
      idx += [v, v + 1, v + 33];
      idx += [v + 1, v + 34, v + 33];
    }
  }
  idx
}

// bake ONE chunk of the given tier -> a VAO (vbuf built + uploaded INSIDE the fn — loft#392).
// use_talus (detail tier only): apply the S6.2 angle-of-repose talus (bare faces + scree).
fn bake_chunk(o: Overland, cx: integer, cz: integer, idx: vector<integer>, overworld: boolean,
              use_talus: boolean) -> integer {
  mraw: vector<float> = [];
  if overworld {
    ca = overworld_chunk(o, cx, cz);
    ce = overworld_chunk(o, cx + 1, cz);
    cs = overworld_chunk(o, cx, cz + 1);
    cse = overworld_chunk(o, cx + 1, cz + 1);
    mraw = chunk_mesh_ov(ca, ce, cs, cse);
  } else {
    if use_talus {
      ca = talus_chunk(o, cx, cz);
      ce = talus_chunk(o, cx + 1, cz);
      cs = talus_chunk(o, cx, cz + 1);
      cse = talus_chunk(o, cx + 1, cz + 1);
      mraw = chunk_mesh(ca, ce, cs, cse);
    } else {
      ca = detail_chunk(o, cx, cz);
      ce = detail_chunk(o, cx + 1, cz);
      cs = detail_chunk(o, cx, cz + 1);
      cse = detail_chunk(o, cx + 1, cz + 1);
      mraw = chunk_mesh(ca, ce, cs, cse);
    }
  }
  vbuf: vector<single> = [];
  for q in 0..len(mraw) { vbuf += [(mraw[q] ?? 0.0) as single]; }
  vao = graphics::gl_upload_vertices(vbuf, 6);
  _e = graphics::gl_upload_indices(vao, idx);
  vao
}

// stream a loaded set to the window centred on chunk (fcx,fcz) of the tier; returns bakes count.
fn window_update(o: Overland, lcx: &vector<integer>, lcz: &vector<integer>, lvao: &vector<integer>,
                 fcx: integer, fcz: integer, rad: integer, overworld: boolean,
                 use_talus: boolean, idx: vector<integer>) -> integer {
  for k in 0..MAXLOAD {
    vv = lvao[k] ?? 0;
    if vv != 0 {
      ox = lcx[k] ?? 0;
      oz = lcz[k] ?? 0;
      if ox < fcx - rad || ox > fcx + rad || oz < fcz - rad || oz > fcz + rad {
        graphics::gl_delete_vao(vv);
        lvao[k] = 0;
      }
    }
  }
  bakes = 0;
  dz = 0 - rad;
  while dz <= rad {
    dx = 0 - rad;
    while dx <= rad {
      cx = fcx + dx;
      cz = fcz + dz;
      present = false;
      for k in 0..MAXLOAD {
        if (lvao[k] ?? 0) != 0 && (lcx[k] ?? -9) == cx && (lcz[k] ?? -9) == cz { present = true; }
      }
      if !present {
        slot = -1;
        for k in 0..MAXLOAD {
          if (lvao[k] ?? 1) == 0 && slot < 0 { slot = k; }
        }
        if slot >= 0 && slot < lvao.len() {
          lvao[slot] = bake_chunk(o, cx, cz, idx, overworld, use_talus);
          if slot < lcx.len() { lcx[slot] = cx; }
          if slot < lcz.len() { lcz[slot] = cz; }
          bakes += 1;
        }
      }
      dx += 1;
    }
    dz += 1;
  }
  bakes
}

fn build_mvp(cam: ViewerCam, aspect: float) -> math::Mat4 {
  d = cam.zoom;
  eye = math::vec3(cam.focal_x + d * 0.38, cam.focal_y + d * 0.90, cam.focal_z + d * 0.38);
  target = math::vec3(cam.focal_x, cam.focal_y, cam.focal_z);
  up = math::vec3(0.0, 1.0, 0.0);
  far = d * 4.0 + 8000.0;
  proj = math::mat4_perspective(0.8, aspect, 0.5, far);
  view = math::mat4_look_at(eye, target, up);
  math::mat4_mul(proj, view)
}

// draw one pane's loaded set under its camera. Caller has already set the viewport + cleared.
fn draw_pane(cam: ViewerCam, shader: integer, lvao: vector<integer>, nidx: integer, aspect: float) {
  mvp = build_mvp(cam, aspect);
  graphics::gl_use_shader(shader);
  graphics::gl_set_uniform_mat4(shader, "uMVP", mvp.m);
  for k in 0..MAXLOAD {
    vv = lvao[k] ?? 0;
    if vv != 0 { graphics::gl_draw_elements(vv, nidx, graphics::DRAW_TRIANGLES); }
  }
}

fn main() {
  println("=== crawler S5e viewer (dual split, SHARED camera: model | talus; VIEWER_SMOKE=1 -> golden) ===");
  o = overland_new();
  idx = build_indices();
  nidx = len(idx);

  w = 800;
  h = 600;
  if !graphics::gl_create_window(w, h, "crawler S5e viewer") {
    println("FAIL: gl_create_window");
    return;
  }
  graphics::gl_enable(graphics::GL_DEPTH_TEST);
  shader = graphics::gl_create_shader(VERT, FRAG);
  hw = w / 2 ?? 400;
  pane_aspect = (hw as float) / (h as float) ?? 0.667;

  // ONE shared camera on the DETAIL tier, framed to the flank chunk (143,83). BOTH panes use it,
  // so WASD/QE drives both together — the panes differ only in DATA (the A/B), not the view.
  ca0 = detail_chunk(o, 143, 83);
  minh = 99999.0;
  maxh = -99999.0;
  for ci in 0..1024 {
    hh = chunk_height(ca0, ci);
    if hh < minh { minh = hh; }
    if hh > maxh { maxh = hh; }
  }
  span = maxh - minh;
  cfx = (((143 * 32 + 16) as float) + 0.5) * DETAIL_CELL_M;
  cfz = (((83 * 32 + 16) as float) + 0.5) * DETAIL_CELL_M;
  cam = ViewerCam { focal_x: cfx, focal_y: minh + span * 0.35, focal_z: cfz,
                    zoom: DETAIL_CHUNK_M * 3.0 + 40.0 };

  use_talus = env_variable("VIEWER_TALUS") == "1";

  // two detail sets at the SAME camera: LEFT = plain model, RIGHT = talus (S6 geomorphology) when
  // VIEWER_TALUS=1, else identical to left (the A/B placeholder until real-from-seed lands).
  ld_cx: vector<integer> = [];
  ld_cz: vector<integer> = [];
  ld_vao: vector<integer> = [];
  lt_cx: vector<integer> = [];
  lt_cz: vector<integer> = [];
  lt_vao: vector<integer> = [];
  for _k in 0..MAXLOAD {
    ld_cx += [0];
    ld_cz += [0];
    ld_vao += [0];
    lt_cx += [0];
    lt_cz += [0];
    lt_vao += [0];
  }

  (dfx, dfz) = detail_chunk_of(cam.focal_x, cam.focal_z);
  _bl = window_update(o, ld_cx, ld_cz, ld_vao, dfx, dfz, DETAIL_RAD, false, false, idx);
  if use_talus {
    _br = window_update(o, lt_cx, lt_cz, lt_vao, dfx, dfz, DETAIL_RAD, false, true, idx);
  }
  println("S5e: detail chunk ({dfx},{dfz}); shared camera; right-pane talus={use_talus}");

  smoke = env_variable("VIEWER_SMOKE");
  if smoke == "1" {
    graphics::gl_viewport(0, 0, w, h);
    graphics::gl_clear(0x223344);
    graphics::gl_viewport(0, 0, hw, h);
    draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
    graphics::gl_viewport(hw, 0, hw, h);
    if use_talus {
      draw_pane(cam, shader, lt_vao, nidx, pane_aspect);
    } else {
      draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
    }
    _s = graphics::gl_screenshot(w, h, "/tmp/viewer_s5e.png");
    graphics::gl_swap_buffers();
    println("S5e smoke: dual frame -> /tmp/viewer_s5e.png (left model | right talus/model, shared camera)");
    return;
  }

  println("S5e: WASD pan / Q-E zoom (drives BOTH panes); right = talus when VIEWER_TALUS=1; Esc quit");
  prev_fx = dfx;
  prev_fz = dfz;
  while graphics::gl_poll_events() {
    if graphics::gl_key_pressed(KEY_ESC) { break; }
    step = cam.zoom * 0.012;
    if graphics::gl_key_pressed(KEY_W) { cam.focal_z = cam.focal_z - step; }
    if graphics::gl_key_pressed(KEY_S) { cam.focal_z = cam.focal_z + step; }
    if graphics::gl_key_pressed(KEY_A) { cam.focal_x = cam.focal_x - step; }
    if graphics::gl_key_pressed(KEY_D) { cam.focal_x = cam.focal_x + step; }
    if graphics::gl_key_pressed(KEY_Q) { cam.zoom = cam.zoom * 1.03; }
    if graphics::gl_key_pressed(KEY_E) { cam.zoom = cam.zoom * 0.97; }
    if cam.zoom < 40.0 { cam.zoom = 40.0; }
    if cam.zoom > 2000.0 { cam.zoom = 2000.0; }
    (nfx, nfz) = detail_chunk_of(cam.focal_x, cam.focal_z);
    if nfx != prev_fx || nfz != prev_fz {
      _bu = window_update(o, ld_cx, ld_cz, ld_vao, nfx, nfz, DETAIL_RAD, false, false, idx);
      if use_talus {
        _bt = window_update(o, lt_cx, lt_cz, lt_vao, nfx, nfz, DETAIL_RAD, false, true, idx);
      }
      prev_fx = nfx;
      prev_fz = nfz;
    }
    graphics::gl_viewport(0, 0, w, h);
    graphics::gl_clear(0x223344);
    graphics::gl_viewport(0, 0, hw, h);
    draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
    graphics::gl_viewport(hw, 0, hw, h);
    if use_talus {
      draw_pane(cam, shader, lt_vao, nidx, pane_aspect);
    } else {
      draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
    }
    graphics::gl_swap_buffers();
  }
  println("S5e: quit");
}
