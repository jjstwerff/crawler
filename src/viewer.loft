// viewer — @PLN2 S5: the chunked-LOD terrain viewer (native GL).
//
// S5e (this step): the DUAL split view with ONE SHARED camera — both panes show the same
// DETAIL-tier view (gl_viewport split), so WASD/QE drives BOTH together; the panes differ only in
// DATA (the A/B): LEFT = plain model, RIGHT = the S6 talus (VIEWER_TALUS=1) or identical to left.
// (A single camera requires both panes at the same scale; the original A=real-from-seed / B=model
// split reuses this exact machinery once @PLN1's real-height seed is ported into loft.)
// VIEWER_SMOKE=1 renders one dual frame -> /tmp/viewer_s5e.png (the `make viewer-gold` gate).
// Design: plans/2-chunked-lod-world/s5-viewer-design.md
use chunk;
use chunkgen;
use chunkmesh;
use talus;
use overland;
use ortlerdata;
use ortlergen;
use graphics;
use math;

const KEY_W = 119;
const KEY_S = 115;
const KEY_A = 97;
const KEY_D = 100;
const KEY_Q = 113;
const KEY_E = 101;
const KEY_ESC = 27;
const KEY_SPACE = 32;     // graphics KEY_SPACE
const KEY_SHIFT = 132;    // graphics KEY_SHIFT

const MAXLOAD = 64;
const DETAIL_RAD = 1;          // detail tier: 3x3 chunks around the focal
const OVERWORLD_RAD = 0;       // overworld tier: one 32x32-hex chunk covers this 9x7 world
const STREAM_PER_FRAME = 1;    // V3: max chunk bakes per interactive frame (keeps the loop live)

// mouse-flight tuning (the Ortler airplane camera). Speeds are world units/second (dt-scaled, so
// the feel is frame-rate independent); angles in radians. Tune here.
const FLY_CRUISE  = 6000.0;    // min airspeed — the plane always flies forward at least this fast
const FLY_MAXSPD  = 60000.0;   // throttle ceiling
const FLY_THR     = 22000.0;   // W/S throttle accel (units/s per second held)
const FLY_WHEEL   = 3500.0;    // airspeed change per scroll-wheel notch
const FLY_MAXBANK = 1.0;       // full mouse deflection -> this bank angle (~57 deg)
const FLY_MAXPITCH = 0.5;      // full vertical deflection -> this pitch (~29 deg)
const FLY_COORD   = 0.75;      // coordinated-turn gain: yaw rate (rad/s) at full bank
const FLY_RUDDER  = 0.5;       // A/D rudder yaw rate (rad/s)
const FLY_EASE    = 6.0;       // attitude smoothing rate (per second) toward the stick target
const FLY_DEAD    = 0.08;      // mouse dead-zone (fraction of half-window) for hands-off level flight
const FLY_CLEAR   = 3000.0;    // soft terrain floor: min clearance above the ground (exag units)

const VERT = `
#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aCol;
uniform mat4 uMVP;
out vec3 vCol;
void main() {{
    vCol = aCol;
    gl_Position = uMVP * vec4(aPos, 1.0);
}}
`;

const FRAG = `
#version 330 core
in vec3 vCol;
out vec4 FragColor;
void main() {{
    FragColor = vec4(vCol, 1.0);
}}
`;

struct ViewerCam {
  focal_x: float not null,
  focal_y: float not null,
  focal_z: float not null,
  zoom:    float not null,
}

// free-fly ("airplane") camera: position (ex,ey,ez) + heading yaw + pitch + roll (bank) + speed
// (forward airspeed, world units/second). yaw 0 looks toward -z; pitch nose up(+)/down(-); roll
// banks the horizon. The mouse-flight loop drives roll/pitch (stick), banking auto-yaws (the
// coordinated turn), and the plane always moves forward at `speed`. Distinct from ViewerCam.
struct FlyCam {
  ex:    float not null,
  ey:    float not null,
  ez:    float not null,
  yaw:   float not null,
  pitch: float not null,
  roll:  float not null,
  speed: float not null,
}

fn build_indices() -> vector<integer> {
  idx: vector<integer> = [];
  for j in 0..32 {
    for i in 0..32 {
      v = j * 33 + i;
      idx += [v, v + 1, v + 33];
      idx += [v + 1, v + 34, v + 33];
    }
  }
  idx
}

// bake ONE chunk of the given tier -> a VAO (vbuf built + uploaded INSIDE the fn — loft#392).
// use_talus (detail tier only): apply the S6.2 angle-of-repose talus (bare faces + scree).
fn bake_chunk(o: Overland, cx: integer, cz: integer, idx: vector<integer>, overworld: boolean,
              use_talus: boolean) -> integer {
  mraw: vector<float> = [];
  if overworld {
    ca = overworld_chunk(o, cx, cz);
    ce = overworld_chunk(o, cx + 1, cz);
    cs = overworld_chunk(o, cx, cz + 1);
    cse = overworld_chunk(o, cx + 1, cz + 1);
    mraw = chunk_mesh_ov(ca, ce, cs, cse);
  } else {
    if use_talus {
      ca = talus_chunk(o, cx, cz);
      ce = talus_chunk(o, cx + 1, cz);
      cs = talus_chunk(o, cx, cz + 1);
      cse = talus_chunk(o, cx + 1, cz + 1);
      mraw = chunk_mesh(ca, ce, cs, cse);
    } else {
      ca = detail_chunk(o, cx, cz);
      ce = detail_chunk(o, cx + 1, cz);
      cs = detail_chunk(o, cx, cz + 1);
      cse = detail_chunk(o, cx + 1, cz + 1);
      mraw = chunk_mesh(ca, ce, cs, cse);
    }
  }
  vbuf: vector<single> = [];
  for q in 0..len(mraw) { vbuf += [(mraw[q] ?? 0.0) as single]; }
  vao = graphics::gl_upload_vertices(vbuf, 6);
  _e = graphics::gl_upload_indices(vao, idx);
  vao
}

// bake ONE Ortler chunk -> a VAO via the efficient overworld-tier mesh (chunk_mesh_ov). Mirrors
// bake_chunk's overworld branch but sources DetailChunks from the real 80x80 data (ortler_chunk)
// instead of ov_sample. real selects A (OSM landcover) vs B (model bands). vbuf built inline
// (loft#392). The baked arrays (hd/od/rd) are passed in so they are not rebuilt per chunk.
fn bake_ortler(hd: vector<integer>, od: vector<integer>, rd: vector<integer>,
               cx: integer, cz: integer, real: boolean, exag: float, idx: vector<integer>) -> integer {
  ca = ortler_chunk(hd, od, rd, cx, cz, real);
  ce = ortler_chunk(hd, od, rd, cx + 1, cz, real);
  cs = ortler_chunk(hd, od, rd, cx, cz + 1, real);
  cse = ortler_chunk(hd, od, rd, cx + 1, cz + 1, real);
  mraw = chunk_mesh_ov(ca, ce, cs, cse);
  // vertical exaggeration: ~3.7 km of real relief over ~120 km reads flat from above, so scale
  // the vertex height (stride 6, component 1) — done HERE, not in the shared mesh routine, and
  // after the true-scale base+0.1 m encoding so nothing clips the 6553 m offset cap.
  vbuf: vector<single> = [];
  q = 0;
  while q < len(mraw) {
    v = mraw[q] ?? 0.0;
    if q % 6 == 1 { v = v * exag; }
    vbuf += [v as single];
    q += 1;
  }
  vao = graphics::gl_upload_vertices(vbuf, 6);
  _e = graphics::gl_upload_indices(vao, idx);
  vao
}

// stream a loaded set to the window centred on chunk (fcx,fcz) of the tier; returns bakes count.
fn window_update(o: Overland, lcx: &vector<integer>, lcz: &vector<integer>, lvao: &vector<integer>,
                 fcx: integer, fcz: integer, rad: integer, overworld: boolean,
                 use_talus: boolean, idx: vector<integer>) -> integer {
  for k in 0..MAXLOAD {
    vv = lvao[k] ?? 0;
    if vv != 0 {
      ox = lcx[k] ?? 0;
      oz = lcz[k] ?? 0;
      if ox < fcx - rad || ox > fcx + rad || oz < fcz - rad || oz > fcz + rad {
        graphics::gl_delete_vao(vv);
        lvao[k] = 0;
      }
    }
  }
  bakes = 0;
  dz = 0 - rad;
  while dz <= rad {
    dx = 0 - rad;
    while dx <= rad {
      cx = fcx + dx;
      cz = fcz + dz;
      present = false;
      for k in 0..MAXLOAD {
        if (lvao[k] ?? 0) != 0 && (lcx[k] ?? -9) == cx && (lcz[k] ?? -9) == cz { present = true; }
      }
      if !present {
        slot = -1;
        for k in 0..MAXLOAD {
          if (lvao[k] ?? 1) == 0 && slot < 0 { slot = k; }
        }
        if slot >= 0 && slot < lvao.len() {
          lvao[slot] = bake_chunk(o, cx, cz, idx, overworld, use_talus);
          if slot < lcx.len() { lcx[slot] = cx; }
          if slot < lcz.len() { lcz[slot] = cz; }
          bakes += 1;
        }
      }
      dx += 1;
    }
    dz += 1;
  }
  bakes
}

// V3 streaming: window_update's two halves split so the interactive loop runs them INCREMENTALLY —
// evict cheaply every frame, bake at most a few chunks/frame — instead of one blocking full-window
// bake. window_update itself stays for the SMOKE path (one-shot full bake before the screenshot).

// evict every loaded slot that left the [fcx±rad, fcz±rad] window (frees its VAO). Cheap (no bakes).
fn window_evict(lcx: const vector<integer>, lcz: const vector<integer>, lvao: &vector<integer>,
                fcx: integer, fcz: integer, rad: integer) {
  for k in 0..MAXLOAD {
    vv = lvao[k] ?? 0;
    if vv != 0 {
      ox = lcx[k] ?? 0;
      oz = lcz[k] ?? 0;
      if ox < fcx - rad || ox > fcx + rad || oz < fcz - rad || oz > fcz + rad {
        graphics::gl_delete_vao(vv);
        lvao[k] = 0;
      }
    }
  }
}

// bake the FIRST not-yet-loaded chunk in the window into a free slot; return true if it baked one
// (so the caller bakes a bounded count per frame), false when the window is already fully loaded.
fn window_bake_one(o: Overland, lcx: &vector<integer>, lcz: &vector<integer>, lvao: &vector<integer>,
                   fcx: integer, fcz: integer, rad: integer, overworld: boolean, use_talus: boolean,
                   idx: vector<integer>) -> boolean {
  dz = 0 - rad;
  while dz <= rad {
    dx = 0 - rad;
    while dx <= rad {
      cx = fcx + dx;
      cz = fcz + dz;
      present = false;
      for k in 0..MAXLOAD {
        if (lvao[k] ?? 0) != 0 && (lcx[k] ?? -9) == cx && (lcz[k] ?? -9) == cz { present = true; }
      }
      if !present {
        slot = -1;
        for k in 0..MAXLOAD {
          if (lvao[k] ?? 1) == 0 && slot < 0 { slot = k; }
        }
        if slot >= 0 && slot < lvao.len() {
          lvao[slot] = bake_chunk(o, cx, cz, idx, overworld, use_talus);
          if slot < lcx.len() { lcx[slot] = cx; }
          if slot < lcz.len() { lcz[slot] = cz; }
          return true;
        }
      }
      dx += 1;
    }
    dz += 1;
  }
  false
}

fn build_mvp(cam: ViewerCam, aspect: float) -> math::Mat4 {
  d = cam.zoom;
  eye = math::vec3(cam.focal_x + d * 0.38, cam.focal_y + d * 0.90, cam.focal_z + d * 0.38);
  target = math::vec3(cam.focal_x, cam.focal_y, cam.focal_z);
  up = math::vec3(0.0, 1.0, 0.0);
  far = d * 4.0 + 8000.0;
  proj = math::mat4_perspective(0.8, aspect, 0.5, far);
  view = math::mat4_look_at(eye, target, up);
  math::mat4_mul(proj, view)
}

// the forward unit vector from a FlyCam's yaw/pitch (yaw 0 -> -z; pitch + = nose up).
fn fly_forward(fc: FlyCam) -> (float, float, float) {
  cp = cos(fc.pitch);
  (cp * sin(fc.yaw), sin(fc.pitch), 0.0 - cp * cos(fc.yaw))
}

// rescale a normalized axis (-1..1) outside a dead-zone -> still -1..1, with 0 inside the zone.
// Lets the mouse rest near screen-centre = wings-level without twitch.
fn deadzone(v: float, dz: float) -> float {
  if v > dz { return (v - dz) / (1.0 - dz); }
  if v < 0.0 - dz { return (v + dz) / (1.0 - dz); }
  0.0
}

// MVP for the free-fly camera. The up vector is BANKED by roll (rotated about the forward axis),
// so the horizon tilts in a turn — the core "flying" cue. Far plane large (the Ortler world is
// ~120 km across with exaggerated relief).
fn build_mvp_fly(fc: FlyCam, aspect: float) -> math::Mat4 {
  (fx, fy, fz) = fly_forward(fc);
  // right = normalize(forward x worldUp);  worldUp = (0,1,0) -> (-fz, 0, fx)
  rxl = sqrt(fz * fz + fx * fx);
  if rxl < 0.0001 { rxl = 0.0001; }
  rx = (0.0 - fz) / rxl;
  rz = fx / rxl;
  // level up = right x forward  (orthonormal, no bank)
  ux = 0.0 * fz - rz * fy;
  uy = rz * fx - rx * fz;
  uz = rx * fy - 0.0 * fx;
  // bank: rotate the level-up toward `right` by roll -> up' = up*cos(roll) + right*sin(roll)
  cr = cos(fc.roll);
  sr = sin(fc.roll);
  upx = ux * cr + rx * sr;
  upy = uy * cr;
  upz = uz * cr + rz * sr;
  eye = math::vec3(fc.ex, fc.ey, fc.ez);
  target = math::vec3(fc.ex + fx, fc.ey + fy, fc.ez + fz);
  up = math::vec3(upx, upy, upz);
  proj = math::mat4_perspective(0.8, aspect, 0.5, 600000.0);
  view = math::mat4_look_at(eye, target, up);
  math::mat4_mul(proj, view)
}

// draw a loaded set under a pre-built MVP (shared-camera dual panes compute the MVP once).
fn draw_pane_mvp(mvp: math::Mat4, shader: integer, lvao: vector<integer>, nidx: integer) {
  graphics::gl_use_shader(shader);
  graphics::gl_set_uniform_mat4(shader, "uMVP", mvp.m);
  for k in 0..MAXLOAD {
    vv = lvao[k] ?? 0;
    if vv != 0 { graphics::gl_draw_elements(vv, nidx, graphics::DRAW_TRIANGLES); }
  }
}

// draw one pane's loaded set under its camera. Caller has already set the viewport + cleared.
fn draw_pane(cam: ViewerCam, shader: integer, lvao: vector<integer>, nidx: integer, aspect: float) {
  mvp = build_mvp(cam, aspect);
  graphics::gl_use_shader(shader);
  graphics::gl_set_uniform_mat4(shader, "uMVP", mvp.m);
  for k in 0..MAXLOAD {
    vv = lvao[k] ?? 0;
    if vv != 0 { graphics::gl_draw_elements(vv, nidx, graphics::DRAW_TRIANGLES); }
  }
}

fn main() {
  println("=== crawler S5e viewer (dual split, SHARED camera: model | talus; VIEWER_SMOKE=1 -> golden) ===");
  o = overland_new();
  idx = build_indices();
  nidx = len(idx);

  w = 800;
  h = 600;
  if !graphics::gl_create_window(w, h, "crawler S5e viewer") {
    println("FAIL: gl_create_window");
    return;
  }
  graphics::gl_enable(graphics::GL_DEPTH_TEST);
  // V1: paint one frame + pump events immediately so the window appears and the WM keeps it
  // responsive (decorated) instead of a long black/frozen startup while terrain bakes.
  graphics::gl_viewport(0, 0, w, h);
  graphics::gl_clear(0x223344);
  graphics::gl_swap_buffers();
  _pe0 = graphics::gl_poll_events();
  shader = graphics::gl_create_shader(VERT, FRAG);
  hw = w / 2 ?? 400;
  pane_aspect = (hw as float) / (h as float) ?? 0.667;
  full_aspect = (w as float) / (h as float) ?? 1.333;

  // ONE shared camera on the DETAIL tier, framed to the flank chunk (143,83). BOTH panes use it,
  // so WASD/QE drives both together — the panes differ only in DATA (the A/B), not the view.
  ca0 = detail_chunk(o, 143, 83);
  minh = 99999.0;
  maxh = -99999.0;
  for ci in 0..1024 {
    hh = chunk_height(ca0, ci);
    if hh < minh { minh = hh; }
    if hh > maxh { maxh = hh; }
  }
  span = maxh - minh;
  cfx = (((143 * 32 + 16) as float) + 0.5) * DETAIL_CELL_M;
  cfz = (((83 * 32 + 16) as float) + 0.5) * DETAIL_CELL_M;
  cam = ViewerCam { focal_x: cfx, focal_y: minh + span * 0.35, focal_z: cfz,
                    zoom: DETAIL_CHUNK_M * 3.0 + 40.0 };

  // OVERWORLD camera — frames the WHOLE 9x7 example world (the full landscape, the interactive
  // default). The world spans overworld hexes 0..8 x 0..6; one 32x32-hex overworld chunk (0,0)
  // covers it (+ a sea margin). Centre on the landmass; height span from that chunk's land cells.
  (wx0, wz0) = overworld_center(0, 0);
  (wx1, wz1) = overworld_center(8, 6);
  owcx = (wx0 + wx1) * 0.5;
  owcz = (wz0 + wz1) * 0.5;
  oc0 = overworld_chunk(o, 0, 0);
  ominh = 99999.0;
  omaxh = -99999.0;
  for ohz in 0..7 {
    for ohx in 0..9 {
      oh = chunk_height(oc0, dk_cell_idx(ohx, ohz));
      if oh < ominh { ominh = oh; }
      if oh > omaxh { omaxh = oh; }
    }
  }
  // zoom 18000 frames the full ~12.7 km world with margin (no peak clipping) at build_mvp's fixed
  // 3/4 bird's-eye angle; focal_y a quarter up the relief sits the land mid-frame. Headless-tuned
  // via VIEWER_OVSHOT (gl_screenshot is reliable; CLAUDE.md / PLAN-RENDER P0).
  ovcam = ViewerCam { focal_x: owcx, focal_y: ominh + (omaxh - ominh) * 0.25, focal_z: owcz,
                      zoom: 18000.0 };

  use_talus = env_variable("VIEWER_TALUS") == "1";

  // two detail sets at the SAME camera: LEFT = plain model, RIGHT = talus (S6 geomorphology) when
  // VIEWER_TALUS=1, else identical to left (the A/B placeholder until real-from-seed lands).
  ld_cx: vector<integer> = [];
  ld_cz: vector<integer> = [];
  ld_vao: vector<integer> = [];
  lt_cx: vector<integer> = [];
  lt_cz: vector<integer> = [];
  lt_vao: vector<integer> = [];
  for _k in 0..MAXLOAD {
    ld_cx += [0];
    ld_cz += [0];
    ld_vao += [0];
    lt_cx += [0];
    lt_cz += [0];
    lt_vao += [0];
  }

  (dfx, dfz) = detail_chunk_of(cam.focal_x, cam.focal_z);

  smoke = env_variable("VIEWER_SMOKE");
  if smoke == "1" {
    // SMOKE: bake the FULL window up front (the golden needs the complete frame), render once, exit.
    _bl = window_update(o, ld_cx, ld_cz, ld_vao, dfx, dfz, DETAIL_RAD, false, false, idx);
    if use_talus {
      _br = window_update(o, lt_cx, lt_cz, lt_vao, dfx, dfz, DETAIL_RAD, false, true, idx);
    }
    println("S5e smoke: detail chunk ({dfx},{dfz}); right-pane talus={use_talus}");
    graphics::gl_viewport(0, 0, w, h);
    graphics::gl_clear(0x223344);
    graphics::gl_viewport(0, 0, hw, h);
    draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
    graphics::gl_viewport(hw, 0, hw, h);
    if use_talus {
      draw_pane(cam, shader, lt_vao, nidx, pane_aspect);
    } else {
      draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
    }
    _s = graphics::gl_screenshot(w, h, "/tmp/viewer_s5e.png");
    graphics::gl_swap_buffers();
    println("S5e smoke: dual frame -> /tmp/viewer_s5e.png (left model | right talus/model, shared camera)");
    return;
  }

  // ── ORTLER source (the DEFAULT view): the real 80x80 Ortler grid (@PLN1) as the dual screen ──
  // LEFT = real OSM landcover (A, ground truth); RIGHT = our model's elevation bands (B) over the
  // SAME real heights — the @PLN1 adequacy comparison. Built through the EFFICIENT overworld mesh
  // routine (bake_ortler -> chunk_mesh_ov); framed to the VISUAL AREA (the summit-centred massif).
  // This is what `make viewer` shows by default; the procedural views are opt-in (VIEWER_OVERWORLD=1
  // full landscape, VIEWER_DETAIL=1 detail slice). VIEWER_ORTSHOT=1 = the headless dual shot.
  ort_default = env_variable("VIEWER_OVSHOT") != "1" && env_variable("VIEWER_DETAIL") != "1"
             && env_variable("VIEWER_OVERWORLD") != "1";
  if env_variable("VIEWER_ORTSHOT") == "1" || env_variable("VIEWER_ORTLER") == "1" || ort_default {
    hd = ort_h();
    od = ort_osm();
    rd = ort_river();
    hmin = 99999.0;
    hmax = -99999.0;
    for gi in 0..(ORT_COLS * ORT_ROWS) {
      hv = (hd[gi] ?? 0) as float;
      if hv < hmin { hmin = hv; }
      if hv > hmax { hmax = hv; }
    }
    (sx, sz) = overworld_center(ORT_HC, ORT_HR);   // the visual area: centre on the summit cell
    // exag 6 makes the real ~3.7 km relief read as mountains. The fly camera STARTS in level
    // cruise: south of and above the massif, heading north (yaw 0 -> -z) into it, nosed slightly
    // down, already moving at cruise — so you are flying the moment the window opens.
    orexag = 6.0;
    peak = hmax * orexag;
    flycam = FlyCam { ex: sx, ey: peak * 0.78 + 4000.0, ez: sz + 42000.0,
                      yaw: 0.0, pitch: 0.0 - 0.20, roll: 0.0, speed: FLY_CRUISE };

    // pre-bake the data chunks (0..2 x 0..2 covers the 80x80) once, for BOTH panes (A + B). Baked
    // data -> each bake is cheap; the loop is then pure draw (efficient, never re-bakes).
    tb0 = ticks();
    nbk = 0;
    for ccz in 0..3 {
      for ccx in 0..3 {
        if nbk < MAXLOAD {
          ld_vao[nbk] = bake_ortler(hd, od, rd, ccx, ccz, true, orexag, idx);
          lt_vao[nbk] = bake_ortler(hd, od, rd, ccx, ccz, false, orexag, idx);
          nbk += 1;
        }
      }
    }
    println("Ortler: {nbk} chunks x2 panes baked in {ticks() - tb0} us; h {hmin}..{hmax} m, summit ({sx},{sz})");

    if env_variable("VIEWER_ORTSHOT") == "1" {
      mvp = build_mvp_fly(flycam, pane_aspect);
      graphics::gl_viewport(0, 0, w, h);
      graphics::gl_clear(0x223344);
      graphics::gl_viewport(0, 0, hw, h);
      draw_pane_mvp(mvp, shader, ld_vao, nidx);
      graphics::gl_viewport(hw, 0, hw, h);
      draw_pane_mvp(mvp, shader, lt_vao, nidx);
      _s = graphics::gl_screenshot(w, h, "/tmp/viewer_ortler.png");
      graphics::gl_swap_buffers();
      println("ortler shot: real OSM | model bands -> /tmp/viewer_ortler.png");
      return;
    }

    if env_variable("VIEWER_FLYKEYS") == "1" {
      // KEYBOARD-ONLY fallback (no mouse): A/D yaw, W/S pitch, Q/E move fwd/back along the heading.
      println("Ortler 80x80: real OSM | model bands. KEYBOARD fly — A/D yaw, W/S pitch, Q/E fwd/back; Esc quit");
      while graphics::gl_poll_events() {
        if graphics::gl_key_pressed(KEY_ESC) { break; }
        cw = graphics::gl_window_width();
        ch = graphics::gl_window_height();
        if cw > 0 { w = cw; }
        if ch > 0 { h = ch; }
        hw = w / 2 ?? 400;
        pane_aspect = (hw as float) / (h as float) ?? 0.667;
        if graphics::gl_key_pressed(KEY_A) { flycam.yaw = flycam.yaw - 0.02; }
        if graphics::gl_key_pressed(KEY_D) { flycam.yaw = flycam.yaw + 0.02; }
        if graphics::gl_key_pressed(KEY_W) { flycam.pitch = flycam.pitch - 0.02; }
        if graphics::gl_key_pressed(KEY_S) { flycam.pitch = flycam.pitch + 0.02; }
        if flycam.pitch < 0.0 - 1.45 { flycam.pitch = 0.0 - 1.45; }
        if flycam.pitch > 1.45 { flycam.pitch = 1.45; }
        mstep = 600.0;
        (fwx, fwy, fwz) = fly_forward(flycam);
        if graphics::gl_key_pressed(KEY_Q) {
          flycam.ex = flycam.ex + fwx * mstep;
          flycam.ey = flycam.ey + fwy * mstep;
          flycam.ez = flycam.ez + fwz * mstep;
        }
        if graphics::gl_key_pressed(KEY_E) {
          flycam.ex = flycam.ex - fwx * mstep;
          flycam.ey = flycam.ey - fwy * mstep;
          flycam.ez = flycam.ez - fwz * mstep;
        }
        mvp = build_mvp_fly(flycam, pane_aspect);
        graphics::gl_viewport(0, 0, w, h);
        graphics::gl_clear(0x223344);
        graphics::gl_viewport(0, 0, hw, h);
        draw_pane_mvp(mvp, shader, ld_vao, nidx);
        graphics::gl_viewport(hw, 0, hw, h);
        draw_pane_mvp(mvp, shader, lt_vao, nidx);
        graphics::gl_swap_buffers();
      }
      println("S5e: quit");
      return;
    }

    // MOUSE FLIGHT (default): the cursor is a virtual flight stick — its offset from the window
    // centre (dead-zoned) banks (X) and pitches (Y); banking auto-yaws (the coordinated turn) and
    // the horizon tilts. The plane always flies forward; scroll wheel / W,S throttle, A,D rudder.
    // Near-centre cursor = wings-level. A soft terrain floor keeps you above the peaks. dt-scaled
    // (ticks) so the feel is frame-rate independent.
    println("Ortler 80x80: real OSM | model bands. MOUSE FLIGHT — move mouse to bank/pitch (centre=level),");
    println("  scroll or W/S = throttle, A/D = rudder, Shift = boost, Space = brake; Esc quit");
    prevt = ticks();
    while graphics::gl_poll_events() {
      if graphics::gl_key_pressed(KEY_ESC) { break; }
      // frame time (seconds), clamped so a long bake / stall doesn't lurch the camera
      nowt = ticks();
      dt = ((nowt - prevt) as float) / 1000000.0;
      prevt = nowt;
      if dt > 0.1 { dt = 0.1; }
      if dt < 0.0 { dt = 0.0; }
      // viewport follows the live window size (handles resize / fullscreen)
      cw = graphics::gl_window_width();
      ch = graphics::gl_window_height();
      if cw > 0 { w = cw; }
      if ch > 0 { h = ch; }
      hw = w / 2 ?? 400;
      pane_aspect = (hw as float) / (h as float) ?? 0.667;
      // mouse as a virtual stick: cursor offset from window centre, normalized to -1..1, dead-zoned
      cxp = (w as float) * 0.5;
      cyp = (h as float) * 0.5;
      dxn = deadzone((graphics::gl_mouse_x() - cxp) / cxp, FLY_DEAD);
      dyn = deadzone((graphics::gl_mouse_y() - cyp) / cyp, FLY_DEAD);
      if dxn > 1.0 { dxn = 1.0; }
      if dxn < 0.0 - 1.0 { dxn = 0.0 - 1.0; }
      if dyn > 1.0 { dyn = 1.0; }
      if dyn < 0.0 - 1.0 { dyn = 0.0 - 1.0; }
      bank_t = dxn * FLY_MAXBANK;            // stick right -> bank right
      pitch_t = (0.0 - dyn) * FLY_MAXPITCH;  // mouse up (smaller y) -> nose up
      // ease attitude toward the stick target (inertia / self-levelling when centred)
      e = FLY_EASE * dt;
      if e > 1.0 { e = 1.0; }
      flycam.roll = flycam.roll + (bank_t - flycam.roll) * e;
      flycam.pitch = flycam.pitch + (pitch_t - flycam.pitch) * e;
      // coordinated turn: bank yaws the heading; A/D add rudder trim
      flycam.yaw = flycam.yaw + FLY_COORD * sin(flycam.roll) * dt;
      if graphics::gl_key_pressed(KEY_A) { flycam.yaw = flycam.yaw - FLY_RUDDER * dt; }
      if graphics::gl_key_pressed(KEY_D) { flycam.yaw = flycam.yaw + FLY_RUDDER * dt; }
      // throttle: scroll wheel (per notch) + W/S (held); Shift boost, Space brake
      flycam.speed = flycam.speed + (graphics::gl_mouse_wheel() as float) * FLY_WHEEL;
      if graphics::gl_key_pressed(KEY_W) { flycam.speed = flycam.speed + FLY_THR * dt; }
      if graphics::gl_key_pressed(KEY_S) { flycam.speed = flycam.speed - FLY_THR * dt; }
      if graphics::gl_key_pressed(KEY_SHIFT) { flycam.speed = flycam.speed + FLY_THR * dt; }
      if graphics::gl_key_pressed(KEY_SPACE) { flycam.speed = flycam.speed - FLY_THR * 2.0 * dt; }
      if flycam.speed < FLY_CRUISE { flycam.speed = FLY_CRUISE; }
      if flycam.speed > FLY_MAXSPD { flycam.speed = FLY_MAXSPD; }
      // fly forward
      (fwx, fwy, fwz) = fly_forward(flycam);
      flycam.ex = flycam.ex + fwx * flycam.speed * dt;
      flycam.ey = flycam.ey + fwy * flycam.speed * dt;
      flycam.ez = flycam.ez + fwz * flycam.speed * dt;
      // soft terrain floor: stay FLY_CLEAR above the ground under the eye (exaggerated heights)
      (eq, er) = overworld_hex_of(flycam.ex, flycam.ez);
      if eq >= 0 && eq < ORT_COLS && er >= 0 && er < ORT_ROWS {
        gh = ((hd[er * ORT_COLS + eq] ?? 0) as float) * orexag;
        if flycam.ey < gh + FLY_CLEAR { flycam.ey = gh + FLY_CLEAR; }
      }
      mvp = build_mvp_fly(flycam, pane_aspect);
      graphics::gl_viewport(0, 0, w, h);
      graphics::gl_clear(0x223344);
      graphics::gl_viewport(0, 0, hw, h);
      draw_pane_mvp(mvp, shader, ld_vao, nidx);
      graphics::gl_viewport(hw, 0, hw, h);
      draw_pane_mvp(mvp, shader, lt_vao, nidx);
      graphics::gl_swap_buffers();
    }
    println("S5e: quit");
    return;
  }

  (ofx, ofz) = overworld_chunk_of(ovcam.focal_x, ovcam.focal_z);

  // OVSHOT: headless full-landscape frame (the overworld-view gate, mirrors smoke). Bake the one
  // overworld chunk, render the single full-window pane, screenshot, exit. Xvfb + gl_screenshot
  // is reliable (CLAUDE.md / PLAN-RENDER P0), so the full-landscape framing is self-verifiable.
  ovshot = env_variable("VIEWER_OVSHOT");
  if ovshot == "1" {
    _bo = window_update(o, ld_cx, ld_cz, ld_vao, ofx, ofz, OVERWORLD_RAD, true, false, idx);
    println("overworld shot: chunk ({ofx},{ofz}); world height {ominh}..{omaxh} m");
    graphics::gl_viewport(0, 0, w, h);
    graphics::gl_clear(0x223344);
    draw_pane(ovcam, shader, ld_vao, nidx, full_aspect);
    _s = graphics::gl_screenshot(w, h, "/tmp/viewer_overworld.png");
    graphics::gl_swap_buffers();
    println("overworld shot: full-landscape frame -> /tmp/viewer_overworld.png");
    return;
  }

  // INTERACTIVE detail slice (VIEWER_DETAIL=1): the close-up DUAL split (model | talus). V3
  // incremental streaming — NO blocking pre-bake; each frame evicts chunks that left the window,
  // bakes at most STREAM_PER_FRAME new ones, draws whatever's loaded. The loop polls + draws +
  // swaps EVERY frame so it never freezes (s5-viewer-smooth.md V1/V3). A ~140 m slice at ~1.5 m
  // cells — high detail, small area; for the whole map use the default full-landscape view below.
  detail_view = env_variable("VIEWER_DETAIL") == "1";
  if detail_view {
    println("S5e detail: WASD pan / Q-E zoom (drives BOTH panes); right = talus when VIEWER_TALUS=1; Esc quit");
    while graphics::gl_poll_events() {
      if graphics::gl_key_pressed(KEY_ESC) { break; }
      step = cam.zoom * 0.012;
      if graphics::gl_key_pressed(KEY_W) { cam.focal_z = cam.focal_z - step; }
      if graphics::gl_key_pressed(KEY_S) { cam.focal_z = cam.focal_z + step; }
      if graphics::gl_key_pressed(KEY_A) { cam.focal_x = cam.focal_x - step; }
      if graphics::gl_key_pressed(KEY_D) { cam.focal_x = cam.focal_x + step; }
      if graphics::gl_key_pressed(KEY_Q) { cam.zoom = cam.zoom * 1.03; }
      if graphics::gl_key_pressed(KEY_E) { cam.zoom = cam.zoom * 0.97; }
      if cam.zoom < 40.0 { cam.zoom = 40.0; }
      if cam.zoom > 2000.0 { cam.zoom = 2000.0; }
      (nfx, nfz) = detail_chunk_of(cam.focal_x, cam.focal_z);
      window_evict(ld_cx, ld_cz, ld_vao, nfx, nfz, DETAIL_RAD);
      nb = 0;
      while nb < STREAM_PER_FRAME && window_bake_one(o, ld_cx, ld_cz, ld_vao, nfx, nfz, DETAIL_RAD, false, false, idx) {
        nb += 1;
      }
      if use_talus {
        window_evict(lt_cx, lt_cz, lt_vao, nfx, nfz, DETAIL_RAD);
        nt = 0;
        while nt < STREAM_PER_FRAME && window_bake_one(o, lt_cx, lt_cz, lt_vao, nfx, nfz, DETAIL_RAD, false, true, idx) {
          nt += 1;
        }
      }
      graphics::gl_viewport(0, 0, w, h);
      graphics::gl_clear(0x223344);
      graphics::gl_viewport(0, 0, hw, h);
      draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
      graphics::gl_viewport(hw, 0, hw, h);
      if use_talus {
        draw_pane(cam, shader, lt_vao, nidx, pane_aspect);
      } else {
        draw_pane(cam, shader, ld_vao, nidx, pane_aspect);
      }
      graphics::gl_swap_buffers();
    }
    println("S5e: quit");
    return;
  }

  // INTERACTIVE full landscape (VIEWER_OVERWORLD=1): the procedural 9x7 example world in one coarse
  // overworld chunk, baked ONCE (single full-window pane). After that first bake the loop is pure
  // draw — instant, never freezes, WASD pan / Q-E zoom roam the whole map. (Reached only when
  // VIEWER_OVERWORLD=1; the default is the Ortler dual screen above.)
  println("S5e: full landscape (overworld tier) — WASD pan / Q-E zoom the whole map; Esc quit");
  while graphics::gl_poll_events() {
    if graphics::gl_key_pressed(KEY_ESC) { break; }
    step = ovcam.zoom * 0.012;
    if graphics::gl_key_pressed(KEY_W) { ovcam.focal_z = ovcam.focal_z - step; }
    if graphics::gl_key_pressed(KEY_S) { ovcam.focal_z = ovcam.focal_z + step; }
    if graphics::gl_key_pressed(KEY_A) { ovcam.focal_x = ovcam.focal_x - step; }
    if graphics::gl_key_pressed(KEY_D) { ovcam.focal_x = ovcam.focal_x + step; }
    if graphics::gl_key_pressed(KEY_Q) { ovcam.zoom = ovcam.zoom * 1.03; }
    if graphics::gl_key_pressed(KEY_E) { ovcam.zoom = ovcam.zoom * 0.97; }
    if ovcam.zoom < 2000.0 { ovcam.zoom = 2000.0; }
    if ovcam.zoom > 40000.0 { ovcam.zoom = 40000.0; }
    (nfx, nfz) = overworld_chunk_of(ovcam.focal_x, ovcam.focal_z);
    window_evict(ld_cx, ld_cz, ld_vao, nfx, nfz, OVERWORLD_RAD);
    _nb = window_bake_one(o, ld_cx, ld_cz, ld_vao, nfx, nfz, OVERWORLD_RAD, true, false, idx);
    graphics::gl_viewport(0, 0, w, h);
    graphics::gl_clear(0x223344);
    draw_pane(ovcam, shader, ld_vao, nidx, full_aspect);
    graphics::gl_swap_buffers();
  }
  println("S5e: quit");
}
