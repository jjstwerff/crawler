// worldmesh — the per-level terrain mesh, kernel-side (plan #7 P2; RENDER.md R4).
//
// Geometry + colors only — NO graphics import (the architecture invariant: mesh
// BUILDING is geometry; the view uploads and draws it). One real hexagon per cell
// (a 6-triangle fan from the centre, 18 verts) — the cells tile with no gaps, so
// the floor reads as one continuous surface. Stride 10 = pos.xyz ·
// visUV-in-normal · color.
//
// R4: the terrain-kind tint is PRE-COMPOSED into the vertex color here —
// tinted = floor·(1−a) + tint·a — replacing the old per-frame wash loop (an
// axis-aligned square over a hexagonal cell, re-emitted every frame for every
// hex). The tint is static per level; the only dynamic part — FOV dimming — is
// the R3 vis texture applied in the fragment shader, so movement never
// invalidates the bake. Tint rules preserved from the wash exactly: floor tiles
// only (walls keep the wall tone), kind >= 0 (the dungeon draws none), never
// K_FACE (stone faces read as wall).

use sim;
use hex_grid;
use overland;
use wallgeo;

// R5 wall strokes — capsule-SDF quads (plan #7 P3; blueprint:
// tools/blueprints/wall_sdf.py — interior pure, ~1px AA ramp, joins continuous
// with zero gap pixels; the fringe over-blend at joins is a conscious, bounded
// one-sided artifact, see the blueprint's 3b note).
WALL_HALFW = 0.09;             // stroke half-width, world units (~4.7px at SCALE 26)
WALL_AA    = 0.0384615384615;  // AA ramp = 1 screen px at SCALE 26, in world units

// One expanded quad (6 verts) per wall segment, stride 10, self-describing:
//   loc0 = (x, y, 0)                 world position
//   loc1 = (u, v, len)               capsule-local coords + segment length
//   loc2 = (visU, visV, halfw, aa)   FOV texel of the MIDPOINT hex + SDF params
// The fragment shader computes d = |(clamp(u,0,len)-u, v)| and the linear
// coverage ramp — exactly the blueprint's formula.
pub fn build_wall_mesh(s: Sim, walls: vector<WallSeg>) -> vector<single> {
  buf: vector<single> = [];
  zz = 0.0 as single;
  lwf = s.lw as float;
  lhf = s.lh as float;
  e = WALL_HALFW + WALL_AA;     // expand past the AA ramp so the quad never clips it
  for i in 0..len(walls) {
    sg = walls[i];
    if sg != null {
      dx = sg.bx - sg.ax;
      dy = sg.by - sg.ay;
      ln = sqrt(dx * dx + dy * dy) ?? 0.0;
      if ln > 0.000001 {
        ux = dx / ln ?? 0.0;
        uy = dy / ln ?? 0.0;
        nx = 0.0 - uy;
        ny = ux;
        // the FOV texel of the segment's midpoint hex (the old stipple's rule)
        (mq, mr) = px_to_hex((sg.ax + sg.bx) / 2.0, (sg.ay + sg.by) / 2.0);
        vu = ((((mq - s.qmin) as float + 0.5) / lwf) ?? 0.0) as single;
        vv = ((((mr - s.rmin) as float + 0.5) / lhf) ?? 0.0) as single;
        hw = WALL_HALFW as single;
        aa = WALL_AA as single;
        lns = ln as single;
        u0 = (0.0 - e) as single;
        u1 = (ln + e) as single;
        vneg = (0.0 - e) as single;
        vpos = e as single;
        // the four expanded corners in world space
        x00 = (sg.ax - ux * e - nx * e) as single; y00 = (sg.ay - uy * e - ny * e) as single;
        x01 = (sg.ax - ux * e + nx * e) as single; y01 = (sg.ay - uy * e + ny * e) as single;
        x10 = (sg.bx + ux * e - nx * e) as single; y10 = (sg.by + uy * e - ny * e) as single;
        x11 = (sg.bx + ux * e + nx * e) as single; y11 = (sg.by + uy * e + ny * e) as single;
        buf += [x00, y00, zz, u0, vneg, lns, vu, vv, hw, aa];
        buf += [x10, y10, zz, u1, vneg, lns, vu, vv, hw, aa];
        buf += [x11, y11, zz, u1, vpos, lns, vu, vv, hw, aa];
        buf += [x00, y00, zz, u0, vneg, lns, vu, vv, hw, aa];
        buf += [x11, y11, zz, u1, vpos, lns, vu, vv, hw, aa];
        buf += [x01, y01, zz, u0, vpos, lns, vu, vv, hw, aa];
      }
    }
  }
  buf
}

// The terrain-kind wash colors (the contract wilderness; light-floor doctrine).
fn kind_tint(k: integer) -> (float, float, float, float) {
  if k == K_FOREST { return (0.13, 0.35, 0.16, 0.55); }
  if k == K_SAND { return (0.86, 0.78, 0.55, 0.50); }
  if k == K_SCREE { return (0.45, 0.42, 0.36, 0.50); }
  if k == K_MEADOW { return (0.52, 0.72, 0.35, 0.50); }
  if k == K_SNOW { return (0.93, 0.95, 0.97, 0.60); }
  if k == K_ICE { return (0.75, 0.84, 0.94, 0.60); }
  if k == K_RIVER { return (0.22, 0.45, 0.72, 0.65); }
  if k == K_LAKE { return (0.15, 0.35, 0.60, 0.70); }
  if k == K_SEA { return (0.08, 0.22, 0.42, 0.75); }
  if k == K_FIELD { return (0.76, 0.66, 0.30, 0.50); }
  if k == K_ROAD { return (0.58, 0.50, 0.38, 0.55); }
  if k == K_SWAMP { return (0.28, 0.40, 0.30, 0.62); }
  (0.52, 0.64, 0.33, 0.55)
}

// The pre-composed floor color of hex (q,r): bare-floor tone with the terrain-kind
// tint baked in (R4), or the dark wall tone for impassable hexes (walls/faces/water
// never tint). The ONE color oracle — shared by the instanced floor
// (build_world_instances) and the legacy fat mesh, so they can never diverge.
fn hex_floor_rgb(s: Sim, q: integer, r: integer) -> (float, float, float) {
  t = tile_at(s, q, r);
  cr = 0.80; cg = 0.745; cb = 0.59;
  if t == 1 {
    cr = 0.15; cg = 0.14; cb = 0.13;
  } else {
    k = sim_tile_kind(s, q, r);
    if k >= 0 && k != K_FACE {
      (tnr, tng, tnb, tna) = kind_tint(k);
      keep = 1.0 - tna;
      cr = cr * keep + tnr * tna;
      cg = cg * keep + tng * tna;
      cb = cb * keep + tnb * tna;
    }
  }
  (cr, cg, cb)
}

// Per-level terrain VBO data: one hexagon fan/hex, stride 10. Vertex count is
// deterministic: 18 · lw · lh. (Legacy fat path — superseded by the instanced
// floor below; plan #7 P6.)
pub fn build_world_mesh(s: Sim) -> vector<single> {
  buf: vector<single> = [];
  one = 1.0 as single;
  zz = 0.0 as single;
  lwf = s.lw as float;
  lhf = s.lh as float;
  for gr in 0..s.lh {
    for gq in 0..s.lw {
      q = s.qmin + gq;
      r = s.rmin + gr;
      (cr, cg, cb) = hex_floor_rgb(s, q, r);
      cs_r = cr as single; cs_g = cg as single; cs_b = cb as single;
      u = (((gq as float + 0.5) / lwf) ?? 0.0) as single;
      v = (((gr as float + 0.5) / lhf) ?? 0.0) as single;
      (wx, wy) = hex_to_px(q, r);
      cxs = wx as single; cys = wy as single;
      for kc in 0..6 {
        (kax, kay) = hex_corner_px(q, r, kc);
        (kbx, kby) = hex_corner_px(q, r, (kc + 1) % 6 ?? 0);
        buf += [cxs, cys, zz, u, v, zz, cs_r, cs_g, cs_b, one];
        buf += [kax as single, kay as single, zz, u, v, zz, cs_r, cs_g, cs_b, one];
        buf += [kbx as single, kby as single, zz, u, v, zz, cs_r, cs_g, cs_b, one];
      }
    }
  }
  buf
}

// ── R7 instanced floor (plan #7 P6; blueprint: tools/blueprints/
//    instanced_floor.py) ──
//
// The fat mesh above re-emits 18 verts PER hex. The instanced floor emits the
// hexagon ONCE (build_hex_offsets) and one small record per hex
// (build_world_instances), drawn via gl_draw_instanced. The decomposition is the
// LATTICE construction the blueprint pinned: a corner's world position is
//   x = SQRT3 · (column + dx),   y = row_y + dy
// where column = q + 0.5·(r&1) and row_y = 1.5·r are EXACT half-integers (per
// instance) and dx ∈ {0,±0.5} (lattice) / dy ∈ {0,±0.5,±1} (world) are EXACT
// per-vertex offsets. Because column+dx and row_y+dy are bit-identical for every
// hex that shares a corner, the shader's f32 result is identical there too — the
// floor is WATERTIGHT (no seam cracks). This is the achievable invariant:
// bit-exact parity with the f64-rounded fat VBO is impossible from an f32 shader,
// but watertight + sub-pixel-identical (≤1 ULP) is, and that is what the floor
// needs. The naive center+offset decomposition is NOT watertight (see blueprint).

// Lattice/world corner offset of the base hexagon, corner i (matches hex_grid
// hex_corner_offset: dy is its y; dx is its x ÷ SQRT3, hardcoded EXACT as ±0.5 so
// the shared-corner arithmetic stays bit-exact).
fn hex_lat_offset(i: integer) -> (float, float) {
  if i == 0 { return (0.0, 1.0); }
  if i == 1 { return (0.0 - 0.5, 0.5); }
  if i == 2 { return (0.0 - 0.5, 0.0 - 0.5); }
  if i == 3 { return (0.0, 0.0 - 1.0); }
  if i == 4 { return (0.5, 0.0 - 0.5); }
  (0.5, 0.5)
}

// The base hexagon for the instanced floor: the 6-triangle fan as 18 verts of
// (dx_lattice, dy_world, 0), stride 3 (loc0). Constant — built once, not per
// level. The fan center carries the (0,0) lattice/world offset (so it lands on
// the hex centre via x=SQRT3·column, y=row_y).
pub fn build_hex_offsets() -> vector<single> {
  buf: vector<single> = [];
  zz = 0.0 as single;
  for kc in 0..6 {
    (adx, ady) = hex_lat_offset(kc);
    (bdx, bdy) = hex_lat_offset((kc + 1) % 6 ?? 0);
    buf += [zz, zz, zz];                                  // fan centre
    buf += [adx as single, ady as single, zz];
    buf += [bdx as single, bdy as single, zz];
  }
  buf
}

// Per-level instance records for the instanced floor: one 7-float record per hex
// — (column = q + 0.5·(r&1), row_y = 1.5·r, visU, visV, r, g, b). Paired with
// build_hex_offsets() + gl_draw_instanced(vao, 18, lw·lh). column/row_y are the
// EXACT lattice anchors; visUV is the per-hex FOV texel (centre); the color is
// the R4-baked floor tone (hex_floor_rgb — the same oracle as the fat mesh).
// Record count = lw · lh.
pub fn build_world_instances(s: Sim) -> vector<single> {
  buf: vector<single> = [];
  lwf = s.lw as float;
  lhf = s.lh as float;
  for gr in 0..s.lh {
    for gq in 0..s.lw {
      q = s.qmin + gq;
      r = s.rmin + gr;
      par = r & 1;
      column = (q as float) + 0.5 * (par as float);
      row_y = 1.5 * (r as float);
      u = ((gq as float + 0.5) / lwf) ?? 0.0;   // lw,lh ≥ 1 — the guard only silences the warning
      v = ((gr as float + 0.5) / lhf) ?? 0.0;
      (cr, cg, cb) = hex_floor_rgb(s, q, r);
      buf += [column as single, row_y as single, u as single, v as single,
              cr as single, cg as single, cb as single];
    }
  }
  buf
}
