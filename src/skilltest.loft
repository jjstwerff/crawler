// skilltest — Tier-1 passive skills. First skill: MELEE, a flat to-damage bonus derived from
// character level + effective STR, folded into the player's damage (wdam). It is 0 at the baseline
// (level 1, starting STR) — so early combat is unchanged — and grows BOTH as you level AND as you
// spend banked stat points on STR, so the level/stat systems feed combat (the stat-choice payoff).
use sim;

fn main() {
  println("=== story skill test (passive melee: level + STR -> damage) ===");
  s = sim_new_gen(5, 1);
  base_skill = sim_skill_melee(s);       // level 1, starting STR -> 0
  base_dam = sim_player_dam(s);

  sim_award_xp(s, 200);                  // -> ~level 5 (also banks stat points)
  lvl_skill = sim_skill_melee(s);
  lvl_dam = sim_player_dam(s);

  sim_raise_stat(s, "str");              // spend a banked point on STR -> melee sharpens further
  str_skill = sim_skill_melee(s);
  str_dam = sim_player_dam(s);

  println("melee skill: base={base_skill} after-levels={lvl_skill} after-+STR={str_skill}");
  println("player dam:  base={base_dam} after-levels={lvl_dam} after-+STR={str_dam}");
  ok = base_skill == 0
    && lvl_skill > base_skill && lvl_dam > base_dam
    && str_skill > lvl_skill && str_dam > lvl_dam;
  if ok { println("=== SKILL OK ==="); } else { println("=== FAIL ==="); }
}
