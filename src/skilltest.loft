// skilltest — Tier-1 passive skills. First skill: MELEE, a flat to-damage bonus derived from
// character level + effective MIGHT, folded into the player's damage (wdam). It is 0 at the baseline
// (level 1, starting Might) — so early combat is unchanged — and grows BOTH as you level AND as you
// spend banked stat points on Might, so the level/stat systems feed combat (the stat-choice payoff).
use sim;

fn main() {
  println("=== story skill test (passive melee: level + Might -> damage) ===");
  s = sim_new_gen(5, 1);
  base_skill = sim_skill_melee(s);       // level 1, starting Might -> 0
  base_dam = sim_player_dam(s);

  sim_award_xp(s, 200);                  // -> ~level 5 (also banks stat points)
  lvl_skill = sim_skill_melee(s);
  lvl_dam = sim_player_dam(s);

  sim_raise_stat(s, "might");            // spend a banked point on Might -> melee sharpens further
  str_skill = sim_skill_melee(s);
  str_dam = sim_player_dam(s);

  // STEALTH: 0 at baseline; a monster within vision wakes at level 1, but a high-stealth (high
  // level) character can stand the same distance and it stays asleep (its wake range is shrunk).
  lo = sim_new();
  st_lo = sim_skill_stealth(lo);              // level 1 -> 0
  sim_set_awake(lo, 0, false);                // (the arena enemy starts awake; lull it)
  for _ in 0..3 { sim_tick(lo); }
  woke_lo = sim_enemy_awake(lo, 0);           // within vision + LOS -> re-wakes

  hi = sim_new();
  sim_award_xp(hi, 100000);                   // level hard -> big stealth
  st_hi = sim_skill_stealth(hi);
  sim_set_awake(hi, 0, false);
  for _ in 0..3 { sim_tick(hi); }
  woke_hi = sim_enemy_awake(hi, 0);           // wake range shrunk to ~adjacent -> stays asleep
  stealth_ok = st_lo == 0 && st_hi > 0 && woke_lo && !woke_hi;

  println("melee skill: base={base_skill} after-levels={lvl_skill} after-+Might={str_skill}");
  println("player dam:  base={base_dam} after-levels={lvl_dam} after-+Might={str_dam}");
  println("stealth:     base={st_lo} leveled={st_hi}  woke(lo/hi)={woke_lo}/{woke_hi}");
  ok = base_skill == 0
    && lvl_skill > base_skill && lvl_dam > base_dam
    && str_skill > lvl_skill && str_dam > lvl_dam
    && stealth_ok;
  if ok { println("=== SKILL OK ==="); } else { println("=== FAIL ==="); }
}
