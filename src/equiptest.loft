// equiptest — G3 equipment: wield items and have them matter (§3a #3 lateral
// progression). A weapon raises melee damage; armour adds HP and reduces incoming
// damage (never to 0); unequip reverts; re-equipping from inventory restores. Uses
// sim_new_gen (the real-game constructor, which seeds the starting kit). Deterministic.

use hexgrid;
use sim;
use items;
use player;

fn main() {
  println("=== story equip test (G3: wield + effects) ===");
  s = sim_new_gen(1234, 1);            // procedural start, with the starting loadout

  dam_eq = sim_player_dam(s);          // base + dagger
  ac_eq  = sim_player_ac(s);           // soft leather i_ac
  hp_eq  = sim_player_hp_max(s);       // hero_maxhp(1) + ac
  mit_armored = sim_mitigate(s, 20);   // < 20 (armour DR)
  wpn_on = sim_equipped(s, SLOT_WEAPON) >= 0;
  bdy_on = sim_equipped(s, SLOT_BODY) >= 0;

  // remove armour: max HP drops, DR gone
  sim_unequip(s, SLOT_BODY);
  hp_noarm = sim_player_hp_max(s);
  ac_noarm = sim_player_ac(s);
  mit_bare = sim_mitigate(s, 20);

  // remove weapon: damage drops to unarmed
  sim_unequip(s, SLOT_WEAPON);
  dam_bare = sim_player_dam(s);

  // re-equip both from inventory (unequip pushed them there); equip routes by slot
  sim_equip(s, 0);
  sim_equip(s, 0);
  dam_re = sim_player_dam(s);
  ac_re  = sim_player_ac(s);

  load_ok    = wpn_on && bdy_on && ac_eq > 0;
  armor_hp   = hp_eq > hp_noarm && ac_noarm == 0;
  armor_dr   = mit_armored < mit_bare && mit_bare == 20 && mit_armored >= 1;  // never 100%
  weapon_ok  = dam_eq > dam_bare;
  reequip_ok = dam_re > dam_bare && ac_re > 0;

  // Internal Player API (player.loft): the OO methods bundle scripts call must set values on
  // the current Sim structs (proves the cross-module &Sim mutation threads through methods).
  ps = sim_new();
  pl = player_new(0);
  inv0 = sim_inv_count(ps);
  pl.give_item(ps, "potion_cure_light");      // -> inventory
  pl.equip(ps, "everbright_torch");           // -> equipment (light slot)
  pl.grant_stat(ps, "con", 2);                // -> statistic
  pl.grant_skill(ps, "stealth", 1);           // stub today — must not crash
  pl.equip(ps, "soft_leather_armor");         // armour -> AC -> raises the saving throw
  pl.grant_gold(ps, 25);
  pl.grant_xp(ps, 5);
  pl.teleport(ps, 5, 5);
  pl.face(ps, 6, 6);
  inv1 = sim_inv_count(ps);
  // Saving throws + damage reduction (functional): equipment + CON raise the save; magic
  // (fire) is resisted by it, never to 0; physical is soaked by AC; heal clamps to max.
  sv = sim_player_save(ps);
  hp_b = sim_player_hp(ps);
  pl.damage(ps, 10, "fire");                  // reduced by the save, never to 0
  fire_taken = hp_b - sim_player_hp(ps);
  pl.heal(ps, 1000);
  save_ok = sv > 6 && fire_taken >= 1 && fire_taken < 10 && sim_player_hp(ps) == sim_player_hp_max(ps);
  // Three-layer stats (player.loft): permanent drain lowers current (restorable), and a temp
  // potion modifies it for a while then expires (last-wins override). Use a tickable world.
  ts = sim_new_gen(99, 1);
  con0 = sim_stat_max(ts, "con");
  pl.drain_stat(ts, "con", 3);    con_dr = sim_stat(ts, "con");   // permanent drain (restorable)
  pl.restore_stat(ts, "con");     con_rs = sim_stat(ts, "con");   // restored to innate
  pl.buff_stat(ts, "con", 4, 2);  con_bf = sim_stat(ts, "con");   // good potion: +4 for 2 ticks
  sim_tick(ts); sim_tick(ts); sim_tick(ts);                       // 3 ticks > 2 -> buff expired
  con_af = sim_stat(ts, "con");
  println("stats(con): innate={con0} drained={con_dr} restored={con_rs} buffed={con_bf} expired={con_af}");
  stat_ok = con_dr == con0 - 3 && con_rs == con0 && con_bf == con0 + 4 && con_af == con0;
  player_api_ok = inv1 > inv0 && sim_equipped(ps, SLOT_LIGHT) >= 0 && sim_light_radius(ps) >= 12 && save_ok && stat_ok;

  println("loadout: dam={dam_eq} ac={ac_eq} hp={hp_eq} mit20={mit_armored}");
  println("bare:    dam={dam_bare} hp={hp_noarm} ac={ac_noarm} mit20={mit_bare}");
  println("reequip: dam={dam_re} ac={ac_re}");
  println("player-api: inv {inv0}->{inv1} torch-radius={sim_light_radius(ps)}");
  println("load={load_ok} armor-hp={armor_hp} armor-dr={armor_dr} weapon={weapon_ok} reequip={reequip_ok} player-api={player_api_ok}");
  if load_ok && armor_hp && armor_dr && weapon_ok && reequip_ok && player_api_ok {
    println("=== EQUIP OK ===");
  } else {
    println("=== FAIL ===");
  }
}
