// wallgeo — derive smoothed wall outlines from solid hex regions + edge walls.
//
// Renderer-agnostic (uses hexgeo + sim, NO graphics): outputs world-space
// segments that both the 2D view and the future 3D mesh builder consume.
//
// Pipeline:
//   A. Collect boundary edges — a hex edge is a wall face when it separates an
//      open (floor) hex from a solid one, plus any explicit edge wall.
//   B. Dedupe the edge endpoints into a corner graph (shared hex vertices merge
//      by quantised position), recording each corner's degree + first two
//      neighbours.
//   C. Laplacian-smooth degree-2 corners toward their neighbours' midpoint:
//      the per-hex zig-zag "wobble" (high frequency) flattens into straight
//      runs; junctions (deg != 2) and endpoints anchor. (First-cut smoothing;
//      a 12-direction snap + corner-preserving pass is the planned refinement.)
//   D. Emit one segment per edge using the smoothed corner positions.

use hex_grid;
use sim;

SMOOTH_ITERS  = 3;
SMOOTH_LAMBDA = 0.5;   // 0..1 blend toward the neighbour midpoint each pass
SNAP_TOL2     = 0.3844; // (0.62 world units)^2 — snap a corner onto a room side-line within this
// EQUAL WALL WIDTH (the asymmetry fix, measured in tools/wallproto): horizontal side-lines
// sit ON the hex tops -> faces 1.0 from the wall row (walls read 2.0 wide); the straight
// vertical line through the STAGGERED column gives only sqrt(3) ~ 1.732. Inset vertical
// side-lines toward the room by (1 - sqrt(3)/2) so their faces are ALSO 1.0 from the wall
// column -> both directions read exactly 2.0. The odd-parity faces lie 0.732 from the inset
// line (vs 0.5 max on horizontals), so vertical lines snap with their OWN tolerance.
WIDEN_V      = 0.1339746;  // 1 - sqrt(3)/2
SNAP_TOL2_V  = 0.5625;     // (0.75)^2 — vertical lines must catch both stagger parities

pub struct WallSeg {
  ax: float not null, ay: float not null,
  bx: float not null, by: float not null,
}

struct WCorner {
  x: float not null, y: float not null,
  deg: integer not null,
  n1: integer not null,
  n2: integer not null,
  anc: integer not null,   // 1 = snapped onto a room side-line → anchored (no smoothing)
}

struct WEdge { a: integer not null, b: integer not null }

struct CornerRef { ck: text, idx: integer not null }

struct WallGraph {
  corners: vector<WCorner> not null,
  edges:   vector<WEdge> not null,
  lookup:  hash<CornerRef[ck]>,
}

fn corner_key(x: float, y: float) -> text {
  kx = round(x * 1000.0) as integer;
  ky = round(y * 1000.0) as integer;
  "{kx}_{ky}"
}

fn get_or_add(g: &WallGraph, x: float, y: float) -> integer {
  k = corner_key(x, y);
  found = g.lookup[k];
  if found != null { return found.idx; }
  idx = len(g.corners);
  g.corners += [WCorner { x: x, y: y, deg: 0, n1: -1, n2: -1, anc: 0 }];
  g.lookup += [CornerRef { ck: k, idx: idx }];
  idx
}

fn add_edge(g: &WallGraph, q: integer, r: integer, dir: integer) {
  (ca, cb) = hex_edge_corners(dir);
  (ax, ay) = hex_corner_px(q, r, ca);
  (bx, by) = hex_corner_px(q, r, cb);
  ia = get_or_add(g, ax, ay);
  ib = get_or_add(g, bx, by);
  g.edges += [WEdge { a: ia, b: ib }];
}

fn corner_at(cs: vector<WCorner>, i: integer) -> WCorner {
  if i < 0 { return WCorner { x: 0.0, y: 0.0, deg: 0, n1: -1, n2: -1, anc: 0 }; }
  if i < len(cs) { return cs[i]; }
  WCorner { x: 0.0, y: 0.0, deg: 0, n1: -1, n2: -1, anc: 0 }
}

fn edge_at(es: vector<WEdge>, i: integer) -> WEdge {
  if i < 0 { return WEdge { a: -1, b: -1 }; }
  if i < len(es) { return es[i]; }
  WEdge { a: -1, b: -1 }
}

// A room's exact rhombus side-line (world space). gen carries the room rects, so
// these are the *known* straight edges the sawtooth boundary should lie on.
struct WallLine {
  ax: float not null, ay: float not null,
  bx: float not null, by: float not null,
}

// Outermost world corner of corner-cell `ci` (0..3) of room rect (q0,r0,rw,rh) —
// the rhombus tip. Four tips in cyclic order give the room's four side-lines.
// (loft-faithful to tools/wallproto/hexdungeon.py: integer centre cell, squared
//  distance — no sqrt — and corner-cell cyclic order — no atan2.)
fn room_tip(q0: integer, r0: integer, rw: integer, rh: integer, ci: integer) -> (float, float) {
  qc = q0 + rw / 2;
  rc = r0 + rh / 2;
  (ccx, ccy) = hex_to_px(qc, rc);
  cq = q0;
  cr = r0;
  if ci == 1 { cq = q0 + rw - 1; cr = r0; }
  else if ci == 2 { cq = q0 + rw - 1; cr = r0 + rh - 1; }
  else if ci == 3 { cq = q0; cr = r0 + rh - 1; }
  bestx = 0.0;
  besty = 0.0;
  bd = 0.0 - 1.0;
  for k in 0..6 {
    (cxk, cyk) = hex_corner_px(cq, cr, k);
    dx = cxk - ccx;
    dy = cyk - ccy;
    d = dx * dx + dy * dy;
    if d > bd { bd = d; bestx = cxk; besty = cyk; }
  }
  (bestx, besty)
}

// All room side-lines for the level (4 per room). Empty when the Sim has no room
// rects (the hand-built test level) → the straightener falls back to pure smoothing.
fn build_room_sides(s: Sim) -> vector<WallLine> {
  out: vector<WallLine> = [];
  q0s = s.room_q0;
  r0s = s.room_r0;
  ws = s.room_w;
  hs = s.room_h;
  n = len(q0s);
  for ri in 0..n {
    if ri < n {
      q0 = q0s[ri] ?? 0;
      r0 = r0s[ri] ?? 0;
      rw = ws[ri] ?? 0;
      rh = hs[ri] ?? 0;
      if rw > 0 && rh > 0 {
        (t0x, t0y) = room_tip(q0, r0, rw, rh, 0);
        (t1x, t1y) = room_tip(q0, r0, rw, rh, 1);
        (t2x, t2y) = room_tip(q0, r0, rw, rh, 2);
        (t3x, t3y) = room_tip(q0, r0, rw, rh, 3);
        // equal-width inset: vertical sides move WIDEN_V toward the room (see header)
        (rcx, rcy) = hex_to_px(q0 + rw / 2, r0 + rh / 2);
        lx = t3x;                                  // the left side-line's x (tips 3 -> 0)
        if rcx > lx { lx = lx + WIDEN_V; } else { lx = lx - WIDEN_V; }
        rx = t1x;                                  // the right side-line's x (tips 1 -> 2)
        if rcx > rx { rx = rx + WIDEN_V; } else { rx = rx - WIDEN_V; }
        out += [WallLine { ax: t0x, ay: t0y, bx: t1x, by: t1y }];
        out += [WallLine { ax: rx, ay: t1y, bx: rx, by: t2y }];
        out += [WallLine { ax: t2x, ay: t2y, bx: t3x, by: t3y }];
        out += [WallLine { ax: lx, ay: t3y, bx: lx, by: t0y }];
      }
    }
  }
  out
}

pub fn build_walls(s: Sim) -> vector<WallSeg> {
  g = WallGraph { corners: [], edges: [], lookup: [] };

  // A. Collect boundary edges.
  for gr in 0..s.lh {
    for gq in 0..s.lw {
      q = s.qmin + gq;
      r = s.rmin + gr;
      if !is_wall(s, q, r) {
        for d in 0..6 {
          (nq, nr) = hex_neighbor(q, r, d);
          if is_wall(s, nq, nr) { add_edge(g, q, r, d); }
        }
      }
      for e in 0..3 {
        if edge_wall_raw(s, q, r, e) != 0 { add_edge(g, q, r, e); }
      }
    }
  }

  cs = g.corners;
  es = g.edges;

  // B. Degree + first two neighbours per corner.
  for ei in 0..len(es) {
    ed = edge_at(es, ei);
    ia = ed.a;
    ib = ed.b;
    if ia >= 0 && ib >= 0 {
      ca2 = corner_at(cs, ia);
      ca2.deg += 1;
      if ca2.deg == 1 { ca2.n1 = ib; } else if ca2.deg == 2 { ca2.n2 = ib; }
      if ia < len(cs) { cs[ia] = ca2; }
      cb2 = corner_at(cs, ib);
      cb2.deg += 1;
      if cb2.deg == 1 { cb2.n1 = ia; } else if cb2.deg == 2 { cb2.n2 = ia; }
      if ib < len(cs) { cs[ib] = cb2; }
    }
  }

  // C. Straighten — the two-stage "constructive instrument" blueprint pinned in
  //    tools/wallproto/hexdungeon.py (panel D): rooms are lattice rhombi whose 4
  //    side-lines gen knows exactly, so
  //    1) snap every boundary corner that lies on a room side-line ONTO it (rooms
  //       -> dead-straight + sharp corners), and anchor it against smoothing;
  //    2) Laplacian-smooth the remaining (corridor) corners (smooth passages).
  //    Door/corridor mouths aren't on a room line, so openings fall out for free.
  sides = build_room_sides(s);
  nsides = len(sides);
  tlo = 0.0 - 0.12;   // allow the projection a little past the segment ends
  for ci in 0..len(cs) {
    c = corner_at(cs, ci);
    bx = c.x;
    by = c.y;
    bestd2 = 9999.0;   // per-line tolerances gate below; this only ranks candidates
    hit = 0;
    for si in 0..nsides {
      if si < nsides {
        ln = sides[si];
        dx = ln.bx - ln.ax;
        dy = ln.by - ln.ay;
        l2 = dx * dx + dy * dy;
        if l2 > 0.0 {
          t = ((c.x - ln.ax) * dx + (c.y - ln.ay) * dy) / l2;
          if t >= tlo && t <= 1.12 {
            fx = ln.ax + t * dx;
            fy = ln.ay + t * dy;
            ex = c.x - fx;
            ey = c.y - fy;
            d2 = ex * ex + ey * ey;
            // vertical lines need the wider tolerance (both stagger parities must snap)
            tol = SNAP_TOL2;
            adx = dx; if adx < 0.0 { adx = 0.0 - adx; }
            ady = dy; if ady < 0.0 { ady = 0.0 - ady; }
            if adx < ady { tol = SNAP_TOL2_V; }
            if d2 < tol && d2 < bestd2 { bestd2 = d2; bx = fx; by = fy; hit = 1; }
          }
        }
      }
    }
    if hit == 1 {
      c.x = bx;
      c.y = by;
      c.anc = 1;
      if ci < len(cs) { cs[ci] = c; }
    }
  }
  for _ in 0..SMOOTH_ITERS {
    for ci in 0..len(cs) {
      c = corner_at(cs, ci);
      if c.anc == 0 && c.deg == 2 && c.n1 >= 0 && c.n2 >= 0 {
        p1 = corner_at(cs, c.n1);
        p2 = corner_at(cs, c.n2);
        mx = (p1.x + p2.x) / 2.0;
        my = (p1.y + p2.y) / 2.0;
        c.x = c.x + SMOOTH_LAMBDA * (mx - c.x);
        c.y = c.y + SMOOTH_LAMBDA * (my - c.y);
        if ci < len(cs) { cs[ci] = c; }
      }
    }
  }

  // D. Emit one segment per edge from the smoothed corners.
  segs: vector<WallSeg> = [];
  for ej in 0..len(es) {
    ee = edge_at(es, ej);
    if ee.a >= 0 && ee.b >= 0 {
      pa = corner_at(cs, ee.a);
      pb = corner_at(cs, ee.b);
      segs += [WallSeg { ax: pa.x, ay: pa.y, bx: pb.x, by: pb.y }];
    }
  }
  segs
}
