// figtest — the reference figure, checked before anything is rendered against it.
use mesh3d;
use glb;
use figure;

fn main() {
  println("=== story figure test ===");
  ok = true;
  println("reference height {FIGURE_M} m = {FIGURE_WU} wu");
  e = FIGURE_WU * 0.8660254037844386 - FIGURE_M;
  if e < 0.0 { e = 0.0 - e; }
  if e > 0.0001 { ok = false; }

  sc = scene("figure");
  skin = add_material(sc, material_color("skin", 0.78, 0.60, 0.46));
  add_figure(sc, 0.0, 0.0, 0.0, skin);
  println("figure built: nodes placed");

  // a 1-metre cube beside it, so the render itself carries a ruler
  cu = add_mesh(sc, cube());
  ref = add_material(sc, material_color("ref", 0.85, 0.25, 0.20));
  one_m = 1.0 / 0.8660254037844386 ?? 0.0;
  add_node(sc, node_at("one_metre_cube", cu, ref,
    mat4_trs(0.0, one_m * 1.6, one_m * 0.5, 0.0, one_m, one_m, one_m)));

  add_camera(sc, camera("cam"));
  add_light(sc, directional_light("sun", 1.0, 0.97, 0.92, 1.0, vec3(0.4, 0.5, -0.75)));
  // loft resolves a relative path against the PROGRAM's directory, not the cwd — the same
  // trap the font path hit (LOFT-HANDOFF S3). Build an absolute path from PWD.
  out = "{env_variable("PWD") ?? "."}/build/figure.glb";
  save_scene_glb(sc, out);
  println("wrote {out}");

  if ok { println("=== FIGURE OK ==="); } else { println("=== FAIL ==="); }
}
