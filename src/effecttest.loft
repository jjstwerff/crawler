// effecttest — the use-item EFFECTS now wired (SLICE §2): the inert consumables actually do their
// faithful thing. Phase Door blinks the player; Cure Serious heals; Restoration undoes a stat drain;
// Magic Mapping reveals the level. (Unbuilt effects still return false -> "Nothing happens.")
use sim;
use catalog;
use itemfx;
use player;
use items;
use hex_grid;

fn main() {
  println("=== story use-item effects test (blink / heal / restore / mapping) ===");

  // Scroll of Phase Door -> the player blinks to a new hex within range
  s = sim_new_gen(7, 1);
  (q0, r0) = sim_player_hex(s);
  sim_give_item(s, "scroll_phase_door");
  use_item(s, sim_find_item(s, "scroll_phase_door"));
  (q1, r1) = sim_player_hex(s);
  blink = (q1 != q0 || r1 != r0) && hex_distance(q0, r0, q1, r1) <= 5;

  // Potion of Cure Serious Wounds -> HP recovers
  h = sim_new();
  ph = player_new(0);
  ph.damage(h, 20, "physical");
  hp0 = sim_player_hp(h);
  sim_give_item(h, "potion_cure_serious");
  use_item(h, sim_find_item(h, "potion_cure_serious"));
  heal = sim_player_hp(h) > hp0;

  // Potion of Restoration -> a drained stat returns to its max
  rs = sim_new();
  str_orig = sim_stat(rs, "str");
  sim_drain_stat(rs, "str", 3);
  drained = sim_stat(rs, "str") < str_orig;
  sim_give_item(rs, "potion_restore");
  use_item(rs, sim_find_item(rs, "potion_restore"));
  restored = sim_stat(rs, "str") == str_orig;

  // Scroll of Magic Mapping -> a far, unseen tile becomes remembered
  m = sim_new_gen(7, 1);
  before = sim_hex_state(m, m.dn_q, m.dn_r);
  sim_give_item(m, "scroll_magic_mapping");
  use_item(m, sim_find_item(m, "scroll_magic_mapping"));
  after = sim_hex_state(m, m.dn_q, m.dn_r);
  mapped = before == 0 && after >= 1;

  // A blink must land somewhere you can STAND. It used to ask `tile_at != 1`,
  // which sees rock but not the solidity rule's other two arms, so it would drop
  // you inside a boulder or a fence post. Gated on the SURFACE, standing next to
  // the farmers' fences — the dungeon has neither kind, which is why the depth-1
  // check above never caught it.
  b = sim_new_gen(777, 0);
  fq = -1;
  fr = -1;
  for br0 in 0..101 {
    for bq0 in 0..101 {
      tb = tile_at(b, bq0, br0);
      if fq < 0 && (tb == 4 || tb == 5) { fq = bq0; fr = br0; }
    }
  }
  sq = -1;                                  // an open hex beside it — blink from there
  sr = -1;
  for d0 in 0..6 {
    (nq0, nr0) = hex_neighbor(fq, fr, d0);
    if sq < 0 && !is_wall(b, nq0, nr0) { sq = nq0; sr = nr0; }
  }
  soft_near = 0;                            // solid but NOT rock, within blink range:
  if sq >= 0 {                              // exactly what the old rule let through
    for rr0 in 0..7 {
      for qq0 in 0..7 {
        cq = sq + qq0 - 3;
        cr = sr + rr0 - 3;
        if hex_distance(sq, sr, cq, cr) <= 3 {
          tc = tile_at(b, cq, cr);
          if tc == 4 || tc == 5 { soft_near += 1; }
        }
      }
    }
  }
  landed_solid = 0;
  moved = 0;
  if sq >= 0 {
    for _ in 0..300 {
      sim_teleport(b, sq, sr);
      sim_blink(b, 3);
      (bq1, br1) = sim_player_hex(b);
      if bq1 != sq || br1 != sr { moved += 1; }
      if is_wall(b, bq1, br1) { landed_solid += 1; }
    }
  }
  // soft_near > 0 and moved > 200 are the anti-vacuous guards: there WAS something
  // solid-but-not-rock in range, and the blinks really fired.
  blink_solid = landed_solid == 0 && moved > 200 && soft_near > 0;

  println("blink={blink} heal={heal} restore={restored}(drained={drained}) mapped={mapped}(b={before} a={after})");
  println("blink-standable: from=({sq},{sr}) non-rock-solids-in-range={soft_near} blinks-moved={moved} landed-in-solid={landed_solid}");
  ok = blink && heal && drained && restored && mapped && blink_solid;
  if ok { println("=== EFFECT OK ==="); } else { println("=== FAIL ==="); }
}
