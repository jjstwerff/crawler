// view3d — the first-person pass (plan #11 P3). The world the kernel says is there,
// seen from eye height, through the `hexscene` camera whose round-trip is gated headless
// in `scenetest`.
//
// Deliberately a SEPARATE path from `view.loft` rather than surgery on it: the 2D view is
// one monolithic function (world -> post -> HUD) and it still works, so this adds a
// complete alternative and leaves it alone. `V` toggles. 3D replaces 2D for good in
// plan #11 P9, not here.
//
// SCOPE, so the frame is not read as broken: this draws the WORLD — floor and walls.
// Actors are boards through the presentation seam and are plan #11 P4; the full HUD comes
// with P9. A first-person frame with no monsters in it is this phase working, not failing.
//
// EXTRACTION: the geometry half (field -> floor + wall triangles) is generic and belongs
// in `hex_scene` with the camera; the COLOURS and HEIGHTS below are crawler's and stay.
// That split is stated in EXTRACTION.md -> "The runtime half".
use graphics;
use sim;
use hex_grid;
use hexscene;
use worldtex;
use overland;
use farfield;      // the terrain BEYOND the window — the far half of I-HORIZON (P6)
use scale;         // m_to_wu — the haze distance is stated in metres (SCALE.md)
use ground;        // the near field's SURFACE — one construction for standing and drawing (P6)

WALL3D_H = 3.2;          // world units ~ 2.77 m: a room you can stand up in (SCALE.md)
EYE3D_Z  = 1.847;        // 1.6 m eye height at 0.866 m per world unit

// Stride 8 is the graphics library's pos(3)/loc1(3)/UV(2) layout — location 2 carries two
// floats at offset 24 only at exactly that stride, which is why the buffer is 8 wide and
// not 7 plus a flag.
//
// ⚠ THE FLOOR/WALL DISCRIMINATOR IS THE UV ITSELF: a floor vertex always lands inside [0,1]
// (the frame is the window's own lattice bounding box), so walls carry (-1,-1) and the
// fragment reads the texture only where the uv is real. One attribute, no second channel to
// keep in step with the first.
V3VERT = `
#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aCol;
layout (location = 2) in vec2 aUV;
uniform mat4 uMVP;
out vec3 vCol;
out vec2 vUV;
out float vDepth;
void main() {{
  vec4 p = uMVP * vec4(aPos, 1.0);
  gl_Position = p;
  vCol = aCol;
  vUV = aUV;
  vDepth = p.w;
}}
`;

V3FRAG = `
#version 330 core
in vec3 vCol;
in vec2 vUV;
in float vDepth;
out vec4 FragColor;
uniform vec3 uFog;
uniform float uHaze;
uniform sampler2D uWorld;
void main() {{
  // I-PAINT: landcover comes off the world texture, which is rasterised from the same field
  // the floor under it is built from. vCol modulates rather than replaces, so a per-vertex
  // floor tone stays available without touching this branch.
  vec3 base = vCol;
  if (vUV.x >= 0.0) base = texture(uWorld, vUV).rgb * vCol;
  // AERIAL PERSPECTIVE, at the scale the atmosphere actually has (plan #11 P6). This was a
  // fade saturating at 42 wu — 36 m — which was a stand-in for a horizon that did not exist
  // yet, and its own comment said so. With terrain now drawn out to ~36 km, that curve made
  // everything past a street corner one flat colour. Exponential extinction over a stated
  // visibility instead: near geometry is crisp (36 m fades 1%), the window edge is barely
  // touched, and the far ridges wash out with distance the way distance washes them out.
  float f = 1.0 - exp(-vDepth * uHaze);
  FragColor = vec4(mix(base, uFog, f), 1.0);
}}
`;

pub fn make_view3d_shader() -> integer {
  graphics::gl_create_shader(V3VERT, V3FRAG)
}

// Landcover tone per terrain kind — the palette, and the ONLY place colour enters the world
// texture. It lives view-side on purpose: `worldtex` emits CLASSES, so the gate compares
// classes and two kinds sharing a tone cannot hide a mismatch behind an equal colour.
// Kind -1 (the dungeon, and off the window edge) is warm aged stone underfoot.
fn kind_rgb3(k: integer) -> (float, float, float) {
  if k == K_GRASS  { return (0.42, 0.52, 0.30); }
  if k == K_FOREST { return (0.20, 0.34, 0.20); }
  if k == K_SAND   { return (0.78, 0.72, 0.52); }
  if k == K_SCREE  { return (0.52, 0.50, 0.46); }
  if k == K_MEADOW { return (0.50, 0.62, 0.34); }
  if k == K_SNOW   { return (0.90, 0.92, 0.95); }
  if k == K_FACE   { return (0.42, 0.40, 0.37); }
  if k == K_ICE    { return (0.72, 0.80, 0.88); }
  if k == K_RIVER  { return (0.24, 0.38, 0.50); }
  if k == K_LAKE   { return (0.20, 0.33, 0.46); }
  if k == K_SEA    { return (0.16, 0.28, 0.42); }
  if k == K_FIELD  { return (0.62, 0.56, 0.31); }
  if k == K_ROAD   { return (0.55, 0.50, 0.42); }
  if k == K_SWAMP  { return (0.32, 0.38, 0.28); }
  (0.72, 0.68, 0.55)                                  // aged travertine, the dungeon floor
}

// The world texture, uploaded (plan #11 P3b, I-PAINT). The kernel hands over one terrain
// kind per texel; this turns them into pixels through a 15-entry palette lookup rather than
// a branch per texel, and uploads.
//
// LINEAR + mipmaps, deliberately. The raster is exact AT TEXEL CENTRES — that is what
// `worldtextest` asserts — and a linear sampler blends across at most one texel, which at
// TEX_SX=4 is 0.19 m of world. Nearest would keep the claim literal at every fragment and
// show 19 cm blocks underfoot; the blend is the better picture and the error is stated
// rather than hidden.
pub fn build_world_texture3d(s: Sim) -> integer {
  t = build_world_tex(s);
  pal: vector<integer> = [];
  for pk in -1..14 {
    (pr, pg, pb) = kind_rgb3(pk);
    pal += [graphics::rgba((pr * 255.0) as integer ?? 0, (pg * 255.0) as integer ?? 0,
                           (pb * 255.0) as integer ?? 0, 255)];
  }
  // Built INLINE and handed straight to the upload — never returned from a helper
  // (loft#392: a vector routed through a returning function into a native FFI call can
  // abort the program silently).
  pix: vector<integer> = [];
  n = t.wt_w * t.wt_h;
  for i in 0..n { pix += [pal[(t.wt_kind[i] ?? -1) + 1] ?? 0]; }
  tex = graphics::gl_upload_canvas(pix, t.wt_w, t.wt_h);
  graphics::gl_texture_filter(tex, false);
  graphics::gl_generate_mipmap(tex);
  tex
}

// How much light reaches one floor triangle: a Lambert term against a fixed sun, flat per
// triangle. Flat rather than smoothed on purpose — a facet is the honest picture of a mesh
// whose vertices are hex samples, and a smoothed normal would claim a curvature the field
// does not carry. On level ground every triangle takes the same value, so a flat world stays
// flat-looking and only relief shows.
//
// The sun sits high and to the north-west (the direction the 2D view has always lit from) so
// slopes facing it read bright and the ones away read dark; the ambient floor is 0.55, which
// keeps a shadowed hillside readable rather than black — this is legibility, not a lighting
// model, and there is no shadow term at all.
fn tri_shade(cx: float, cy: float, cz: float, ax: float, ay: float, az: float,
             bx: float, by: float, bz: float) -> float {
  ux = ax - cx; uy = ay - cy; uz = az - cz;
  vx = bx - cx; vy = by - cy; vz = bz - cz;
  nx = uy * vz - uz * vy;
  ny = uz * vx - ux * vz;
  nz = ux * vy - uy * vx;
  if nz < 0.0 { nx = 0.0 - nx; ny = 0.0 - ny; nz = 0.0 - nz; }   // normals point up
  ln = sqrt(nx * nx + ny * ny + nz * nz) ?? 0.0;
  if ln <= 0.0 { return 1.0; }
  d = ((nx * (0.0 - 0.40) + ny * 0.30 + nz * 0.866) / ln) ?? 0.0;
  if d < 0.0 { d = 0.0; }
  0.55 + 0.45 * d
}

// Build the level's 3D scene and upload it. Returns (vao, vertex count).
//
// The buffer is built INLINE here and handed straight to gl_upload_vertices — never
// returned from a helper. loft#392: a `fn(...) -> vector<single>` whose result reaches
// gl_upload_vertices SILENTLY ABORTS the program once the real pipeline is in context —
// no output, no error, exit 0. This shape is the documented workaround, not a style choice.
pub fn build_scene3d(s: Sim) -> (integer, integer) {
  buf: vector<single> = [];
  n = 0;
  zf = 0.0 as single;
  hf = WALL3D_H as single;
  neg = (0.0 - 1.0) as single;         // the wall marker: no uv, use the vertex tone
  one = 1.0 as single;
  // The texture FRAME only — `world_tex_of` carries no raster, so asking it where a vertex
  // lands costs nothing. The uv comes from `world_tex_uv`, the same function the gate
  // round-trips in `worldtextest` row 2: one owner for the mapping, so the ground cannot
  // sample a texture laid out somewhere else.
  wt = world_tex_of(s);
  for gr in 0..s.lh {
    for gq in 0..s.lw {
      q = s.qmin + gq;
      r = s.rmin + gr;
      // ⚠ ROCK IS GROUND YOU CANNOT WALK ON, NOT AN ABSENCE OF GROUND (plan #11 P6).
      // The floor used to be drawn only where the field says you may stand, which was right
      // while the world was flat — a K_FACE hex was rendered by the 3.2 wu wall quads its
      // open neighbours emit, and there was nothing else it could have been. With heights it
      // is wrong twice over: the mountain draws as a HOLE ringed by a 2.8 m fence, and the
      // fence duplicates a cliff the height already describes. So the floor follows the
      // READING, not the passability.
      //
      // ⚠ It is a small correction on the shipped window and the frame barely moves — of its
      // 290 blocked hexes only **33 are rock**; the other 257 are BUILT, and they are what the
      // dark band across the first-person frame from the town square actually is. Written down
      // because the obvious reading of that band was "the mountain", and `skyprobe` had to be
      // asked before the change could be described. It is a valley town: the rock is elsewhere.
      drawfloor = !field_blocked(s, q, r, DIR_HEX) || sim_has_ground(s, q, r);
      if drawfloor {
        // FLOOR — a hexagon fan standing on the near field's own height (plan #11 P6). The
        // centre takes the hex's reading and each corner the mean of the hexes meeting there,
        // so the fan of one hex meets its neighbour's along a shared edge with shared
        // endpoints: the ground is a continuous sheet, not a field of terraces. Landcover
        // rides the world texture (I-PAINT), so the vertex tone is white and only modulates.
        (cx, cy) = hex_to_px(q, r);
        cxs = cx as single;
        cys = cy as single;
        czs = sim_ground_z(s, q, r) as single;
        (cu, cv) = world_tex_uv(wt, cx, cy);
        cus = cu as single;
        cvs = cv as single;
        for kc in 0..6 {
          kc2 = (kc + 1) % 6 ?? 0;
          (kax, kay) = hex_corner_px(q, r, kc);
          (kbx, kby) = hex_corner_px(q, r, kc2);
          kazf = ground_corner_z(s, q, r, kc);
          kbzf = ground_corner_z(s, q, r, kc2);
          kaz = kazf as single;
          kbz = kbzf as single;
          (au, av) = world_tex_uv(wt, kax, kay);
          (bu, bv) = world_tex_uv(wt, kbx, kby);
          // ⚠ WITHOUT THIS THE HEIGHT FIELD IS INVISIBLE. An unlit floor is its landcover
          // colour whatever its slope, so a 40-degree hillside renders as the same flat green
          // as a meadow — the frame cannot show the one thing this phase built, and "the
          // ground looks wrong" and "the ground looks fine" produce the same picture.
          // A per-triangle Lambert term against a fixed sun is the whole of it, carried in
          // the vertex tone the shader already multiplies the texture by (I-PAINT keeps the
          // COLOUR in the texture; this only says how much light reaches it).
          sl = tri_shade(cx, cy, sim_ground_z(s, q, r), kax, kay, kazf, kbx, kby, kbzf) as single;
          buf += [cxs, cys, czs, sl, sl, sl, cus, cvs];
          buf += [kax as single, kay as single, kaz, sl, sl, sl, au as single, av as single];
          buf += [kbx as single, kby as single, kbz, sl, sl, sl, bu as single, bv as single];
          n += 3;
        }
        // WALLS — one quad per blocked edge, raised from the floor. Emitted from the
        // OPEN side only, so each face is built once and faces the cell you can stand in.
        //
        // ⚠ A CLIFF IS NOT A WALL. Where the blocker is terrain rock the height field already
        // draws the face — at its true size, which is tens of metres, not 2.8 — so a quad
        // there is a second, shorter mountain standing inside the first. Architecture keeps
        // its quads: a house wall is 2.8 m of built thing ON the ground (decision 6, a wall's
        // THICKNESS decides its layer), and nothing in the height field describes it.
        for d in 0..6 {
          if field_blocked(s, q, r, d) {
            (bnq, bnr) = hex_neighbor(q, r, d);
            isrock = sim_terrain_at(s, bnq, bnr) == K_FACE + 1;
            if !isrock {
            (e0, e1) = hex_edge_corners(d);
            (w0x, w0y) = hex_corner_px(q, r, e0);
            (w1x, w1y) = hex_corner_px(q, r, e1);
            // Face tone varies with the edge direction so corners read as corners
            // instead of one flat mass — the only lighting this pass has.
            sh = 0.62 + 0.10 * cos((d as float) * 1.0471975511965976);
            wr = (0.30 * sh) as single;
            wg = (0.285 * sh) as single;
            wb = (0.26 * sh) as single;
            ax = w0x as single;
            ay = w0y as single;
            bx = w1x as single;
            by = w1y as single;
            // The wall's FOOT follows the ground it stands on — the same two corner heights
            // the floor triangles use, so a wall meets the floor along one line rather than
            // hovering over a slope or sinking into it. Its top rides parallel: a wall is a
            // constant height ABOVE its own ground, not a constant height above sea level.
            az0 = ground_corner_z(s, q, r, e0);
            bz0 = ground_corner_z(s, q, r, e1);
            azs = az0 as single;
            bzs = bz0 as single;
            azh = (az0 + WALL3D_H) as single;
            bzh = (bz0 + WALL3D_H) as single;
            buf += [ax, ay, azs, wr, wg, wb, neg, neg];
            buf += [bx, by, bzs, wr, wg, wb, neg, neg];
            buf += [bx, by, bzh, wr, wg, wb, neg, neg];
            buf += [ax, ay, azs, wr, wg, wb, neg, neg];
            buf += [bx, by, bzh, wr, wg, wb, neg, neg];
            buf += [ax, ay, azh, wr, wg, wb, neg, neg];
            n += 6;
            }
          }
        }
      }
    }
  }
  (graphics::gl_upload_vertices(buf, 8), n)
}

// THE FAR FIELD — the terrain beyond the level window, as a polar skirt whose ring 0 is the
// window's own boundary (plan #11 P6; the construction and why it is not a clipmap are in
// `farfield.loft`). Returns (vao, vertex count); (0,0) on a dungeon level, which has no
// wilderness to continue into.
//
// The uv is the wall marker (-1,-1) throughout: the world texture covers the WINDOW only, so
// past it the landcover palette is read per vertex. That is the same discriminator the walls
// use and needs no shader branch of its own.
//
// Same inline-buffer rule as `build_scene3d` (loft#392).
pub fn build_far3d(s: Sim) -> (integer, integer) {
  if s.depth != 0 { return (0, 0); }
  buf: vector<single> = [];
  n = 0;
  neg = (0.0 - 1.0) as single;
  o = overland_new();
  (ax, ay, cwx, cwy) = sim_window_frame(s);
  na = far_ang_count(s);
  for j in 0..FAR_RINGS {
    for i in 0..na {
      i2 = i + 1;
      if i2 >= na { i2 = 0; }
      (x0, y0, z0, k0) = far_point(o, s, ax, ay, cwx, cwy, i, j);
      (x1, y1, z1, k1) = far_point(o, s, ax, ay, cwx, cwy, i2, j);
      (x2, y2, z2, k2) = far_point(o, s, ax, ay, cwx, cwy, i, j + 1);
      (x3, y3, z3, k3) = far_point(o, s, ax, ay, cwx, cwy, i2, j + 1);
      // One tone for the quad, from its own outer corner: a far vertex is shared by two
      // quads that may want different landcover, and a per-vertex kind would blend rock into
      // meadow across a ridge line. Flat per quad keeps the classes the overland assigned.
      (qr0, qg0, qb0) = kind_rgb3(k3);
      sh0 = tri_shade(x0, y0, z0, x1, y1, z1, x2, y2, z2);
      sh1 = tri_shade(x1, y1, z1, x3, y3, z3, x2, y2, z2);
      for t in 0..2 {
        sh = sh0;
        if t == 1 { sh = sh1; }
        cr = (qr0 * sh) as single;
        cg = (qg0 * sh) as single;
        cb = (qb0 * sh) as single;
        if t == 0 {
          buf += [x0 as single, y0 as single, z0 as single, cr, cg, cb, neg, neg];
          buf += [x1 as single, y1 as single, z1 as single, cr, cg, cb, neg, neg];
          buf += [x2 as single, y2 as single, z2 as single, cr, cg, cb, neg, neg];
        } else {
          buf += [x1 as single, y1 as single, z1 as single, cr, cg, cb, neg, neg];
          buf += [x3 as single, y3 as single, z3 as single, cr, cg, cb, neg, neg];
          buf += [x2 as single, y2 as single, z2 as single, cr, cg, cb, neg, neg];
        }
        n += 3;
      }
    }
  }
  (graphics::gl_upload_vertices(buf, 8), n)
}

// The ADAPTER for the presentation seam. `ActorView` and `present_boards` live in
// hexscene because they take a SceneCamera and nothing else; this function takes `Sim`, which
// is exactly the line EXTRACTION.md draws between library and game.
// Kernel state -> presentation records. Reads only `sim_*` accessors, so it stays on the
// kernel side of the architecture invariant and carries no drawing decisions at all.
pub fn actors_collect(s: Sim, tex_of: vector<integer>) -> vector<ActorView> {
  out: vector<ActorView> = [];
  n = sim_enemy_count(s);
  for i in 0..n {
    if sim_enemy_alive(s, i) {
      (ax, ay) = sim_enemy_pos(s, i);
      tx = 0;
      if i < len(tex_of) { tx = tex_of[i] ?? 0; }
      // A humanoid is 1.75 m tall = 2.02 world units (SCALE.md, 0.866 m per unit). One
      // size for now: per-monster metric sizes are content, and belong in the bundle.
      (er, eg, eb) = sim_enemy_color(s, i);
      // FEET ON THE GROUND (plan #11 P6): a board's base sits at the surface height under it,
      // read through the same function the camera stands on and the floor is drawn from.
      az = ground_at(s, ax, ay);
      av = ActorView { av_x: ax, av_y: ay, av_z: az, av_w: 1.15, av_h: 2.02,
                       av_yaw: 0.0,
                       av_r: (er as float) / 255.0 ?? 0.5,
                       av_g: (eg as float) / 255.0 ?? 0.5,
                       av_b: (eb as float) / 255.0 ?? 0.5,
                       av_tex: tx };
      out += [av];                        // hoisted: loft#496 nulls all but the first
    }                                     //   element when a struct temp is inlined here
  }
  out
}

// The camera for this frame — a pure function of kernel state, which is I-STAND: the
// renderer holds no position of its own, it reads the one the kernel moved.
//
// The eye is EYE3D_Z above THE GROUND, not above sea level (plan #11 P6). `ground_eye_z`
// interpolates inside the same triangle the floor fan draws, so the horizon rises and falls
// with the ground the player walks instead of the player wading through a hillside.
pub fn view3d_camera(s: Sim, vw: float, vh: float) -> hexscene::SceneCamera {
  camera_new(s.px, s.py, ground_eye_z(s, s.px, s.py, EYE3D_Z), s.heading, 0.0,
             1.0471975511965976, vw, vh)
}

// Actors, through the seam, in ONE draw call. The frame loop never learns that a board
// came out: it collects records and calls the presenter. Swapping present_boards for a
// mesh presenter is the whole of the change this seam exists to make cheap.
// The board buffer, created ONCE and re-uploaded each frame with gl_update_buffer rather
// than recreated — a VAO per frame would churn GL objects for no gain. Seeded with one
// degenerate quad so the handle is valid before any actor exists.
pub fn make_actor_vbo() -> integer {
  seed: vector<single> = [];
  z = 0.0 as single;
  for _ in 0..36 { seed += [z]; }
  graphics::gl_upload_vertices(seed, 6)
}

pub fn view3d_actors(s: Sim, prog: integer, avbo: integer, vw: float, vh: float) -> integer {
  c = view3d_camera(s, vw, vh);
  texs: vector<integer> = [];
  views = actors_collect(s, texs);
  buf: vector<single> = [];
  n = present_boards(c, views, buf);          // inline: never route a vector<single>
  if n > 0 {                                  //   through a returning helper (loft#392)
    graphics::gl_update_buffer(avbo, buf);
    graphics::gl_draw(avbo, n);
  }
  n
}

// VISIBILITY, as one number: the distance at which extinction reaches 1 - 1/e. 25 natural km
// is a clear-day alpine haze, and it is stated in metres and converted, so it is a length in
// the world rather than a shader constant nobody can price (SCALE.md's rule).
FAR_VIS_M = 25000.0;

pub fn view3d_frame(s: Sim, prog: integer, vao: integer, nverts: integer, wtex: integer,
                    vw: float, vh: float) {
  view3d_frame_far(s, prog, vao, nverts, 0, 0, wtex, vw, vh);
}

pub fn view3d_frame_far(s: Sim, prog: integer, vao: integer, nverts: integer,
                        fvao: integer, fverts: integer, wtex: integer,
                        vw: float, vh: float) {
  // Depth state BEFORE the clear: gl_clear is documented as clearing colour and says
  // nothing about depth, and nothing in this repo had ever enabled depth testing before
  // (every other pass disables it), so the window may not even carry a depth attachment.
  // If the frame is right on the first draw and wrong after, this is the first place to
  // look — see LOFT-HANDOFF.md -> G1.
  graphics::gl_enable(graphics::GL_DEPTH_TEST);
  graphics::gl_depth_mask(true);
  graphics::gl_clear(graphics::rgba(96, 112, 138, 255));      // the air colour
  c = view3d_camera(s, vw, vh);
  // ⚠ THE FAR PLANE IS PART OF THE FAR FIELD, and it was the whole of it at first: the skirt
  // reaches ~4100 wu and this clipped at 400, so 108 000 uploaded vertices changed EXACTLY
  // ZERO pixels — which the far field's own negative control (render with it, render without,
  // diff) is what caught. A near plane of 0.05 wu is 4 cm and buys nothing at 1.6 m eye
  // height; 0.1 halves the depth range's cost and 5000 covers the skirt with room over.
  // DESIGN.md's depth-partition note is about spanning 0.5 m to 600 km — 0.1 to 5000 wu is
  // 5e4, which a 24-bit buffer carries, so the partition is still P6d's business and not yet
  // needed here.
  m = cam_mat4(c, 0.1, 5000.0);
  graphics::gl_use_shader(prog);
  graphics::gl_set_uniform_mat4(prog, "uMVP", m);
  graphics::gl_set_uniform_vec3(prog, "uFog", 0.376, 0.439, 0.541);
  graphics::gl_set_uniform_float(prog, "uHaze", 1.0 / m_to_wu(FAR_VIS_M) ?? 0.0);
  graphics::gl_bind_texture(wtex, 0);
  graphics::gl_set_uniform_int(prog, "uWorld", 0);
  // The far field first: it is behind the near window everywhere except the one-hex band
  // they share, and the depth test settles that band rather than a draw order guess.
  if fverts > 0 { graphics::gl_draw(fvao, fverts); }
  if nverts > 0 { graphics::gl_draw(vao, nverts); }
  graphics::gl_disable(graphics::GL_DEPTH_TEST);
}
