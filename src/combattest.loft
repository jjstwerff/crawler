// combattest — headless check of the melee loop (player kills enemy by bumping;
// enemy hits back). Deterministic; no graphics.

use sim;

fn main() {
  println("=== story combat test ===");
  s = sim_new();
  alive0 = sim_enemy_alive(s, 0);
  hp0 = sim_player_hp(s);

  // Charge the enemy: re-aim at its (possibly moving) world position each frame, glide
  // in, and bump-melee until it dies. Coordinate-agnostic — works for any hex layout
  // (the old fixed-heading version was hand-tuned to the axial diagonal and missed a
  // sidestepping enemy once the grid became odd-r offset).
  for _ in 0..600 {
    if sim_enemy_alive(s, 0) {
      (epx, epy) = sim_enemy_pos(s, 0);
      s.heading = atan2(epy - s.py, epx - s.px);
    }
    sim_step(s, 1, 0, 0.016);
  }

  alive1 = sim_enemy_alive(s, 0);
  hp1 = sim_player_hp(s);
  ehp1 = sim_enemy_hp(s, 0);
  pmax = sim_player_hp_max(s);
  println("enemy alive: {alive0} -> {alive1} (enemy hp now {ehp1})");
  println("player hp: {hp0} -> {hp1} (max {pmax})");

  ok_kill = alive0 && !alive1;   // player's bump-melee killed the enemy
  ok_hurt = hp1 < hp0;           // the enemy hit back while adjacent
  println("player-kills-enemy: {ok_kill}");
  println("enemy-hits-player : {ok_hurt}");
  if ok_kill && ok_hurt {
    println("=== COMBAT OK ===");
  } else {
    println("=== FAIL ===");
  }
}
