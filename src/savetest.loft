// savetest — G4 checkpoint respawn + Souls grave stake (§3a #5). Death is not
// permadeath: respawn at the last save point KEEPING the character (level/XP/gold/items/
// equipment) at full HP, losing the dive. A percentage of gold is left as a grave at the
// death spot — recover it by returning there; in single-player a fresh death forfeits the
// prior grave. Deterministic.

use hex_grid;
use sim;

fn main() {
  println("=== story save-point + grave test (G4) ===");

  s = sim_new_gen(7777, 1);
  start_save = sim_save_depth(s);          // 1 (the home/bed)
  sim_grant_gold(s, 100);
  sim_award_xp(s, 500);
  cl  = sim_clevel(s);
  xp  = sim_xp(s);
  dam = sim_player_dam(s);
  ac  = sim_player_ac(s);

  // Dive to a save point (depth 4), then one level past it (depth 5).
  s = sim_descend(s, 1);                     // 2
  s = sim_descend(s, 1);                     // 3
  s = sim_descend(s, 1);                     // 4 — save point
  save_at4 = sim_save_depth(s);
  s = sim_descend(s, 1);                     // 5
  d_before    = sim_depth(s);                // 5
  gold_before = sim_gold(s);                 // 100 (carried)

  // Die at depth 5 -> respawn at checkpoint 4; stake half the gold on a grave at 5.
  rs = sim_respawn(s);
  d_after = sim_depth(rs);                   // 4
  kept   = sim_clevel(rs) == cl && sim_xp(rs) == xp
        && sim_player_dam(rs) == dam && sim_player_ac(rs) == ac;
  healed = sim_player_hp(rs) == sim_player_hp_max(rs);
  alive  = !sim_over(rs);
  staked = sim_gold(rs) == 50 && sim_grave_gold(rs) == 50 && sim_grave_depth(rs) == 5;

  // Return to the grave (re-dive to depth 5, arrive on the death spot) and reclaim it.
  rb = sim_descend(rs, 1);                   // 4 -> 5, player at the entrance = death spot
  sim_step(rb, 0, 0, 0.016);                 // standing on the grave reclaims its gold
  reclaimed = sim_gold(rb) == 100 && sim_grave_gold(rb) == 0;

  // Forfeit (single-player): dying again before reclaiming overwrites the prior grave.
  rf = sim_respawn(rs);                      // rs still holds the depth-5 grave + 50 gold
  forfeit = sim_grave_depth(rf) == 4 && sim_grave_gold(rf) == 25 && sim_gold(rf) == 25;

  home_ok    = start_save == 1;
  advance_ok = save_at4 == 4;
  respawn_ok = d_after == 4 && d_before == 5;

  println("home={start_save} save@4={save_at4} depth {d_before}->{d_after} gold {gold_before}->{sim_gold(rs)}");
  println("char L{cl} kept={kept} healed={healed} alive={alive}");
  println("grave: staked={staked} reclaimed={reclaimed} forfeit={forfeit}");
  println("home={home_ok} advance={advance_ok} respawn={respawn_ok}");
  if home_ok && advance_ok && respawn_ok && kept && healed && alive && staked && reclaimed && forfeit {
    println("=== SAVE OK ===");
  } else {
    println("=== FAIL ===");
  }
}
