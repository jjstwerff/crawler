// story — M0 vertical slice entry point.
//
// Opens a window, runs the frame loop, maps analog WASD input into kernel
// intents, and draws the egocentric 2D view. The kernel (sim/hexgeo) is the
// reusable core; this file and view.loft are the swappable 2D front-end.
//
// Controls: W glide forward · S glide back · A/D turn (free) · walk onto a
// stair to change level (no button) · . / Space wait · g grab · Esc quit.
// E and Q are intentionally FREE — reserved for upcoming character actions
// (fire arrow / cast spell); that's why stairs are taken by walking, not a key.

use graphics;
use sim;
use wallgeo;
use view;
use itemfx;
use bundles;   // bundle_activate — the quick-start class kit (generated registry)

WIN_W   = 800;
WIN_H   = 600;
KEY_W   = 119;
KEY_S   = 115;
KEY_A   = 97;
KEY_D   = 100;
KEY_G   = 103;      // 'g' grab items under you (gold auto-collects)
KEY_DOT = 46;       // '.' wait one tick
KEY_SPC = 32;       // Space — also wait
KEY_ESC = 27;
KEY_C   = 99;       // 'c' — open/close the character page
KEY_I   = 105;      // 'i' — open/close the inventory page
KEY_1   = 49;       // '1'..'9' — in play: use quick-slot N; char page: spend a stat; inv: use/wield N
KEY_Q   = 113;      // 'q' — quick-slot active Q (fire the launcher)
KEY_E   = 101;      // 'e' — quick-slot active E (spell — later)
KEY_ENTER = 13;     // Enter — equip the selected item in the inventory hub

GEN_SEED  = 1337;   // world-key seed for this dungeon (deterministic gen)
GEN_DEPTH = 0;      // start on the SURFACE (depth 0 = the open desert + the dungeon entrance);
                    // walk onto the entrance to descend into the dungeon (depth 1: rats/bats/…)

// Stat name for the character page's 1-6 keys (index 0..5 -> STR..CHR).
fn stat_name(i: integer) -> text {
  if i == 0 { return "str"; }
  if i == 1 { return "int"; }
  if i == 2 { return "wis"; }
  if i == 3 { return "dex"; }
  if i == 4 { return "con"; }
  "chr"
}

fn main() {
  if !graphics::gl_create_window(WIN_W, WIN_H, "story — M0") {
    println("story: failed to create window");
    return;
  }
  painter = graphics::create_painter_2d(WIN_W as float, WIN_H as float);
  // The window enables GL_DEPTH_TEST by default, and 2D quads all share one
  // z — so with depth-test on, the FIRST quad drawn to a pixel wins (terrain
  // would occlude the player; a full-screen backdrop would occlude the whole
  // world -> black). Disable it for normal last-drawn-on-top painting, and
  // enable blending for alpha. (Same setup brick-buster uses.)
  graphics::gl_disable(graphics::GL_DEPTH_TEST);
  graphics::gl_enable(graphics::GL_BLEND);
  graphics::gl_blend_func(graphics::BLEND_SRC_ALPHA, graphics::BLEND_ONE_MINUS_SRC_ALPHA);
  s = sim_new_gen(GEN_SEED, GEN_DEPTH);   // procedural dungeon + DB monsters
  // QUICK-START: every new game boots a ready-made HUMAN WARRIOR (race default + the classic first
  // class) with its class kit — no creation screen in the way. Walking into the spawning crystal
  // re-specs race/class (the crystal page); the kit is a new-game grant only.
  sim_set_class(s, "warrior");
  bundle_activate(s, "warrior");
  walls = build_walls(s);   // smoothed wall outline, built once (static per level)
  hud = build_hud(s);       // load font + bake glyph/HUD textures (after window)
  ml = build_msglog(s, hud.font);     // baked message-log lines (rebaked only when a message arrives)
  last_total = sim_msg_total(s);      // watch this to know when to rebake
  last_known = sim_known_count(s);    // watch identifications to re-bake the quick-slot names (flavour → real)
  wprog = make_world_shader();   // GPU terrain shader (global, built once)
  wvao = build_world_vbo(s);     // GPU terrain VBO (rebuilt on each level change)
  last = ticks();
  w_was = false;            // edge-trigger for the wait key
  g_was = false;            // edge-trigger for the grab key
  page_open = false;        // character page overlay (C): pauses the world while open
  pg: vector<integer> = []; // baked character-page line textures (rebuilt on open + each spend)
  c_was = false;            // edge-trigger for the page toggle
  spend_was = false;        // edge-trigger for the 1-9 number keys (shared by both pages)
  qs_was = false;           // edge-trigger for the quick-slot keys (1-9 / Q / E in normal play)
  inv_open = false;         // inventory overlay (I): also pauses the world
  pg_inv: vector<integer> = [];   // baked inventory-hub textures (rebuilt on cursor move / equip / bind)
  i_was = false;            // edge-trigger for the inventory toggle
  inv_cursor = 0;           // highlighted carried item in the hub
  iu_was = false;           // edge-triggers for the hub: cursor up / down / Q-bind / E-bind / equip
  id_was = false;
  iq_was = false;
  ie_was = false;
  ient_was = false;
  crys_open = false;        // the CRYSTAL page (bump the shrine): pauses the world too
  pg_crys: vector<integer> = [];  // baked crystal-page textures (rebuilt on cursor/column/apply)
  crys_col = 0;             // 0 = race column, 1 = class column
  crys_cur = 0;             // highlighted entry in the active column
  cu_was = false;           // crystal-page edge-triggers: W/S/A/D/Enter/Q
  cd_was = false;
  ca_was = false;
  cdd_was = false;
  cent_was = false;
  ckq_was = false;
  (sq, sr) = sim_player_hex(s);   // stair-hex tracker: armed on the start stair so
                                  // standing on it doesn't fire (walk-onto edge-trigger)
  running = true;
  while running {
    if !graphics::gl_poll_events() {
      running = false;
    } else if graphics::gl_key_pressed(KEY_ESC) {
      running = false;
    } else {
      tnow = ticks();
      dt = (tnow - last) as float / 1000000.0;
      last = tnow;
      if dt > 0.05 { dt = 0.05; }

      // Character page (C): toggle the overlay. While open the world is PAUSED and the number
      // keys 1-6 spend banked stat points (the deferred, player-chosen level-up).
      c_down = graphics::gl_key_pressed(KEY_C);
      if c_down && !c_was {
        page_open = !page_open;
        if page_open { inv_open = false; pg = build_charpage(s, hud.font); }
      }
      c_was = c_down;

      i_down = graphics::gl_key_pressed(KEY_I);
      if i_down && !i_was {
        inv_open = !inv_open;
        if inv_open { page_open = false; inv_cursor = 0; pg_inv = build_invpage(s, hud.font, inv_cursor); }
      }
      i_was = i_down;

      if crys_open {
        // THE CRYSTAL PAGE — W/S move, A/D switch column, Enter reshapes, Q steps away.
        ccount = if crys_col == 0 { sim_race_count() } else { sim_class_count() };
        cu = graphics::gl_key_pressed(KEY_W);
        if cu && !cu_was && crys_cur > 0 { crys_cur -= 1; pg_crys = build_crystalpage(s, hud.font, crys_col, crys_cur); }
        cu_was = cu;
        cd = graphics::gl_key_pressed(KEY_S);
        if cd && !cd_was && crys_cur < ccount - 1 { crys_cur += 1; pg_crys = build_crystalpage(s, hud.font, crys_col, crys_cur); }
        cd_was = cd;
        ca = graphics::gl_key_pressed(KEY_A);
        cdd = graphics::gl_key_pressed(KEY_D);
        if (ca && !ca_was) || (cdd && !cdd_was) {
          crys_col = 1 - crys_col;
          nmax = if crys_col == 0 { sim_race_count() } else { sim_class_count() };
          if crys_cur >= nmax { crys_cur = nmax - 1; }
          pg_crys = build_crystalpage(s, hud.font, crys_col, crys_cur);
        }
        ca_was = ca;
        cdd_was = cdd;
        cent = graphics::gl_key_pressed(KEY_ENTER);
        if cent && !cent_was {
          if crys_col == 0 { sim_shrine_apply(s, "race", sim_race_key(crys_cur)); }
          else { sim_shrine_apply(s, "class", sim_class_key(crys_cur)); }
          crys_open = false;
        }
        cent_was = cent;
        ckq = graphics::gl_key_pressed(KEY_Q);
        if ckq && !ckq_was { crys_open = false; }
        ckq_was = ckq;
      } else if page_open || inv_open {
        // Number keys 1-9: char page SPENDS a stat (1-6); inventory hub BINDS the selected item to
        // that quick-slot (the manual reslot).
        sd = -1;
        for ki in 0..9 {
          if graphics::gl_key_pressed(KEY_1 + ki) { sd = ki; }
        }
        sdn = sd >= 0;
        if sdn && !spend_was {
          if page_open && sd < 6 {
            if sim_raise_stat(s, stat_name(sd)) { pg = build_charpage(s, hud.font); }
          } else if inv_open {
            sim_inv_bind(s, inv_cursor, sd);
            pg_inv = build_invpage(s, hud.font, inv_cursor);
          }
        }
        spend_was = sdn;

        if inv_open {
          // WASD cursor over the carried list
          up_d = graphics::gl_key_pressed(KEY_W);
          if up_d && !iu_was && inv_cursor > 0 { inv_cursor = inv_cursor - 1; pg_inv = build_invpage(s, hud.font, inv_cursor); }
          iu_was = up_d;
          dn_d = graphics::gl_key_pressed(KEY_S);
          if dn_d && !id_was && inv_cursor < sim_inv_count(s) - 1 { inv_cursor = inv_cursor + 1; pg_inv = build_invpage(s, hud.font, inv_cursor); }
          id_was = dn_d;
          // Q / E bind the selected item to an active slot
          q_d = graphics::gl_key_pressed(KEY_Q);
          if q_d && !iq_was { sim_inv_bind(s, inv_cursor, QS_Q); pg_inv = build_invpage(s, hud.font, inv_cursor); }
          iq_was = q_d;
          e_d = graphics::gl_key_pressed(KEY_E);
          if e_d && !ie_was { sim_inv_bind(s, inv_cursor, QS_E); pg_inv = build_invpage(s, hud.font, inv_cursor); }
          ie_was = e_d;
          // Enter equips the selected item to its worn location
          ent_d = graphics::gl_key_pressed(KEY_ENTER);
          if ent_d && !ient_was {
            sim_equip(s, inv_cursor);
            if inv_cursor >= sim_inv_count(s) && inv_cursor > 0 { inv_cursor = sim_inv_count(s) - 1; }
            pg_inv = build_invpage(s, hud.font, inv_cursor);
          }
          ient_was = ent_d;
        }
      } else {
        spend_was = false;

      // Quick-slots: 1-9 / Q / E use the bound item (consumable -> use_item, launcher -> sim_fire).
      // Edge-triggered so a held key fires once. The bar reads live, so no rebake is needed.
      qslot = -1;
      for ki in 0..9 {
        if graphics::gl_key_pressed(KEY_1 + ki) { qslot = ki; }
      }
      if graphics::gl_key_pressed(KEY_Q) { qslot = QS_Q; }
      if graphics::gl_key_pressed(KEY_E) { qslot = QS_E; }
      qdn = qslot >= 0;
      if qdn && !qs_was { use_slot(s, qslot); }
      qs_was = qdn;

      fwd = 0;
      turn = 0;
      if graphics::gl_key_pressed(KEY_W) { fwd = 1; }
      if graphics::gl_key_pressed(KEY_S) { fwd = -1; }
      if graphics::gl_key_pressed(KEY_A) { turn = 1; }   // left  = CCW (heading up)
      if graphics::gl_key_pressed(KEY_D) { turn = -1; }  // right = CW

      // Wait: '.' or Space advances one tick in place (enemies act, you don't move).
      w_down = graphics::gl_key_pressed(KEY_DOT) || graphics::gl_key_pressed(KEY_SPC);
      if w_down && !w_was { sim_wait(s); }
      w_was = w_down;

      // Grab: 'g' picks up items under the player (gold auto-collects on walk-over).
      g_down = graphics::gl_key_pressed(KEY_G);
      if g_down && !g_was { sim_pickup(s); }
      g_was = g_down;

      sim_step(s, fwd, turn, dt);
      if sim_over(s) {              // death is not permadeath: respawn at the last save point
        s = sim_respawn(s);
        walls = build_walls(s);
        hud = build_hud(s);
        graphics::gl_delete_vao(wvao);
        wvao = build_world_vbo(s);
        (sq, sr) = sim_player_hex(s);   // re-arm on the respawn stair
      } else {
        // Walk onto a stair to change level. Edge-trigger: fire only when ENTERING
        // a new hex that is a stair, so arriving ON the destination stair doesn't
        // bounce you straight back (you step off, then re-entering fires again).
        (cq, cr) = sim_player_hex(s);
        if cq != sq || cr != sr {
          stt = sim_stair_under(s);
          if stt == 2 || stt == 6 {           // '>' down (6 = a natural cave mouth)
            s = sim_descend(s, 1);
            walls = build_walls(s);
            hud = build_hud(s);
            graphics::gl_delete_vao(wvao);
            wvao = build_world_vbo(s);
            (sq, sr) = sim_player_hex(s);     // arm on the arrival stair
          } else if stt == 3 && sim_depth(s) > 1 {   // '<' up (no overworld above depth 1 yet)
            s = sim_descend(s, -1);
            walls = build_walls(s);
            hud = build_hud(s);
            graphics::gl_delete_vao(wvao);
            wvao = build_world_vbo(s);
            (sq, sr) = sim_player_hex(s);
          } else if sim_depth(s) == 0 && sim_edge_exit(s) != 0 {
            // the wilderness continues: walking off the window edge crosses over
            s = sim_travel(s);
            walls = build_walls(s);
            hud = build_hud(s);
            graphics::gl_delete_vao(wvao);
            wvao = build_world_vbo(s);
            (sq, sr) = sim_player_hex(s);
          } else {
            sq = cq;
            sr = cr;
          }
        }
      }
      }
      // The shrine: bumping the spawning crystal raises the INTERACT event -> the crystal page.
      if sim_shrine_pending(s) == 1 {
        sim_shrine_clear(s);
        crys_open = true;
        page_open = false;
        inv_open = false;
        crys_col = 0;
        crys_cur = 0;
        pg_crys = build_crystalpage(s, hud.font, crys_col, crys_cur);
      }
      sim_compute_fov(s);          // directed-light FOV: recompute visibility for this frame
      // Rebake the message log only when a new line arrived (combat, pickup, level, descend, …).
      tot = sim_msg_total(s);
      if tot != last_total {
        free_msglog(ml);
        ml = build_msglog(s, hud.font);
        last_total = tot;
      }
      // Re-bake the quick-slot item names only when an identification changed what they show.
      kn = sim_known_count(s);
      if kn != last_known {
        hud.itex = hud_rebuild_items(hud, s);
        last_known = kn;
      }
      view_draw(painter, s, walls, hud, wprog, wvao);
      draw_msglog(painter, s, hud, ml);
      if page_open { draw_charpage(painter, s, hud, pg); }
      else if inv_open { draw_invpage(painter, s, hud, pg_inv, inv_cursor); }
      else if crys_open { draw_crystalpage(painter, s, hud, pg_crys, crys_col, crys_cur); }
      graphics::gl_swap_buffers();
    }
  }
  graphics::gl_destroy_window();
}
