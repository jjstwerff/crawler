// story — M0 vertical slice entry point.
//
// Opens a window, runs the frame loop, maps analog WASD input into kernel
// intents, and draws the egocentric 2D view. The kernel (sim/hexgeo) is the
// reusable core; this file and view.loft are the swappable 2D front-end.
//
// Controls: W glide forward · S glide back · A/D turn (free) · walk onto a
// stair to change level (no button) · . / Space wait · g grab · Esc quit.
// E and Q are intentionally FREE — reserved for upcoming character actions
// (fire arrow / cast spell); that's why stairs are taken by walking, not a key.

use graphics;
use sim;
use wallgeo;
use view;
use itemfx;

WIN_W   = 800;
WIN_H   = 600;
KEY_W   = 119;
KEY_S   = 115;
KEY_A   = 97;
KEY_D   = 100;
KEY_G   = 103;      // 'g' grab items under you (gold auto-collects)
KEY_DOT = 46;       // '.' wait one tick
KEY_SPC = 32;       // Space — also wait
KEY_ESC = 27;
KEY_C   = 99;       // 'c' — open/close the character page
KEY_I   = 105;      // 'i' — open/close the inventory page
KEY_1   = 49;       // '1'..'9' — character page: spend a stat point; inventory: use/wield item N

GEN_SEED  = 1337;   // world-key seed for this dungeon (deterministic gen)
GEN_DEPTH = 0;      // start on the SURFACE (depth 0 = the open desert + the dungeon entrance);
                    // walk onto the entrance to descend into the dungeon (depth 1: rats/bats/…)

// Stat name for the character page's 1-6 keys (index 0..5 -> STR..CHR).
fn stat_name(i: integer) -> text {
  if i == 0 { return "str"; }
  if i == 1 { return "int"; }
  if i == 2 { return "wis"; }
  if i == 3 { return "dex"; }
  if i == 4 { return "con"; }
  "chr"
}

fn main() {
  if !graphics::gl_create_window(WIN_W, WIN_H, "story — M0") {
    println("story: failed to create window");
    return;
  }
  painter = graphics::create_painter_2d(WIN_W as float, WIN_H as float);
  // The window enables GL_DEPTH_TEST by default, and 2D quads all share one
  // z — so with depth-test on, the FIRST quad drawn to a pixel wins (terrain
  // would occlude the player; a full-screen backdrop would occlude the whole
  // world -> black). Disable it for normal last-drawn-on-top painting, and
  // enable blending for alpha. (Same setup brick-buster uses.)
  graphics::gl_disable(graphics::GL_DEPTH_TEST);
  graphics::gl_enable(graphics::GL_BLEND);
  graphics::gl_blend_func(graphics::BLEND_SRC_ALPHA, graphics::BLEND_ONE_MINUS_SRC_ALPHA);
  s = sim_new_gen(GEN_SEED, GEN_DEPTH);   // procedural dungeon + DB monsters
  walls = build_walls(s);   // smoothed wall outline, built once (static per level)
  hud = build_hud(s);       // load font + bake glyph/HUD textures (after window)
  wprog = make_world_shader();   // GPU terrain shader (global, built once)
  wvao = build_world_vbo(s);     // GPU terrain VBO (rebuilt on each level change)
  last = ticks();
  w_was = false;            // edge-trigger for the wait key
  g_was = false;            // edge-trigger for the grab key
  page_open = false;        // character page overlay (C): pauses the world while open
  pg: vector<integer> = []; // baked character-page line textures (rebuilt on open + each spend)
  c_was = false;            // edge-trigger for the page toggle
  spend_was = false;        // edge-trigger for the 1-9 number keys (shared by both pages)
  inv_open = false;         // inventory overlay (I): also pauses the world
  pg_inv: vector<integer> = [];   // baked inventory line textures (rebuilt on open + use/wield)
  i_was = false;            // edge-trigger for the inventory toggle
  (sq, sr) = sim_player_hex(s);   // stair-hex tracker: armed on the start stair so
                                  // standing on it doesn't fire (walk-onto edge-trigger)
  running = true;
  while running {
    if !graphics::gl_poll_events() {
      running = false;
    } else if graphics::gl_key_pressed(KEY_ESC) {
      running = false;
    } else {
      tnow = ticks();
      dt = (tnow - last) as float / 1000000.0;
      last = tnow;
      if dt > 0.05 { dt = 0.05; }

      // Character page (C): toggle the overlay. While open the world is PAUSED and the number
      // keys 1-6 spend banked stat points (the deferred, player-chosen level-up).
      c_down = graphics::gl_key_pressed(KEY_C);
      if c_down && !c_was {
        page_open = !page_open;
        if page_open { inv_open = false; pg = build_charpage(s, hud.font); }
      }
      c_was = c_down;

      i_down = graphics::gl_key_pressed(KEY_I);
      if i_down && !i_was {
        inv_open = !inv_open;
        if inv_open { page_open = false; pg_inv = build_invpage(s, hud.font); }
      }
      i_was = i_down;

      if page_open || inv_open {
        sd = -1;
        for ki in 0..9 {
          if graphics::gl_key_pressed(KEY_1 + ki) { sd = ki; }
        }
        sdn = sd >= 0;
        if sdn && !spend_was {
          if page_open && sd < 6 {
            if sim_raise_stat(s, stat_name(sd)) { pg = build_charpage(s, hud.font); }
          } else if inv_open && sd < sim_inv_count(s) {
            if !use_item(s, sd) { sim_equip(s, sd); }   // consumable -> use; else wield
            pg_inv = build_invpage(s, hud.font);
          }
        }
        spend_was = sdn;
      } else {
        spend_was = false;

      fwd = 0;
      turn = 0;
      if graphics::gl_key_pressed(KEY_W) { fwd = 1; }
      if graphics::gl_key_pressed(KEY_S) { fwd = -1; }
      if graphics::gl_key_pressed(KEY_A) { turn = 1; }   // left  = CCW (heading up)
      if graphics::gl_key_pressed(KEY_D) { turn = -1; }  // right = CW

      // Wait: '.' or Space advances one tick in place (enemies act, you don't move).
      w_down = graphics::gl_key_pressed(KEY_DOT) || graphics::gl_key_pressed(KEY_SPC);
      if w_down && !w_was { sim_wait(s); }
      w_was = w_down;

      // Grab: 'g' picks up items under the player (gold auto-collects on walk-over).
      g_down = graphics::gl_key_pressed(KEY_G);
      if g_down && !g_was { sim_pickup(s); }
      g_was = g_down;

      sim_step(s, fwd, turn, dt);
      if sim_over(s) {              // death is not permadeath: respawn at the last save point
        s = sim_respawn(s);
        walls = build_walls(s);
        hud = build_hud(s);
        graphics::gl_delete_vao(wvao);
        wvao = build_world_vbo(s);
        (sq, sr) = sim_player_hex(s);   // re-arm on the respawn stair
      } else {
        // Walk onto a stair to change level. Edge-trigger: fire only when ENTERING
        // a new hex that is a stair, so arriving ON the destination stair doesn't
        // bounce you straight back (you step off, then re-entering fires again).
        (cq, cr) = sim_player_hex(s);
        if cq != sq || cr != sr {
          stt = sim_stair_under(s);
          if stt == 2 {                       // '>' down
            s = sim_descend(s, 1);
            walls = build_walls(s);
            hud = build_hud(s);
            graphics::gl_delete_vao(wvao);
            wvao = build_world_vbo(s);
            (sq, sr) = sim_player_hex(s);     // arm on the arrival stair
          } else if stt == 3 && sim_depth(s) > 1 {   // '<' up (no overworld above depth 1 yet)
            s = sim_descend(s, -1);
            walls = build_walls(s);
            hud = build_hud(s);
            graphics::gl_delete_vao(wvao);
            wvao = build_world_vbo(s);
            (sq, sr) = sim_player_hex(s);
          } else {
            sq = cq;
            sr = cr;
          }
        }
      }
      }
      sim_compute_fov(s);          // directed-light FOV: recompute visibility for this frame
      view_draw(painter, s, walls, hud, wprog, wvao);
      if page_open { draw_charpage(painter, s, hud, pg); }
      else if inv_open { draw_invpage(painter, s, hud, pg_inv); }
      graphics::gl_swap_buffers();
    }
  }
  graphics::gl_destroy_window();
}
