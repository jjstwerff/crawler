// meshtest — the kernel-side terrain mesh (PLAN-RENDER P2 / RENDER.md R4): the
// vertex-count invariant holds, wall hexes keep the wall tone, dungeon floors
// (kind -1) stay untinted, and a surface sand hex carries the EXACT pre-composed
// tint — expected values hardcoded from the design numbers (floor 0.80/0.745/0.59,
// sand tint 0.86/0.78/0.55 @ a=0.50 → 0.83/0.7625/0.57), an independent oracle,
// not the bake formula re-run. Headless, deterministic.
use sim;
use worldmesh;
use wallgeo;
use hex_grid;
use overland;

// Color floats ride the mesh as singles; compare against float literals loosely.
fn near(a: float, b: float) -> boolean {
  d = a - b;
  d < 0.0005 && d > -0.0005
}

// The color triple of hex (gq,gr) in grid coords: first vertex of its fan,
// stride 10, color at offset 6.
fn hex_color(buf: vector<single>, s: Sim, gq: integer, gr: integer) -> (float, float, float) {
  base = ((gr * s.lw) + gq) * 180;
  ((buf[base + 6] ?? 0.0) as float, (buf[base + 7] ?? 0.0) as float, (buf[base + 8] ?? 0.0) as float)
}

fn main() {
  println("=== story world-mesh test (R4 tint bake: counts + exact colors) ===");

  // ── The dungeon (depth 1, kind -1 everywhere): counts + untinted tones ──
  d = sim_new_gen(1337, 1);
  dbuf = build_world_mesh(d);
  count_ok = len(dbuf) == 180 * d.lw * d.lh;
  println("count={count_ok} ({len(dbuf)} floats for {d.lw}x{d.lh})");

  // find one floor and one wall hex; their colors are the plain design tones
  floor_ok = false;
  wall_ok = false;
  for gr in 0..d.lh {
    for gq in 0..d.lw {
      t = tile_at(d, d.qmin + gq, d.rmin + gr);
      (cr, cg, cb) = hex_color(dbuf, d, gq, gr);
      if t == 0 && !floor_ok {
        floor_ok = near(cr, 0.80) && near(cg, 0.745) && near(cb, 0.59);
      }
      if t == 1 && !wall_ok {
        wall_ok = near(cr, 0.15) && near(cg, 0.14) && near(cb, 0.13);
      }
    }
  }
  println("dungeon-floor-untinted={floor_ok} wall-tone={wall_ok}");

  // ── The surface (depth 0): a sand hex carries the exact pre-composed mix ──
  s = sim_new_gen(1337, 0);
  sbuf = build_world_mesh(s);
  sand_ok = false;
  face_dark = true;
  for gr in 0..s.lh {
    for gq in 0..s.lw {
      q = s.qmin + gq;
      r = s.rmin + gr;
      k = sim_tile_kind(s, q, r);
      t2 = tile_at(s, q, r);
      (cr2, cg2, cb2) = hex_color(sbuf, s, gq, gr);
      if t2 == 0 && k == K_SAND && !sand_ok {
        sand_ok = near(cr2, 0.83) && near(cg2, 0.7625) && near(cb2, 0.57);
      }
      // every impassable hex keeps the wall tone — faces/water never tint
      if t2 == 1 && face_dark {
        face_dark = near(cr2, 0.15) && near(cg2, 0.14) && near(cb2, 0.13);
      }
    }
  }
  println("sand-exact={sand_ok} impassable-wall-tone={face_dark}");

  // ── R5 wall-stroke quads (P3): exact corners + capsule locals + the midpoint
  //    hex's vis texel. One synthetic segment through the player hex center —
  //    expected values hand-computed (e = halfw+aa = 0.09 + 1/26 = 0.1284615…).
  (pq, pr) = sim_player_hex(d);
  (cx, cy) = hex_to_px(pq, pr);
  wsegs: vector<WallSeg> = [WallSeg { ax: cx - 1.0, ay: cy, bx: cx + 1.0, by: cy }];
  wbuf = build_wall_mesh(d, wsegs);
  e = 0.1284615384615;
  six_verts = len(wbuf) == 60;
  c0 = near((wbuf[0] ?? 0.0) as float, cx - 1.0 - e) && near((wbuf[1] ?? 0.0) as float, cy - e);
  c2 = near((wbuf[20] ?? 0.0) as float, cx + 1.0 + e) && near((wbuf[21] ?? 0.0) as float, cy + e);
  locals_ok = near((wbuf[3] ?? 0.0) as float, 0.0 - e)     // u0 = -e
           && near((wbuf[4] ?? 0.0) as float, 0.0 - e)     // v  = -e
           && near((wbuf[5] ?? 0.0) as float, 2.0)         // len
           && near((wbuf[8] ?? 0.0) as float, 0.09)        // halfw
           && near((wbuf[9] ?? 0.0) as float, 0.0384615);  // aa
  evu = ((pq - d.qmin) as float + 0.5) / (d.lw as float) ?? 0.0;
  vis_ok = near((wbuf[6] ?? 0.0) as float, evu);
  wallmesh_ok = six_verts && c0 && c2 && locals_ok && vis_ok;
  println("wallmesh: verts={six_verts} corners={c0}/{c2} locals={locals_ok} visuv={vis_ok}");

  // ── R7 instanced floor (P6): the base hexagon + per-hex instance records.
  //    Independent oracles — base hexagon = 18 verts of EXACT lattice/world
  //    offsets; instance count = 7·lw·lh; column=q+0.5·(r&1), row_y=1.5·r; the
  //    instance color == the fat mesh's color for the same hex (the shared bake).
  hexoff = build_hex_offsets();
  base_ok = len(hexoff) == 54
         && near((hexoff[0] ?? 9.0) as float, 0.0)        // fan centre x
         && near((hexoff[1] ?? 9.0) as float, 0.0)        // fan centre y
         && near((hexoff[3] ?? 9.0) as float, 0.0)        // corner0 dx = 0
         && near((hexoff[4] ?? 9.0) as float, 1.0)        // corner0 dy = 1
         && near((hexoff[6] ?? 9.0) as float, 0.0 - 0.5)  // corner1 dx = -0.5
         && near((hexoff[7] ?? 9.0) as float, 0.5);       // corner1 dy = 0.5
  println("base-hexagon: {base_ok} ({len(hexoff)} floats)");

  ibuf = build_world_instances(d);
  icount_ok = len(ibuf) == 7 * d.lw * d.lh;
  // lattice anchors + color parity for hex (gq=1, gr=1) — oracles computed here
  iq = d.qmin + 1; ir = d.rmin + 1;
  ipar = ir & 1;
  exp_col = (iq as float) + 0.5 * (ipar as float);
  exp_row = 1.5 * (ir as float);
  ib = ((1 * d.lw) + 1) * 7;
  lat_ok = near((ibuf[ib + 0] ?? 0.0) as float, exp_col)
        && near((ibuf[ib + 1] ?? 0.0) as float, exp_row);
  (fr, fg, fb) = hex_color(dbuf, d, 1, 1);                // the fat mesh's color
  icol_ok = near((ibuf[ib + 4] ?? 0.0) as float, fr)
         && near((ibuf[ib + 5] ?? 0.0) as float, fg)
         && near((ibuf[ib + 6] ?? 0.0) as float, fb);
  inst_ok = base_ok && icount_ok && lat_ok && icol_ok;
  println("instances: count={icount_ok} lattice={lat_ok} color-parity={icol_ok}");

  if count_ok && floor_ok && wall_ok && sand_ok && face_dark && wallmesh_ok && inst_ok {
    println("=== MESH OK ===");
  } else {
    println("=== MESH FAILED ===");
  }
}
