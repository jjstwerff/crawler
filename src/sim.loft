// sim — the renderer-agnostic roguelike kernel (M0).
//
// Continuous player (position + heading) over a hex tile grid; hex-locked
// enemies; a distance-driven clock: every HEX_LEN of player travel = one tick,
// turning costs no distance and therefore no time.  NO graphics dependency.

use hexgeo;
use gen;
use monsters;
use items;

MOVE_SPEED = 6.0;     // world units / second (brisk, Angband-paced; clock is distance)
TURN_SPEED = 2.6;     // radians / second
PLAYER_RADIUS = 0.45; // collision radius; ~half the marker, < hex apothem (0.866)
PLAYER_DAM = 6;       // player base melee damage per hit (before the level-ratio cap)
COMBAT_DELTA_CAP = 8; // level gap beyond which raw level stops mattering in combat (§3a #2)
COMBAT_STEP = 6;      // % damage per level of (capped) gap — at most ±48%: level alone can't win/lose a fight
FLOW_BIG   = 1000000; // unreachable / unset distance in the flow field
HERO_CON   = 16;      // starting Constitution (full stat block = H2; HP is class-uniform, not con-driven)
HERO_HP_BASE      = 28; // base max HP — identical for every class (fair); armour adds HP% (G3, §3a #3)
HERO_HP_PER_LEVEL = 2;  // gentle per-level HP (§3a #2): whole-game span a few×, not 10×+
MAX_CLEVEL = 50;      // character-level cap
FLOOR_MAX  = 64;      // floor-item slots per level (fixed array — see LOFT_ISSUES)
INV_MAX    = 64;      // inventory slots
NUM_SLOTS  = 12;      // equipment slots, indexed by SLOT_* (0 = SLOT_NONE, 11 = SLOT_AMULET)
SAVE_INTERVAL = 3;    // a save-point level every 3 levels (depth 1, 4, 7, …) — checkpoint respawn
GRAVE_PCT  = 50;      // % of gold left on a grave at the death spot (Souls stake — §3a #5)
VISION_RADIUS = 10;   // FOV radius DIRECTLY AHEAD — a directed lamp; later from the equipped light
NEAR_RADIUS = 1;      // always-visible bubble (own + adjacent); also the sight radius behind you

// Fresh zero-filled int vector of length n (build-time append to a local works;
// runtime append to a struct field does not — so floor/inv use fixed arrays).
fn zeros(n: integer) -> vector<integer> {
  v: vector<integer> = [];
  for _ in 0..n { v += [0]; }
  v
}

pub struct Enemy {
  cur_q: integer not null,
  cur_r: integer not null,
  tgt_q: integer not null,
  tgt_r: integer not null,
  hp:    integer not null,
  maxhp: integer not null,
  dam:   integer not null,
  xp:     integer not null,   // experience awarded on death (m_xp)
  mlvl:   integer not null,   // native level (m_depth) — scales the kill XP
  vision: integer not null,   // aggro / detection range in hexes (from the DB)
  flags:  integer not null,   // MF_* bitmask (from the DB)
  awake:  boolean not null,   // false = asleep: won't act until it perceives you
  cr:    integer not null,    // display colour 0..255 (from the monster DB)
  cg:    integer not null,
  cb:    integer not null,
  glyph: text,                // single-char map symbol (e.g. "r", "k", "o")
  alive: boolean not null,
}

pub struct Sim {
  lw:      integer not null,
  lh:      integer not null,
  qmin:    integer not null,
  rmin:    integer not null,
  tiles:   vector<integer> not null,   // hex kind: 0 floor, 1 solid full-hex wall
  walls:   vector<integer> not null,   // edge walls: idx = hex*3 + edge(0=N,1=NE,2=SE)
  seen:    vector<integer> not null,   // FOV memory: 1 = hex ever seen (revealed map; lost on death)
  vis:     vector<integer> not null,   // FOV current: 1 = hex visible this frame (recomputed)
  px:      float not null,
  py:      float not null,
  heading: float not null,             // radians; forward = (cos,sin)
  accrued: float not null,             // remainder distance in [0, HEX_LEN)
  ticks:   integer not null,
  enemies: vector<Enemy> not null,
  php:     integer not null,   // player hit points
  phpmax:  integer not null,
  over:    boolean not null,   // game over (player died)
  clevel:  integer not null,   // character level (1..MAX_CLEVEL)
  xp:      integer not null,   // experience points
  gold:    integer not null,   // gold (income arrives with items, I1)
  hcon:    integer not null,   // Constitution — drives HP growth
  depth:   integer not null,   // dungeon level (1 = shallowest)
  save_depth: integer not null,   // checkpoint: deepest save-point level reached (respawn target)
  grave_depth: integer not null,  // death-stake grave: depth / hex / gold (0 gold = no grave).
  grave_q:     integer not null,  //   SP keeps one grave (re-death forfeits it); MP would hold a
  grave_r:     integer not null,  //   list (owner-less, persistent) — a later, non-rewrite variant.
  grave_gold:  integer not null,
  wseed:   integer not null,   // world seed (per-level gen seed = mix(wseed, depth))
  up_q:    integer not null,   // up-stair hex (player start / arrival from below)
  up_r:    integer not null,
  dn_q:    integer not null,   // down-stair hex
  dn_r:    integer not null,
  rstate:  integer not null,   // drop RNG state
  ninv:    integer not null,   // inventory count
  inv:     vector<integer> not null,   // carried item def indices [0..ninv) (UI = I2)
  eq:      vector<integer> not null,   // equipped item: defidx+1 per SLOT_* slot (0 = empty)
  wdam:    integer not null,           // cached melee damage (PLAYER_DAM + equipped weapon)
  pac:     integer not null,           // cached armour class (sum equipped i_ac) — feeds HP + DR
  fi_n:    integer not null,   // floor-item count
  fi_q:    vector<integer> not null,   // floor items — hex position [0..fi_n)
  fi_r:    vector<integer> not null,
  fi_gold: vector<integer> not null,   // gold amount (>0 = gold pile, 0 = an item)
  fi_cat:  vector<integer> not null,   // item category (IT_*); -1 for gold
  fi_def:  vector<integer> not null,   // item def index; -1 for gold
  fi_live: vector<integer> not null,   // 1 = on the floor, 0 = collected
  room_q0: vector<integer> not null,   // room rects (axial) — wall straightener snaps to their
  room_r0: vector<integer> not null,   //   exact rhombus side-lines; empty = pure-smooth fallback
  room_w:  vector<integer> not null,
  room_h:  vector<integer> not null,
}

// ── World queries ────────────────────────────────────────────────────

pub fn tile_at(s: Sim, q: integer, r: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 1;
  }
  tiles = s.tiles;
  ti = (r - s.rmin) * s.lw + (q - s.qmin);
  if ti < len(tiles) { tiles[ti] } else { 1 }
}

pub fn is_wall(s: Sim, q: integer, r: integer) -> boolean {
  tile_at(s, q, r) == 1
}

// Read a stored canonical edge wall directly (edge 0=N,1=NE,2=SE on this hex).
pub fn edge_wall_raw(s: Sim, q: integer, r: integer, edge: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 0;
  }
  ws = s.walls;
  ei = ((r - s.rmin) * s.lw + (q - s.qmin)) * 3 + edge;
  if ei < len(ws) { ws[ei] } else { 0 }
}

// Wall value on the edge leaving (q,r) in direction `dir` (resolves the
// canonical owner: dirs 3,4,5 read the neighbour's edge).
pub fn edge_wall(s: Sim, q: integer, r: integer, dir: integer) -> integer {
  (oq, owr, oe) = canon_edge(q, r, dir);
  edge_wall_raw(s, oq, owr, oe)
}

// Is a single-hex step from (q1,r1) to (q2,r2) blocked? Blocked if the
// target is a solid full-hex wall (or out of bounds), or an edge wall sits
// on the shared edge.
pub fn is_blocked_move(s: Sim, q1: integer, r1: integer, q2: integer, r2: integer) -> boolean {
  if is_wall(s, q2, r2) { return true; }
  bd = neighbor_dir(q1, r1, q2, r2);
  if bd < 0 { return false; }
  edge_wall(s, q1, r1, bd) != 0
}

// Can the player's centre at (fromx,fromy) advance so its probe point lands at
// (tox,toy)?  Returns true if that probe enters a solid hex, an enemy hex, or
// crosses a walled edge.  Used per-axis with the probe offset one radius ahead.
fn pos_blocked(s: Sim, fromx: float, fromy: float, tox: float, toy: float) -> boolean {
  (aq, ar) = px_to_hex(fromx, fromy);
  (bq, br) = px_to_hex(tox, toy);
  if enemy_blocks(s, bq, br) { return true; }
  if aq == bq && ar == br { return is_wall(s, bq, br); }
  is_blocked_move(s, aq, ar, bq, br)
}

fn enemy_blocks(s: Sim, q: integer, r: integer) -> boolean {
  enemies = s.enemies;
  hit = false;
  for eb in 0..len(enemies) {
    e = enemies[eb];
    if e.alive && ((e.cur_q == q && e.cur_r == r) || (e.tgt_q == q && e.tgt_r == r)) {
      hit = true;
    }
  }
  hit
}

// Breadth-first distance field from (pq,pr) over reachable hexes (respecting
// solid hexes AND edge walls via is_blocked_move). flow[idx] = path length to
// the player; FLOW_BIG = unreachable. Recomputed each tick; monsters descend it
// to route around walls (vs. the old greedy step that stuck on corners).
fn compute_flow(s: Sim, pq: integer, pr: integer) -> vector<integer> {
  n = s.lw * s.lh;
  flow: vector<integer> = [];
  for _ in 0..n { flow += [FLOW_BIG]; }
  if pq >= s.qmin && pr >= s.rmin && pq < s.qmin + s.lw && pr < s.rmin + s.lh && !is_wall(s, pq, pr) {
    start = (pr - s.rmin) * s.lw + (pq - s.qmin);
    if start >= 0 && start < len(flow) { flow[start] = 0; }
    frontier: vector<integer> = [];
    frontier += [start];
    head = 0;
    while head < len(frontier) {
      cur = frontier[head] ?? 0;
      head += 1;
      cq = s.qmin + (cur % s.lw ?? 0);
      cr = s.rmin + (cur / s.lw ?? 0);
      cd = flow[cur] ?? FLOW_BIG;
      for fdir in 0..6 {
        (nq, nr) = hex_neighbor(cq, cr, fdir);
        if nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh && !is_blocked_move(s, cq, cr, nq, nr) {
          nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
          if nidx >= 0 && nidx < len(flow) {
            cn = flow[nidx] ?? FLOW_BIG;
            if cn > cd + 1 {
              flow[nidx] = cd + 1;
              frontier += [nidx];
            }
          }
        }
      }
    }
  }
  flow
}

// One step DOWN the flow gradient toward the player (routes around walls);
// never steps onto the player's own hex. Stays put if nothing is closer.
fn flow_step(s: Sim, flow: vector<integer>, eq: integer, er: integer, pq: integer, pr: integer) -> (integer, integer) {
  bq = eq;
  br = er;
  bestd = FLOW_BIG;
  if eq >= s.qmin && er >= s.rmin && eq < s.qmin + s.lw && er < s.rmin + s.lh {
    ci = (er - s.rmin) * s.lw + (eq - s.qmin);
    bestd = flow[ci] ?? FLOW_BIG;
  }
  for sdir in 0..6 {
    (nq, nr) = hex_neighbor(eq, er, sdir);
    if !is_blocked_move(s, eq, er, nq, nr) && !(nq == pq && nr == pr) && nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh {
      nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
      nd = flow[nidx] ?? FLOW_BIG;
      if nd < bestd { bestd = nd; bq = nq; br = nr; }
    }
  }
  (bq, br)
}

// ── Combat ───────────────────────────────────────────────────────────

// Nearest live enemy that is close (adjacent-ish) and ahead of the heading —
// the melee target when pressing forward into it. Returns its index, or -1.
fn front_enemy(s: Sim) -> integer {
  fx = cos(s.heading);
  fy = sin(s.heading);
  reach = HEX_LEN * 1.3;
  best = -1;
  bestd = reach * reach;
  enemies = s.enemies;
  for fe in 0..len(enemies) {
    e = enemies[fe];
    if e.alive {
      (ecx, ecy) = hex_to_px(e.cur_q, e.cur_r);
      rx = ecx - s.px;
      ry = ecy - s.py;
      d2 = rx * rx + ry * ry;
      dot = rx * fx + ry * fy;
      if dot > 0.0 && d2 <= bestd { bestd = d2; best = fe; }
    }
  }
  best
}

// ── Hero progression (XP / level / HP) ───────────────────────────────

// Max HP at a character level. Class-INDEPENDENT by design: every class gets the
// same HP (fair progression — §3a #3). Tankiness is lateral gear, not a class lock:
// heavy/metal armour adds HP% (and raises spell-cost%) in G3. Gentle curve (§3a #2):
// modest per-level growth so a run spans a few×, not 10×+.
fn hero_maxhp(clevel: integer) -> integer {
  HERO_HP_BASE + clevel * HERO_HP_PER_LEVEL
}

// Total XP required to be AT a character level (quadratic growth).
fn xp_for_level(lvl: integer) -> integer {
  if lvl <= 1 { return 0; }
  (lvl - 1) * (lvl - 1) * 10
}

// ── Equipment (G3): wield items; effects feed combat + HP ────────────
// Equipment is lateral progression (§3a #3): a weapon raises melee damage, armour
// adds HP and reduces incoming damage. Derived stats are cached (wdam/pac) and
// refreshed only on equip/unequip/level-up, so combat reads fields — not item_table —
// per hit. (Percentage / typed-resist modifiers + the metal/cloth spell-cost axis
// layer on later; this slice is the wield mechanic + flat weapon/armour effects.)

// Recompute cached weapon damage, armour class, and max HP from the equipped slots.
// Same module as its &-callers (C4). AC feeds BOTH max HP (heavy armour = tanky — the
// fighter's compensation, §3a #3) and damage reduction.
fn refresh_stats(s: &Sim) {
  itbl = item_table();
  eq = s.eq;
  ac = 0;
  for sl in 0..NUM_SLOTS {
    e = eq[sl] ?? 0;
    if e > 0 { ac += item_ac(itbl, e - 1); }
  }
  wd = PLAYER_DAM;
  w = eq[SLOT_WEAPON] ?? 0;
  if w > 0 {
    dd = item_dd(itbl, w - 1);
    ds = item_ds(itbl, w - 1);
    if dd > 0 && ds > 0 { wd += dd * (ds + 1) / 2 ?? 0; }   // average weapon roll
  }
  s.wdam = wd;
  s.pac = ac;
  oldmax = s.phpmax;
  newmax = hero_maxhp(s.clevel) + ac;
  if newmax > oldmax { s.php += newmax - oldmax; }   // donning armour grants the HP
  if s.php > newmax { s.php = newmax; }
  if s.php < 1 { s.php = 1; }
  s.phpmax = newmax;
}

// Reduce an incoming hit by armour class as a never-100% percentage (§3a #2/#3:
// nothing fully negated): dmg * 100 / (100 + ac), floored at 1.
fn apply_dr(dmg: integer, ac: integer) -> integer {
  v = dmg * 100 / (100 + ac) ?? dmg;
  if v < 1 { v = 1; }
  v
}

// Equip the inventory item at index `ii` into its slot; any displaced item returns to
// that inventory slot, else the slot is removed (compacted). Recomputes stats.
pub fn sim_equip(s: &Sim, ii: integer) {
  iv = s.inv;
  if ii < 0 || ii >= s.ninv || ii >= len(iv) { return; }
  defidx = iv[ii] ?? -1;
  if defidx < 0 { return; }
  itbl = item_table();
  sl = item_slot(itbl, defidx);
  eq = s.eq;
  if sl <= 0 || sl >= len(eq) { return; }   // not wieldable / out of range
  prev = eq[sl] ?? 0;
  if sl < len(eq) { eq[sl] = defidx + 1; }
  if prev > 0 {
    if ii < len(iv) { iv[ii] = prev - 1; }   // swap: displaced item takes the slot
  } else {
    n = s.ninv;
    for k in ii..(n - 1) {
      if k >= 0 && k + 1 < len(iv) { iv[k] = iv[k + 1] ?? -1; }   // remove: shift down
    }
    s.ninv = n - 1;
  }
  refresh_stats(s);
}

// Unequip slot `sl` back to inventory (if room). Recomputes stats.
pub fn sim_unequip(s: &Sim, sl: integer) {
  eq = s.eq;
  if sl <= 0 || sl >= len(eq) { return; }
  e = eq[sl] ?? 0;
  if e == 0 { return; }
  iv = s.inv;
  n = s.ninv;
  if n >= 0 && n < len(iv) {
    iv[n] = e - 1;
    s.ninv = n + 1;
  }
  if sl < len(eq) { eq[sl] = 0; }
  refresh_stats(s);
}

// Seed the class-as-kit starting loadout (BUNDLE.md): a dagger + soft leather armour,
// equipped. A single generic kit for now; per-class kits arrive with classes.
pub fn sim_starting_loadout(s: &Sim) {
  itbl = item_table();
  di = item_index(itbl, "dagger");
  ai = item_index(itbl, "soft_leather_armor");
  eq = s.eq;
  if di >= 0 && SLOT_WEAPON < len(eq) { eq[SLOT_WEAPON] = di + 1; }
  if ai >= 0 && SLOT_BODY < len(eq) { eq[SLOT_BODY] = ai + 1; }
  refresh_stats(s);
}

// Award XP and level up while the threshold is met; each level refreshes derived
// stats (max HP grows by the gentle per-level step; current HP gains the delta).
pub fn sim_award_xp(s: &Sim, amount: integer) {
  if amount > 0 { s.xp += amount; }
  while s.clevel < MAX_CLEVEL && s.xp >= xp_for_level(s.clevel + 1) {
    s.clevel += 1;
    refresh_stats(s);
  }
}

// ── Loot (gold + item drops) ─────────────────────────────────────────

// Drop-RNG: advance the per-Sim LCG (same module as its caller, so the `&`
// mutation sticks) and return a value in [lo, hi].
fn sim_roll(s: &Sim, lo: integer, hi: integer) -> integer {
  if hi <= lo { return lo; }
  s.rstate = (s.rstate * 1103515245 + 12345) & 2147483647;
  lo + (s.rstate % (hi - lo + 1) ?? 0)
}

// Add a floor entry (gold pile if gold>0, else an item with cat/def) by writing
// into the fixed arrays at the count slot — runtime append to a struct field is
// unreliable in loft, so we index-write like `enemies`.
fn add_floor(s: &Sim, q: integer, r: integer, gold: integer, cat: integer, def: integer) {
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fc = s.fi_cat;
  fd = s.fi_def;
  fl = s.fi_live;
  n = s.fi_n;
  if n >= 0 && n < len(fq) && n < len(fr) && n < len(fg) && n < len(fc) && n < len(fd) && n < len(fl) {
    fq[n] = q;
    fr[n] = r;
    fg[n] = gold;
    fc[n] = cat;
    fd[n] = def;
    fl[n] = 1;
    s.fi_n = n + 1;
  }
}

// On a kill: drop a gold pile, and sometimes a depth-appropriate item, at (q,r).
fn drop_loot(s: &Sim, q: integer, r: integer, mlvl: integer) {
  gamt = sim_roll(s, 1, 3) * (mlvl + 1) + sim_roll(s, 0, 4);
  add_floor(s, q, r, gamt, -1, -1);
  if sim_roll(s, 0, 99) < 35 {
    itbl = item_table();
    idx = item_choose_idx(itbl, s.depth, sim_roll(s, 1, 2000000000));
    if idx >= 0 {
      cat = item_cat(itbl, idx);
      add_floor(s, q, r, 0, cat, idx);
    }
  }
}

// Combat damage multiplier (percent) from the attacker↔defender level gap, capped
// BOTH ways: past ±COMBAT_DELTA_CAP levels the gap stops mattering, so level shifts a
// fight by at most ±(CAP*STEP)% — difficulty is skill, not level (§3a #2). Symmetric:
// mult(a,b) + mult(b,a) == 200. Monsters attack through the SAME function (the mirror).
pub fn combat_mult_pct(att_lvl: integer, def_lvl: integer) -> integer {
  d = att_lvl - def_lvl;
  if d > COMBAT_DELTA_CAP { d = COMBAT_DELTA_CAP; }
  if d < 0 - COMBAT_DELTA_CAP { d = 0 - COMBAT_DELTA_CAP; }
  100 + d * COMBAT_STEP
}

// Apply the level-ratio cap to a base hit, never below 1: you always chip, and nothing
// is ever fully negated (the no-100%-immunity rule, §3a #3).
pub fn capped_dmg(base: integer, att_lvl: integer, def_lvl: integer) -> integer {
  v = base * combat_mult_pct(att_lvl, def_lvl) / 100 ?? 0;
  if v < 1 { v = 1; }
  v
}

// Player hits enemy `idx` for capped melee damage; on a kill, awards XP and drops loot.
fn player_attack(s: &Sim, idx: integer) {
  enemies = s.enemies;
  if idx >= 0 && idx < len(enemies) {
    e = enemies[idx];
    if e.alive {
      e.hp -= capped_dmg(s.wdam, s.clevel, e.mlvl);
      gain = 0;
      if e.hp <= 0 {
        e.alive = false;
        gain = e.xp * e.mlvl / s.clevel ?? 0;
        if gain < 1 { gain = 1; }
        drop_loot(s, e.cur_q, e.cur_r, e.mlvl);
      }
      enemies[idx] = e;
      if gain > 0 { sim_award_xp(s, gain); }
    }
  }
}

// Auto-collect any gold pile under the player (called each frame from sim_step).
fn sim_autocollect_gold(s: &Sim) {
  (pq, pr) = px_to_hex(s.px, s.py);
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fl = s.fi_live;
  n = s.fi_n;
  for i in 0..n {
    if (fl[i] ?? 0) == 1 {
      q = fq[i] ?? -999;
      r = fr[i] ?? -999;
      amt = fg[i] ?? 0;
      if q == pq && r == pr && amt > 0 {
        s.gold += amt;
        fl[i] = 0;
      }
    }
  }
}

// Pick up everything under the player ('g'): gold to the purse, items to inventory.
pub fn sim_pickup(s: &Sim) {
  (pq, pr) = px_to_hex(s.px, s.py);
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fd = s.fi_def;
  fl = s.fi_live;
  iv = s.inv;
  n = s.fi_n;
  for i in 0..n {
    if (fl[i] ?? 0) == 1 {
      q = fq[i] ?? -999;
      r = fr[i] ?? -999;
      if q == pq && r == pr {
        amt = fg[i] ?? 0;
        if amt > 0 {
          s.gold += amt;
        } else {
          ni = s.ninv;
          if ni >= 0 && ni < len(iv) {
            iv[ni] = fd[i] ?? -1;
            s.ninv = ni + 1;
          }
        }
        fl[i] = 0;
      }
    }
  }
}

// ── Clock & step ─────────────────────────────────────────────────────

// One world tick: each live enemy commits its move; if adjacent to the player
// it attacks (instead of moving), else it steps toward the player.
// Round to nearest integer (as float), correct for negatives — for cube lerp.
// (`as integer` truncates toward zero, so bias by ±0.5 before truncating.)
fn rnd_f(v: float) -> float {
  base = v + 0.5;
  if v < 0.0 { base = v - 0.5; }
  i = base as integer;
  i as float
}

// Hex line-of-sight: true if no solid hex blocks the line between the two hex
// centres (endpoints excluded). Cube-coordinate interpolation + rounding.
pub fn hex_los(s: Sim, q0: integer, r0: integer, q1: integer, r1: integer) -> boolean {
  n = hex_distance(q0, r0, q1, r1);
  blocked = false;
  if n > 1 {
    x0 = q0;
    z0 = r0;
    y0 = 0 - q0 - r0;
    x1 = q1;
    z1 = r1;
    y1 = 0 - q1 - r1;
    for li in 1..n {
      t = li as float / n as float ?? 0.0;
      fx = x0 as float + (x1 - x0) as float * t;
      fy = y0 as float + (y1 - y0) as float * t;
      fz = z0 as float + (z1 - z0) as float * t;
      rx = rnd_f(fx);
      ry = rnd_f(fy);
      rz = rnd_f(fz);
      dx = abs(rx - fx);
      dy = abs(ry - fy);
      dz = abs(rz - fz);
      if dx > dy && dx > dz {
        rx = 0.0 - ry - rz;
      } else if dy > dz {
        ry = 0.0 - rx - rz;
      } else {
        rz = 0.0 - rx - ry;
      }
      if is_wall(s, rx as integer, rz as integer) { blocked = true; }
    }
  }
  !blocked
}

// ── Field of view (FOV / fog-of-war) ─────────────────────────────────
// DIRECTED light: your sight radius depends on the angle to your heading — full
// VISION_RADIUS straight ahead, falling off to NEAR_RADIUS behind you (a forward-pointed
// lamp), by line of sight, plus an always-visible NEAR_RADIUS bubble. So turning points
// your light — a real choice. `vis` is recomputed each call; `seen` accumulates the
// revealed map (memory; fresh per level → lost on death). The view (or a test) calls
// this; the visibility set is renderer-agnostic (immediate or GPU — RENDER.md).
pub fn sim_compute_fov(s: &Sim) {
  vis = s.vis;
  seen = s.seen;
  (pq, pr) = px_to_hex(s.px, s.py);
  hx = cos(s.heading);
  hy = sin(s.heading);
  nearf = NEAR_RADIUS as float;
  visf = VISION_RADIUS as float;
  for gr in 0..s.lh {
    for gq in 0..s.lw {
      idx = gr * s.lw + gq;
      q = s.qmin + gq;
      r = s.rmin + gr;
      v = 0;
      d = hex_distance(pq, pr, q, r);
      if d <= NEAR_RADIUS {
        v = 1;                                         // always-visible bubble (your feet)
      } else if d <= VISION_RADIUS {
        (cxp, cyp) = hex_to_px(q, r);
        dx = cxp - s.px;
        dy = cyp - s.py;
        ln = sqrt(dx * dx + dy * dy);
        if ln > 0.0 {
          dot = (dx * hx + dy * hy) / ln ?? 0.0;        // -1 behind .. +1 ahead
          fwd = (dot + 1.0) / 2.0 ?? 0.0;               // 0 behind .. 1 ahead
          eff = nearf + (visf - nearf) * fwd * fwd;     // directed-lamp falloff (forward-biased)
          if (d as float) <= eff && hex_los(s, pq, pr, q, r) { v = 1; }
        }
      }
      if idx >= 0 && idx < len(vis) { vis[idx] = v; }
      if v != 0 && idx >= 0 && idx < len(seen) { seen[idx] = 1; }
    }
  }
}

// Render state of a hex: 2 = visible now, 1 = remembered (seen before), 0 = unseen.
pub fn sim_hex_state(s: Sim, q: integer, r: integer) -> integer {
  gq = q - s.qmin;
  gr = r - s.rmin;
  if gq < 0 || gq >= s.lw || gr < 0 || gr >= s.lh { return 0; }
  idx = gr * s.lw + gq;
  vis = s.vis;
  v = vis[idx] ?? 0;
  if v != 0 { return 2; }
  seen = s.seen;
  sn = seen[idx] ?? 0;
  if sn != 0 { return 1; }
  0
}

// FOV render state at a world position — convenience for the view (enemies/items/walls).
pub fn sim_hex_state_at(s: Sim, wx: float, wy: float) -> integer {
  (q, r) = px_to_hex(wx, wy);
  sim_hex_state(s, q, r)
}

pub fn sim_tick(s: &Sim) {
  s.ticks += 1;
  (pq, pr) = px_to_hex(s.px, s.py);
  flow = compute_flow(s, pq, pr);   // shared by every chasing monster this tick
  enemies = s.enemies;
  for et in 0..len(enemies) {
    e = enemies[et];
    if e.alive {
      e.cur_q = e.tgt_q;
      e.cur_r = e.tgt_r;
      d = hex_distance(e.cur_q, e.cur_r, pq, pr);
      // Awareness: a sleeping monster wakes when the player is within its
      // vision and in line of sight; once awake it stays awake.
      if !e.awake && d <= e.vision && hex_los(s, e.cur_q, e.cur_r, pq, pr) {
        e.awake = true;
      }
      if e.awake {
        if d <= 1 {
          s.php -= apply_dr(capped_dmg(e.dam, e.mlvl, s.clevel), s.pac);  // strike: ratio cap, then armour DR
          e.tgt_q = e.cur_q;
          e.tgt_r = e.cur_r;
          if s.php <= 0 { s.over = true; }
        } else if (e.flags & MF_NEVER_MOVE) != 0 {
          e.tgt_q = e.cur_q;         // stationary (molds, eyes): never steps
          e.tgt_r = e.cur_r;
        } else {
          (bq, br) = flow_step(s, flow, e.cur_q, e.cur_r, pq, pr);
          e.tgt_q = bq;
          e.tgt_r = br;
        }
      } else {
        e.tgt_q = e.cur_q;           // asleep: holds position
        e.tgt_r = e.cur_r;
      }
      enemies[et] = e;
    }
  }
}

// Wait: advance one world tick in place (enemies act, the player doesn't move).
pub fn sim_wait(s: &Sim) {
  if !s.over { sim_tick(s); }
}

// Advance one frame.  fwd in {-1,0,1}, turn in {-1,0,1}, dt seconds.
// Reclaim the grave's gold by standing on the death spot at its depth (any character —
// owner-less, no PvP). Called each frame from sim_step.
fn sim_reclaim_grave(s: &Sim) {
  if s.grave_gold <= 0 { return; }
  if s.depth != s.grave_depth { return; }
  (pq, pr) = px_to_hex(s.px, s.py);
  if pq == s.grave_q && pr == s.grave_r {
    s.gold += s.grave_gold;
    s.grave_gold = 0;
  }
}

// Grant gold (quest / reward income; also used by tests).
pub fn sim_grant_gold(s: &Sim, amt: integer) {
  if amt > 0 { s.gold += amt; }
}

pub fn sim_step(s: &Sim, fwd: integer, turn: integer, dt: float) {
  if s.over { return; }
  if turn != 0 {
    s.heading += (turn as float) * TURN_SPEED * dt;
  }
  if fwd != 0 {
    step = (fwd as float) * MOVE_SPEED * dt;
    dx = cos(s.heading) * step;
    dy = sin(s.heading) * step;
    moved_x = 0.0;
    moved_y = 0.0;
    // Axis-separated so the player slides along walls; probe one radius ahead
    // in the direction of travel so the centre halts short of the wall face.
    if dx != 0.0 {
      sxr = if dx > 0.0 { PLAYER_RADIUS } else { 0.0 - PLAYER_RADIUS };
      if !pos_blocked(s, s.px, s.py, s.px + dx + sxr, s.py) {
        s.px += dx;
        moved_x = dx;
      }
    }
    if dy != 0.0 {
      syr = if dy > 0.0 { PLAYER_RADIUS } else { 0.0 - PLAYER_RADIUS };
      if !pos_blocked(s, s.px, s.py, s.px, s.py + dy + syr) {
        s.py += dy;
        moved_y = dy;
      }
    }
    dist = sqrt(moved_x * moved_x + moved_y * moved_y);
    // Pressing forward into an enemy = melee: advance the clock at walking pace
    // even though the player can't move, landing a hit each tick.
    fe = if fwd > 0 { front_enemy(s) } else { -1 };
    sd = abs(step);
    if fe >= 0 && dist < sd { dist = sd; }
    s.accrued += dist;
    while s.accrued >= HEX_LEN {
      s.accrued -= HEX_LEN;
      if fe >= 0 { player_attack(s, fe); }
      sim_tick(s);
    }
  }
  sim_autocollect_gold(s);   // walking over a gold pile picks it up
  sim_reclaim_grave(s);      // standing on your grave reclaims its staked gold
}

// ── Read-only accessors for the view / tests ────────────────────────

pub fn sim_frac(s: Sim) -> float { s.accrued / HEX_LEN }

pub fn sim_player_hex(s: Sim) -> (integer, integer) { px_to_hex(s.px, s.py) }

pub fn sim_enemy_count(s: Sim) -> integer { len(s.enemies) }

pub fn sim_enemy_alive(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  alive = false;
  if i < len(enemies) {
    e = enemies[i];
    alive = e.alive;
  }
  alive
}

pub fn sim_enemy_cur(s: Sim, i: integer) -> (integer, integer) {
  enemies = s.enemies;
  rq = 0;
  rr = 0;
  if i < len(enemies) {
    e = enemies[i];
    rq = e.cur_q;
    rr = e.cur_r;
  }
  (rq, rr)
}

// Smoothly-interpolated enemy world position (cur -> tgt by clock fraction).
pub fn sim_enemy_pos(s: Sim, i: integer) -> (float, float) {
  enemies = s.enemies;
  ex = 0.0;
  ey = 0.0;
  if i < len(enemies) {
    e = enemies[i];
    (acx, acy) = hex_to_px(e.cur_q, e.cur_r);
    (atx, aty) = hex_to_px(e.tgt_q, e.tgt_r);
    f = s.accrued / HEX_LEN;
    ex = acx + (atx - acx) * f;
    ey = acy + (aty - acy) * f;
  }
  (ex, ey)
}

pub fn sim_player_hp(s: Sim) -> integer { s.php }
pub fn sim_player_hp_max(s: Sim) -> integer { s.phpmax }
pub fn sim_over(s: Sim) -> boolean { s.over }

pub fn sim_clevel(s: Sim) -> integer { s.clevel }
pub fn sim_xp(s: Sim) -> integer { s.xp }
pub fn sim_gold(s: Sim) -> integer { s.gold }

// Fraction from the current level toward the next (0..1) — for the XP bar.
pub fn sim_xp_frac(s: Sim) -> float {
  lo = xp_for_level(s.clevel);
  hi = xp_for_level(s.clevel + 1);
  f = 0.0;
  if hi > lo {
    f = (s.xp - lo) as float / (hi - lo) as float ?? 0.0;
  }
  if f < 0.0 { f = 0.0; }
  if f > 1.0 { f = 1.0; }
  f
}

pub fn sim_inv_count(s: Sim) -> integer { s.ninv }

// ── Equipment queries (HUD + tests) ──────────────────────────────────
pub fn sim_player_dam(s: Sim) -> integer { s.wdam }   // melee damage (base + weapon)
pub fn sim_player_ac(s: Sim) -> integer { s.pac }     // armour class (HP + damage-reduction)
// Item def index equipped in `slot`, or -1 if empty.
pub fn sim_equipped(s: Sim, slot: integer) -> integer {
  eq = s.eq;
  e = eq[slot] ?? 0;
  if e > 0 { return e - 1; }
  -1
}
// Damage `raw` would deal after the player's armour DR (never below 1).
pub fn sim_mitigate(s: Sim, raw: integer) -> integer { apply_dr(raw, s.pac) }
pub fn sim_floor_count(s: Sim) -> integer { s.fi_n }

pub fn sim_floor_live(s: Sim, i: integer) -> boolean {
  fl = s.fi_live;
  v = false;
  if i < len(fl) { v = (fl[i] ?? 0) == 1; }
  v
}

// World position of floor item i.
pub fn sim_floor_pos(s: Sim, i: integer) -> (float, float) {
  fq = s.fi_q;
  fr = s.fi_r;
  x = 0.0;
  y = 0.0;
  if i < len(fq) && i < len(fr) {
    q = fq[i] ?? 0;
    r = fr[i] ?? 0;
    (x, y) = hex_to_px(q, r);
  }
  (x, y)
}

pub fn sim_floor_is_gold(s: Sim, i: integer) -> boolean {
  fg = s.fi_gold;
  v = false;
  if i < len(fg) { v = (fg[i] ?? 0) > 0; }
  v
}

pub fn sim_floor_cat(s: Sim, i: integer) -> integer {
  fc = s.fi_cat;
  c = 0;
  if i < len(fc) { c = fc[i] ?? 0; }
  c
}

pub fn sim_enemy_hp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 0;
  if i < len(enemies) { e = enemies[i]; v = e.hp; }
  v
}

pub fn sim_enemy_maxhp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 1;
  if i < len(enemies) { e = enemies[i]; v = e.maxhp; }
  v
}

// Enemy display colour (0..255), from its monster-DB definition.
pub fn sim_enemy_color(s: Sim, i: integer) -> (integer, integer, integer) {
  enemies = s.enemies;
  ecr = 200;
  ecg = 60;
  ecb = 50;
  if i < len(enemies) { e = enemies[i]; ecr = e.cr; ecg = e.cg; ecb = e.cb; }
  (ecr, ecg, ecb)
}

// Is enemy i awake (has it perceived the player)?
pub fn sim_enemy_awake(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  a = false;
  if i < len(enemies) { e = enemies[i]; a = e.awake; }
  a
}

// Enemy single-char map glyph (e.g. "r", "k", "o").
pub fn sim_enemy_glyph(s: Sim, i: integer) -> text {
  enemies = s.enemies;
  g = "r";
  if i < len(enemies) { e = enemies[i]; g = e.glyph ?? "r"; }
  g
}

// World-space angle the enemy faces: its current move (cur→tgt), or — when it
// isn't moving — toward the player. Feeds the rotating sprite (the view snaps it
// to the 12-direction model). Hex-locked, so a moving facing is one of 6 dirs.
pub fn sim_enemy_facing(s: Sim, i: integer) -> float {
  enemies = s.enemies;
  a = PI / 2.0;
  if i >= 0 && i < len(enemies) {
    e = enemies[i];
    if e.tgt_q != e.cur_q || e.tgt_r != e.cur_r {
      (cx, cy) = hex_to_px(e.cur_q, e.cur_r);
      (tx, ty) = hex_to_px(e.tgt_q, e.tgt_r);
      a = atan2(ty - cy, tx - cx);
    } else {
      (ecx, ecy) = hex_to_px(e.cur_q, e.cur_r);
      a = atan2(s.py - ecy, s.px - ecx);
    }
  }
  a
}

// ── Construction ─────────────────────────────────────────────────────

pub fn sim_new() -> Sim {
  w = 21;
  h = 21;
  tiles: vector<integer> = [];
  for gr in 0..h {
    for gq in 0..w {
      edge = gq == 0 || gr == 0 || gq == w - 1 || gr == h - 1;
      tiles += [if edge { 1 } else { 0 }];
    }
  }
  // a couple of deterministic interior walls for visual reference
  for wr in 5..13 {
    wi = wr * w + 7;
    if wi < len(tiles) { tiles[wi] = 1; }
  }
  for wq in 9..16 {
    wj = 9 * w + wq;
    if wj < len(tiles) { tiles[wj] = 1; }
  }

  // Demo: a stepped diagonal line of solid hexes (SW corner) — its silhouette
  // should straighten into a clean diagonal wall, showing the wobble-averaging
  // produce an intermediate (non-edge) direction. Off the self-test paths.
  ds_q = [3, 4, 4, 5, 5, 6];
  ds_r = [3, 3, 4, 4, 5, 5];
  for di in 0..len(ds_q) {
    dq = ds_q[di] ?? 0;
    dr = ds_r[di] ?? 0;
    didx = dr * w + dq;
    if didx < len(tiles) { tiles[didx] = 1; }
  }

  // Edge walls: a 3-edge wall stub on hex (12,7), a low barrier you can bump
  // into — demonstrates edge walls alongside the full-hex walls above.
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  ewi = (7 * w + 12) * 3;
  for ee in 0..3 {
    eidx = ewi + ee;
    if eidx < len(walls) { walls[eidx] = 1; }
  }

  (spx, spy) = hex_to_px(10, 10);
  e0 = Enemy { cur_q: 10, cur_r: 16, tgt_q: 10, tgt_r: 16, hp: 8, maxhp: 8, dam: 3,
    xp: 2, mlvl: 1, vision: 8, flags: 0, awake: true,
    cr: 200, cg: 60, cb: 50, glyph: "r", alive: true };
  enemies: vector<Enemy> = [e0];

  Sim {
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    seen: zeros(w * h), vis: zeros(w * h),
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1), phpmax: hero_maxhp(1), over: false,
    clevel: 1, xp: 0, gold: 0, hcon: HERO_CON,
    depth: 1, wseed: 0, save_depth: 1, up_q: 10, up_r: 10, dn_q: 10, dn_r: 16,
    grave_depth: 0, grave_q: 0, grave_r: 0, grave_gold: 0,
    rstate: 12345, ninv: 0, inv: zeros(INV_MAX),
    eq: zeros(NUM_SLOTS), wdam: PLAYER_DAM, pac: 0,
    fi_n: 0, fi_q: zeros(FLOOR_MAX), fi_r: zeros(FLOOR_MAX), fi_gold: zeros(FLOOR_MAX),
    fi_cat: zeros(FLOOR_MAX), fi_def: zeros(FLOOR_MAX), fi_live: zeros(FLOOR_MAX),
    room_q0: [], room_r0: [], room_w: [], room_h: [],   // hand-built level: no rooms → pure smooth
  }
}

// ── Monster placement (Angband get_mon_num) ──────────────────────────

// Self-contained LCG (gen's RNG lives in another module; `&` mutation only
// propagates within a module, so placement keeps its own in `sim`).
struct SimRng { rs: integer not null }

fn srng_seed(seed: integer) -> SimRng { SimRng { rs: (seed & 2147483647) | 1 } }

fn srng(r: &SimRng, lo: integer, hi: integer) -> integer {
  if hi <= lo { return lo; }
  n = (r.rs * 1103515245 + 12345) & 2147483647;
  r.rs = n;
  span = hi - lo + 1;
  lo + (n % span ?? 0)
}

// Monster selection (get_mon_num) lives in monsters.loft as mon_choose —
// iterating the MonsterDef table with a struct fallback SIGSEGVs the interpreter
// from this module, but is fine inside monsters.loft where the type is defined.

// Build a live (asleep) Enemy from a MonsterDef at a hex. (The glyph is guarded
// to "?" — a struct-copy through the selection chain can drop the text field.)
fn mk_enemy(md: MonsterDef, q: integer, r: integer) -> Enemy {
  g = md.m_glyph;
  if len(g) == 0 { g = "?"; }
  Enemy { cur_q: q, cur_r: r, tgt_q: q, tgt_r: r,
    hp: md.m_hp, maxhp: md.m_hp, dam: md.m_dam,
    xp: md.m_xp, mlvl: md.m_depth,
    vision: md.m_vision, flags: md.m_flags, awake: false,
    cr: md.m_cr, cg: md.m_cg, cb: md.m_cb, glyph: g, alive: true }
}

// Is any already-placed enemy on this hex?
fn occupied_hex(enemies: vector<Enemy>, q: integer, r: integer) -> boolean {
  found = false;
  for oi in 0..len(enemies) {
    e = enemies[oi];
    if e.cur_q == q && e.cur_r == r { found = true; }
  }
  found
}

// Is (q,r) solid rock or off-map in this tile array?
fn tile_solid(tiles: vector<integer>, w: integer, h: integer, q: integer, r: integer) -> boolean {
  if q < 0 || r < 0 || q >= w || r >= h { return true; }
  ti = r * w + q;
  solid = true;
  if ti < len(tiles) { solid = (tiles[ti] ?? 1) == 1; }
  solid
}

// Procedural dungeon: rooms + corridors from gen_dungeon (world-keyed seed),
// the player placed in room 0; monsters scattered onto legal floor by the
// Angband placement pass (budget → get_mon_num → start-safe spot → groups).
// Renderer-agnostic — no graphics here.
pub fn sim_new_gen(seed: integer, depth: integer) -> Sim {
  w = 41;
  h = 41;
  // Per-level gen seed = mix(world seed, depth) so each depth has its own layout.
  gseed = (seed ^ world_key_seed(1, 1, depth)) & 2147483647;
  lvl = gen_dungeon(gseed, w, h, 14);
  tiles = lvl.g_tiles;
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  rqs = lvl.g_rq;
  rrs = lvl.g_rr;
  rq0s = lvl.g_rq0;
  rr0s = lvl.g_rr0;
  rws = lvl.g_rw;
  rhs = lvl.g_rh;
  nrm = len(rqs);

  // Player in the first room.
  pq = w / 2;
  pr = h / 2;
  if nrm > 0 {
    pq = rqs[0] ?? (w / 2);
    pr = rrs[0] ?? (h / 2);
  }
  (spx, spy) = hex_to_px(pq, pr);

  // Collect legal floor far from the player start, then sample the budget from
  // it directly (robust even when open floor is a small fraction of the map).
  table = monster_table();
  rng = srng_seed((gseed ^ 20771) & 2147483647);
  safe = 8;                             // keep spawns this far from the start
  candq: vector<integer> = [];
  candr: vector<integer> = [];
  for ccr in 1..(h - 1) {
    for ccq in 1..(w - 1) {
      if !tile_solid(tiles, w, h, ccq, ccr) && hex_distance(ccq, ccr, pq, pr) >= safe {
        candq += [ccq];
        candr += [ccr];
      }
    }
  }
  ncand = len(candq);
  budget = 10 + srng(rng, 0, 8);   // ~10–18
  if budget > ncand { budget = ncand; }
  enemies: vector<Enemy> = [];
  placed = 0;
  guard = 0;
  // Dedup is handled by occupied_hex (re-picking a taken cell just retries) —
  // a `used` marker vector built by comprehension read back null here.
  while placed < budget && guard < ncand * 4 + 100 {
    guard += 1;
    if ncand > 0 {
      k = srng(rng, 0, ncand - 1);
      sq = candq[k] ?? 1;
      sr = candr[k] ?? 1;
      if !occupied_hex(enemies, sq, sr) {
        eff = depth;
        if srng(rng, 0, 24) == 0 { eff = depth + srng(rng, 1, 4); }   // out-of-depth
        md = mon_choose(table, eff, srng(rng, 0, 2000000000));
        if md.m_hp > 0 {
          enemies += [mk_enemy(md, sq, sr)];
          placed += 1;
          if (md.m_flags & MF_GROUP) != 0 {
            gsz = srng(rng, 2, 4);
            for gk in 0..gsz {
              if placed < budget {
                (gq, gr) = hex_neighbor(sq, sr, gk % 6 ?? 0);
                if !tile_solid(tiles, w, h, gq, gr) && hex_distance(gq, gr, pq, pr) >= safe && !occupied_hex(enemies, gq, gr) {
                  enemies += [mk_enemy(md, gq, gr)];
                  placed += 1;
                }
              }
            }
          }
        }
      }
    }
  }

  // Stairs: up at the player start, down at the farthest reachable floor hex.
  dnq = pq;
  dnr = pr;
  bestdd = -1;
  for si in 0..ncand {
    if si < ncand {
      cq = candq[si] ?? pq;
      cr = candr[si] ?? pr;
      dd = hex_distance(cq, cr, pq, pr);
      if dd > bestdd { bestdd = dd; dnq = cq; dnr = cr; }
    }
  }
  ti_up = pr * w + pq;
  if ti_up >= 0 && ti_up < len(tiles) { tiles[ti_up] = 3; }
  ti_dn = dnr * w + dnq;
  if ti_dn >= 0 && ti_dn < len(tiles) { tiles[ti_dn] = 2; }

  s = Sim {
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    seen: zeros(w * h), vis: zeros(w * h),
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1), phpmax: hero_maxhp(1), over: false,
    clevel: 1, xp: 0, gold: 0, hcon: HERO_CON,
    depth: depth, wseed: seed, save_depth: depth, up_q: pq, up_r: pr, dn_q: dnq, dn_r: dnr,
    grave_depth: 0, grave_q: 0, grave_r: 0, grave_gold: 0,
    rstate: (gseed ^ 99173) & 2147483647, ninv: 0, inv: zeros(INV_MAX),
    eq: zeros(NUM_SLOTS), wdam: PLAYER_DAM, pac: 0,
    fi_n: 0, fi_q: zeros(FLOOR_MAX), fi_r: zeros(FLOOR_MAX), fi_gold: zeros(FLOOR_MAX),
    fi_cat: zeros(FLOOR_MAX), fi_def: zeros(FLOOR_MAX), fi_live: zeros(FLOOR_MAX),
    room_q0: rq0s, room_r0: rr0s, room_w: rws, room_h: rhs,
  };
  sim_starting_loadout(s);   // every new character starts with its class kit (§3a #4)
  s
}

// Move between levels: dir +1 descends, -1 ascends (clamped to depth >= 1).
// Regenerates the destination deterministically from (wseed, new depth), carries
// the player's HP, and places them on the arrival stair (down → the new level's
// up-stair, which is where sim_new_gen already drops the player; up → its
// down-stair).
// A level is a save point at depths 1, 1+SAVE_INTERVAL, … (the home/bed is depth 1).
fn is_save_depth(d: integer) -> integer {
  if (d % SAVE_INTERVAL ?? 0) == 1 { return 1; }
  0
}

pub fn sim_descend(s: Sim, dir: integer) -> Sim {
  nd = s.depth + dir;
  if nd < 1 { nd = 1; }
  ns = sim_new_gen(s.wseed, nd);
  ns.php = s.php;
  ns.phpmax = s.phpmax;
  ns.over = s.over;
  ns.clevel = s.clevel;   // carry the hero across levels
  ns.xp = s.xp;
  ns.gold = s.gold;
  ns.hcon = s.hcon;
  ns.inv = s.inv;         // carry the inventory; floor items stay on their level
  ns.ninv = s.ninv;
  ns.eq = s.eq;           // carry equipment + its cached effects across levels
  ns.wdam = s.wdam;
  ns.pac = s.pac;
  ns.rstate = s.rstate;
  ns.heading = s.heading;
  ns.save_depth = s.save_depth;                                          // carry the checkpoint
  if is_save_depth(nd) != 0 && nd > ns.save_depth { ns.save_depth = nd; }  // advance at save points
  ns.grave_depth = s.grave_depth;   // carry the death-stake grave across levels
  ns.grave_q = s.grave_q;
  ns.grave_r = s.grave_r;
  ns.grave_gold = s.grave_gold;
  if dir < 0 {
    (ax, ay) = hex_to_px(ns.dn_q, ns.dn_r);
    ns.px = ax;
    ns.py = ay;
  }
  ns
}

// Respawn after death — NOT permadeath (§3a #5): rebuild the last save-point level and
// keep the character (level/XP/gold/items/equipment), full-healed. The dive is lost (the
// save-point level regenerates; the dungeon state explored since is discarded).
pub fn sim_respawn(s: Sim) -> Sim {
  rs = sim_new_gen(s.wseed, s.save_depth);
  rs.clevel = s.clevel;
  rs.xp = s.xp;
  rs.hcon = s.hcon;
  // Souls stake: leave GRAVE_PCT% of gold as a grave at the death spot. SP keeps one
  // grave, so a fresh death forfeits any prior one (MP would append — §3a #5).
  drop = s.gold * GRAVE_PCT / 100 ?? 0;
  rs.gold = s.gold - drop;
  (dq, dr) = px_to_hex(s.px, s.py);
  rs.grave_depth = s.depth;
  rs.grave_q = dq;
  rs.grave_r = dr;
  rs.grave_gold = drop;
  rs.inv = s.inv;
  rs.ninv = s.ninv;
  rs.eq = s.eq;
  rs.wdam = s.wdam;
  rs.pac = s.pac;
  rs.phpmax = s.phpmax;
  rs.php = s.phpmax;          // full heal on respawn
  rs.save_depth = s.save_depth;
  rs.over = false;
  rs
}

pub fn sim_depth(s: Sim) -> integer { s.depth }
pub fn sim_save_depth(s: Sim) -> integer { s.save_depth }   // checkpoint depth (respawn target)
pub fn sim_grave_gold(s: Sim) -> integer { s.grave_gold }   // gold staked on the grave (0 = none)
pub fn sim_grave_depth(s: Sim) -> integer { s.grave_depth } // depth the grave is on
pub fn sim_grave_q(s: Sim) -> integer { s.grave_q }         // grave hex (for the view marker)
pub fn sim_grave_r(s: Sim) -> integer { s.grave_r }

// Tile under the player: 2 = down-stair, 3 = up-stair, else floor/wall.
pub fn sim_stair_under(s: Sim) -> integer {
  (pq, pr) = px_to_hex(s.px, s.py);
  tile_at(s, pq, pr)
}

pub fn sim_down_hex(s: Sim) -> (integer, integer) { (s.dn_q, s.dn_r) }
pub fn sim_up_hex(s: Sim) -> (integer, integer) { (s.up_q, s.up_r) }
