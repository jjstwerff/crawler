// sim — the renderer-agnostic roguelike kernel (M0).
//
// Continuous player (position + heading) over a hex tile grid; hex-locked
// enemies; a distance-driven clock: every HEX_LEN of player travel = one tick,
// turning costs no distance and therefore no time.  NO graphics dependency.

use hex_grid;
use hex_field;        // HexSet — the solid cell set the edge field is sealed from (plan #11 P2)
use hex_edge;          // EdgeSet + passable() — THE crossing predicate (plan #5's edge model)
use gen;
use monsters;
use items;
use catalog;          // game_monsters()/game_items()/race_catalog()/class_catalog() — the merges
use races;            // RaceDef + RF_* ability flags + race_find/race_has_flag (the chosen race applies)
use classes;          // ClassDef + class_find (the chosen class applies: stats/HP/SP/skills/realm)
use random;           // RandStream (loft-libs-core): owned deterministic streams — combat rolls,
                      //   monster placement, flavour shuffles (EXTRACTION.md item 4 adoption)
use overland;         // the contract wilderness: the surface samples ov_sample (OVERLAND.md 12)
use scale;            // terrain_m_to_wu — THE vertical reading (SCALE.md; plan #11 P6)
use worldtypes;       // RoomStencil / Placement — the world-bundle vocabulary
use world_place_gen;  // world_stencils()/world_placement() — the active bundle's set-piece + rules

MOVE_SPEED = 6.0;     // world units / second (brisk, Angband-paced; clock is distance)
TURN_SPEED = 2.6;     // radians / second
PLAYER_RADIUS = 0.45; // collision radius; ~half the marker, < hex apothem (0.866)
PLAYER_DAM = 6;       // player base melee damage per hit (before the level-ratio cap)
FIRE_RANGE = 10;      // missile range in hexes for the launcher (Q to fire)
FRONT_AIM  = 3.0;     // auto-aim: a dead-ahead target counts as up to this many hexes nearer
pub const QS_N = 11;  // quick-slots: indices 0..8 = number keys 1-9, 9 = active Q, 10 = active E
pub const QS_Q = 9;   // active slot Q (launcher fire / repeated action)
pub const QS_E = 10;  // active slot E (spell / second repeated action)
MSG_MAX = 64;         // message-log ring capacity (the view shows the most recent few)
PARA_DUR   = 2;       // ticks of paralysis per failed gaze save (re-rolled each tick while adjacent)
POISON_DUR = 8;       // ticks a venom dose lasts
POISON_DMG = 2;       // HP lost per poisoned tick
STRUGGLE_X = 4;       // paralysis fast-forward: struggling (pressing move) advances the clock Nx the
                      //   pure-wait pace — same ticks/outcome, just less real-time staring
REGEN_EVERY = 10;     // natural regeneration: +1 HP every N ticks (Angband: wounds slowly knit);
                      //   RF_REGEN (half-troll) halves the interval; poison blocks it entirely
SP_REGEN_EVERY = 6;   // mana returns a little faster than wounds knit; poison does NOT block the mind
COMBAT_DELTA_CAP = 8; // level gap beyond which raw level stops mattering in combat (§3a #2)
COMBAT_STEP = 6;      // % damage per level of (capped) gap — at most ±48%: level alone can't win/lose a fight
pub FLOW_BIG = 1000000; // unreachable / unset distance in the flow field. ⚠ Pub because
                      //   `sim_npc_path_dist` RETURNS it, so every gate that asks "can this
                      //   worker get there" has to name it — and two of them had written the
                      //   literal out instead, which is one fact in three places.
HERO_CON   = 16;      // starting Constitution (full stat block = H2; HP is class-uniform, not con-driven)
// THE EIGHT (CATALOG.md §0, adopted 2026-06-27, built as plan #16 `M2` on 2026-08-10):
// Might · Endurance · Dexterity · Perception · Speed · Will · Charisma · Handiness.
//
// I-AXIS: **this is the only thing that knows the count.** All five stat layers are
// `vector<integer>` (`stat_max`/`stat_cur`/`stat_tmp`/`stat_tmp_t`/`stat_grown_at`), so the
// axis count is a LENGTH, never a struct shape — which is why growing it broke no save
// (measured `M0`: no stat vector is in any save path) and needed no migration.
pub NUM_STATS = 8;    // MIGHT, ENDU, DEX, PERC, SPEED, WILL, CHAR, HAND. ⚠ Pub because the
                      //   FRONT-END bounds the spend keys by it — a literal 6 there was what
                      //   made two new axes look like they would cost two new keys.
// The axes the engine CONSUMES, and what each one drives — `CATALOG.md` §0's role table,
// re-keyed onto the code by plan #16 `M4`. Six of the eight are read; the two that are not say
// so, because an axis with no consumer is a number the player spends points on for nothing.
//
//   ST_MIGHT  -> melee skill, folded into wdam        (§0: the damage channel)
//   ST_ENDU   -> the max-HP pool                      (§0: mitigation / HP ceiling — soak)
//   ST_DEX    -> the stealth skill                    (§0: precision / evasion)
//   ST_PERC   -> the shooting skill                   (§0: ranged accuracy)   ⚠ was ST_DEX
//   ST_SPEED  -> the distance clock, via tick_span()  (§0: the distance clock / initiative)
//   ST_WILL   -> the saving throw + the SP pool       (§0: focus / Tension-resist / realms)
//                                                     ⚠ the save was ST_ENDU's
//   ST_CHAR   -> NOTHING YET. §0 gives it leadership/calling (PARTY.md §5b) and prices; crawler
//                has no party and no priced transaction — gold is found and staked, never spent
//                at a price. Both are systems, not derivations, so `M4` does not invent them.
//   ST_HAND   -> NOTHING YET. §0 gives it disarm/device/repair. `r_device`/`r_disarm` are
//                authored on every race and consumed NOWHERE, and #17's mending is the SMITH's
//                act, not the player's. It waits on the durability call (`CRAFTING.md` q4).
ST_MIGHT   = 0;       // Might's index in the stat vectors (feeds the melee skill; was ST_STR)
ST_ENDU    = 1;       // Endurance (feeds the HP pool; was ST_CON at 4)
ST_DEX     = 2;       // Dexterity (feeds the stealth skill; was 3)
ST_PERC    = 3;       // Perception (feeds the shooting skill — §0's "ranged accuracy")
ST_SPEED   = 4;       // Speed (feeds tick_span: how far you walk before the world acts)
ST_WILL    = 5;       // Will (feeds the saving throw and the caster's SP pool)
HERO_HP_BASE      = 28; // base max HP — identical for every class (fair); armour adds HP% (G3, §3a #3)
HERO_HP_PER_LEVEL = 2;  // gentle per-level HP (§3a #2): whole-game span a few×, not 10×+
STAT_COOLDOWN     = 3;  // a given stat can rise at most once per 3 character levels (player-chosen)
MAX_CLEVEL = 50;      // character-level cap
FLOOR_MAX  = 64;      // floor-item slots per level (fixed array — see LOFT_ISSUES)
INV_MAX    = 64;      // inventory slots
NUM_SLOTS  = 13;      // equipment slots, indexed by SLOT_* (0 = SLOT_NONE .. 11 = AMULET, 12 = RING2)
SAVE_INTERVAL = 3;    // a save-point level every 3 levels (depth 1, 4, 7, …) — checkpoint respawn
DEPTH_MAX  = 64;      // dungeon depths the per-level persistence store addresses
MAX_SPAWNS = 32;      // per-depth cap on stored dead-spawn indices (a level carries ~15)
GRAVE_PCT  = 50;      // % of gold left on a grave at the death spot (Souls stake — §3a #5)
VISION_RADIUS = 10;   // FOV radius DIRECTLY AHEAD — a directed lamp; later from the equipped light
// Monster perception channels — how the player knows a monster is there (best channel wins).
pub const SENSE_NONE = 0;   // not perceived
pub const SENSE_HEAR = 1;   // heard — an awake monster nearby, even out of sight (noise)
pub const SENSE_FEEL = 2;   // felt — position known through walls (detection / telepathy)
pub const SENSE_SEE  = 3;   // seen — in the lit field of view
HEAR_RADIUS = 6;      // an awake monster within this is "heard" when not seen
pub const ENERGY_STEP = 10;   // action cost in energy points; a monster banks (10 + m_speed) per
                              // tick and spends 10 per step/attack — m_speed +5 => 1.5 actions/tick
// Status effects — TIMED by a PRE-CALCULATED expiry tick, not a per-tick countdown: applying one
// stores `until = clock.ticks + duration`, and it is ACTIVE while `ticks <= until`, auto-stopping
// when the clock passes it. No decrement runs each tick — the clock is the single timer. slow =
// half the energy gain; stun = banks none (frozen). More kinds (bless/haste/poison) fit the same shape.
pub const ST_SLOW = 0;
pub const ST_STUN = 1;
NEAR_RADIUS = 1;      // always-visible bubble (own + adjacent); also the sight radius behind you

// Fresh zero-filled int vector of length n (build-time append to a local works;
// runtime append to a struct field does not — so floor/inv use fixed arrays).
fn zeros(n: integer) -> vector<integer> {
  v: vector<integer> = [];
  for _ in 0..n { v += [0]; }
  v
}

pub struct Enemy {
  cur_q: integer not null,
  cur_r: integer not null,
  tgt_q: integer not null,
  tgt_r: integer not null,
  hp:    integer not null,
  maxhp: integer not null,
  dam:   integer not null,
  xp:     integer not null,   // experience awarded on death (m_xp)
  mlvl:   integer not null,   // native level (m_depth) — scales the kill XP
  vision: integer not null,   // aggro / detection range in hexes (from the DB)
  flags:  integer not null,   // MF_* bitmask (from the DB)
  tags:   integer not null,   // the def's placement-role tags (TAG_*) — quest hooks read these
  awake:  boolean not null,   // false = asleep: won't act until it perceives you
  speed:  integer not null,   // energy banked per clock tick = ENERGY_STEP + m_speed
  energy: integer not null,   // action-credit saved toward the next step (the 0..9 leftover between ticks)
  slow_until: integer not null,  // status expiry ticks (0 = none); active while ticks <= until
  stun_until: integer not null,
  cr:    integer not null,    // display colour 0..255 (from the monster DB)
  cg:    integer not null,
  cb:    integer not null,
  glyph: text,                // single-char map symbol (e.g. "r", "k", "o")
  key:   text,                // monster-def key ("giant_rat") — the view resolves <key>.png sprites
  name:  text,                // display name (for the message log: "You have slain the giant rat.")
  alive: boolean not null,
  // CIVILIANS (the town's daily loop): 0 = a monster; roles live by schedule
  // 0 = a hostile monster; the rest are civilian trades, each with its own schedule in
  // `npc_target`. ⚠ This list stopped at 6 while 7-12 were in use, which costs a reader real
  // time — the roles are only ever written as bare integers at the call sites.
  //   0 monster · 1 villager · 2 farmer · 3 guard · 4 fisher · 5 boat · 6 fishing ship
  //   7 cart merchant · 8 merchant ship · 9 gatherer · 10 miner · 11 livestock · 12 wild thing
  role:  integer not null,
  hq:    integer not null,    // home / night anchor
  hr:    integer not null,
  wq2:   integer not null,    // work: the field / fishing spot / patrol leg A
  wr2:   integer not null,
  aq2:   integer not null,    // alt: the food stall / patrol leg B
  ar2:   integer not null,
  c1g:   integer not null,    // cart cargo (item def idx, -1 empty): LIGHT goods only
  c2g:   integer not null,
  // plan #17 `S3` — the gatherer's BAG: 1 = carrying a pick, 0 = empty. Not an item and
  // not a count; it is what makes "arriving home" a discrete event instead of a state that
  // would re-fire every tick the worker stood in town.
  carry: integer not null,
  // plan #17 `S5` — an INCURSION marches. 1 = this hostile was sent by a source and is
  // walking to `wq2/wr2`; its `hq/hr` is the source's spawn hex, which is the source's
  // identity (stable even when the leader itself moves). 0 = an ordinary monster.
  raid:  integer not null,
  // plan #17 `S7` — a MILITIA PICKET. 1 = this role-3 guard is one the settlement would not
  // otherwise have posted; the player's standing raised it. ⚠ It is not a new safety
  // mechanism: a picket is an ordinary guard to `hex_safe`, and this flag exists only so the
  // militia can be counted and so `town_size` keeps meaning *who lives here* — without it,
  // raising a militia would tip a village over the town threshold and start the raids.
  picket: integer not null,
}

// The player's own state — the character record (DESIGN.md §2: moving player-owned
// fields out of the Sim god-object). Sim holds ONE today (s.player); a players
// vector + an NPC-shared character core come later (Enemy is the NPC precursor).
// loft struct vars are REFERENCES — mutate via direct `s.player.field` (works
// through &Sim), never via a `p = s.player; … ; s.player = p` copy-back.
// Scalars-first slice (DESIGN.md §2): scalar fields migrate here in groups; the
// stat/inventory/equipment VECTORS stay on Sim until the vector slice.
pub struct Player {
  pid:    integer not null,   // 0 = the single active player today; players-vector index later
  clevel: integer not null,   // character level (1..MAX_CLEVEL)
  xp:     integer not null,   // experience points
  gold:   integer not null,   // gold (income arrives with items, I1)
}

pub struct Sim {
  tkind: vector<integer> not null,   // surface terrain kind + 1 (0 = dungeon/none)
  // GROUND HEIGHT per hex, in WORLD UNITS above sea level (plan #11 P6, I-HORIZON). The
  // depth-0 generator already sampled this out of the overland and threw it away — the
  // ground was a flat plane in both renderers and `SCALE.md` had never fixed the vertical.
  // It is stored COMPRESSED (scale::terrain_m_to_wu), because rise takes the compression run
  // takes, and ABSOLUTE (sea level = 0) rather than per-window: a datum per window would put
  // a step in the ground at every window seam a traveller crosses.
  // Empty on a dungeon level, which is flat by construction.
  theight: vector<float> not null,
  lw:      integer not null,
  lh:      integer not null,
  qmin:    integer not null,
  rmin:    integer not null,
  tiles:   vector<integer> not null,   // hex kind: 0 floor, 1 solid full-hex wall
  walls:   vector<integer> not null,   // edge walls: idx = hex*3 + edge(0=N,1=NE,2=SE)
  // THE passability field (plan #11 P2). Derived from `tiles` + `walls` at build time by
  // build_field(), then it is the only thing field_blocked reads. Both sources stay:
  // `tiles` because its other consumers ask about CONTENT (stairs, cave mouths, quest
  // features) not passage, and `walls` because it is still the edge authoring surface
  // until fences move onto an EdgeSet of their own.
  solid:   HexSet,                     //   cell occupancy — what fills a hex
  field:   EdgeSet,                    //   the crossing layer — what a path may not cross
  seen:    vector<integer> not null,   // FOV memory: 1 = hex ever seen (revealed map; lost on death)
  vis:     vector<integer> not null,   // FOV current: 1 = hex visible this frame (recomputed)
  px:      float not null,
  py:      float not null,
  heading: float not null,             // radians; forward = (cos,sin)
  accrued: float not null,             // remainder distance in [0, tick_span(s)) — Speed-scaled
  ticks:   integer not null,
  enemies: vector<Enemy> not null,
  php:     integer not null,   // player hit points
  phpmax:  integer not null,
  over:    boolean not null,   // game over (player died)
  player:  Player not null,    // the player's own record — scalars migrating here (clevel/xp/gold so far)
  race:    text not null,      // chosen race key (default "human"); its RaceDef applies to stats/HP/skills/flags
  pclass:  text not null,      // chosen class key ("" = the unclassed baseline; the FRONT-END picks the
                               //   quick-start default — story boots a warrior; the crystal re-specs)
  sp:      integer not null,   // spell points (0/0 for realm-less classes; regenerates over the clock)
  spmax:   integer not null,
  // CACHED race+class derivations (the wdam/pac idiom): apply_creation bakes these so the hot
  // paths (skills per tick, save rolls, xp checks, regen) read FIELDS — never re-merging the
  // race/class catalogs per call (catalog construction in a hot loop = store churn, loft#303).
  rc_flags:   integer not null,   // the race's RF_* ability bitmask
  rc_melee:   integer not null,   // combined race+class skill mods (class on the Angband scale, pre-divided)
  rc_bow:     integer not null,
  rc_stealth: integer not null,
  rc_save:    integer not null,
  rc_hd:      integer not null,   // combined hit-die (race + class)
  rc_xpf:     integer not null,   // combined experience factor % (100 = baseline)
  rc_realm:   text not null,      // the class's casting realm ("none" = no SP/cast)
  rc_spi:     integer not null,   // spell-stat index (stat_index of c_spell_stat; -1 = none)
  shrine_ev:  integer not null,   // pending shrine INTERACT (bumped a MF_SHRINE entity); the view
                                  //   polls sim_shrine_pending + clears — the crystal page opens
  // Statistics — three layers per stat (STR/INT/WIS/DEX/CON/CHR, see stat_index):
  //   stat_max = innate; stat_cur = current (permanent drain lowers, restore returns to max);
  //   stat_tmp/stat_tmp_t = a temporary +/- modifier (good/bad potion) with turns remaining.
  stat_max:   vector<integer> not null,
  stat_cur:   vector<integer> not null,
  stat_tmp:   vector<integer> not null,
  stat_tmp_t: vector<integer> not null,
  // Player-chosen stat growth (never forced): each level-up BANKS one point here; the player
  // spends it whenever they like (sim_raise_stat), deferring until needed. stat_grown_at[i] = the
  // clevel stat i last rose (0 = never), enforcing the once-per-STAT_COOLDOWN-levels cap.
  stat_pts:   integer not null,
  stat_grown_at: vector<integer> not null,
  detect_t:   integer not null,   // monster-detection (see-through-walls) turns remaining
  depth:   integer not null,   // dungeon level (1 = shallowest)
  save_depth: integer not null,   // checkpoint: deepest save-point level reached (respawn target)
  anc_kind:  integer not null,    // the ACTIVE SPAWN ANCHOR: 0 none (legacy save-stair fallback),
  anc_depth: integer not null,    //   1 = a save stair, 2 = the crystal, 3 = a bed (plan #4 H), ...
  anc_wx:    integer not null,    //   any feature can claim the player's respawn — the LAST claim
  anc_wy:    integer not null,    //   wins; death wakes the player there, whole again
  anc_q:     integer not null,
  anc_r:     integer not null,
  q_poster:  integer not null,    // the WANTED poster bounty: 0 unread, 1 taken, 2 boss down, 3 paid
  q_mage:    integer not null,    // the Circle's line: 0 nothing, 1 merchant pointed, 2 asked, 3 the writ
  grave_depth: integer not null,  // death-stake grave: depth / hex / gold (0 gold = no grave).
  grave_q:     integer not null,  //   SP keeps one grave (re-death forfeits it); MP would hold a
  grave_r:     integer not null,  //   list (owner-less, persistent) — a later, non-rewrite variant.
  grave_gold:  integer not null,
  boss_slain:  integer not null,  // quest progress: 1 once a set-piece UNIQUE has died (releases the
                                  //   bundle's infestation on the way out). Carried across levels.
  msg_q:   vector<text> not null,  // message-log ring buffer (size MSG_MAX); index-written, never grown
  msg_n:   integer not null,       // total messages ever logged (the ring write head)
  // PLAYER status (the single player today; per-player when MP lands — "they take a player slot").
  para_until:   integer not null,  // paralysed while ticks < this (the floating-eye gaze)
  poison_until: integer not null,  // poisoned while ticks < this, taking poison_dmg HP per tick
  poison_dmg:   integer not null,
  venom_until:  integer not null,  // venom-WARD (antivenin): poison can't apply/tick while ticks < this
  // Unknown items (per GAME, carried across levels): which item TYPES are identified, and each def's
  // shuffled flavour index (the unidentified display). Indexed by catalog def index.
  known:        vector<integer> not null,
  flavour_idx:  vector<integer> not null,
  wseed:   integer not null,   // world seed (per-level gen seed = mix(wseed, depth))
  win_x:   integer not null,   // which wilderness WINDOW this surface is ((0,0) = the home town;
  win_y:   integer not null,   //  neighbours abut — walking off an edge crosses over)
  up_q:    integer not null,   // up-stair hex (player start / arrival from below)
  up_r:    integer not null,
  dn_q:    integer not null,   // down-stair hex
  dn_r:    integer not null,
  rs1:     integer not null,   // the combat-roll RandStream's state words (random lib) — the
  rs2:     integer not null,   //   stream RIDES the Sim: saves/replays/descends deterministically
  ninv:    integer not null,   // inventory count
  inv:     vector<integer> not null,   // carried item def indices [0..ninv) (UI = I2)
  eq:      vector<integer> not null,   // equipped item: defidx+1 per SLOT_* slot (0 = empty)
  qs:      vector<integer> not null,   // quick-slots [0..QS_N): bound item defidx+1 (0 = empty)
  // DAMAGED GEAR (plan #17 `S6`) — 1 = the item standing in this slot is damaged, parallel to
  // `eq` and `inv`. ⚠ IT CANNOT LIVE ON THE ITEM: `inv`/`eq` hold DEF INDICES, so there is no
  // instance to carry a state, and the `IF_*` bitmask the plan proposed is on the *def* — a
  // flag there would corrode every dagger in the world, including the one the forge makes
  // tomorrow. So the state belongs to the PLACE the item stands in, and I-MEND's second half
  // (below) is the rule that keeps that from meaning "damage evaporates when you take it off".
  eq_dmg:  vector<integer> not null,
  inv_dmg: vector<integer> not null,
  wdam:    integer not null,           // cached melee damage (PLAYER_DAM + equipped weapon)
  pac:     integer not null,           // cached armour class (sum equipped i_ac) — feeds HP + DR
  fi_n:    integer not null,   // floor-item count
  fi_q:    vector<integer> not null,   // floor items — hex position [0..fi_n)
  fi_r:    vector<integer> not null,
  fi_gold: vector<integer> not null,   // gold amount (>0 = gold pile, 0 = an item)
  fi_cat:  vector<integer> not null,   // item category (IT_*); -1 for gold
  fi_def:  vector<integer> not null,   // item def index; -1 for gold
  fi_live: vector<integer> not null,   // 1 = on the floor, 0 = collected
  // plan #17 `S3` — the settlement's STOCK: one number per producer (NUM_PRODUCERS, indexed
  // by items.loft's `producer_index`), raised when a worker brings something home and drawn
  // when a workshop makes. ⚠ A NUMBER, NEVER AN ITEM INVENTORY — the moment it holds items
  // somebody wants a screen for it and the interface budget is spent (CRAFTING.md `F2`).
  prod_stock: vector<integer> not null,
  // plan #17 `S7` — STANDING, per settlement. Stride `STAND_W`: `[win_x, win_y, deeds,
  // pickets]`, one entry per settlement the player has done anything for, appended on first
  // deed. `pickets` is `-1` until they petition and `0..n` after (a militia that has been
  // raised and is stalled at its first site is a real state, so "raised" cannot be inferred
  // from the count).
  //
  // ⚠ LOCAL, NEVER GLOBAL KARMA, and the key is what enforces it: the window IS the
  // settlement's identity, so being a hero in one valley says nothing in the next. A single
  // integer here would be a campaign-wide reputation number, and every settlement after the
  // first would be scenery.
  //
  // ⚠ ONE NUMBER, ONE CONSUMER (the militia) — the guard rail that keeps `S7` from being the
  // social sim `DESIGN.md` §3a #6 forbids. No dialogue tree, no disposition matrix, no
  // per-NPC relations. A SECOND consumer is the moment to re-check that, not a free extension.
  stand: vector<integer> not null,
  // Civilian path fields, one per (destination, movement class), computed on first use and
  // KEPT — a civilian's destinations are fixed when it spawns and the terrain under them
  // does not move, so a field is built once per level and read by every NPC heading there.
  // ⚠ FLAT, not a vector of vectors: nested-vector stores are the loft#250 family (`walltest`
  // exists because of it). Slot k occupies `flowd_data[k*lw*lh ..]`.
  flowd_q:    vector<integer> not null,
  flowd_r:    vector<integer> not null,
  flowd_cls:  vector<integer> not null,
  flowd_data: vector<integer> not null,
  // Per-level persistence (deterministic base + delta): dead-spawn indices captured when you leave
  // a level, replayed on re-entry. Compact fixed blocks indexed by depth (dd_idx[depth*MAX_SPAWNS+k]).
  dd_idx:  vector<integer> not null,
  dd_n:    vector<integer> not null,   // dead count per depth (overwritten each time you leave)
  room_q0: vector<integer> not null,   // room rects (axial) — wall straightener snaps to their
  room_r0: vector<integer> not null,   //   exact rhombus side-lines; empty = pure-smooth fallback
  room_w:  vector<integer> not null,
  room_h:  vector<integer> not null,
}

// ── World queries ────────────────────────────────────────────────────

pub fn tile_at(s: Sim, q: integer, r: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 1;
  }
  tiles = s.tiles;
  ti = (r - s.rmin) * s.lw + (q - s.qmin);
  if ti < len(tiles) { tiles[ti] } else { 1 }
}

// How good a hex is as a gatherer's picking ground — lower is better, -1 = not one at all.
// Takes the STORED kind (terrain + 1), the form the level arrays hold.
//
// Alpine shelves and the rubble under the stone faces are where the good herbs are, so they
// rank first; woodland next; open grass last, because a settlement can always send someone
// into the meadowy clearings even when the mountain is shut. ⚠ The ranking is what keeps the
// flavour while making the role WORK — restricted to rank 0 the gatherer simply does not
// exist in most worlds, which is what it had been doing.
fn pick_rank(stored_kind: integer) -> integer {
  if stored_kind == K_MEADOW + 1 || stored_kind == K_SCREE + 1 { return 0; }
  if stored_kind == K_FOREST + 1 { return 1; }
  if stored_kind == K_GRASS + 1 { return 2; }
  -1
}

// Which hexes a WALKING civilian can actually reach from (sq,sr) — a flood fill over the
// bare arrays, because siting happens before a `Sim` exists.
//
// ⚠ THIS EXISTS BECAUSE A WORKER WAS GIVEN A JOB IT COULD NOT REACH. The gatherer's picking
// ground was chosen as the nearest meadow/scree at least 14 hexes out, with no check that a
// path to it existed — and on world 777 there was none at all (`sim_npc_path_dist` answers
// `FLOW_BIG` in both directions). It walked 13 hexes, stopped, and stood there for the life
// of the world. *Nearest is not reachable*, and on a map with lakes and cliffs the two come
// apart constantly.
fn walk_reach(tiles: vector<integer>, tk: vector<integer>, w: integer, h: integer,
              sq: integer, sr: integer) -> vector<integer> {
  n = w * h;
  seen: vector<integer> = [];
  for _ in 0..n { seen += [0]; }
  if sq < 1 || sr < 1 || sq >= w - 1 || sr >= h - 1 { return seen; }
  start = sr * w + sq;
  if start < 0 || start >= n { return seen; }
  seen[start] = 1;
  frontier: vector<integer> = [];
  frontier += [start];
  head = 0;
  while head < len(frontier) {
    cur = frontier[head] ?? 0;
    head += 1;
    cq = cur % w ?? 0;
    cr = cur / w ?? 0;
    for wd in 0..6 {
      (nq, nr) = hex_neighbor(cq, cr, wd);
      if nq >= 1 && nr >= 1 && nq < w - 1 && nr < h - 1 {
        ni = nr * w + nq;
        if ni >= 0 && ni < n && (seen[ni] ?? 1) == 0 {
          // the same three tests `npc_passable` makes for a walker: solid, lake, sea
          if !solid_kind(tiles[ni] ?? 1)
             && (tk[ni] ?? 0) != K_LAKE + 1 && (tk[ni] ?? 0) != K_SEA + 1 {
            seen[ni] = 1;
            frontier += [ni];
          }
        }
      }
    }
  }
  seen
}

// The solidity RULE, stated once: which hex kinds fill their hex completely.
// 1 = rock, 4 = boulder, 5 = fence post. Used on a Sim through field_blocked
// and on a bare tile array through tile_solid (generation, before a Sim exists).
fn solid_kind(t: integer) -> boolean {
  t == 1 || t == 4 || t == 5
}

// Read a stored canonical edge wall directly (edge 0=N,1=NE,2=SE on this hex).
pub fn edge_wall_raw(s: Sim, q: integer, r: integer, edge: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 0;
  }
  ws = s.walls;
  ei = ((r - s.rmin) * s.lw + (q - s.qmin)) * 3 + edge;
  if ei < len(ws) { ws[ei] } else { 0 }
}

// ── The passability chokepoint (plan #11 P1 — invariant I-TRUTH) ──────
//
// THE one predicate: does the field forbid this?  `dir` selects the question —
// DIR_HEX asks whether the hex itself is solid, 0..5 whether the step out of
// (q,r) that way is blocked, by the destination hex or by a wall on the edge
// between them.  It is the only place that turns stored world data into a
// passability answer, and its domain (hex, direction) is what plan #11 P2's
// differential harness enumerates: P2 swaps this body for the hex field, and
// no caller changes.  Everything below is a spelling of this call.
pub const DIR_HEX = -1;                    // "the hex itself", not a step out of it

pub fn field_blocked(s: Sim, q: integer, r: integer, dir: integer) -> boolean {
  if dir < 0 {
    // off the map is rock, not void — the plane stays a total partition (I-CROSS)
    if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh { return true; }
    return hexset_get(s.solid, q, r);
  }
  (fbq, fbr) = hex_neighbor(q, r, dir);
  !passable(s.field, q, r, fbq, fbr)
}

// ── Building the field (plan #11 P2) ─────────────────────────────────────────
//
// Both halves are DERIVED from what the generator already wrote, so the world builders
// are untouched and the differential harness (`src/fieldtest.loft`) can prove the answers
// are the ones we had. `tiles` keeps its other job — stairs, cave mouths, quest features
// are CONTENT questions, not passage — and stops being read for passability.

fn build_solid(tiles: vector<integer>, w: integer, h: integer) -> HexSet {
  hs = hexset_chunk(0, 0, w, h);
  for r in 0..h {
    for q in 0..w {
      ti = r * w + q;
      if solid_kind(tiles[ti] ?? 1) { hexset_set(hs, q, r, true); }
    }
  }
  hs
}

// Seal the edges. An edge is blocked when EITHER of its cells is filled (or lies off the
// map), plus every stored edge wall. Note this is deliberately not quite the old answer:
// the old predicate asked only about the DESTINATION, so a step *out of* a wall was
// permitted. That difference is only reachable from inside a wall, which I-CROSS makes
// unreachable — and `fieldtest` reports the count rather than hiding it.
fn build_field(solid: HexSet, walls: vector<integer>, w: integer, h: integer) -> EdgeSet {
  e = edgeset_new(0, 0, w, h);
  for r in 0..h {
    for q in 0..w {
      here = hexset_get(solid, q, r);
      for d in 0..6 {
        (nq, nr) = hex_neighbor(q, r, d);
        off = nq < 0 || nr < 0 || nq >= w || nr >= h;
        if here || off || hexset_get(solid, nq, nr) { edge_block(e, q, r, nq, nr); }
      }
      for ce in 0..3 {                       // the stored canonical edge walls
        wi = (r * w + q) * 3 + ce;
        if wi < len(walls) && (walls[wi] ?? 0) != 0 {
          (wq, wr) = hex_neighbor(q, r, ce);
          edge_block(e, q, r, wq, wr);
        }
      }
    }
  }
  e
}

// Does a solid full-hex wall (or the off-map edge) fill this hex?
pub fn is_wall(s: Sim, q: integer, r: integer) -> boolean {
  field_blocked(s, q, r, DIR_HEX)
}

// Is a single-hex step from (q1,r1) to (q2,r2) blocked?  Non-adjacent pairs —
// including (q1,r1) == (q2,r2) — have no shared edge, so they reduce to the
// destination's own solidity.
pub fn is_blocked_move(s: Sim, q1: integer, r1: integer, q2: integer, r2: integer) -> boolean {
  bd = hex_neighbor_dir(q1, r1, q2, r2);
  if bd < 0 { return field_blocked(s, q2, r2, DIR_HEX); }
  field_blocked(s, q1, r1, bd)
}

// ── Swept movement (plan #11 P2b — invariant I-CROSS) ────────────────────────
//
// Advance the centre from (px,py) by (dx,dy) along a SWEPT path, sliding along whatever
// stops it. The segment tested runs one PLAYER_RADIUS past the target so the centre halts
// short of the wall face — the same offset convention the old probe used. What changed is
// that the whole segment is tested instead of its end point, so the set of walls that stop
// you no longer depends on dt: dropping frames or falling fast cannot step over one.
//
// LIMIT, stated rather than implied: this sweeps the CENTRE with a radius back-off, not
// the player's disc. A wall passing within a radius of the path but not across it is not
// detected. A true swept disc is a Minkowski expansion of the edge set and belongs with
// the surfaces P5 puts on edges.
// One swept advance along a unit direction: travel at most `len`, stopping one
// PLAYER_RADIUS short of whatever the path crosses. Used for BOTH the primary move and
// the slide — a slide without the same back-off leaves the centre exactly on a wall
// boundary, where px_to_hex rounds it into the wall (which is how the first version put
// the player inside one, caught by selftest's wall-slide check).
fn swept_advance(s: Sim, px: float, py: float, ux: float, uy: float, len: float)
    -> (float, float, integer, integer, integer) {
  ext = len + PLAYER_RADIUS;
  (f0, bq0, br0, bd0) = sweep_path(s.field, px, py, px + ux * ext, py + uy * ext);
  allow = (f0 ?? 1.0) * ext - PLAYER_RADIUS;
  if allow > len { allow = len; }
  if allow < 0.0 { allow = 0.0; }
  (px + ux * allow, py + uy * allow, bq0 ?? 0, br0 ?? 0, bd0 ?? -1)
}

fn swept_step(s: Sim, px: float, py: float, dx: float, dy: float) -> (float, float) {
  len = sqrt(dx * dx + dy * dy) ?? 0.0;
  if len < 0.000001 { return (px, py); }
  ux = dx / len ?? 0.0;
  uy = dy / len ?? 0.0;
  (nx, ny, cq, cr, bd) = swept_advance(s, px, py, ux, uy, len);
  if bd < 0 { return (nx, ny); }

  // SLIDE. The blocking edge's normal is the direction between the two cell centres —
  // exact here because these walls ARE hex edges (cells sealed by build_field). When P5
  // puts real surfaces on edges, `collide` supplies the true normal instead and a curved
  // wall stops reading as facets.
  (ex, ey) = hex_to_px(cq, cr);
  (ax, ay) = hex_to_px(nb_q(cq, cr, bd), nb_r(cq, cr, bd));
  wx = ax - ex;
  wy = ay - ey;
  wl = sqrt(wx * wx + wy * wy) ?? 0.0;
  if wl < 0.000001 { return (nx, ny); }
  tx = 0.0 - (wy / wl ?? 0.0);                     // the wall's tangent
  ty = wx / wl ?? 0.0;
  gone = sqrt((nx - px) * (nx - px) + (ny - py) * (ny - py)) ?? 0.0;
  along = (ux * tx + uy * ty) * (len - gone);      // what is left of the motion, along it
  if along < 0.0 { tx = 0.0 - tx; ty = 0.0 - ty; along = 0.0 - along; }
  if along < 0.000001 { return (nx, ny); }
  (fx, fy, _, _, _) = swept_advance(s, nx, ny, tx, ty, along);
  (fx, fy)
}

// Can the player's centre at (fromx,fromy) advance so its probe point lands at
// (tox,toy)?  Returns true if that probe enters a solid hex, an enemy hex, or
// crosses a walled edge.  Used per-axis with the probe offset one radius ahead.
fn pos_blocked(s: Sim, fromx: float, fromy: float, tox: float, toy: float) -> boolean {
  (aq, ar) = px_to_hex(fromx, fromy);
  (bq, br) = px_to_hex(tox, toy);
  if enemy_blocks(s, bq, br) { return true; }
  if water_blocked(s, bq, br) { return true; }
  is_blocked_move(s, aq, ar, bq, br)   // same hex / non-adjacent -> the target's solidity
}

// Open water (lake/sea) blocks walking on the surface; rivers stay fordable.
fn water_blocked(s: Sim, q: integer, r: integer) -> boolean {
  if q < 0 || r < 0 || q >= s.lw || r >= s.lh { return false; }
  ti = r * s.lw + q;
  tk = 0;
  if ti < len(s.tkind) { tk = s.tkind[ti] ?? 0; }
  tk == K_LAKE + 1 || tk == K_SEA + 1
}

// The surface terrain kind at (q,r) — -1 in the dungeon (the view tints by it).
pub fn sim_tile_kind(s: Sim, q: integer, r: integer) -> integer {
  if q < 0 || r < 0 || q >= s.lw || r >= s.lh { return -1; }
  ti = r * s.lw + q;
  tk = 0;
  if ti < len(s.tkind) { tk = s.tkind[ti] ?? 0; }
  tk - 1
}

fn enemy_blocks(s: Sim, q: integer, r: integer) -> boolean {
  enemies = s.enemies;
  hit = false;
  for eb in 0..len(enemies) {
    e = enemies[eb];
    if e.alive && ((e.cur_q == q && e.cur_r == r) || (e.tgt_q == q && e.tgt_r == r)) {
      hit = true;
    }
  }
  hit
}

// Breadth-first distance field from (pq,pr) over reachable hexes (respecting
// solid hexes AND edge walls via is_blocked_move). flow[idx] = path length to
// the player; FLOW_BIG = unreachable. Recomputed each tick; monsters descend it
// to route around walls (vs. the old greedy step that stuck on corners).
fn compute_flow(s: Sim, pq: integer, pr: integer) -> vector<integer> {
  n = s.lw * s.lh;
  flow: vector<integer> = [];
  for _ in 0..n { flow += [FLOW_BIG]; }
  if pq >= s.qmin && pr >= s.rmin && pq < s.qmin + s.lw && pr < s.rmin + s.lh && !is_wall(s, pq, pr) {
    start = (pr - s.rmin) * s.lw + (pq - s.qmin);
    if start >= 0 && start < len(flow) { flow[start] = 0; }
    frontier: vector<integer> = [];
    frontier += [start];
    head = 0;
    while head < len(frontier) {
      cur = frontier[head] ?? 0;
      head += 1;
      cq = s.qmin + (cur % s.lw ?? 0);
      cr = s.rmin + (cur / s.lw ?? 0);
      cd = flow[cur] ?? FLOW_BIG;
      for fdir in 0..6 {
        (nq, nr) = hex_neighbor(cq, cr, fdir);
        if nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh && !is_blocked_move(s, cq, cr, nq, nr) {
          nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
          if nidx >= 0 && nidx < len(flow) {
            cn = flow[nidx] ?? FLOW_BIG;
            if cn > cd + 1 {
              flow[nidx] = cd + 1;
              frontier += [nidx];
            }
          }
        }
      }
    }
  }
  flow
}

// One step DOWN the flow gradient toward the player (routes around walls);
// never steps onto the player's own hex. Stays put if nothing is closer.
fn flow_step(s: Sim, flow: vector<integer>, eq: integer, er: integer, pq: integer, pr: integer) -> (integer, integer) {
  bq = eq;
  br = er;
  bestd = FLOW_BIG;
  if eq >= s.qmin && er >= s.rmin && eq < s.qmin + s.lw && er < s.rmin + s.lh {
    ci = (er - s.rmin) * s.lw + (eq - s.qmin);
    bestd = flow[ci] ?? FLOW_BIG;
  }
  for sdir in 0..6 {
    (nq, nr) = hex_neighbor(eq, er, sdir);
    if !is_blocked_move(s, eq, er, nq, nr) && !(nq == pq && nr == pr) && nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh {
      nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
      nd = flow[nidx] ?? FLOW_BIG;
      if nd < bestd { bestd = nd; bq = nq; br = nr; }
    }
  }
  (bq, br)
}

// ── Combat ───────────────────────────────────────────────────────────

// Nearest live enemy that is close (adjacent-ish) and ahead of the heading —
// the melee target when pressing forward into it. Returns its index, or -1.
fn front_enemy(s: Sim) -> integer {
  // (civilians are skipped below — bumping them is not an attack)
  fx = cos(s.heading);
  fy = sin(s.heading);
  reach = HEX_LEN * 1.3;
  best = -1;
  bestd = reach * reach;
  enemies = s.enemies;
  for fe in 0..len(enemies) {
    e = enemies[fe];
    if e.alive && e.role == 0 {
      (ecx, ecy) = hex_to_px(e.cur_q, e.cur_r);
      rx = ecx - s.px;
      ry = ecy - s.py;
      d2 = rx * rx + ry * ry;
      dot = rx * fx + ry * fy;
      if dot > 0.0 && d2 <= bestd { bestd = d2; best = fe; }
    }
  }
  best
}

// ── Hero progression (XP / level / HP) ───────────────────────────────

// Max HP at a character level. Class-INDEPENDENT by design: every class gets the
// same HP (fair progression — §3a #3). Tankiness is lateral gear, not a class lock:
// heavy/metal armour adds HP% (and raises spell-cost%) in G3. Gentle curve (§3a #2):
// modest per-level growth so a run spans a few×, not 10×+.
fn hero_maxhp(clevel: integer) -> integer {
  HERO_HP_BASE + clevel * HERO_HP_PER_LEVEL
}

// Total XP required to be AT a character level (quadratic growth).
fn xp_for_level(lvl: integer) -> integer {
  if lvl <= 1 { return 0; }
  (lvl - 1) * (lvl - 1) * 10
}

// ── Equipment (G3): wield items; effects feed combat + HP ────────────
// Equipment is lateral progression (§3a #3): a weapon raises melee damage, armour
// adds HP and reduces incoming damage. Derived stats are cached (wdam/pac) and
// refreshed only on equip/unequip/level-up, so combat reads fields — not item_table —
// per hit. (Percentage / typed-resist modifiers + the metal/cloth spell-cost axis
// layer on later; this slice is the wield mechanic + flat weapon/armour effects.)

// Recompute cached weapon damage, armour class, and max HP from the equipped slots.
// Same module as its &-callers (C4). AC feeds BOTH max HP (heavy armour = tanky — the
// fighter's compensation, §3a #3) and damage reduction.
// ⚠ I-MEND RIDES ON THIS FUNCTION BEING A DERIVATION (plan #17 `S6`). Every number below is
// recomputed from the def table plus the current flags — never incremented, never patched in
// place — so *repair is the exact inverse of damage* holds structurally rather than by
// arithmetic care: clear the flag and `pac`/`wdam`/`phpmax` return to the identical values.
// Damaging is idempotent for the same reason. Anything here that started ACCUMULATING would
// break the invariant silently, which is why the damage term is a factor on a read, not a
// subtraction from a stored total.
fn refresh_stats(s: &Sim) {
  itbl = game_items();
  eq = s.eq;
  ed = s.eq_dmg;
  ac = 0;
  for sl in 0..NUM_SLOTS {
    e = eq[sl] ?? 0;
    if e > 0 {
      a1 = item_ac(itbl, e - 1);
      if (ed[sl] ?? 0) != 0 { a1 = a1 / 2 ?? 0; }   // damaged: the piece protects half as well
      ac += a1;
    }
  }
  wd = PLAYER_DAM;
  w = eq[SLOT_WEAPON] ?? 0;
  if w > 0 {
    dd = item_dd(itbl, w - 1);
    ds = item_ds(itbl, w - 1);
    if dd > 0 && ds > 0 {
      avg = dd * (ds + 1) / 2 ?? 0;                                  // average weapon roll
      if (ed[SLOT_WEAPON] ?? 0) != 0 { avg = avg / 2 ?? 0; }         // damaged: a chipped edge
      wd += avg;
    }
  }
  wd += sim_skill_melee(s);   // passive melee skill (level + STR) sharpens melee damage
  s.wdam = wd;
  s.pac = ac;
  oldmax = s.phpmax;
  // Max HP: the class-uniform base + armour + the cached race/class hit-die + ENDURANCE
  // (plan #16 `M4`). ⚠ `endu_hp_bonus` reads the PERMANENT layer (I-POOL) — a 2-tick potion
  // must not move a stored ceiling.
  newmax = hero_maxhp(s.player.clevel) + ac + rc_hp_bonus(s) + endu_hp_bonus(s);
  if newmax < 1 { newmax = 1; }
  if newmax > oldmax { s.php += newmax - oldmax; }   // donning armour grants the HP
  if s.php > newmax { s.php = newmax; }
  if s.php < 1 { s.php = 1; }
  s.phpmax = newmax;
  // Max SP: realm casters draw from their spell stat (level + stat headroom); realm "none" => 0/0
  // (the sidebar SP row stays the status pip). Mirrors the HP grant-on-increase. Reads the CACHED
  // realm/spell-stat (apply_creation bakes them — no catalog merge in here).
  newsp = 0;
  if s.rc_realm != "none" && s.rc_realm != "" {
    bonus = 0;
    if s.rc_spi >= 0 { bonus = stat_perm(s, s.rc_spi) - HERO_CON; }   // I-POOL: permanent layer only
    newsp = 2 + s.player.clevel + bonus;
    if newsp < 1 { newsp = 1; }
  }
  oldsp = s.spmax;
  if newsp > oldsp { s.sp += newsp - oldsp; }
  if s.sp > newsp { s.sp = newsp; }
  if s.sp < 0 { s.sp = 0; }
  s.spmax = newsp;
}

// Reduce an incoming hit by armour class as a never-100% percentage (§3a #2/#3:
// nothing fully negated): dmg * 100 / (100 + ac), floored at 1.
fn apply_dr(dmg: integer, ac: integer) -> integer {
  v = dmg * 100 / (100 + ac) ?? dmg;
  if v < 1 { v = 1; }
  v
}

// Equip the inventory item at index `ii` into its slot; any displaced item returns to
// that inventory slot, else the slot is removed (compacted). Recomputes stats.
pub fn sim_equip(s: &Sim, ii: integer) {
  iv = s.inv;
  if ii < 0 || ii >= s.ninv || ii >= len(iv) { return; }
  defidx = iv[ii] ?? -1;
  if defidx < 0 { return; }
  sim_identify(s, defidx);                  // wielding reveals the kind (rings/amulets) for the game
  itbl = game_items();
  sl = item_slot(itbl, defidx);
  eq = s.eq;
  if sl <= 0 || sl >= len(eq) { return; }   // not wieldable / out of range
  // Rings have TWO locations (L = SLOT_RING, R = SLOT_RING2): fill the first free, else swap the left.
  if sl == SLOT_RING {
    if (eq[SLOT_RING] ?? 0) == 0 { sl = SLOT_RING; }
    else if SLOT_RING2 < len(eq) && (eq[SLOT_RING2] ?? 0) == 0 { sl = SLOT_RING2; }
    else { sl = SLOT_RING; }
  }
  prev = eq[sl] ?? 0;
  // ⚠ THE DAMAGE MOVES WITH THE ITEM, IN LOCKSTEP WITH THE DEF INDEX (I-MEND). Every write
  // to `eq`/`inv` in this file has a partner write here; a missed one is a SILENT repair,
  // which is the one failure this design can have. `mendtest` walks each seam for that reason.
  ed = s.eq_dmg;
  idg = s.inv_dmg;
  mydmg = 0;
  if ii < len(idg) { mydmg = idg[ii] ?? 0; }
  prevdmg = 0;
  if sl < len(ed) { prevdmg = ed[sl] ?? 0; }
  if sl < len(eq) { eq[sl] = defidx + 1; }
  if sl < len(ed) { ed[sl] = mydmg; }
  if prev > 0 {
    if ii < len(iv) { iv[ii] = prev - 1; }   // swap: displaced item takes the slot
    if ii < len(idg) { idg[ii] = prevdmg; }  //   — carrying its own condition back
  } else {
    n = s.ninv;
    for k in ii..(n - 1) {
      if k >= 0 && k + 1 < len(iv) { iv[k] = iv[k + 1] ?? -1; }   // remove: shift down
      if k >= 0 && k + 1 < len(idg) { idg[k] = idg[k + 1] ?? 0; }
    }
    s.ninv = n - 1;
  }
  refresh_stats(s);
}

// Unequip slot `sl` back to inventory (if room). Recomputes stats.
pub fn sim_unequip(s: &Sim, sl: integer) {
  eq = s.eq;
  if sl <= 0 || sl >= len(eq) { return; }
  e = eq[sl] ?? 0;
  if e == 0 { return; }
  iv = s.inv;
  ed = s.eq_dmg;
  idg = s.inv_dmg;
  n = s.ninv;
  if n >= 0 && n < len(iv) {
    iv[n] = e - 1;
    if n < len(idg) && sl < len(ed) { idg[n] = ed[sl] ?? 0; }   // I-MEND: taking it off is not mending it
    s.ninv = n + 1;
  }
  if sl < len(eq) { eq[sl] = 0; }
  if sl < len(ed) { ed[sl] = 0; }
  refresh_stats(s);
}

// Seed the class-as-kit starting loadout (BUNDLE.md): a dagger + soft leather armour,
// equipped. A single generic kit for now; per-class kits arrive with classes.
pub fn sim_starting_loadout(s: &Sim) {
  itbl = game_items();
  di = item_index(itbl, "dagger");
  ai = item_index(itbl, "soft_leather_armor");
  eq = s.eq;
  if di >= 0 && SLOT_WEAPON < len(eq) { eq[SLOT_WEAPON] = di + 1; }
  if ai >= 0 && SLOT_BODY < len(eq) { eq[SLOT_BODY] = ai + 1; }
  refresh_stats(s);
}

// ── Kernel player-mutation primitives ────────────────────────────────
// The Player methods (player.loft) wrap these; the actual &Sim mutation lives HERE,
// where cross-module writes are proven (equiptest calls sim_equip across modules). Today
// they act on the single player; when multi-player lands they take a player slot.

// Add an item (by key) to the player's inventory — fixed array + count (C18-safe).
pub fn sim_give_item(s: &Sim, key: text) {
  itbl = game_items();
  idx = item_index(itbl, key);
  if idx >= 0 && s.ninv < INV_MAX {
    n = s.ninv;
    v = s.inv;
    v[n] = idx;
    // ⚠ ZERO THE CONDITION, DO NOT INHERIT IT. `sim_consume_inv` shifts the tail down and
    // leaves the vacated slot holding its old value, so an arriving item that trusted the
    // slot would be born damaged by whatever stood there last (I-MEND).
    dgv = s.inv_dmg;
    if n < len(dgv) { dgv[n] = 0; }
    s.ninv = n + 1;
    sim_qs_autoslot(s, idx);    // first useable item of its kind auto-fills a quick-slot
  }
}

// ── Quick-slots: a uniform 1-9 + Q/E bar over usable items (SLICE: the quick-slot bar) ──
// A slot holds an item DEFIDX+1 (0 = empty), mirroring eq[]. Binding is by def (stable across
// consume/refill); a def lives in at most ONE slot. Auto-slot + manual reslot share sim_qs_bind.

// First inventory index carrying def `defidx`, or -1. (Slot bindings are by def, not inv index,
// so dispatch resolves the def to a live inventory entry here.)
pub fn sim_inv_find(s: Sim, defidx: integer) -> integer {
  iv = s.inv;
  out = -1;
  for i in 0..s.ninv {
    if out < 0 && i < len(iv) {
      if (iv[i] ?? -1) == defidx { out = i; }
    }
  }
  out
}

// Quick-slot k -> bound item defidx (or -1 if empty). The view reads this for name/glyph.
pub fn sim_qs_def(s: Sim, k: integer) -> integer {
  q = s.qs;
  if k < 0 || k >= len(q) { return -1; }
  d1 = q[k] ?? 0;
  if d1 == 0 { return -1; }
  d1 - 1
}

// Slot index currently holding def `defidx`, or -1. (Used to enforce one-slot-per-def.)
fn qs_find(s: Sim, defidx: integer) -> integer {
  q = s.qs;
  out = -1;
  for i in 0..len(q) {
    if out < 0 {
      if (q[i] ?? 0) == defidx + 1 { out = i; }
    }
  }
  out
}

// Bind def `defidx` to quick-slot k (the one primitive behind auto-slot AND manual reslot). A def
// lives in at most one slot, so any prior slot holding it is cleared first (re-bind = move). The
// slot's previous occupant is simply overwritten (unbound). defidx < 0 clears the slot.
pub fn sim_qs_bind(s: &Sim, k: integer, defidx: integer) {
  q = s.qs;
  if k < 0 || k >= len(q) { return; }
  if defidx < 0 { q[k] = 0; return; }
  prev = qs_find(s, defidx);                 // move: clear an existing binding of this def
  if prev >= 0 && prev < len(q) { q[prev] = 0; }
  q[k] = defidx + 1;
}

// Auto-slot a freshly-acquired item by category (SLICE type-routing): a consumable fills the next
// free numeric slot 0..8; a launcher auto-equips + binds active slot Q; ammo is fuel (no slot);
// anything else (worn gear) gets no quick-slot. Idempotent: an already-slotted def is left alone.
pub fn sim_qs_autoslot(s: &Sim, defidx: integer) {
  if defidx < 0 { return; }
  itbl = game_items();
  if item_is_quest(itbl, defidx) { return; } // a quest keepsake is never quick-slotted (inspect-only)
  cat = item_cat(itbl, defidx);
  if qs_find(s, defidx) >= 0 { return; }     // already slotted (e.g. picked up a second of the same)
  if cat == IT_POTION || cat == IT_SCROLL || cat == IT_FOOD {
    q = s.qs;
    free = -1;
    for i in 0..QS_Q {                        // numeric slots 0..8 only (Q/E reserved for actives)
      if free < 0 {
        if (q[i] ?? 0) == 0 { free = i; }
      }
    }
    if free >= 0 { sim_qs_bind(s, free, defidx); }
  }
  if cat == IT_BOW {
    j = sim_inv_find(s, defidx);              // equip the launcher we just picked up...
    if j >= 0 { sim_equip(s, j); }
    sim_qs_bind(s, QS_Q, defidx);             // ...and bind FIRE to active slot Q
  }
}

// Quick-slot k -> the count to show on the bar. For a launcher slot it's the matching ammo carried
// (the quiver); for a consumable it's how many of that def are in inventory. 0 = empty/none left.
pub fn sim_qs_count(s: Sim, k: integer) -> integer {
  defidx = sim_qs_def(s, k);
  if defidx < 0 { return 0; }
  itbl = game_items();
  cat = item_cat(itbl, defidx);
  iv = s.inv;
  n = 0;
  if cat == IT_BOW {
    for i in 0..s.ninv {                      // count arrows/shots/bolts in the quiver
      if i < len(iv) {
        if item_cat(itbl, iv[i] ?? -1) == IT_AMMO { n = n + 1; }
      }
    }
  } else {
    for i in 0..s.ninv {                      // count this consumable's stack
      if i < len(iv) {
        if (iv[i] ?? -1) == defidx { n = n + 1; }
      }
    }
  }
  n
}

// ── Unknown items (the Angband "mystery") ──────────────────────────────────────────────────
// Magic goods (potions/scrolls/wands/staves/rings/amulets) read as a shuffled FLAVOUR ("a Crimson
// Potion") until the KIND is identified — using one (quaff/read/wield) or a Scroll of Identify
// reveals it for the whole GAME. `known[defidx]` = this kind is identified; `flavour_idx[defidx]` =
// its per-game flavour. IF_KNOWN/IF_QUEST items (e.g. the antivenin) skip the system. The mapping +
// known set are assigned once (assign_flavours) and carried across levels/death.

// Has this item KIND been identified this game?
pub fn sim_identified(s: Sim, defidx: integer) -> boolean {
  kv = s.known;
  if defidx < 0 || defidx >= len(kv) { return false; }
  (kv[defidx] ?? 0) != 0
}

// Mark this item KIND identified. Returns true if it was NEWLY revealed (for the "It was …!" line).
pub fn sim_identify(s: &Sim, defidx: integer) -> boolean {
  kv = s.known;
  if defidx < 0 || defidx >= len(kv) { return false; }
  if (kv[defidx] ?? 0) != 0 { return false; }
  kv[defidx] = 1;                            // index-write on a captured field vector persists (C18)
  true
}

// The name to SHOW for item `defidx`: the real name once identified / always-known / not a mystery
// type; otherwise the per-game flavour. The one place the view/messages resolve an item's name.
pub fn sim_item_display_name(s: Sim, defidx: integer) -> text {
  itbl = game_items();
  if defidx < 0 || defidx >= len(itbl) { return ""; }
  d = itbl[defidx];
  cat = d.i_cat;
  if !item_unknown_type(cat) || item_known_flag(itbl, defidx) || sim_identified(s, defidx) {
    return item_name(itbl, defidx);
  }
  fi = s.flavour_idx;
  flavour_name(cat, fi[defidx] ?? 0)
}

// Scroll of Identify (slice behaviour — no per-item prompt yet): reveal the first carried item whose
// KIND is still a mystery. Returns the def identified, or -1 if nothing carried is unknown.
pub fn sim_identify_carried(s: &Sim) -> integer {
  iv = s.inv;
  itbl = game_items();
  for i in 0..s.ninv {
    if i < len(iv) {
      di = iv[i] ?? -1;
      if di >= 0 && di < len(itbl) {
        d = itbl[di];
        if item_unknown_type(d.i_cat) && !item_known_flag(itbl, di) && !sim_identified(s, di) {
          sim_identify(s, di);
          return di;
        }
      }
    }
  }
  -1
}

// Number of item defs in the MERGED catalog (base + bundles) — the view sizes its baked name array
// to this so a quick-slotted BUNDLE item (whose defid sits past the base table) still shows its name.
pub fn sim_item_count() -> integer { len(game_items()) }

// Category (IT_*) of merged-catalog def `defidx`, or -1 if out of range. Lets the view classify a
// quick-slot's bound item (launcher vs consumable) without importing the catalog merge itself.
pub fn sim_item_cat(defidx: integer) -> integer {
  itbl = game_items();
  if defidx < 0 || defidx >= len(itbl) { return -1; }
  d = itbl[defidx];
  d.i_cat
}

// How many item KINDS are identified this game. The view watches this to know when a quick-slot
// name changed (flavour → real) and re-bakes the always-visible bar (it bakes once, not per frame).
pub fn sim_known_count(s: Sim) -> integer {
  kv = s.known;
  n = 0;
  for i in 0..len(kv) { if (kv[i] ?? 0) != 0 { n += 1; } }
  n
}

// SHORT display name for the always-visible quick-slot bar / inventory column: the per-game flavour
// while a mystery, else the short real name (drops the "Category of " prefix). The short sibling of
// sim_item_display_name — same identified/known-flag/not-a-mystery gate.
pub fn sim_item_short_name(s: Sim, defidx: integer) -> text {
  itbl = game_items();
  if defidx < 0 || defidx >= len(itbl) { return ""; }
  d = itbl[defidx];
  cat = d.i_cat;
  if !item_unknown_type(cat) || item_known_flag(itbl, defidx) || sim_identified(s, defidx) {
    return item_short_idx(itbl, defidx);
  }
  fi = s.flavour_idx;
  flavour_name(cat, fi[defidx] ?? 0)
}

// Inventory slot -> item key (for use/inspect routines). "" if empty or out of range.
pub fn sim_inv_key(s: Sim, slot: integer) -> text {
  iv = s.inv;
  if slot < 0 || slot >= s.ninv || slot >= len(iv) { return ""; }
  defidx = iv[slot] ?? -1;
  item_key(game_items(), defidx)
}

// Inventory slot -> the item's display name (for the inventory screen). "" if empty/out of range.
pub fn sim_inv_name(s: Sim, slot: integer) -> text {
  iv = s.inv;
  if slot < 0 || slot >= s.ninv || slot >= len(iv) { return ""; }
  defidx = iv[slot] ?? -1;
  "{sim_item_display_name(s, defidx)}{dmg_suffix(sim_inv_damaged(s, slot))}"
}
// Description of the carried item in `slot` (the inventory hub's examine line). "" if empty.
pub fn sim_inv_desc(s: Sim, slot: integer) -> text {
  iv = s.inv;
  if slot < 0 || slot >= s.ninv || slot >= len(iv) { return ""; }
  item_desc(game_items(), iv[slot] ?? -1)
}
// Bind the carried item in `inv_slot` to quick-slot `qslot` (the inventory hub's manual reslot).
pub fn sim_inv_bind(s: &Sim, inv_slot: integer, qslot: integer) {
  iv = s.inv;
  if inv_slot < 0 || inv_slot >= s.ninv || inv_slot >= len(iv) { return; }
  sim_qs_bind(s, qslot, iv[inv_slot] ?? -1);
}

// First inventory slot holding item `key`, or -1.
pub fn sim_find_item(s: Sim, key: text) -> integer {
  itbl = game_items();
  target = item_index(itbl, key);
  if target < 0 { return -1; }
  iv = s.inv;
  for i in 0..s.ninv {
    if i < len(iv) && (iv[i] ?? -1) == target { return i; }
  }
  -1
}

// Remove one item from inventory slot `slot` (shift the tail down) — a single-use consume.
pub fn sim_consume_inv(s: &Sim, slot: integer) {
  iv = s.inv;
  idg = s.inv_dmg;
  n = s.ninv;
  if slot < 0 || slot >= n { return; }
  for k in slot..(n - 1) {
    if k >= 0 && k + 1 < len(iv) { iv[k] = iv[k + 1] ?? -1; }
    if k >= 0 && k + 1 < len(idg) { idg[k] = idg[k + 1] ?? 0; }   // the condition shifts with the item
  }
  s.ninv = n - 1;
}

// Monster detection (see-through-walls) for `turns` ticks; decays in sim_tick.
pub fn sim_reveal_monsters(s: &Sim, turns: integer) { s.detect_t = turns; }
pub fn sim_detect_active(s: Sim) -> boolean { s.detect_t > 0 }

// Equip an item (by key) into its own slot, then refresh derived stats.
pub fn sim_equip_by_key(s: &Sim, key: text) {
  itbl = game_items();
  idx = item_index(itbl, key);
  if idx >= 0 && idx < len(itbl) {
    d = itbl[idx];
    sl = d.i_slot;
    eq = s.eq;
    ed = s.eq_dmg;
    if sl >= 0 && sl < len(eq) { eq[sl] = idx + 1; }
    if sl >= 0 && sl < len(ed) { ed[sl] = 0; }   // conjured straight into the slot: sound
  }
  refresh_stats(s);
}

// ---- Statistics: three layers (innate max / current / temporary modifier) ----------------
// The EIGHT -> vector index. -1 = unknown (the stat ops then no-op).
pub fn stat_index(stat: text) -> integer {
  if stat == "might" { return 0; }
  if stat == "endu"  { return 1; }
  if stat == "dex"   { return 2; }
  if stat == "perc"  { return 3; }
  if stat == "speed" { return 4; }
  if stat == "will"  { return 5; }
  if stat == "char"  { return 6; }
  if stat == "hand"  { return 7; }
  // ✅ THE LEGACY ARM IS GONE (plan #16 `M3`, 2026-08-11). It aliased `str/con/int/wis/chr`
  // onto the eight for exactly one step, while the 18 bundles still carried the old six named
  // fields. They now carry `r_might…r_hand` / `c_might…c_hand` and every caster declares
  // `c_spell_stat: "will"`, so the old keys resolve to -1 like any other typo — which is the
  // point: an unknown stat key must be an ERROR, not a quiet redirect to whatever it used to be.
  -1
}

// The starting stat block — uniform, and eight long by `NUM_STATS` rather than by a literal
// row, so the axis count lives in exactly one place (I-AXIS).
fn start_stats() -> vector<integer> {
  t: vector<integer> = [];
  for _ in 0..NUM_STATS { t += [HERO_CON]; }
  t
}

// ── Race application (the chosen race's RaceDef modifies the live character) ──────────────────
// The race key lives on the Sim; everything but the STAT BLOCK is derived LIVE from it (skills /
// hit-die / save / flags), so only the stat block needs baking into stat_max (grants mutate that).

// Hit-die HP at the current level from the CACHED combined hit-die (race + class; baked by
// apply_creation): rc_hd>0 => tankier (warrior/half-troll), <0 => frailer (elf). Level-scaled.
fn rc_hp_bonus(s: Sim) -> integer {
  s.rc_hd * (s.player.clevel + 2) / 2 ?? 0
}

// ENDURANCE HP at the current level — §0's *"mitigation / HP ceiling — soak"*, keyed by plan
// #16 `M4`. Deliberately the SAME SHAPE as the hit-die bonus above (a per-point term scaled by
// level) at HALF its weight, so the two stack legibly instead of the stat quietly out-weighing
// the class choice: a half-troll warrior carries +4 Endurance into +18 HP by level 10, against
// the hit-die's +54, and a human mage's -2 costs it 6.
//
// ⚠ SOAK IS THE HP CEILING HERE, not a second damage-reduction term. §0 names Endurance
// "mitigation / HP" as ONE role, and damage reduction is already armour's number (`apply_dr`
// on `pac`); keying Endurance into both would make one axis pay twice while Charisma and
// Handiness pay nothing.
//
// ⚠ Reads `stat_perm`, not `stat_eff` — I-POOL. See the note on stat_perm for what reading the
// overlay here would have cost.
fn endu_hp_bonus(s: Sim) -> integer {
  (stat_perm(s, ST_ENDU) - HERO_CON) * (s.player.clevel + 2) / 4 ?? 0
}

// XP required to BE at level `lvl` for THIS character: the base curve scaled by the CACHED
// combined race × class experience factor (Angband's expfact; 100 = baseline).
fn xp_need(s: Sim, lvl: integer) -> integer {
  xp_for_level(lvl) * s.rc_xpf / 100 ?? 0
}

// A stat is SUSTAINED when the race carries its RF_SUST_* flag — drain simply fails (Angband
// sustains). Only the three PHYSICAL axes have sustain flags in the vocabulary (plan #16 `M3`
// renamed them off the old six: RF_SUST_STR/CON -> RF_SUST_MIGHT/ENDU).
fn stat_sustained(s: Sim, i: integer) -> boolean {
  if i == ST_MIGHT { return (s.rc_flags & RF_SUST_MIGHT) != 0; }
  if i == ST_DEX { return (s.rc_flags & RF_SUST_DEX) != 0; }
  if i == ST_ENDU { return (s.rc_flags & RF_SUST_ENDU) != 0; }
  false
}

// Angband class skill numbers ride a 0..40ish scale; our passive skills are small flat bonuses.
// One adapter constant maps between them (tuning knob, §3a: systems faithful, numbers friendly).
CLASS_SKILL_DIV = 6;

// Apply the CREATION choices: bake the race+class STAT BLOCKS onto the uniform base, and CACHE
// every derived number the hot paths read (the wdam/pac idiom — skills/save/xp/regen read fields,
// never re-merging the catalogs per call; catalog churn in a hot loop = store pressure, loft#303).
// Idempotent (re-derives from base), so the crystal's re-spec re-applies cleanly; the catalog
// lookups happen ONLY here.
fn apply_creation(s: &Sim) {
  rd = race_find(race_catalog(), s.race);
  cd = class_find(class_catalog(), s.pclass);
  base = start_stats();
  // ✅ THE PLACEHOLDER IS GONE (plan #16 `M3`): race and class each state all EIGHT axes, so
  // the two lists below are a straight read of authored content — no axis is derived from
  // another and none is left at a manufactured zero. The order is `stat_name`'s, and the field
  // name is the stat key, so a mis-ordered row is a compile error rather than a silent swap.
  rmods = [rd.r_might, rd.r_endu, rd.r_dex, rd.r_perc, rd.r_speed, rd.r_will, rd.r_char, rd.r_hand];
  cmods = [cd.c_might, cd.c_endu, cd.c_dex, cd.c_perc, cd.c_speed, cd.c_will, cd.c_char, cd.c_hand];
  sm = s.stat_max;
  sc = s.stat_cur;
  for i in 0..NUM_STATS {
    v = (base[i] ?? 0) + (rmods[i] ?? 0) + (cmods[i] ?? 0);
    if v < 3 { v = 3; }
    sm[i] = v;
    sc[i] = v;
  }
  s.rc_flags = rd.r_flags;
  s.rc_melee = rd.r_melee + cd.c_melee / CLASS_SKILL_DIV;
  s.rc_bow = rd.r_bow + cd.c_bow / CLASS_SKILL_DIV;
  s.rc_stealth = rd.r_stealth + cd.c_stealth;   // class stealth is already on the small scale
  s.rc_save = rd.r_save + cd.c_save / CLASS_SKILL_DIV;
  s.rc_hd = rd.r_hd + cd.c_hd;
  s.rc_xpf = rd.r_xp * cd.c_xp / 100 ?? 100;
  s.rc_realm = cd.c_realm;
  s.rc_spi = stat_index(cd.c_spell_stat);
  refresh_stats(s);   // CON + hit-dies + realm changed -> recompute max HP and max SP
}

// Choose race / class (creation or the crystal's re-spec): set the key, re-bake, recompute.
pub fn sim_set_race(s: &Sim, key: text) {
  s.race = key;
  apply_creation(s);
}
pub fn sim_set_class(s: &Sim, key: text) {
  s.pclass = key;
  apply_creation(s);
}
pub fn sim_player_race(s: Sim) -> text { s.race }
pub fn sim_player_class(s: Sim) -> text { s.pclass }

// ── The shrine (the spawning crystal's re-spec) ────────────────────────────────────────────
// Bumping a MF_SHRINE entity raises a pending INTERACT (sim_step); the view polls + clears it
// and opens the crystal page. Applying a choice re-derives the character (apply_creation is
// idempotent) and makes them WHOLE — full heal, full mind ("the crystal reshapes you").
// Inventory/equipment unchanged; the class KIT is a new-game grant only (no re-spec farming).
pub fn sim_shrine_pending(s: Sim) -> integer { s.shrine_ev }

// ── SPAWN ANCHORS: any feature can claim the player's respawn ────────────────
// The save stairs claim it, the crystal claims it, the bed will (plan #4
// Phase H), and any later spawner just calls sim_anchor_here. The LAST claim
// wins; sim_respawn regenerates the anchor's level/window and wakes the player
// on the anchor hex, whole again.
fn anchor_wake(kind: integer) -> text {
  if kind == 2 { return "You wake beside the crystal, your wounds knit."; }
  if kind == 3 { return "You wake in your own bed, whole again."; }
  "You wake at the last save point, your wounds knit."
}

pub fn sim_anchor_here(s: &Sim, kind: integer) {
  (aq, ar) = px_to_hex(s.px, s.py);
  s.anc_kind = kind;
  s.anc_depth = s.depth;
  s.anc_wx = s.win_x;
  s.anc_wy = s.win_y;
  s.anc_q = aq;
  s.anc_r = ar;
}

pub fn sim_anchor_kind(s: Sim) -> integer { s.anc_kind }

pub fn sim_quest_poster(s: Sim) -> integer { s.q_poster }
pub fn sim_quest_mage(s: Sim) -> integer { s.q_mage }
pub fn sim_enemy_tags(s: Sim, i: integer) -> integer {
  ev = s.enemies;
  if i >= 0 && i < len(ev) { e = ev[i]; return e.tags; }
  0
}
pub fn sim_shrine_clear(s: &Sim) { s.shrine_ev = 0; }
pub fn sim_shrine_apply(s: &Sim, kind: text, key: text) {
  if kind == "race" { sim_set_race(s, key); }
  if kind == "class" { sim_set_class(s, key); }
  s.php = s.phpmax;
  s.sp = s.spmax;
  sim_log(s, "The crystal reshapes you.");
}

// Race/class roster accessors for the CHOICE UI (the crystal page) — the view reads the merged
// catalogs only through these (architecture invariant). Page-build only, never per-frame.
pub fn sim_race_count() -> integer { len(race_catalog()) }
pub fn sim_race_key(i: integer) -> text {
  t = race_catalog();
  if i < 0 || i >= len(t) { return ""; }
  rd = t[i];
  rd.r_key
}
pub fn sim_race_name(i: integer) -> text {
  t = race_catalog();
  if i < 0 || i >= len(t) { return ""; }
  rd = t[i];
  rd.r_name
}
pub fn sim_race_desc(i: integer) -> text {
  t = race_catalog();
  if i < 0 || i >= len(t) { return ""; }
  rd = t[i];
  rd.r_desc
}
pub fn sim_class_count() -> integer { len(class_catalog()) }
pub fn sim_class_key(i: integer) -> text {
  t = class_catalog();
  if i < 0 || i >= len(t) { return ""; }
  cd = t[i];
  cd.c_key
}
pub fn sim_class_name(i: integer) -> text {
  t = class_catalog();
  if i < 0 || i >= len(t) { return ""; }
  cd = t[i];
  cd.c_name
}
pub fn sim_class_desc(i: integer) -> text {
  t = class_catalog();
  if i < 0 || i >= len(t) { return ""; }
  cd = t[i];
  cd.c_desc
}
// The class's casting realm ("none" for the unclassed/warrior) — castfx + the view read this.
pub fn sim_player_realm(s: Sim) -> text { s.rc_realm }
// Race ability flags wired to the systems that exist: free-action gates the gaze paralysis; resist-
// poison gates monster venom. (Other RF_* flags wait on their systems — see BUNDLE-MIGRATION.md.)
// All read the CACHED flag bitmask (no catalog merge per query).
pub fn sim_player_free_action(s: Sim) -> boolean { (s.rc_flags & RF_FREE_ACTION) != 0 }
pub fn sim_player_res_poison(s: Sim) -> boolean { (s.rc_flags & RF_RES_POISON) != 0 }

// Effective value of stat i = current + the temporary modifier WHILE it is still active.
// The PERMANENT layer of a stat — innate max after any drain/gain, with the temporary potion
// overlay deliberately EXCLUDED.
//
// **I-POOL: a STORED pool derives only from the permanent layers; the temporary layer is a
// live-read overlay that never enters stored state.** `refresh_stats` writes `phpmax`/`spmax`
// into the Sim, so anything it reads is *frozen there* until something else re-derives — and
// `sim_buff_stat` pointedly does NOT re-derive, which is what made the overlay live-only.
//
// ⚠ IT WAS ALREADY BROKEN AT ONE SITE, measured in plan #16 `M4`: `refresh_stats` read
// `stat_eff` for the SP pool, so a temporary Will potion plus ANY unrelated re-derive (equip a
// helmet, gain a level, drink a stat-gain potion) baked the potion's points into `spmax`, where
// they outlived it — `base=7 → 11 → still 11 long after expiry`. Not reachable by the buff
// alone, which is why it sat there. The fix is this accessor at the one site that stores, not a
// re-derive hook on expiry: the overlay should never have reached stored state at all.
fn stat_perm(s: Sim, i: integer) -> integer {
  if i < 0 { return 0; }
  cv = s.stat_cur;
  cv[i] ?? 0
}

fn stat_eff(s: Sim, i: integer) -> integer {
  if i < 0 { return 0; }
  cv = s.stat_cur;
  c = cv[i] ?? 0;
  ttv = s.stat_tmp_t;
  if (ttv[i] ?? 0) > 0 {
    tv = s.stat_tmp;
    c = c + (tv[i] ?? 0);
  }
  c
}

// Permanent GAIN (stat-gain potion / level reward): raise innate max AND current.
pub fn sim_grant_stat(s: &Sim, stat: text, n: integer) {
  i = stat_index(stat);
  if i >= 0 {
    mx = s.stat_max; mx[i] = (mx[i] ?? 0) + n;
    cu = s.stat_cur; cu[i] = (cu[i] ?? 0) + n;
    refresh_stats(s);
  }
}

// Permanent DRAIN (restorable): lower current only, never below 1; innate max is untouched so
// a later restore brings it back.
pub fn sim_drain_stat(s: &Sim, stat: text, n: integer) {
  i = stat_index(stat);
  if i >= 0 {
    if stat_sustained(s, i) { sim_log(s, "Your body resists the drain."); return; }
    cu = s.stat_cur;
    c = (cu[i] ?? 0) - n;
    if c < 1 { c = 1; }
    cu[i] = c;
    refresh_stats(s);
  }
}

// RESTORE a drained stat: current returns to its innate max.
pub fn sim_restore_stat(s: &Sim, stat: text) {
  i = stat_index(stat);
  if i >= 0 {
    mx = s.stat_max;
    cu = s.stat_cur;
    cu[i] = mx[i] ?? 0;
    refresh_stats(s);
  }
}

// TEMPORARY modifier (good potion = +n, bad potion = -n) for `turns` ticks. Last-wins: the
// newest potion overrides any active one (opposite signs cancel). Decays in sim_tick.
pub fn sim_buff_stat(s: &Sim, stat: text, n: integer, turns: integer) {
  i = stat_index(stat);
  if i >= 0 {
    tv = s.stat_tmp; tv[i] = n;
    ttv = s.stat_tmp_t; ttv[i] = turns;
  }
}

// Stat accessors (effective / current / innate) for the view + tests.
pub fn sim_stat(s: Sim, stat: text) -> integer { stat_eff(s, stat_index(stat)) }
pub fn sim_stat_cur(s: Sim, stat: text) -> integer {
  i = stat_index(stat);
  if i < 0 { return 0; }
  v = s.stat_cur; v[i] ?? 0
}
pub fn sim_stat_max(s: Sim, stat: text) -> integer {
  i = stat_index(stat);
  if i < 0 { return 0; }
  v = s.stat_max; v[i] ?? 0
}

// Teach a class skill / saving throw. Placeholders: the per-player skill & save stores land
// with the skill system. Kept so the Player API is stable now (scripts/events written today
// won't change). The args document the shape; they no-op until those fields exist.
pub fn sim_grant_skill(s: &Sim, skill: text, n: integer) {
  if false { s.player.gold = s.player.gold + n + len(skill); }   // touch args; no per-player skill store yet
}
pub fn sim_grant_save(s: &Sim, save: text, n: integer) {
  if false { s.player.gold = s.player.gold + n + len(save); }     // touch args; no per-player save store yet
}

// Heal the player, clamped to max HP.
pub fn sim_heal(s: &Sim, amount: integer) {
  s.php = s.php + amount;
  if s.php > s.phpmax { s.php = s.phpmax; }
}

// Hurt the player by `amount` of damage of `kind` (physical/fire/cold/poison/…). The
// per-kind resistance/effect handling lands later (the type just documents the shape now);
// today it is generic HP loss + death, mirroring melee.
pub fn sim_damage(s: &Sim, amount: integer, kind: text) {
  dmg = amount;
  if kind == "physical" {
    dmg = apply_dr(amount, s.pac);          // armour soaks physical blows (existing AC DR)
  } else {
    sv = sim_player_save(s);                // a saving throw resists magic/elemental effects
    cut = amount * sv / 100 ?? 0;
    dmg = amount - cut;
    if dmg < 1 { dmg = 1; }                 // never fully negated — save is capped < 100%
  }
  s.php = s.php - dmg;
  if s.php <= 0 { s.php = 0; s.over = true; }
}

// The player's saving throw (% resist for magic/elemental damage). Grows with character
// level, equipped armour (AC), and WILL — so gearing up and stat upgrades both help.
// Capped below 100% (friendly but fair — never total immunity; §3a).
//
// ⚠ RE-KEYED FROM ENDURANCE TO WILL (plan #16 `M4`), and it is the one re-key that changes who
// is good at something rather than only which name is on the door. This number resists MAGIC
// (§0: *Will — focus / Tension-resistance*), so it is a mind, not a constitution; Endurance
// keeps the soak it was given, as the HP ceiling. A warrior therefore loses ~2 save and a mage
// gains ~1 — which is the design saying casters are hard to bend, not a tuning accident.
// ⚠ `stat_eff`, not `stat_perm`: this is computed LIVE per call, so the temporary overlay is
// exactly what a potion of Will should buy (I-POOL constrains STORED pools only).
pub fn sim_player_save(s: Sim) -> integer {
  sv = 5 + s.player.clevel + s.pac / 4 + stat_eff(s, ST_WILL) / 3 + s.rc_save;   // cached race+class bonus
  if sv > 75 { sv = 75; }
  if sv < 0 { sv = 0; }
  sv
}

// The player FAILS a saving throw against an effect (gaze / venom): roll vs save% — higher save
// resists more often. (Early on save is low, so the floating eye is genuinely deadly.)
fn sim_save_fails(s: &Sim) -> boolean {
  sim_roll(s, 0, 99) >= sim_player_save(s)
}

// SP (spell points): pool accessors + the spend gate castfx uses. spmax is derived in
// refresh_stats from the class realm + spell stat; regen rides sim_tick.
pub fn sim_player_sp(s: Sim) -> integer { s.sp }
pub fn sim_player_sp_max(s: Sim) -> integer { s.spmax }
pub fn sim_spend_sp(s: &Sim, n: integer) -> boolean {
  if n > s.sp { return false; }
  s.sp -= n;
  true
}

// PLAYER status queries (the view shows a pip; the step/tick logic gates on these).
pub fn sim_player_paralysed(s: Sim) -> boolean { s.para_until > s.ticks }
pub fn sim_player_poisoned(s: Sim) -> boolean { s.poison_until > s.ticks }
pub fn sim_player_warded(s: Sim) -> boolean { s.venom_until > s.ticks }

// Antivenin: clear venom from the blood AND ward against more for `dur` ticks (the boss-drop escape
// hatch — long enough to climb out through the brood).
pub fn sim_cure_venom(s: &Sim, dur: integer) {
  s.poison_until = 0;
  s.poison_dmg = 0;
  s.venom_until = s.ticks + dur;
}

// Passive MELEE skill — a flat to-damage bonus from character level + effective STR. 0 at the
// baseline (level 1, starting STR), so it never shifts early combat; it grows as you level AND as
// you spend stat points on STR (the stat-choice payoff). refresh_stats folds it into wdam.
pub fn sim_skill_melee(s: Sim) -> integer {
  b = (s.player.clevel - 1) / 2 + (stat_eff(s, ST_MIGHT) - HERO_CON) + s.rc_melee;   // cached race+class aptitude
  if b < 0 { b = 0; }
  b
}

// Passive STEALTH skill — from character level + effective DEX. 0 at the baseline; it SHRINKS the
// range at which a monster notices you (its effective vision in the awareness check), so a stealthy
// (high-level / high-DEX) character can slip closer before waking sleepers. refresh-free (derived).
pub fn sim_skill_stealth(s: Sim) -> integer {
  b = (s.player.clevel - 1) / 3 + (stat_eff(s, ST_DEX) - HERO_CON) + s.rc_stealth;   // cached race+class
  if b < 0 { b = 0; }
  b
}

// Passive SHOOTING skill — a flat to-damage bonus for missiles, from level + PERCEPTION. 0 at
// the baseline; grows with level and with points spent on Perception. Added to the launched damage.
//
// ⚠ RE-KEYED FROM DEXTERITY (plan #16 `M4`). Angband shoots off DEX and we followed it; §0 gives
// ranged accuracy to Perception instead, and that is the better reading — a bow is aimed, not
// fumbled. It also gives the ranger (Perc +4, bow 32) and the elf (Perc +3, bow 5) one axis that
// says the same thing their skills already said, where before the two pulled apart.
pub fn sim_skill_shoot(s: Sim) -> integer {
  b = (s.player.clevel - 1) / 2 + (stat_eff(s, ST_PERC) - HERO_CON) + s.rc_bow;   // cached race+class aptitude
  if b < 0 { b = 0; }
  b
}

// Move the player to hex (q,r) — level placement / arrival / scripted movement.
pub fn sim_teleport(s: &Sim, q: integer, r: integer) {
  (tx, ty) = hex_to_px(q, r);
  s.px = tx;
  s.py = ty;
}

// Blink: teleport the player to a random hex they can stand in, within `max_d`
// (Scroll of Phase Door = short, Teleportation = long). Tries a handful of random
// offsets; a no-op if none land (always safe).
//
// Standable is asked through the chokepoint, not restated here: this used to test
// `tile_at != 1`, which sees rock but not the solidity rule's other two arms, so a
// blink could drop you inside a boulder or a fence post.
pub fn sim_blink(s: &Sim, max_d: integer) {
  (pq, pr) = px_to_hex(s.px, s.py);
  for _ in 0..60 {
    tq = pq + sim_roll(s, 0 - max_d, max_d);
    tr = pr + sim_roll(s, 0 - max_d, max_d);
    d = hex_distance(pq, pr, tq, tr);
    if d >= 1 && d <= max_d && tq >= 1 && tr >= 1 && tq < s.lw - 1 && tr < s.lh - 1 {
      if !field_blocked(s, tq, tr, DIR_HEX) {     // floor / stair — anything you can stand in
        sim_teleport(s, tq, tr);
        return;
      }
    }
  }
}

// Reveal the whole level on the memory map (Scroll of Magic Mapping). Index-write on the captured
// `seen` vector persists (C18-safe).
pub fn sim_reveal_map(s: &Sim) {
  seen = s.seen;
  for i in 0..len(seen) { seen[i] = 1; }
}

// Turn the player to face hex (q,r) — NPC interactions, scripted events.
pub fn sim_face(s: &Sim, q: integer, r: integer) {
  (tx, ty) = hex_to_px(q, r);
  s.heading = atan2(ty - s.py, tx - s.px);
}

// Radius of the equipped light (its i_power), or 0 if none. Feeds the FOV sight radius
// (a brighter light widens sight) and lets the view size the light cone later.
pub fn sim_light_radius(s: Sim) -> integer {
  l = s.eq[SLOT_LIGHT] ?? 0;
  if l <= 0 { return 0; }
  itbl = game_items();
  defi = l - 1;
  if defi >= 0 && defi < len(itbl) {
    d = itbl[defi];
    return d.i_power;
  }
  0
}

// Award XP and level up while the threshold is met; each level refreshes derived
// stats (max HP grows by the gentle per-level step; current HP gains the delta).
// ── Message log ──────────────────────────────────────────────────────────────────────
// A small ring of game messages (kernel data; the view renders the most recent few). Events across
// the kernel + the item API push lines via sim_log; the view reads them through sim_msg_count /
// sim_msg_at (k=0 = newest). Fixed array + write head — C18-safe (index-write + integer increment on
// a struct field both persist; never grow the vector).
pub fn sim_log(s: &Sim, m: text) {
  q = s.msg_q;
  i = (s.msg_n % MSG_MAX) ?? 0;
  if i >= 0 && i < len(q) { q[i] = m; }
  s.msg_n = s.msg_n + 1;
}
pub fn sim_msg_count(s: Sim) -> integer {
  if s.msg_n < MSG_MAX { return s.msg_n; }
  MSG_MAX
}
// Total messages ever logged (monotonic) — the view watches this to rebake only when it changes.
pub fn sim_msg_total(s: Sim) -> integer { s.msg_n }
// The k-th most-recent message (k = 0 is newest); "" if out of range.
pub fn sim_msg_at(s: Sim, k: integer) -> text {
  c = sim_msg_count(s);
  if k < 0 || k >= c { return ""; }
  q = s.msg_q;
  idx = ((s.msg_n - 1 - k) % MSG_MAX) ?? 0;
  if idx < 0 { idx = idx + MSG_MAX; }
  if idx >= 0 && idx < len(q) { return q[idx] ?? ""; }
  ""
}

pub fn sim_award_xp(s: &Sim, amount: integer) {
  if amount > 0 { s.player.xp += amount; }
  while s.player.clevel < MAX_CLEVEL && s.player.xp >= xp_need(s, s.player.clevel + 1) {   // race expfact scales the curve
    s.player.clevel += 1;
    refresh_stats(s);   // max HP grows with level (hero_maxhp); the gained HP is granted
    s.stat_pts += 1;    // BANK a stat-growth point — never auto-spent; the player picks when ready
    sim_log(s, "Welcome to level {s.player.clevel}!");
  }
}

// Spend a banked stat point on `stat` (player-chosen growth). Succeeds only if a point is banked
// AND the stat is off cooldown (last rose >= STAT_COOLDOWN levels ago). Returns whether it applied,
// so a deferred hoard of points can be timed + spread, but never dumped into one stat.
pub fn sim_raise_stat(s: &Sim, stat: text) -> boolean {
  i = stat_index(stat);
  if i < 0 || s.stat_pts <= 0 { return false; }
  ga = s.stat_grown_at;
  last = ga[i] ?? 0;
  if last != 0 && (s.player.clevel - last) < STAT_COOLDOWN { return false; }   // on cooldown
  mx = s.stat_max; mx[i] = (mx[i] ?? 0) + 1;
  cu = s.stat_cur; cu[i] = (cu[i] ?? 0) + 1;
  ga[i] = s.player.clevel;
  s.stat_pts = s.stat_pts - 1;
  refresh_stats(s);
  true
}

// Banked stat-growth points awaiting the player's choice (0 = none pending).
pub fn sim_stat_points(s: Sim) -> integer { s.stat_pts }

// Can the player raise `stat` right now? (a point is banked and the stat is off cooldown) — for
// the level-up choice UI to enable / grey out each stat.
pub fn sim_can_raise_stat(s: Sim, stat: text) -> boolean {
  i = stat_index(stat);
  if i < 0 || s.stat_pts <= 0 { return false; }
  ga = s.stat_grown_at;
  last = ga[i] ?? 0;
  last == 0 || (s.player.clevel - last) >= STAT_COOLDOWN
}

// ── Loot (gold + item drops) ─────────────────────────────────────────

// Drop-RNG: a value in [lo, hi] from the Sim's OWN combat stream (random lib) — the
// state words ride the Sim, so rolls save/replay/descend deterministically.
pub fn sim_roll(s: &Sim, lo: integer, hi: integer) -> integer {   // pub: castfx rolls spell failure
  if hi <= lo { return lo; }
  r = random::RandStream { s1: s.rs1, s2: s.rs2 };
  v = r.get(lo, hi) ?? lo;
  s.rs1 = r.s1;
  s.rs2 = r.s2;
  v
}

// Add a floor entry (gold pile if gold>0, else an item with cat/def) by writing
// into the fixed arrays at the count slot — runtime append to a struct field is
// unreliable in loft, so we index-write like `enemies`.
fn add_floor(s: &Sim, q: integer, r: integer, gold: integer, cat: integer, def: integer) {
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fc = s.fi_cat;
  fd = s.fi_def;
  fl = s.fi_live;
  n = s.fi_n;
  if n >= 0 && n < len(fq) && n < len(fr) && n < len(fg) && n < len(fc) && n < len(fd) && n < len(fl) {
    fq[n] = q;
    fr[n] = r;
    fg[n] = gold;
    fc[n] = cat;
    fd[n] = def;
    fl[n] = 1;
    s.fi_n = n + 1;
  }
}

// On a kill: drop a gold pile, and sometimes a depth-appropriate item, at (q,r).
fn drop_loot(s: &Sim, q: integer, r: integer, mlvl: integer) {
  gamt = sim_roll(s, 1, 3) * (mlvl + 1) + sim_roll(s, 0, 4);
  add_floor(s, q, r, gamt, -1, -1);
  if sim_roll(s, 0, 99) < 35 {
    itbl = game_items();
    idx = item_choose_idx(itbl, s.depth, sim_roll(s, 1, 2000000000));
    if idx >= 0 {
      cat = item_cat(itbl, idx);
      add_floor(s, q, r, 0, cat, idx);
    }
  }
}

// Drop a specific item by key on the floor at (q, r) — used for the bundle boss-drop.
fn sim_drop_item(s: &Sim, q: integer, r: integer, key: text) {
  itbl = game_items();
  idx = item_index(itbl, key);
  if idx >= 0 { add_floor(s, q, r, 0, item_cat(itbl, idx), idx); }
}

// A set-piece UNIQUE died: record quest progress, announce it, and — if the active overlay names a
// boss-drop — leave it at the death spot (the escape hatch). One place, called from both kill paths.
fn sim_on_unique_death(s: &Sim, eq: integer, er: integer, ename: text) {
  s.boss_slain = 1;
  sim_log(s, "{ename} falls — its brood breaks loose!");
  if world_has_placement() == 1 {
    bd = world_placement().boss_drop;
    if bd != "" {
      sim_drop_item(s, eq, er, bd);
      sim_log(s, "From its coils spills a vial of antivenin.");
    }
  }
}

// Combat damage multiplier (percent) from the attacker↔defender level gap, capped
// BOTH ways: past ±COMBAT_DELTA_CAP levels the gap stops mattering, so level shifts a
// fight by at most ±(CAP*STEP)% — difficulty is skill, not level (§3a #2). Symmetric:
// mult(a,b) + mult(b,a) == 200. Monsters attack through the SAME function (the mirror).
pub fn combat_mult_pct(att_lvl: integer, def_lvl: integer) -> integer {
  d = att_lvl - def_lvl;
  if d > COMBAT_DELTA_CAP { d = COMBAT_DELTA_CAP; }
  if d < 0 - COMBAT_DELTA_CAP { d = 0 - COMBAT_DELTA_CAP; }
  100 + d * COMBAT_STEP
}

// Apply the level-ratio cap to a base hit, never below 1: you always chip, and nothing
// is ever fully negated (the no-100%-immunity rule, §3a #3).
pub fn capped_dmg(base: integer, att_lvl: integer, def_lvl: integer) -> integer {
  v = base * combat_mult_pct(att_lvl, def_lvl) / 100 ?? 0;
  if v < 1 { v = 1; }
  v
}

// Player hits enemy `idx` for capped melee damage; on a kill, awards XP and drops loot.
fn player_attack(s: &Sim, idx: integer) {
  enemies = s.enemies;
  if idx >= 0 && idx < len(enemies) {
    e = enemies[idx];
    if e.alive {
      e.hp -= capped_dmg(s.wdam, s.player.clevel, e.mlvl);
      gain = 0;
      if e.hp <= 0 {
        e.alive = false;
        gain = e.xp * e.mlvl / s.player.clevel ?? 0;
        if gain < 1 { gain = 1; }
        drop_loot(s, e.cur_q, e.cur_r, e.mlvl);
        sim_log(s, "You have slain the {e.name}.");
        if (e.flags & MF_UNIQUE) != 0 { sim_on_unique_death(s, e.cur_q, e.cur_r, e.name); }
        on_hostile_slain(s, e.role, e.tags, e.raid);
      }
      enemies[idx] = e;
      if gain > 0 { sim_award_xp(s, gain); }
    }
  }
}

// Fire the equipped launcher (SLOT_BOW) at the nearest SEEN enemy in range, spending one ammo.
// Damage = ammo dice average * launcher multiplier (i_power) + the shooting skill, then the same
// level-ratio cap as melee (crawler combat is auto-hit-capped, not a to-hit roll). A quick-slot
// (Q/E or 1-9) triggers this; the action itself is input-scheme-agnostic.
// Returns: 0 no launcher, 1 no ammo, 2 no target, 3 hit, 4 kill.
// Auto-aim (shared by the launcher AND attack spells): among SEEN enemies in range, score by
// distance with a frontal bonus — very near wins on distance, but at roughly equal range the one
// more dead-ahead of your heading wins. A mob BEHIND the character (front <= 0) can never be
// targeted. Returns the enemy index, or -1 with nothing in your sights.
fn aim_target(s: Sim) -> integer {
  enemies = s.enemies;
  hx = cos(s.heading);
  hy = sin(s.heading);
  epx = 0.0;                 // pre-declared so the nested tuple-assign below resolves (no nested destructure-decl)
  epy = 0.0;
  target = -1;
  bestscore = (FIRE_RANGE as float) + 100.0;
  for i in 0..len(enemies) {
    e = enemies[i];
    if e.alive && sim_monster_sense(s, i) == SENSE_SEE {
      d = sim_enemy_dist(s, i);
      if d <= FIRE_RANGE {
        (epx, epy) = sim_enemy_pos(s, i);
        dx = epx - s.px;
        dy = epy - s.py;
        ln = sqrt(dx * dx + dy * dy) ?? 0.0;
        front = 0.0;
        if ln > 0.0 { front = (dx * hx + dy * hy) / ln ?? 0.0; }   // -1 behind .. +1 dead ahead
        if front > 0.0 {                                            // never target what's behind you
          eff = (d as float) - FRONT_AIM * front;
          if eff < bestscore { bestscore = eff; target = i; }
        }
      }
    }
  }
  target
}

// Hurl a magic BOLT (an attack spell's kernel verb): the launcher's auto-aim, no launcher or ammo.
// `dam` is the spell's damage knob (its s_power). Returns 0 = nothing in sights, 3 = hit, 4 = slain.
pub fn sim_bolt(s: &Sim, dam: integer) -> integer {
  target = aim_target(s);
  if target < 0 { return 0; }
  enemies = s.enemies;
  e = enemies[target];
  e.hp -= capped_dmg(dam, s.player.clevel, e.mlvl);
  ret = 3;
  gain = 0;
  if e.hp <= 0 {
    e.alive = false;
    gain = e.xp * e.mlvl / s.player.clevel ?? 0;
    if gain < 1 { gain = 1; }
    drop_loot(s, e.cur_q, e.cur_r, e.mlvl);
    sim_log(s, "Your bolt slays the {e.name}.");
    if (e.flags & MF_UNIQUE) != 0 { sim_on_unique_death(s, e.cur_q, e.cur_r, e.name); }
    on_hostile_slain(s, e.role ?? 0, e.tags ?? 0, e.raid ?? 0);
    ret = 4;
  } else {
    sim_log(s, "Your bolt strikes the {e.name}.");
  }
  enemies[target] = e;
  if gain > 0 { sim_award_xp(s, gain); }
  ret
}

pub fn sim_fire(s: &Sim) -> integer {
  bow = s.eq[SLOT_BOW] ?? 0;
  if bow == 0 { return 0; }
  itbl = game_items();
  mult = item_power(itbl, bow - 1);
  iv = s.inv;
  ammo_slot = -1;
  for k in 0..s.ninv {
    if ammo_slot < 0 && k < len(iv) {
      di = iv[k] ?? -1;
      if item_cat(itbl, di) == IT_AMMO { ammo_slot = k; }
    }
  }
  if ammo_slot < 0 { return 1; }
  target = aim_target(s);
  if target < 0 { return 2; }
  enemies = s.enemies;
  ad = iv[ammo_slot] ?? -1;
  avg = item_dd(itbl, ad) * (item_ds(itbl, ad) + 1) / 2 ?? 0;
  base = avg * mult + sim_skill_shoot(s);
  e = enemies[target];
  e.hp -= capped_dmg(base, s.player.clevel, e.mlvl);
  ret = 3;
  gain = 0;
  if e.hp <= 0 {
    e.alive = false;
    gain = e.xp * e.mlvl / s.player.clevel ?? 0;
    if gain < 1 { gain = 1; }
    drop_loot(s, e.cur_q, e.cur_r, e.mlvl);
    sim_log(s, "Your shot slays the {e.name}.");
    if (e.flags & MF_UNIQUE) != 0 { sim_on_unique_death(s, e.cur_q, e.cur_r, e.name); }
    on_hostile_slain(s, e.role ?? 0, e.tags ?? 0, e.raid ?? 0);
    ret = 4;
  } else {
    sim_log(s, "Your shot strikes the {e.name}.");
  }
  enemies[target] = e;
  sim_consume_inv(s, ammo_slot);
  if gain > 0 { sim_award_xp(s, gain); }
  ret
}

// Auto-collect any gold pile under the player (called each frame from sim_step).
fn sim_autocollect_gold(s: &Sim) {
  (pq, pr) = px_to_hex(s.px, s.py);
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fl = s.fi_live;
  n = s.fi_n;
  for i in 0..n {
    if (fl[i] ?? 0) == 1 {
      q = fq[i] ?? -999;
      r = fr[i] ?? -999;
      amt = fg[i] ?? 0;
      if q == pq && r == pr && amt > 0 {
        s.player.gold += amt;
        fl[i] = 0;
      }
    }
  }
}

// Pick up everything under the player ('g'): gold to the purse, items to inventory.
pub fn sim_pickup(s: &Sim) {
  (pq, pr) = px_to_hex(s.px, s.py);
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fd = s.fi_def;
  fl = s.fi_live;
  iv = s.inv;
  n = s.fi_n;
  for i in 0..n {
    if (fl[i] ?? 0) == 1 {
      q = fq[i] ?? -999;
      r = fr[i] ?? -999;
      if q == pq && r == pr {
        amt = fg[i] ?? 0;
        if amt > 0 {
          s.player.gold += amt;
          sim_log(s, "You find {amt} gold.");
        } else {
          ni = s.ninv;
          if ni >= 0 && ni < len(iv) {
            di = fd[i] ?? -1;
            iv[ni] = di;
            idg9 = s.inv_dmg;
            if ni < len(idg9) { idg9[ni] = 0; }   // what you find off the floor is sound (I-MEND)
            s.ninv = ni + 1;
            sim_log(s, "You pick up the {sim_item_display_name(s, di)}.");
            sim_qs_autoslot(s, di);    // auto-fill a quick-slot on first pickup of a useable item
          }
        }
        fl[i] = 0;
      }
    }
  }
}

// ── Clock & step ─────────────────────────────────────────────────────

// One world tick: each live enemy commits its move; if adjacent to the player
// it attacks (instead of moving), else it steps toward the player.
// Round to nearest integer (as float), correct for negatives — for cube lerp.
// (`as integer` truncates toward zero, so bias by ±0.5 before truncating.)
fn rnd_f(v: float) -> float {
  base = v + 0.5;
  if v < 0.0 { base = v - 0.5; }
  i = base as integer;
  i as float
}

// Hex line-of-sight: true if no solid hex blocks the line between the two hex
// centres (endpoints excluded). Cube-coordinate interpolation + rounding.
pub fn hex_los(s: Sim, q0: integer, r0: integer, q1: integer, r1: integer) -> boolean {
  n = hex_distance(q0, r0, q1, r1);
  blocked = false;
  if n > 1 {
    x0 = q0;
    z0 = r0;
    y0 = 0 - q0 - r0;
    x1 = q1;
    z1 = r1;
    y1 = 0 - q1 - r1;
    for li in 1..n {
      t = li as float / n as float ?? 0.0;
      fx = x0 as float + (x1 - x0) as float * t;
      fy = y0 as float + (y1 - y0) as float * t;
      fz = z0 as float + (z1 - z0) as float * t;
      rx = rnd_f(fx);
      ry = rnd_f(fy);
      rz = rnd_f(fz);
      dx = abs(rx - fx);
      dy = abs(ry - fy);
      dz = abs(rz - fz);
      if dx > dy && dx > dz {
        rx = 0.0 - ry - rz;
      } else if dy > dz {
        ry = 0.0 - rx - rz;
      } else {
        rz = 0.0 - rx - ry;
      }
      if is_wall(s, rx as integer, rz as integer) { blocked = true; }
    }
  }
  !blocked
}

// ── Field of view (FOV / fog-of-war) ─────────────────────────────────
// DIRECTED light: your sight radius depends on the angle to your heading — full
// VISION_RADIUS straight ahead, falling off to NEAR_RADIUS behind you (a forward-pointed
// lamp), by line of sight, plus an always-visible NEAR_RADIUS bubble. So turning points
// your light — a real choice. `vis` is recomputed each call; `seen` accumulates the
// revealed map (memory; fresh per level → lost on death). The view (or a test) calls
// this; the visibility set is renderer-agnostic (immediate or GPU — RENDER.md).
pub fn sim_compute_fov(s: &Sim) {
  vis = s.vis;
  seen = s.seen;
  // SURFACE DAYLIGHT: depth 0 has NO light radius — open desert under the sky, the player
  // sees to the screen edge all the time (the view merely clips). Everything is lit; the
  // directed-lamp cone below is a DUNGEON thing.
  if s.depth == 0 {
    for di in 0..len(vis) { vis[di] = 1; }
    for dj in 0..len(seen) { seen[dj] = 1; }
    return;
  }
  // Read the scalar bounds into locals once before the hot loop (a small micro-opt). This loop's
  // shape (per-cell tuple-returns like hex_to_px) was the repro that surfaced loft#299 — a parser
  // bug that dropped a thin struct-return's result, fixed in loft2 fc80115 (LOFT_ISSUES C21).
  lw = s.lw;
  lh = s.lh;
  qmin = s.qmin;
  rmin = s.rmin;
  spx = s.px;
  spy = s.py;
  (pq, pr) = px_to_hex(spx, spy);
  hx = cos(s.heading);
  hy = sin(s.heading);
  nearf = NEAR_RADIUS as float;
  // Effective sight radius: the base, WIDENED by a bright equipped light (never reduced).
  // The Everbright Torch (radius 12 > base 10) lets you see further; weak lights don't
  // shrink the base. (The fuller "no light = dark" model is a later step.)
  vr = VISION_RADIUS;
  ll = s.eq[SLOT_LIGHT] ?? 0;
  if ll > 0 {
    litbl = game_items();
    ldi = ll - 1;
    if ldi >= 0 && ldi < len(litbl) {
      ldef = litbl[ldi];
      if ldef.i_power > vr { vr = ldef.i_power; }
    }
  }
  visf = vr as float;
  for gr in 0..lh {
    for gq in 0..lw {
      idx = gr * lw + gq;
      q = qmin + gq;
      r = rmin + gr;
      v = 0;
      d = hex_distance(pq, pr, q, r);
      if d <= NEAR_RADIUS {
        v = 1;                                         // always-visible bubble (your feet)
      } else if d <= vr {
        (cxp, cyp) = hex_to_px(q, r);
        dx = cxp - spx;
        dy = cyp - spy;
        ln = sqrt(dx * dx + dy * dy) ?? 0.0;
        if ln > 0.0 {
          dot = (dx * hx + dy * hy) / ln ?? 0.0;        // -1 behind .. +1 ahead
          fwd = (dot + 1.0) / 2.0 ?? 0.0;               // 0 behind .. 1 ahead
          eff = nearf + (visf - nearf) * fwd * fwd;     // directed-lamp falloff (forward-biased)
          if (d as float) <= eff && hex_los(s, pq, pr, q, r) { v = 1; }
        }
      }
      if idx >= 0 && idx < len(vis) { vis[idx] = v; }
      if v != 0 && idx >= 0 && idx < len(seen) { seen[idx] = 1; }
    }
  }
}

// Render state of a hex: 2 = visible now, 1 = remembered (seen before), 0 = unseen.
pub fn sim_hex_state(s: Sim, q: integer, r: integer) -> integer {
  gq = q - s.qmin;
  gr = r - s.rmin;
  if gq < 0 || gq >= s.lw || gr < 0 || gr >= s.lh { return 0; }
  idx = gr * s.lw + gq;
  vis = s.vis;
  v = vis[idx] ?? 0;
  if v != 0 { return 2; }
  seen = s.seen;
  sn = seen[idx] ?? 0;
  if sn != 0 { return 1; }
  0
}

// FOV render state at a world position — convenience for the view (enemies/items/walls).
pub fn sim_hex_state_at(s: Sim, wx: float, wy: float) -> integer {
  (q, r) = px_to_hex(wx, wy);
  sim_hex_state(s, q, r)
}

// Line of sight from the player to hex (q,r) — convenience for perception/targeting.
pub fn sim_los_to(s: Sim, q: integer, r: integer) -> boolean {
  (pq, pr) = px_to_hex(s.px, s.py);
  hex_los(s, pq, pr, q, r)
}

// How the player PERCEIVES monster `i` right now — the canonical perception query a full game
// renders + reasons from (the view shows SEEN solid, FELT as a marker, HEARD as a blip). Best
// channel wins: SEE > FEEL > HEAR > NONE. Everything that changes perception plugs in HERE as
// a modifier, never as a view special-case:
//   - the player's lit FOV (sim_hex_state) feeds SEE;
//   - a self-luminous monster (MF_GLOW) is its own light — SEEN in the dark given LOS;
//   - the detect-monsters potion / telepathy (s.detect_t) feeds FEEL (through walls);
//   - an awake monster's noise within HEAR_RADIUS feeds HEAR.
pub fn sim_monster_sense(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return SENSE_NONE; }
  e = enemies[i];
  if !e.alive { return SENSE_NONE; }
  if sim_hex_state(s, e.cur_q, e.cur_r) == 2 { return SENSE_SEE; }   // in the player's lit FOV
  (pq, pr) = px_to_hex(s.px, s.py);
  if (e.flags & MF_GLOW) != 0 && hex_los(s, pq, pr, e.cur_q, e.cur_r) {
    return SENSE_SEE;                                                // glows: no light needed, just LOS
  }
  if s.detect_t > 0 { return SENSE_FEEL; }                          // detection / telepathy modifier
  if e.awake && hex_distance(pq, pr, e.cur_q, e.cur_r) <= HEAR_RADIUS { return SENSE_HEAR; }
  SENSE_NONE
}

// Make monster `i` self-luminous (MF_GLOW) — for glowing monster types, or a "faerie fire"
// style effect that lights one up. Feeds sim_monster_sense's SEE-without-light channel.
pub fn sim_make_glow(s: &Sim, i: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.flags = e.flags | MF_GLOW;
  enemies[i] = e;
}

// Give monster `i` a paralysing gaze (MF_GAZE) — a curse/hex effect, and the test hook for the gaze.
pub fn sim_make_gaze(s: &Sim, i: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.flags = e.flags | MF_GAZE;
  enemies[i] = e;
}

// Give monster `i` a corroding touch (MF_CORRODE) — the acid-jelly blow, and the test hook
// for it (the sibling of sim_make_gaze, and for the same reason: a special blow reachable
// only by finding its one carrier at depth is one the gate cannot see both sides of).
pub fn sim_make_corrode(s: &Sim, i: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.flags = e.flags | MF_CORRODE;
  enemies[i] = e;
}

// ── I-MEND: damage is an EVENT, and repair is its exact inverse (plan #17 `S6`) ──────────
//
// ⚠ NO RUNNING DEGRADATION ANYWHERE IN THIS. Nothing here is called by the clock; the only
// callers are a landed blow and a smith. That is the whole distinction the design turns on
// (CRAFTING.md): wear-per-use is a maintenance chore with a meter behind it, event damage is
// one state that the causing event teaches — and event damage is Angband's actual model
// (acid ruins armour), so faithfulness settles it rather than taste.
//
// ⚠ IT GOES FOR WHAT YOU WOULD MISS: the sound piece with the most to lose, weapon last.
// Angband rolls a random slot; deterministic is better here on two grounds — the first blow
// always produces a signal the player can NOTICE (a random pick can eat a cloak's 1 AC and
// teach nothing), and a gate can then state which piece without pinning the roll stream.
// Returns the slot corroded, or -1 when the player has nothing left to ruin.
//
// Pub for the reason `prod_draw_when` is: an effect reachable only by standing next to the
// one creature that carries it, at the depth it lives, is an effect whose ALGEBRA nobody
// gates. `mendtest` proves the blow wires to this once, then states the invariant against
// the primitive — which is also the shape that keeps a second cause from re-deriving the rule.
pub fn sim_damage_gear(s: &Sim) -> integer {
  itbl = game_items();
  eq = s.eq;
  ed = s.eq_dmg;
  best = -1;
  bestv = -1;
  for sl in 0..NUM_SLOTS {
    e = eq[sl] ?? 0;
    if e > 0 && (ed[sl] ?? 0) == 0 && item_damageable(itbl, e - 1) {
      v = item_ac(itbl, e - 1);
      if sl == SLOT_WEAPON { v = 0; }   // the arm is the last thing to go
      if v > bestv { bestv = v; best = sl; }
    }
  }
  if best < 0 { return -1; }
  if best < len(ed) { ed[best] = 1; }
  refresh_stats(s);
  best
}

// THE SMITH'S WHOLE DECISION, in one call: is there anything to mend, may the forge spare
// the iron, and mend it. ⚠ ONE UNIT ON PURPOSE — a mend that could happen without a draw
// would make the supply coupling decorative, and split across two public calls the gate
// would prove each half while the pairing rotted. `sim_talk_to`'s smith arm is dialogue
// over this and nothing else.
//   1 = mended · 0 = nothing needed mending · -1 = the ore store is empty
pub fn sim_smith_mend(s: &Sim) -> integer {
  d = sim_next_damaged(s);
  if d < 0 { return 0; }
  sim_smith_mend_when(s, prod_gated(producer_index(item_repair_producer(game_items(), d))))
}

// The same decision with the arming supplied by the caller — `prod_draw_when`'s reason
// exactly, and today it is the load-bearing one: the forge lines are UNARMED (no reachable
// mine, see `prod_gated`), so the shipped smith always has iron and the REFUSAL branch would
// be dead code that compiles. It is the branch the whole coupling rests on, and it goes live
// the day the ore face becomes walkable — `mendtest` proves both answers now, not then.
pub fn sim_smith_mend_when(s: &Sim, gated: boolean) -> integer {
  d = sim_next_damaged(s);
  if d < 0 { return 0; }
  if !prod_draw_when(s, item_repair_producer(game_items(), d), gated) { return -1; }
  _m = mend_one(s);
  1
}

// Mend ONE piece: equipment first (what is worn is what is missed), then the pack. Answers
// the slot's item def, or -1 when nothing needed it — so the caller can name what it fixed
// without asking twice. ⚠ It does NOT decide whether the smith may: that is the stock's
// call, and it is made at the one call site so a mend cannot happen without a draw.
fn mend_one(s: &Sim) -> integer {
  ed = s.eq_dmg;
  eq = s.eq;
  for sl in 0..NUM_SLOTS {
    if (ed[sl] ?? 0) != 0 {
      ed[sl] = 0;
      refresh_stats(s);
      return (eq[sl] ?? 0) - 1;
    }
  }
  idg = s.inv_dmg;
  iv = s.inv;
  for i in 0..s.ninv {
    if i < len(idg) && (idg[i] ?? 0) != 0 {
      idg[i] = 0;
      return iv[i] ?? -1;
    }
  }
  -1
}

// What the smith would be handed next, without handing it over — the stock question needs
// the item's forge line BEFORE the mend, and asking twice would mend the wrong thing.
pub fn sim_next_damaged(s: Sim) -> integer {
  ed = s.eq_dmg;
  eq = s.eq;
  for sl in 0..NUM_SLOTS {
    if (ed[sl] ?? 0) != 0 { return (eq[sl] ?? 0) - 1; }
  }
  idg = s.inv_dmg;
  iv = s.inv;
  for i in 0..s.ninv {
    if i < len(idg) && (idg[i] ?? 0) != 0 { return iv[i] ?? -1; }
  }
  -1
}

// The DAILY LOOP: a day lasts DAY_LEN ticks; phase 0 = day, 1 = night.
pub const DAY_LEN = 400;
pub fn sim_phase(s: Sim) -> integer {
  if ((s.ticks % DAY_LEN) ?? 0) < 280 { 0 } else { 1 }
}

// ── SAFETY: the category a worker refuses to enter (plan #17 S1) ────────────────────────
//
// I-SAFE (CRAFTING.md): a settlement's output is a function of the danger around it, and
// the hero's only lever on it is the one they already hold. This is that danger, as a
// CATEGORY rather than a gradient — "get an area into the safe category" is a threshold a
// player can cross and see crossed; a sliding float is unreadable in play and untestable
// in a gate.
//
// Two terms, and the second is what keeps the town from being scenery: a living hostile
// makes ground unsafe, and a guard within reach makes it safe again. The player is one
// input to safety, never the only one.
//
// ⚠ PRESENCE, NOT WAKEFULNESS — and the gate found this on its first run. Keyed on `awake`
// the predicate reported a freshly generated level as ENTIRELY safe (416 open hexes, 0
// unsafe), because monsters sleep until they perceive the PLAYER. That is backwards for a
// farmer: a sleeping monster in the woods is exactly why nobody goes into the woods.
// Wakefulness describes a monster's reaction to the hero; danger to a worker does not wait
// for the hero to arrive.
pub const THREAT_R = 6;      // hexes: how far a living hostile spoils the ground around it
pub const GUARD_R  = 4;      // hexes: how far a guard's presence holds ground safe

// What one gathering trip brings back, and how much the settlement can hold (plan #17 `S3`).
//
// ⚠ BOTH ARE SET AGAINST MEASURED FLOW, NOT TASTE, and the cap is the load-bearing one. With
// a reachable picking ground the gatherer runs ~2.5 round trips a day; the alchemist brews on
// three days in seven. Uncapped, stock reached **120 in 16 days** and simply grew — and a
// stock that is never empty gates nothing, so "danger cuts output" would have been true in
// the code and false in the game. The cap makes the store sit full in peace and *drain* when
// the gatherer stops, which is the behaviour the plan is about.
pub const GATHER_LOAD = 1;
pub const PROD_STOCK_MAX = 8;

// ⚠ AND HOW FAR A WORK SITE MAY BE — because REACHABLE IS NOT WORKABLE (2026-08-10).
//
// The town wall used to seal its own people in (498 of 9801 hexes), so every siting scan
// chose from a pocket that was mostly the market square. Cutting real gates opened the
// window to 8951 hexes — and the gatherer immediately re-sited onto genuine alpine shelves
// **50 hexes out**, because rank beat distance absolutely and the good ground is up in the
// mountains. Measured: **3 deliveries in four days became 0.** The site got better and the
// supply died, which is the whole lesson — a work site nobody can round-trip in a working
// day is a work site nobody works, exactly as unusable as one with no path at all.
//
// The bound is the DAY, not taste: daylight is 280 of `DAY_LEN`'s 400 ticks and a walker
// covers about a hex a tick, so a round trip has ~140 hexes of budget — but a civilian
// crossing monster country stalls at every safety border (measured: 1023 of 1600 daylight
// ticks frozen), which spends most of it. 22 leaves room for two trips on a clear day and
// one on a bad one, and it keeps the `>= 14` far-out preference meaningful inside it.
pub const WORK_MAX_D = 22;

pub fn hex_safe(s: Sim, q: integer, r: integer) -> boolean {
  es = s.enemies;
  for i in 0..len(es) {
    e = es[i];
    if e != null && e.alive && e.role == 0
       && hex_distance(e.cur_q, e.cur_r, q, r) <= THREAT_R {
      // a hostile is near — unless a guard is holding this ground
      for j in 0..len(es) {
        g = es[j];
        if g != null && g.alive && g.role == 3
           && hex_distance(g.cur_q, g.cur_r, q, r) <= GUARD_R {
          return true;
        }
      }
      return false;
    }
  }
  true
}

// ── plan #17 `S3` — STOCK: a workshop needs its inputs ────────────────────────────────
//
// I-STOCK: a producer's stock is raised only by a worker bringing something home and drawn
// only by that workshop making, so **stock == raised − drawn** at every tick. Both are
// discrete EVENTS, never per-tick states — a raise that fired while a worker merely stood
// somewhere would climb without bound, and the empty state (the whole point of the
// mechanism) would be unreachable. That is the trap this repo keeps meeting: a check that
// cannot go red. `stocktest` asserts the conservation directly.
//
// ⚠ `alchemy` IS ARMED, and the whole chain behind it now runs (2026-08-10). Getting there
// took the gatherer's three defects (`S3`), the den that gave danger somewhere to press
// (`S5`), and finally the two terms that make the ground matter at all: **the bag fills only
// at the work site** and **only while that ground is safe** (`npc_gather`), and **nobody
// travels to work that is unsafe** (`npc_target`). Measured over a week on world 777, den
// alive vs cleared: **1 load and 1 potion against 17 and 11.**
//
//
// ✅ AND THE TWO FORGE LINES ARE ARMED TOO (2026-08-10) — because the ore now arrives.
// Arming follows the supply and never leads it, and getting a supply took three things, in
// this order: a town whose wall has GATES (its people were sealed in, 498 of 9801 hexes
// walkable), a mine sited on ground the miners can reach AND round-trip in a working day
// (`walk_reach` + `WORK_MAX_D`), and a GUARD POSTED ON THE WORKS — without which the camp
// at the foot of the mountain is unsafe 1600 of 1600 ticks and the trade is not hindered
// but dead. Measured over four days on the shipped world, den cleared against den alive:
// **the ore face is safe 1600/1600 and delivers, against unsafe 775/1600 and delivering
// nothing.** That is the whole claim, on the chain the raids actually press.
//
// ⚠ IT IS ALSO WHAT MAKES `S6`'s REPAIR MEAN ANYTHING. A smith draws the same store the
// forge draws, so a mine nobody dares walk to means nobody mends your sword either — the
// point at which I-SAFE closes on the PLAYER and not only on the town (CRAFTING.md).
//
// The four still unarmed (scriptorium x2, town_craft, import) have no worker delivering to
// them. An unarmed producer draws nothing and makes as it always did; `prod_draw_when` takes
// the arming as an argument so both branches stay gated whichever way the switch is set.
fn prod_gated(pi: integer) -> boolean {
  pi >= 0 && (pi == producer_index("alchemy")
              || pi == producer_index("forge_weapon")
              || pi == producer_index("forge_armor"))
}

// A worker came home with something. Raising an ungated producer is harmless and still
// counted, so the conservation law holds for all seven rather than for a special case.
pub fn prod_raise(s: &Sim, producer: text) {
  pi = producer_index(producer);
  if pi < 0 { return; }
  st = s.prod_stock;
  if pi < len(st) {
    have = st[pi] ?? 0;
    // A store has walls. Without the cap the number only ever climbs (measured: 120 in 16
    // days), and an input that cannot run out is not an input.
    if have < PROD_STOCK_MAX { st[pi] = have + 1; }
  }
}

// The workshop makes. Answers whether it MAY, and draws when it does — so the caller
// cannot draw without making or make without drawing (one call site, one decision).
//
// Pub for the same reason `npc_may_enter` is: a predicate that can only be reached through
// a day of simulation is one whose FALSE branch nobody can gate. `stocktest` calls it
// directly to see both answers, then checks the daily loop honours the same rule.
pub fn prod_draw(s: &Sim, producer: text) -> boolean {
  prod_draw_when(s, producer, prod_gated(producer_index(producer)))
}

// The same decision with the arming supplied by the caller. ⚠ THE SWITCH IS A POLICY, AND A
// POLICY THAT CANNOT BE SET IN A TEST IS ONE WHOSE OTHER BRANCH NOBODY PROVES — with
// `prod_gated` off today (see above), the drawing half would otherwise be dead code that
// compiles, and it would go live untested on the day someone flips it.
pub fn prod_draw_when(s: &Sim, producer: text, gated: boolean) -> boolean {
  pi = producer_index(producer);
  if pi < 0 { return true; }
  if !gated { return true; }
  st = s.prod_stock;
  have = 0;
  if pi < len(st) { have = st[pi] ?? 0; }
  if have <= 0 { return false; }
  st[pi] = have - 1;
  true
}

// Read-only, for the gate and for `S4`'s "the world says it" (which shows the CONSEQUENCE,
// never the number — CRAFTING.md `F2`).
pub fn sim_prod_stock(s: Sim, producer: text) -> integer {
  pi = producer_index(producer);
  if pi < 0 { return 0; }
  st = s.prod_stock;
  if pi >= len(st) { return 0; }
  st[pi] ?? 0
}

// ⚠ ENTER, NEVER LEAVE. `npc_step` freezes an NPC when no neighbour is passable, so a
// worker caught in newly-dangerous ground would be STUCK in it rather than walking out —
// the opposite of avoiding. So the rule is asymmetric by construction: safety only blocks
// a step INTO danger, and anyone already standing in it may always move.
//
// Guards are exempt (walking toward trouble is the job) and so are wild things, which keep
// their own counsel. Hostiles never reach here — npc_step is only called for role != 0.
// Takes role + origin rather than the Enemy, so a gate can ask it directly — the two
// facts it uses are the only two it needs, and a predicate that cannot be asked in
// isolation is one nobody writes a control for.
pub fn npc_may_enter(s: Sim, role: integer, fq: integer, fr: integer,
                     q: integer, r: integer) -> boolean {
  if role == 3 || role == 12 { return true; }
  if hex_safe(s, q, r) { return true; }
  !hex_safe(s, fq, fr)                  // already in danger: leaving is always allowed
}

// Can this civilian stand on (q,r)? Boats live ON the water; walkers off it.
fn npc_passable(s: Sim, role: integer, q: integer, r: integer) -> boolean {
  if q < 1 || r < 1 || q >= s.lw - 1 || r >= s.lh - 1 { return false; }
  ti = r * s.lw + q;
  tk = 0;
  if ti < len(s.tkind) { tk = s.tkind[ti] ?? 0; }
  if role == 5 { return tk == K_LAKE + 1 || tk == K_RIVER + 1; }
  if role == 6 { return tk == K_SEA + 1; }
  !is_wall(s, q, r) && tk != K_LAKE + 1 && tk != K_SEA + 1
}

// The schedule: where does this civilian's ROUTE put it right now? `npc_target` below is
// what the rest of the engine asks — the route with safety's veto over it.
fn npc_route(s: Sim, e: Enemy) -> (integer, integer) {
  night = sim_phase(s) == 1;
  salt = e.hq * 31 + e.hr * 17;
  if e.role == 3 {                       // guards patrol day AND night
    leg = (((s.ticks / 80) ?? 0) + salt) % 2 ?? 0;
    if leg == 0 { return (e.wq2, e.wr2); }
    return (e.aq2, e.ar2);
  }
  if e.role == 7 || e.role == 8 {        // the MERCHANTS' multi-day trade routes
    if night { return (e.aq2, e.ar2); }  // park the night at the road stop
    leg = (((s.ticks / DAY_LEN) ?? 0) + salt) % 2 ?? 0;
    if leg == 0 { return (e.wq2, e.wr2); }
    return (e.hq, e.hr);                 // the other end: home market
  }
  if e.role == 9 {                       // rugged travelers camp where dusk finds them
    if night { return (e.cur_q, e.cur_r); }
    // ⚠ THE BAG STEERS, NOT THE CALENDAR (plan #17 `S3`). This used to alternate by day
    // parity between the picking ground and a second FAR point — which meant two bugs at
    // once: the gatherer never came home, and it never arrived anywhere at all. Measured:
    // the picking ground is 50 hexes out, a day carries it 13, and the leg flipped every
    // day — so it oscillated between home and 13 hexes out, forever. In 21 days it gathered
    // nothing, which is why role 9 has been decorative since it was added.
    //
    // Keyed on the bag the trip is self-correcting at any distance: empty, head for the
    // picking ground; full, head home. The round trip then takes however long it takes.
    if e.carry > 0 { return (e.hq, e.hr); }
    return (e.wq2, e.wr2);
  }
  if e.role == 12 { return (e.wq2, e.wr2); }   // wild things keep their own hours
  if night { return (e.hq, e.hr); }      // everyone else sleeps at home/anchor
  if e.role == 2 || e.role == 10 {       // farmers cycle field -> stall;
                                         // MINERS cycle the ore face -> furnace
    leg = (((s.ticks / 90) ?? 0) + salt) % 2 ?? 0;
    if leg == 0 { return (e.wq2, e.wr2); }
    return (e.aq2, e.ar2);
  }
  (e.wq2, e.wr2)                         // villagers: the square; fishers: the
                                         // water's edge; boats: their grounds
}

// Where this civilian wants to BE right now: the route, and the one veto over it.
//
// ⚠ I-SITE — NOBODY TRAVELS TO WORK THAT IS UNSAFE. This is `S2`'s second half, designed
// ("one term added to `npc_passable`, plus the same term in SITE SELECTION") and never
// built — and without it `S2` gates far less than it reads as gating. `npc_may_enter`
// refuses a step INTO danger but must let anyone already inside it move, or a worker caught
// by a raid would be trapped rather than avoiding anything. That escape hatch is unavoidable
// and on its own it swallows the rule whole: measured 2026-08-10, a gatherer swallowed by a
// raid walked its route at full speed and then CAMPED on its picking ground for 935 of 2800
// ticks, waiting out a ground that was unsafe for 2458 of them, and pocketed 21 loads
// against 17 in the same week with the den cleared. **Danger raised output.**
//
// The two rules answer different questions and the pair is what `I-SAFE` needs: this decides
// whether there is anywhere to go, `npc_may_enter` decides which step is allowed on the way.
// Guards are exempt (walking toward trouble is the job) and so are wild things, exactly as
// there. ⚠ It vetoes to HOME, never to a frozen step — a worker with nowhere to work still
// walks, so the signal is a settlement idling at home rather than a town of statues.
fn npc_target(s: Sim, e: Enemy) -> (integer, integer) {
  (tq, tr) = npc_route(s, e);
  if e.role == 3 || e.role == 12 { return (tq, tr); }
  if hex_safe(s, tq, tr) { return (tq, tr); }
  (e.hq, e.hr)                           // no work there today — the day is spent at home
}

// One scheduled step: greedy toward the target; idle wander when arrived.
// ── Incursions (plan #17 `S5`) ────────────────────────────────────────────────────────
//
// I-SOURCE: **every hostile pressing on a settlement came FROM a source that still exists.**
// Pressure ARRIVES; it does not accumulate. There is no timer anywhere in this — a source
// that is alive and has fewer than `RAID_CAP` of its people out may send another, and that
// is the whole condition. Kill the leader and it never sends again, permanently.
//
// ⚠ THE OBVIOUS IMPLEMENTATION IS THE ONE THAT RUINS IT (CRAFTING.md `D`, `F7`). Uniform
// *decay* — cleared ground reverting on a timer — reads as "my work rots", offers no cause
// to address, and makes the same valley a chore forever. Arriving from a source instead
// keeps a structure the player can read and act on: the valley is unsafe *because* of the
// thing over the ridge, and going at the thing over the ridge ends it.
//
// ⚠ NOT KEYED TO THE PLAYER (`F8`). Nothing here reads the hero's level, gear or progress.
// The world pushes where it is weak, not where the player is strong — a difficulty dial
// dressed as a world would read as punishment for getting better.
pub const RAID_CAP = 2;   // how many of its own a single source will have out at once

// One marching step for an incursion, down the same path field the civilians use. Hostiles
// are otherwise either asleep or chasing the hero; a raider walks with a purpose instead.
// ⚠ It does NOT consult `npc_may_enter`: safety is a rule for people who avoid danger, and
// this is the danger.
fn raider_step(s: &Sim, e: &Enemy) {
  if hex_distance(e.cur_q, e.cur_r, e.wq2, e.wr2) == 0 {
    e.tgt_q = e.cur_q;
    e.tgt_r = e.cur_r;
    return;
  }
  fbase = npc_flow_base(s, e.wq2, e.wr2, 0);
  fdata = s.flowd_data;
  bq = e.cur_q;
  br = e.cur_r;
  bf = FLOW_BIG;
  if fbase >= 0 {
    hidx = fbase + (e.cur_r - s.rmin) * s.lw + (e.cur_q - s.qmin);
    if hidx >= fbase && hidx < len(fdata) { bf = fdata[hidx] ?? FLOW_BIG; }
  }
  if fbase < 0 || bf >= FLOW_BIG {
    e.tgt_q = e.cur_q;
    e.tgt_r = e.cur_r;
    return;
  }
  // ⚠ GUARDED EXACTLY AS THE FIELD WAS BUILT, AND NO FURTHER. `compute_npc_flow` expands
  // through `is_blocked_move` (the EDGE — a thin wall between two open hexes) and
  // `npc_passable` (the hex), so a descent that tested less would walk through a fence.
  //
  // ⚠ AND IT DOES NOT TEST OCCUPANCY, WHICH IS THE DEFECT THIS COMMENT EXISTS FOR.
  // A first cut refused an occupied neighbour, and the raider never took a step in any
  // world: it spawns inside its own den, where the ONE improving neighbour is a sleeping
  // kinsman, and sleepers never move. Held position forever, 26 hexes out, looking exactly
  // like a raid that was never sent. `occupied_hex` is the CIVILIAN rule; hostiles have
  // never used it — `flow_step` (the chase) has no occupancy test at all, so monsters
  // already pass through each other on the way to the hero. One actor cannot have two
  // contradictory occupancy rules across its two states: it would refuse to stack while
  // marching and stack freely the tick it wakes. A sleeping monster is not terrain.
  for rd in 0..6 {
    (nq, nr) = hex_neighbor(e.cur_q, e.cur_r, rd);
    if npc_passable(s, 0, nq, nr) && !is_blocked_move(s, e.cur_q, e.cur_r, nq, nr) {
      nidx = fbase + (nr - s.rmin) * s.lw + (nq - s.qmin);
      if nidx >= fbase && nidx < len(fdata) {
        nf = fdata[nidx] ?? FLOW_BIG;
        if nf < bf { bf = nf; bq = nq; br = nr; }
      }
    }
  }
  e.tgt_q = bq;
  e.tgt_r = br;
}

// The settlement's SEAT — the market square the makers set their goods on, and the thing an
// incursion presses toward.
//
// ⚠ ONE ORIGIN FOR THE COORDINATE. `s.lw / 2 + 2` was written out twice — once by the
// morning economy and once by `send_incursions` — which is the literal-coordinate trap
// STATE.md records from the other side: two copies of a position are two claims about a
// world that is free to move, and only one of them gets updated.
fn town_seat(s: Sim) -> (integer, integer) { (s.lw / 2 + 2, s.lh / 2 - 2) }

// What an incursion actually PRESSES ON: the settlement's most exposed WORK — the outlying
// hex some worker has to reach and nobody can guard. The square when there is no such work.
//
// ⚠ THE SQUARE WAS THE FIRST ANSWER AND IT WAS THE WRONG ONE, measured 2026-08-10. Raiders
// marched at `town_seat`, arrived, and changed NOTHING: over seven days with the den alive
// the gatherer's picking ground was unsafe for **0 ticks** and the week's deliveries were 4,
// exactly as with the den cleared. The square is the one place danger cannot register —
// `hex_safe`'s second term is a guard within `GUARD_R`, and the square is where the guards
// are. An incursion aimed there is aimed at its own cancellation.
//
// So the objective is the settlement's DEPENDENCE, not its centre: the field, the ore face,
// the herb slope. That is what "a settlement's output is a function of the danger around it"
// says when read literally — and it is the legible version in play too. *Goblins are on the
// slope, so the alchemist has nothing* is a sentence a player can act on; *goblins are in the
// market, guarded, and the potions stopped* is not.
// ⚠ AND IT IS CHOSEN FROM WHERE THE SOURCE STANDS, over ground the source can actually
// cross. The first version ranked work sites by exposure alone and handed a den a field 45
// hexes away with no path to it: the raider descended a flow field that read `FLOW_BIG`
// under its own feet and held position for seven days, 32 hexes short, indistinguishable
// from a raid that was never sent. *Nearest is not reachable* cost this repo a decorative
// gatherer for months (`walk_reach`); farthest is not reachable either. Returns `(-1, -1)`
// when this source can reach no work and no square — then it sends nobody, which is the
// truthful answer rather than a walker that will never arrive.
fn raid_objective(s: &Sim, fq: integer, fr: integer) -> (integer, integer) {
  bq = -1;
  br = -1;
  bd = -1;
  (sq, sr) = town_seat(s);
  for i in 0..len(s.enemies) {
    e = s.enemies[i];
    // roles 2/9/10 — farmer, gatherer, miner: the ones whose job is OUTSIDE the walls
    if e != null && e.alive && (e.role == 2 || e.role == 9 || e.role == 10) {
      d = hex_distance(e.wq2, e.wr2, sq, sr);
      if d > bd && sim_npc_path_dist(s, e.wq2, e.wr2, 0, fq, fr) < FLOW_BIG {
        bd = d;
        bq = e.wq2;
        br = e.wr2;
      }
    }
  }
  if bq < 0 && sim_npc_path_dist(s, sq, sr, 0, fq, fr) < FLOW_BIG { return (sq, sr); }
  (bq, br)
}

// How big is the settlement in this window — the count the morning economy has always
// branched on (guards, less the one at the gate). ⚠ SEPARATE FROM THE SEAT, deliberately:
// the seat is where the square IS, the size is who lives there. Folding them into one
// answer sent a VILLAGE's goods to `(-1, -1)`, because the village fails the town test and
// still has a square. `>= 3` is a town; smaller is a village; `< 0` is empty wilderness.
pub fn town_size(s: Sim) -> integer {
  guards = 0;
  for gi in 0..len(s.enemies) {
    e = s.enemies[gi];
    // ⚠ PICKETS DO NOT COUNT (plan #17 `S7`). This is *who lives here*, and a militia is not
    // residents — it is the player's reach. Counted, a raised militia would tip a VILLAGE over
    // the `>= 3` town threshold, and the settlement would start receiving incursions because
    // the player defended it. A mechanism that answers "you did well" with "so the world now
    // attacks you" is `F8` wearing a different hat.
    if e != null && e.alive && e.role == 3 && e.picket == 0 { guards += 1; }
  }
  guards - 1
}

// Each day, every LIVING source with room to send, sends. The condition is entirely about
// the world's state — leader alive, fewer than `RAID_CAP` of its own already out — so
// clearing the source ends it and nothing is owed if the conditions never hold.
fn send_incursions(s: &Sim) {
  // ⚠ NO SETTLEMENT, NO INCURSION. Measured 2026-08-10 and it is why this guard exists: all
  // three of world 777's ruins sit in windows with 0 guards and 0 civilians, so a den that
  // sent anyway marched its people at the geometric centre of an empty wilderness — forever,
  // costing a safety recompute a tick, pressing on nothing. Pressure is pressure ON something.
  if town_size(s) < 3 { return; }
  enemies = s.enemies;
  ctbl = game_monsters();
  for bi in 0..len(enemies) {
    b = enemies[bi];
    if b != null && b.alive && b.role == 0 && (b.tags & TAG_RUIN_BOSS) != 0 {
      // A source's identity is its SPAWN hex, not where its leader happens to stand — the
      // leader moves when it wakes, and a moving identity would orphan its own raiders.
      out = 0;
      for ri in 0..len(enemies) {
        r2 = enemies[ri];
        if r2 != null && r2.alive && r2.raid == 1 && r2.hq == b.hq && r2.hr == b.hr { out += 1; }
      }
      if out < RAID_CAP {
        // WHERE first, WHO second. ⚠ Not a tidiness preference: `mon_pick_tag` leaks one
        // MonsterDef store record per call (measured 2026-08-10 — 22 calls, 21 records;
        // LOFT-HANDOFF `N3`), so picking before knowing there is room to stand would leak
        // once per source per DAY forever, in a den that is full and sends nothing.
        sq = -1;
        sr = -1;
        for nd in 0..6 {
          (cq, cr) = hex_neighbor(b.cur_q, b.cur_r, nd);
          if sq < 0 && npc_passable(s, 0, cq, cr) && !occupied_hex(s.enemies, cq, cr) {
            sq = cq;
            sr = cr;
          }
        }
        // Per SOURCE, not per world: which work this den can actually get at is a fact
        // about where this den stands.
        (tq, tr) = raid_objective(s, b.cur_q, b.cur_r);
        if sq >= 0 && tq >= 0 {
          // ONE per source per day. ⚠ Not one per WORLD per day: a global send would make
          // the enemy list's ORDER the schedule — the third den never sends until the first
          // two are capped — and a schedule is the one thing this mechanism does not have.
          salt = (b.hq * 2654435761 ^ b.hr * 40503) & 2147483647;
          md = mon_pick_tag(ctbl, TAG_RUIN_NEST, salt + s.ticks);
          if md.m_hp > 0 {
            ne = mk_enemy(md, sq, sr);
            ne.hq = b.hq;             // whose people these are
            ne.hr = b.hr;
            ne.wq2 = tq;              // and where they are going
            ne.wr2 = tr;
            ne.raid = 1;
            s.enemies += [ne];
          }
        }
      }
    }
  }
}

// ── Standing, and the militia it raises (plan #17 `S7`) ───────────────────────────────
//
// I-STAND: **standing is one number per settlement, raised only by acts done for that
// settlement, read only as a category, and it has exactly ONE consumer** — whether the
// militia may be raised. That last clause is the guard rail, not a description: a second
// consumer is the point where this stops being a number and starts wanting a social sim
// (`DESIGN.md` §3a #6).
//
// I-PICKET: **a picket is a guard the settlement would not otherwise have posted.** It is an
// ordinary role-3 actor, so `hex_safe` gains no term and the safety expression is untouched —
// `S1` bought this whole step without knowing it. The militia is one new *source* of guards,
// never a new kind of safety.
//
// ⚠ THE PLAYER'S PUSH OUT, WHERE `S5` IS THE WORLD'S PUSH IN, and they argue about the SAME
// ground: `militia_site` reads the set `raid_objective` presses on, from the other side. If
// they ranked different hexes neither side's move would be legible against the other's.
//
// ⚠ AND IT IS NOT A PROGRESS BAR (`F7`). Nothing here has a timer. The militia advances when
// there is work it can hold and stops when a living source is sitting on the rest — a legible
// place, stalled for a legible reason, that moves again when the player kills the cause.
pub const STAND_KNOWN = 3;    // deeds: the town knows your face
pub const STAND_TRUST = 6;    //        the town would put men under you
const DEED_RAID   = 1;        // turning back what a source sent at this settlement
const DEED_SOURCE = 3;        // ending the source itself — worth three of the above
const STAND_W = 4;            // stride of `s.stand`: win_x, win_y, deeds, pickets

// How close a living source keeps the militia off. ⚠ DERIVED, NOT CHOSEN: a picket covers
// `GUARD_R` around itself and a source spoils `THREAT_R` around itself, so inside the sum the
// two rings overlap and the picket would be holding the den's own doorstep by main force.
// Refusing that is what makes *"come back later"* a world state instead of a timer — the
// tough spots stay the player's job, which is the whole shape the design asked for.
pub const SRC_R = THREAT_R + GUARD_R;

// This settlement's row in `s.stand`, appended on first use. The WINDOW is the settlement's
// identity — see the field's comment for why a single global number is the thing to refuse.
fn stand_slot(s: &Sim) -> integer {
  st = s.stand;
  n = (len(st) / STAND_W) ?? 0;
  for i in 0..n {
    b = i * STAND_W;
    if (st[b] ?? 0) == s.win_x && (st[b + 1] ?? 0) == s.win_y { return b; }
  }
  b2 = len(st);
  s.stand += [s.win_x];
  s.stand += [s.win_y];
  s.stand += [0];
  s.stand += [-1];              // -1 = never petitioned (0 pickets is a RAISED militia)
  b2
}

// The same lookup without creating one — every read-only path uses this, so merely asking
// about standing never writes a row.
fn stand_find(s: Sim) -> integer {
  st = s.stand;
  n = (len(st) / STAND_W) ?? 0;
  for i in 0..n {
    b = i * STAND_W;
    if (st[b] ?? 0) == s.win_x && (st[b + 1] ?? 0) == s.win_y { return b; }
  }
  -1
}

// Deeds this settlement counts to the player. Pub for the gate: a category with no readable
// number underneath it is one nobody can assert either side of.
pub fn sim_standing(s: Sim) -> integer {
  b = stand_find(s);
  if b < 0 { return 0; }
  s.stand[b + 2] ?? 0
}

// The CATEGORY, which is the only form the player ever meets it in — a threshold you can
// cross and see crossed, never a float that slides (the same argument as `S1`'s safety).
pub fn sim_standing_word(s: Sim) -> text {
  d = sim_standing(s);
  if d >= STAND_TRUST { return "trusted"; }
  if d >= STAND_KNOWN { return "known"; }
  "stranger"
}

// Pickets this settlement's militia has posted; -1 = it has never been petitioned.
pub fn sim_militia(s: Sim) -> integer {
  b = stand_find(s);
  if b < 0 { return -1; }
  s.stand[b + 3] ?? -1
}

// A deed done for the settlement the player is standing in. ⚠ NO SETTLEMENT, NO STANDING:
// standing is a town's reckoning of you, so there has to be a town doing the reckoning —
// the same test `send_incursions` makes before it presses on anything.
fn stand_earn(s: &Sim, n: integer) {
  if s.depth != 0 { return; }
  if town_size(s) < 3 { return; }
  b = stand_slot(s);
  st = s.stand;
  was = st[b + 2] ?? 0;
  deeds = was + n;
  st[b + 2] = deeds;
  // THE WORLD SAYS IT, AND ONLY WHEN IT CHANGES (I-SAY, `S4`). No panel, no meter: the two
  // lines a player ever sees are the two threshold crossings, and the second one points at
  // the guard master without a quest marker.
  if was < STAND_KNOWN && deeds >= STAND_KNOWN {
    sim_log(s, "Word gets round: you were on the road when it mattered.");
  }
  if was < STAND_TRUST && deeds >= STAND_TRUST {
    sim_log(s, "The watch nods as you pass. Someone should tell the guard master.");
  }
}

// ONE PLACE A HOSTILE'S DEATH IS ACCOUNTED FOR. ⚠ The poster bounty was written out THREE
// times — melee, bolt, shot — and standing would have made it six. Three copies of a rule is
// three chances to add a fourth kill path and forget one, and forgetting is silent: the
// player kills the thing and the town simply never notices.
//
// Takes the three FACTS rather than the Enemy, the same way `npc_may_enter` takes role and
// origin: they are the only three it uses, the kill paths hold a nullable record, and a rule
// that can be asked in isolation is one a gate can control.
fn on_hostile_slain(s: &Sim, role: integer, tags: integer, raid: integer) {
  if role != 0 { return; }
  if (tags & TAG_RUIN_BOSS) != 0 && s.q_poster == 1 {
    s.q_poster = 2;
    sim_log(s, "That was the brute from the poster - the watch owes you gold.");
  }
  // STANDING IS EARNED BY ACTS, and these are the acts: turning back what a source sent at
  // this settlement's work, and ending the source. Nothing else counts — which is what keeps
  // one number to one meaning, rather than a score that rises for existing nearby.
  if raid == 1 {
    stand_earn(s, DEED_RAID);
  } else if (tags & TAG_RUIN_BOSS) != 0 {
    stand_earn(s, DEED_SOURCE);
  }
}

// Is this ground held CONTINUOUSLY — some guard whose whole walk stays inside `GUARD_R` of it?
//
// ⚠ NOT "a guard is near it right now". A guard walks two legs, so a momentary reading answers
// differently depending on which tick asks, and a militia that chose its post from one would
// post somewhere else every time the window was rebuilt. The guard master's beat was designed
// against exactly this rule — both legs inside `GUARD_R` of the seat, so the square is held
// from every point of the walk — and this is that rule asked of any hex.
pub fn hex_held(s: Sim, q: integer, r: integer) -> boolean {
  es = s.enemies;
  for i in 0..len(es) {
    g = es[i];
    if g != null && g.alive && g.role == 3
       && hex_distance(g.wq2, g.wr2, q, r) <= GUARD_R
       && hex_distance(g.aq2, g.ar2, q, r) <= GUARD_R { return true; }
  }
  false
}

// A living source whose GROUND this is. ⚠ Its SPAWN hex, not where its leader stands — the
// same identity `send_incursions` uses, and for the same reason: a den's ground does not move
// when the thing in it wakes up and wanders. It also keeps the militia's decision independent
// of the tick that asks, which is what makes the whole mechanism gate-able.
pub fn src_near(s: Sim, q: integer, r: integer) -> boolean {
  es = s.enemies;
  for i in 0..len(es) {
    e = es[i];
    if e != null && e.alive && e.role == 0 && (e.tags & TAG_RUIN_BOSS) != 0
       && hex_distance(e.hq, e.hr, q, r) <= SRC_R { return true; }
  }
  false
}

// What is standing on it — for the guard master's stall line, so the halt has a NAME.
fn src_name_near(s: Sim, q: integer, r: integer) -> text {
  es = s.enemies;
  for i in 0..len(es) {
    e = es[i];
    if e != null && e.alive && e.role == 0 && (e.tags & TAG_RUIN_BOSS) != 0
       && hex_distance(e.hq, e.hr, q, r) <= SRC_R { return e.name; }
  }
  ""
}

// Whose work a hex is — so the militia's marching order can be said in the words the workers
// already use (`work_words`, `S4`) rather than in coordinates.
fn site_role(s: Sim, q: integer, r: integer) -> integer {
  es = s.enemies;
  for i in 0..len(es) {
    e = es[i];
    if e != null && e.alive && (e.role == 2 || e.role == 9 || e.role == 10)
       && e.wq2 == q && e.wr2 == r { return e.role; }
  }
  1
}

// The next hex the militia would hold: the settlement's most exposed WORK that nobody holds
// and the watch can walk to.
//
// `slack = false` is the question an ADVANCE asks — and it includes the source rule, which is
// the stall. `slack = true` is the question a RE-POST asks, and it deliberately does not.
//
// Pub for the reason `npc_may_enter` and `prod_draw_when` are: the branch that matters most
// here is the one where it answers NOTHING, and a decision reachable only through a day of
// simulation is one whose refusal nobody can gate.
pub fn militia_site(s: &Sim, slack: boolean) -> (integer, integer) {
  (sq, sr) = town_seat(s);
  bq = -1;
  br = -1;
  bd = -1;
  tq2 = 0;                       // pre-declared: a tuple assign inside the block cannot declare
  tr2 = 0;
  for i in 0..len(s.enemies) {
    e = s.enemies[i];
    // roles 2/9/10 — farmer, gatherer, miner: the work that is OUTSIDE the walls, which is
    // the same set `raid_objective` chooses a target from.
    if e != null && e.alive && (e.role == 2 || e.role == 9 || e.role == 10) {
      d = hex_distance(e.wq2, e.wr2, sq, sr);
      if d > bd && !hex_held(s, e.wq2, e.wr2)
         && sim_npc_path_dist(s, e.wq2, e.wr2, 3, sq, sr) < FLOW_BIG
         && (slack || !src_near(s, e.wq2, e.wr2)) {
        // ⚠ AND THE GROUND MUST GIVE IT SOMEWHERE TO STAND. Without this the advance keeps
        // choosing a site it can never post at, and the militia stalls forever on a hex with
        // no cause a player can see or act on — the failure mode this whole step is shaped to
        // avoid, arriving through the back door.
        (tq2, tr2) = militia_stand(s, e.wq2, e.wr2);
        if tq2 >= 0 {
          bd = d;
          bq = e.wq2;
          br = e.wr2;
        }
      }
    }
  }
  (bq, br)
}

// WHERE A PICKET ACTUALLY STANDS to hold a work site: two hexes out, on the FAR side — the
// side away from the settlement — or `(-1, -1)` when the ground gives it nowhere.
//
// ⚠ NOT ON THE WORK ITSELF, AND THIS COST THE FIRST BUILD ITS WHOLE MEASUREMENT. A picket
// posted on the ore face made it safe **1600 of 1600 ticks** and the town's ore went from 3
// deliveries to **0**: `npc_step` refuses any occupied hex and only ever takes a strictly
// improving neighbour, so a permanent body in a one-hex mountain pass freezes everyone behind
// it forever — both miners stuck three hexes short, one carrying a load it could never bring
// home. It is the corpse defect (*the dead do not hold ground*) with a living body, and it is
// worse, because this one the militia put there itself.
//
// So the rule is directional, and the fiction and the mechanism agree for once: **a picket
// faces outward.** Standing two hexes beyond the work, on the side away from town, it cannot
// be on the road the workers come up — that road approaches from the settlement — and the
// working ring (`npc_mine`/`npc_gather` fire within one hex) stays clear. Two out is still
// well inside `GUARD_R`, so the ground is held from either end of its beat.
fn militia_stand(s: &Sim, q: integer, r: integer) -> (integer, integer) {
  (sq, sr) = town_seat(s);
  bq = -1;
  br = -1;
  bd = -1;
  for ry in 0..5 {
    for rx in 0..5 {
      cq = q + rx - 2;
      cr = r + ry - 2;
      if hex_distance(cq, cr, q, r) == 2 && npc_passable(s, 3, cq, cr)
         && !occupied_hex(s.enemies, cq, cr) {
        // connected to the ground it holds — asked against the SITE's own field, which the
        // workers heading there have already paid for, so this adds no flow cache pressure
        if sim_npc_path_dist(s, q, r, 3, cq, cr) < FLOW_BIG {
          d = hex_distance(cq, cr, sq, sr);
          if d > bd { bd = d; bq = cq; br = cr; }
        }
      }
    }
  }
  (bq, br)
}

// Post one, ON its stand rather than walking it there from the square.
//
// ⚠ IT DOES NOT MARCH, and the reason is a deadlock rather than a preference. A picket walking
// out through a one-hex pass meets a miner walking in; neither may enter the other's hex and
// neither is going anywhere else, so both freeze permanently — the same occupancy rule that
// the stand above is placed around. Posting directly also makes an advance and a re-derivation
// the same operation, which removes an axis the two could otherwise silently disagree on.
//
// ⚠ AND IT HAS NO BEAT AT ALL — BOTH LEGS ARE THE STAND, which is a cost decision, not a
// flavour one. Civilian pathing runs on cached flow fields keyed by (destination, movement
// class), `FLOWD_MAX` of them, and **the shipped world already sits at the cap**: measured
// 2026-08-10, the home window holds 24 of 24 before a militia exists. A field is handed out
// first-come, so every extra destination a picket wanted took one a worker needed, and the
// loser silently fell back to greedy stepping — which is the freeze this repo has already paid
// for once (*greedy is not pathing*). A picket given a two-hex beat cost the miners their
// route home: the ore went from 3 deliveries to 0 with the ground perfectly safe, and the
// miner stood on ground whose path field read `FLOW_BIG` in every direction.
//
// Standing its post, a picket asks for NOTHING: `npc_step` returns at `d0 == 0` before it ever
// touches the cache. A sentry that does not move is also what a picket IS — the patrol beat
// was borrowed from the town guard, whose job is different.
fn militia_place(s: &Sim, q: integer, r: integer) -> boolean {
  (pq, pr) = militia_stand(s, q, r);
  if pq < 0 { return false; }
  ne = mk_npc(3, "militia", "militia", "g", 190, 170, 120, pq, pr, pq, pr, pq, pr, pq, pr);
  ne.picket = 1;
  s.enemies += [ne];
  true
}

// The militia's own move, once a day at dawn — the same eligibility hook the sources use, and
// deliberately the same *kind* of rule: no schedule, no accumulation, just "is there ground it
// can hold today". One picket a day, so the frontier is something a player watches move.
fn militia_advance(s: &Sim) {
  if s.depth != 0 { return; }
  b = stand_find(s);
  if b < 0 { return; }
  n = s.stand[b + 3] ?? -1;
  if n < 0 { return; }                     // never petitioned: the settlement posts nobody
  (q, r) = militia_site(s, false);
  if q < 0 { return; }                     // everything it can hold is held, or a source has the rest
  if !militia_place(s, q, r) { return; }
  st = s.stand;
  st[b + 3] = n + 1;
  (sq, sr) = town_seat(s);
  srole = site_role(s, q, r);
  place = "";                    // pre-declared: a tuple assign here cannot also declare
  cost = "";
  (place, cost) = work_words(srole);
  sim_log(s, "The watch marches a picket out to {place}, {bearing_word(sq, sr, q, r)} of here.");
  sim_log(s, "That road is the town's again.");
}

// Re-derive the pickets this settlement has already bought, after its window is rebuilt.
//
// ⚠ THE ADVANCE IS A DECISION; A PICKET IS A FACT. So this asks only what is a property of the
// world as generated — is this still the settlement's exposed work, and can the watch get
// there — and NOT the source rule that gates an advance. Asking the full question here would
// quietly UNPOST a picket the player earned, every time they walked out of the valley and back.
fn militia_repost(s: &Sim) {
  if s.depth != 0 { return; }
  b = stand_find(s);
  if b < 0 { return; }
  n = s.stand[b + 3] ?? -1;
  for _ in 0..n {
    (q, r) = militia_site(s, true);
    if q >= 0 { militia_place(s, q, r); }
  }
}

// What the watch would say about a militia it has already raised: 3 = still advancing,
// 4 = STALLED at a living source, 5 = the line is out as far as this settlement's work goes.
fn militia_report(s: &Sim) -> integer {
  (fq, fr) = militia_site(s, false);
  if fq >= 0 { return 3; }
  (sq, sr) = militia_site(s, true);
  if sq >= 0 { return 4; }
  5
}

// BUMP-TO-PETITION — the player asks the watch to raise a militia, at ZERO new keys: the seam
// is `sim_talk_to`, which already carries the town's quest lines (`DESIGN.md` §3a #7).
//
// ⚠ IT RAISES, IT DOES NOT ADVANCE. The kick-start is the player's (a user ruling) and it puts
// one picket on the road at once, so the act has a result you can see; every picket after that
// is the militia's own daily move. Bumping again only ever reports — a verb that posted a
// picket per press would be a button, and the frontier would stop being a world state.
//
// Returns: 0 no settlement here · 1 not enough standing · 2 raised, a picket marches now ·
// 3/4/5 as `militia_report`. Pub because a predicate reachable only through a conversation is
// one whose branches nobody can gate.
pub fn sim_militia_petition(s: &Sim) -> integer {
  if s.depth != 0 { return 0; }
  if town_size(s) < 3 { return 0; }
  b = stand_slot(s);
  st = s.stand;
  if (st[b + 3] ?? -1) >= 0 { return militia_report(s); }
  if (st[b + 2] ?? 0) < STAND_TRUST { return 1; }
  st[b + 3] = 0;
  militia_advance(s);
  2
}

// ── Civilian path fields (plan #17 `S3`) ──────────────────────────────────────────────
//
// ⚠ CIVILIANS USED TO STEP GREEDILY, AND GREEDY IS NOT PATHING. The old step took a
// neighbour only if it was STRICTLY closer, so it walked into the first concave obstacle and
// stopped there — permanently, since nothing about the situation ever changed. Measured on
// world 777: the gatherer froze 13 hexes from home, 37 short of its picking ground, and in
// 21 simulated days delivered nothing. Monsters have had `compute_flow` since the AI landed;
// this gives the same thing to the people.
//
// A flow field has no local minimum except its destination, so descending it cannot get
// stuck — that is the whole reason to pay for it.
//
// THE COST IS PAID ONCE. A field depends only on (destination, movement class) and the
// terrain, all of which are fixed for the level: an NPC's `hq`/`wq2`/`aq2` are set when it
// spawns. So fields are built lazily and then kept, and every NPC walking to the same place
// reads the same one. Recomputing per NPC per tick — the obvious implementation — would be a
// 10,201-hex BFS per civilian per tick, which is why it is worth saying that it is not that.
// ⚠ HOW MANY IS NOT A CONSTANT — see `flowd_cap` below. A flat 24 sat *under* the shipped
// world's own demand of 38 and quietly sent nine civilians home in a straight line every
// night. The cap is derived from the actor count now, and the gate asserts the demand is met
// rather than trusting that it is.

// Which terrain a role can cross. Boats and ships live on water, everyone else off it — the
// same three-way split `npc_passable` makes, named once so a field is shared by every role
// that walks rather than built per role.
fn npc_move_class(role: integer) -> integer {
  if role == 5 { return 5; }
  if role == 6 { return 6; }
  0
}

// BFS path-distance to (dq,dr) for one movement class. Mirrors `compute_flow` but asks
// `npc_passable` as well as `is_blocked_move`, so a walker's field never routes through a
// lake — a field that ignored terrain would just relocate the freeze rather than remove it.
fn compute_npc_flow(s: Sim, dq: integer, dr: integer, cls: integer) -> vector<integer> {
  n = s.lw * s.lh;
  fl: vector<integer> = [];
  for _ in 0..n { fl += [FLOW_BIG]; }
  if dq >= s.qmin && dr >= s.rmin && dq < s.qmin + s.lw && dr < s.rmin + s.lh {
    start = (dr - s.rmin) * s.lw + (dq - s.qmin);
    if start >= 0 && start < len(fl) {
      fl[start] = 0;
      frontier: vector<integer> = [];
      frontier += [start];
      head = 0;
      while head < len(frontier) {
        cur = frontier[head] ?? 0;
        head += 1;
        cq = s.qmin + (cur % s.lw ?? 0);
        cr = s.rmin + (cur / s.lw ?? 0);
        cd = fl[cur] ?? FLOW_BIG;
        for fdir in 0..6 {
          (nq, nr) = hex_neighbor(cq, cr, fdir);
          if nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh
             && !is_blocked_move(s, cq, cr, nq, nr) && npc_passable(s, cls, nq, nr) {
            nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
            if nidx >= 0 && nidx < len(fl) {
              cn = fl[nidx] ?? FLOW_BIG;
              if cn > cd + 1 {
                fl[nidx] = cd + 1;
                frontier += [nidx];
              }
            }
          }
        }
      }
    }
  }
  fl
}

// How many fields this world may hold — **a property of the world, not a constant.**
//
// ⚠ THE CONSTANT WAS A SILENT CLIFF, AND IT WAS ALREADY OVER (measured 2026-08-10). The
// shipped home window DEMANDS 38 distinct (destination, class) fields against a flat
// `FLOWD_MAX = 24`, so 14 destinations were never served — and the losers were not random.
// Work is asked by day and home by night, day comes first, so what lost was systematically
// the HOMES: **nine townsfolk walked home on a straight line every night**, freezing at the
// first concave obstacle, which is the exact failure the fields were introduced to end
// (*greedy is not pathing*). Nothing reported it; the fallback is silent by construction.
//
// The bound is derivable, and the comment above already contains the derivation: an actor's
// `hq`/`wq2`/`aq2` are fixed when it spawns, so **it can ask for at most three destinations**,
// and everything asked at runtime resolves to one of those or to the town seat — a raid
// objective is a worker's own work hex (`raid_objective`), a picket's stand is asked against
// the work site's field (`militia_stand`), and a picket has no beat to walk. So `3n + slack`
// is provably above the demand for any world, at any actor count, forever.
//
// ⚠ IT IS A RUNAWAY GUARD, NOT A BUDGET. Fill stays lazy, so memory tracks what is actually
// asked (~38 fields, ~3 MB) and never the cap. Read live off `len(enemies)` rather than baked
// at genesis, because raiders and pickets are appended after it.
fn flowd_cap(s: Sim) -> integer { 3 * len(s.enemies) + 16 }

// The slot base for this destination's field, building it on first ask. -1 only if a caller
// ever exceeds `flowd_cap` — which no actor can, by the derivation above — and the caller then
// falls back to the greedy step, which is what it always did.
fn npc_flow_base(s: &Sim, dq: integer, dr: integer, role: integer) -> integer {
  cls = npc_move_class(role);
  n = s.lw * s.lh;
  kq = s.flowd_q;
  kr = s.flowd_r;
  kc = s.flowd_cls;
  for i in 0..len(kq) {
    if (kq[i] ?? -1) == dq && (kr[i] ?? -1) == dr && (kc[i] ?? -1) == cls { return i * n; }
  }
  if len(kq) >= flowd_cap(s) { return -1; }
  fl = compute_npc_flow(s, dq, dr, cls);
  base = len(kq) * n;
  s.flowd_q += [dq];
  s.flowd_r += [dr];
  s.flowd_cls += [cls];
  d = s.flowd_data;
  for i in 0..n { d += [fl[i] ?? FLOW_BIG]; }
  base
}

// Path distance from (fq,fr) to (dq,dr) for a role, or `FLOW_BIG` when no path exists.
// Exposed because "can this worker actually get to its job" is a question about the WORLD,
// and a gate that cannot ask it can only observe that nothing happened.
pub fn sim_npc_path_dist(s: &Sim, dq: integer, dr: integer, role: integer,
                         fq: integer, fr: integer) -> integer {
  base = npc_flow_base(s, dq, dr, role);
  if base < 0 { return FLOW_BIG; }
  if fq < s.qmin || fr < s.rmin || fq >= s.qmin + s.lw || fr >= s.rmin + s.lh { return FLOW_BIG; }
  d = s.flowd_data;
  idx = base + (fr - s.rmin) * s.lw + (fq - s.qmin);
  if idx < base || idx >= len(d) { return FLOW_BIG; }
  d[idx] ?? FLOW_BIG
}

// How many path fields are cached — `FLOWD_MAX` means the cache is full and later askers
// silently fall back to the straight-line step.
pub fn sim_flow_fields(s: Sim) -> integer { len(s.flowd_q) }

fn npc_step(s: &Sim, e: &Enemy) {
  (tq, tr) = npc_target(s, e);
  d0 = hex_distance(e.cur_q, e.cur_r, tq, tr);
  if d0 == 0 {
    // arrived: boats drift their grounds; folk shuffle about the spot
    wob = ((s.ticks * 2654435761) ^ ((e.hq * 40503 + e.wq2) * 69427)) & 7;
    if (e.role == 5 || e.role == 6 || e.role == 1 || e.role == 11 || e.role == 12) && wob < 2 {
      dpick = ((s.ticks * 1103515245) ^ (e.hq * 12345)) % 6 ?? 0;
      (nq, nr) = hex_neighbor(e.cur_q, e.cur_r, dpick);
      if npc_passable(s, e.role, nq, nr) && npc_may_enter(s, e.role, e.cur_q, e.cur_r, nq, nr) && !occupied_hex(s.enemies, nq, nr) {
        e.tgt_q = nq;
        e.tgt_r = nr;
        return;
      }
    }
    e.tgt_q = e.cur_q;
    e.tgt_r = e.cur_r;
    return;
  }
  // Descend the PATH field, not the straight line. `fbase < 0` means the cache is full and
  // the old straight-line measure stands in; `fhere == FLOW_BIG` means this NPC is somewhere
  // the field never reached (off it, or walled off), where a path metric says nothing.
  fbase = npc_flow_base(s, tq, tr, e.role);
  fdata = s.flowd_data;
  fhere = FLOW_BIG;
  if fbase >= 0 {
    hidx = fbase + (e.cur_r - s.rmin) * s.lw + (e.cur_q - s.qmin);
    if hidx >= fbase && hidx < len(fdata) { fhere = fdata[hidx] ?? FLOW_BIG; }
  }
  usef = fbase >= 0 && fhere < FLOW_BIG;

  best = -1;
  bd = d0;
  bf = fhere;
  broad = false;
  for dd in 0..6 {
    (nq, nr) = hex_neighbor(e.cur_q, e.cur_r, dd);
    if npc_passable(s, e.role, nq, nr) && npc_may_enter(s, e.role, e.cur_q, e.cur_r, nq, nr) && !occupied_hex(s.enemies, nq, nr) {
      onroad = false;
      if e.role == 7 {
        tin = nr * s.lw + nq;
        if tin < len(s.tkind) { onroad = (s.tkind[tin] ?? 0) == K_ROAD + 1; }
      }
      if usef {
        nf = FLOW_BIG;
        if nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh {
          nidx = fbase + (nr - s.rmin) * s.lw + (nq - s.qmin);
          if nidx >= fbase && nidx < len(fdata) { nf = fdata[nidx] ?? FLOW_BIG; }
        }
        better = nf < bf || (nf == bf && onroad && !broad);
        if better && (nf < bf || e.role == 7) { bf = nf; best = dd; broad = onroad; }
      } else {
        nd = hex_distance(nq, nr, tq, tr);
        better = nd < bd || (nd == bd && onroad && !broad);
        if better && (nd < bd || e.role == 7) { bd = nd; best = dd; broad = onroad; }
      }
    }
  }
  if best >= 0 {
    (nq, nr) = hex_neighbor(e.cur_q, e.cur_r, best);
    e.tgt_q = nq;
    e.tgt_r = nr;
  } else {
    e.tgt_q = e.cur_q;
    e.tgt_r = e.cur_r;
  }
}

// Production repertoires (WHICH item each workshop makes) live in items.loft, beside the
// defs they name — content beside content. What stays here is the ROTATION: the forge
// alternates by day parity, the alchemist brews on three weekdays, the scriptorium on the
// others. Mechanism engine-side, content content-side (BUNDLE.md standing check).

// WHERE THE WILD THINGS LIVE: each terrain kind carries its natural fauna
// (branch selectors — C27). Tier 1 = the nearer wilds, tier 2 = the far and
// high. Engine keys only — bundle monsters place through their own rules.
// The cart's TRADE: at the home market it loads what the makers offer — but
// only weapons/armour, only the LIGHT ones (a cart is no ox-train), and only
// two slots (not much choice); at the route's far end it sets them out.
fn npc_trade(s: &Sim, e: &Enemy) {
  itbl = game_items();
  if hex_distance(e.cur_q, e.cur_r, e.hq, e.hr) <= 2 {
    fl = s.fi_live;
    fq = s.fi_q;
    fr = s.fi_r;
    fd = s.fi_def;
    fc = s.fi_cat;
    fg = s.fi_gold;
    // POTIONS first — the prices outside the city skyrocket, the traders
    // want them badly; arms fill whatever room remains
    for pass2 in 0..2 {
      for li in 0..s.fi_n {
        if (fl[li] ?? 0) == 1 && (fg[li] ?? 0) == 0 {
          dgg = hex_distance(fq[li] ?? 0, fr[li] ?? 0, e.cur_q, e.cur_r);
          ct = fc[li] ?? -1;
          di2 = fd[li] ?? -1;
          want = false;
          if pass2 == 0 { want = ct == IT_POTION; }
          if pass2 == 1 { want = ct == IT_WEAPON || ct == IT_ARMOR; }
          if dgg <= 2 && di2 >= 0 && want {
            dfn = itbl[di2];
            if dfn != null && dfn.i_weight <= 75 {
              if e.c1g < 0 {
                e.c1g = di2;
                if li < len(fl) { fl[li] = 0; }
              } else if e.c2g < 0 {
                e.c2g = di2;
                if li < len(fl) { fl[li] = 0; }
              }
            }
          }
        }
      }
    }
  }
  if hex_distance(e.cur_q, e.cur_r, e.wq2, e.wr2) <= 1 {
    if e.c1g >= 0 {
      add_floor(s, e.cur_q, e.cur_r, 0, item_cat(itbl, e.c1g), e.c1g);
      e.c1g = -1;
    }
    if e.c2g >= 0 {
      add_floor(s, e.cur_q, e.cur_r, 0, item_cat(itbl, e.c2g), e.c2g);
      e.c2g = -1;
    }
  }
}

// THE GATHERER'S ROUND TRIP (plan #17 `S3`) — pick out there, deliver in town.
//
// ⚠ ONE RAISE SITE, and it is the arrival. The bag (`carry`) is what makes the delivery an
// EVENT: reaching the picking ground fills it, reaching home empties it into the stock. A
// raise keyed on "is standing in town" instead would fire every tick of every visit and the
// empty-stock state — the entire point of `S3` — would be unreachable.
//
// This is also where the plan closes. `S2` will not let a gatherer step into unsafe ground,
// so hostiles near the picking grounds mean no pick, no delivery, no stock, and the
// alchemist brews nothing. Output as a function of danger, with no new key and no number
// shown to anybody.
fn npc_gather(s: &Sim, e: &Enemy) {
  enemies = s.enemies;
  // ⚠ ONE FILL SITE, AND UNSAFE GROUND YIELDS NOTHING (I-WORK, plan #17 `S5`). Both halves
  // are load-bearing and both were measured missing on 2026-08-10:
  //
  //   • THE SITE. The bag used to fill wherever a wild thing wandered past, so supply had a
  //     second path with no place attached — and a thing with no place is a thing danger
  //     cannot press on. (Measured: that arm fired **0 times** in either run of the week
  //     below, so it was never the cause `S5` recorded it as — but it was still a hole.)
  //   • THE SAFETY TERM. Refusing to *enter* danger is not enough, because `npc_may_enter`
  //     lets anyone already standing in unsafe ground move anywhere — the escape hatch that
  //     keeps a worker from being trapped. A gatherer swallowed by a raid therefore walked
  //     its whole route unimpeded and picked with raiders on the ground: 31 loads in the week
  //     the picking ground was unsafe 2454 of 2800 ticks, against 17 with the den cleared.
  //     **Danger RAISED output, because being in danger exempts you from avoiding danger.**
  //
  // So avoidance governs where a worker GOES and this governs what the ground GIVES. They are
  // different questions and the second is the one `I-SAFE` is about.
  if hex_distance(e.cur_q, e.cur_r, e.wq2, e.wr2) <= 1 && hex_safe(s, e.cur_q, e.cur_r) {
    // Trapping a wild thing on the range is a pick too — the original flavour, kept. It is
    // the SAME load, not a second one: the bag holds one trip's worth either way.
    for wl9 in 0..len(enemies) {
      w9 = enemies[wl9];
      if w9.alive && w9.role == 12
         && hex_distance(w9.cur_q, w9.cur_r, e.cur_q, e.cur_r) <= 1 {
        w9.alive = false;                // trapped: ingredients for the factory
      }
    }
    e.carry = GATHER_LOAD;
  }
  // Home with a full bag: the settlement gains the load, and the bag is empty again.
  if e.carry > 0 && hex_distance(e.cur_q, e.cur_r, e.hq, e.hr) <= 1 {
    for _ in 0..e.carry { prod_raise(s, "alchemy"); }
    e.carry = 0;
  }
}

// THE MINER'S ROUND TRIP (plan #17 `S6`) — cut at the face, carry it down to the furnace.
//
// The gatherer's shape exactly (`npc_gather`), against the same two terms: the bag fills only
// AT the ore face and only while that ground is safe, and it empties at the furnace, which is
// where worldgen already sends this NPC (`aq2`). ⚠ Both halves are load-bearing for the same
// reasons measured there — a fill site with no place attached is a thing danger cannot press
// on, and refusing to *enter* danger does not cover a worker already standing in it.
//
// ⚠ WHICH LINE IT FEEDS IS THE FORGE'S OWN ROTATION, not a new term: the forge works weapons
// on even days and armour on odd (`sim_tick`), so the ore that comes down today goes to the
// line that will consume it. That keeps one load = one raise — inventing a shared ore store,
// or raising both, would create matter and break I-STOCK's conservation.
fn npc_mine(s: &Sim, e: &Enemy) {
  if hex_distance(e.cur_q, e.cur_r, e.wq2, e.wr2) <= 1 && hex_safe(s, e.cur_q, e.cur_r) {
    e.carry = GATHER_LOAD;
  }
  if e.carry > 0 && hex_distance(e.cur_q, e.cur_r, e.aq2, e.ar2) <= 1 {
    for _ in 0..e.carry { prod_raise(s, forge_line_today(s)); }
    e.carry = 0;
  }
}

// Which forge line the day belongs to. ONE definition, read by the miner's delivery and by
// the forge's own making — they have to agree or the ore lands in the store the forge is not
// drawing from today, and the coupling silently stops.
fn forge_line_today(s: Sim) -> text {
  day = (s.ticks / DAY_LEN) ?? 0;
  if (day % 2 ?? 0) == 0 { return "forge_weapon"; }
  "forge_armor"
}

// The SHIP'S MANIFEST: when the merchant ship lies at anchor by night, it
// lands the goods no local craft can make — the magic imports from beyond
// the map — onto the pier planks beside it.
fn npc_land_cargo(s: &Sim, e: Enemy) {
  if hex_distance(e.cur_q, e.cur_r, e.aq2, e.ar2) > 1 { return; }
  if ((s.ticks % DAY_LEN) ?? 0) != 300 { return; }
  if s.fi_n >= FLOOR_MAX - 4 { return; }
  day4 = (s.ticks / DAY_LEN) ?? 0;
  mkey4 = game_production_key("import", day4 % game_production_len("import") ?? 0);
  // set it on the pier plank beside the anchorage
  for d4 in 0..6 {
    (nq4, nr4) = hex_neighbor(e.cur_q, e.cur_r, d4);
    if nq4 >= 0 && nq4 < s.lw && nr4 >= 0 && nr4 < s.lh {
      ti4 = nr4 * s.lw + nq4;
      if ti4 < len(s.tkind) && (s.tkind[ti4] ?? 0) == K_ROAD + 1 {
        sim_drop_item(s, nq4, nr4, mkey4);
        return;
      }
    }
  }
}

pub fn sim_tick(s: &Sim) {
  s.ticks += 1;
  // THE WORLD PUSHES BACK (plan #17 `S5`): each dawn a living source may send. Eligibility,
  // never a schedule — the condition is the source's own state, so a cleared one is done.
  // …and the settlement pushes out (plan #17 `S7`), on the same dawn and the same kind of
  // rule: a raised militia takes one more piece of ground if there is one it can hold.
  if s.depth == 0 && ((s.ticks % DAY_LEN) ?? 0) == 1 {
    send_incursions(s);
    militia_advance(s);
  }
  // THE ECONOMY: each morning the makers bring the night's work to the stalls
  // — towns craft the simple goods, CITIES the complex armour and weapons.
  // (The merchant ship lands the raw goods; the carts move them on.)
  if s.depth == 0 && ((s.ticks % DAY_LEN) ?? 0) == 5 && s.fi_n < FLOOR_MAX - 4 {
    tsize2 = town_size(s);
    (stq3, str3) = town_seat(s);   // the same square an incursion marches at
    day3 = (s.ticks / DAY_LEN) ?? 0;
    if tsize2 >= 3 {
      // THE FORGE rotates its whole repertoire: weapons on even days, armour
      // on odd — the heavy pieces never leave town (the cart's weight cap)
      // ⚠ THE DRAW IS WRITTEN AND UNARMED (plan #17 `S6`): `prod_draw` returns true for an
      // unarmed producer, so the forge makes exactly as it always did, and the day the mine
      // becomes reachable this line starts costing ore without being touched. The reason it
      // is not armed today is measured beside `prod_gated` — the ore face has no path to the
      // miner's home, so arming would stop the forge outright rather than couple it.
      if (day3 % 2 ?? 0) == 0 {
        wkey3 = game_production_key("forge_weapon", ((day3 / 2) ?? 0) % game_production_len("forge_weapon") ?? 0);
        if prod_draw(s, "forge_weapon") { sim_drop_item(s, stq3, str3, wkey3); }
      } else {
        akey3 = game_production_key("forge_armor", ((day3 / 2) ?? 0) % game_production_len("forge_armor") ?? 0);
        if prod_draw(s, "forge_armor") { sim_drop_item(s, stq3, str3, akey3); }
      }
      // the MILL's bread reaches the stalls every morning
      sim_drop_item(s, stq3 - 1, str3 - 1, "ration_of_food");
      // THE ALCHEMIST-FACTORY: drowned in requests, it only actually BREWS on
      // some days of the week — and each brewing day is ONE type of potion;
      // rare weeks see the premium brews
      dow = day3 % 7 ?? 0;
      week3 = (day3 / 7) ?? 0;
      // ⚠ A BREWING DAY IS NO LONGER ENOUGH — it also needs stock (plan #17 S3). ONE DRAW
      // PER POTION, not per day, so a half-supplied alchemist makes a SHORT batch instead of
      // nothing: the stall thins before it empties, which is the readable signal `S4` is
      // supposed to show and costs no interface to say. With the coupling unarmed every draw
      // succeeds and the batch is the full five, exactly as before.
      if dow == 1 || dow == 3 || dow == 5 {
        pk = game_production_key("alchemy", (week3 * 3 + (dow / 2 ?? 0)) % game_production_len("alchemy") ?? 0);
        for _ in 0..5 {
          if prod_draw(s, "alchemy") { sim_drop_item(s, stq3 + 1, str3 + 1, pk); }
        }
      }
      // THE SCRIPTORIUM: scrolls on the quiet days, a realm book each week's end
      if dow == 0 || dow == 2 || dow == 4 {
        skey3 = game_production_key("scriptorium_scroll", (week3 * 3 + (dow / 2 ?? 0)) % game_production_len("scriptorium_scroll") ?? 0);
        sim_drop_item(s, stq3 - 1, str3 + 1, skey3);
      }
      if dow == 6 {
        bkey3 = game_production_key("scriptorium_book", week3 % game_production_len("scriptorium_book") ?? 0);
        sim_drop_item(s, stq3 - 1, str3 + 1, bkey3);
      }
    } else {
      // TOWNS: the simple goods + leatherwork + the FLETCHER's wood-craft
      tkey3 = game_production_key("town_craft", day3 % game_production_len("town_craft") ?? 0);
      sim_drop_item(s, stq3, str3, tkey3);
    }
  }
  // Venom bleeds the player each tick (silent — the HP bar shows it; death is logged). The antivenin
  // ward suppresses it.
  if s.poison_until > s.ticks && s.poison_dmg > 0 && s.venom_until <= s.ticks {
    s.php -= s.poison_dmg;
    if s.php <= 0 { s.php = 0; s.over = true; sim_log(s, "The venom stops your heart."); }
  }
  // Natural HP regeneration (Angband: everyone's wounds slowly knit; RF_REGEN — the half-troll —
  // doubles the pace). POISON blocks it entirely (venom keeps the wounds open).
  if !s.over && s.php < s.phpmax && s.poison_until <= s.ticks {
    every = REGEN_EVERY;
    if (s.rc_flags & RF_REGEN) != 0 { every = every / 2 ?? every; }
    if (s.ticks % every ?? 0) == 0 { s.php += 1; }
  }
  // Mana returns over the clock too (casters only — spmax 0 otherwise).
  if !s.over && s.sp < s.spmax {
    if (s.ticks % SP_REGEN_EVERY ?? 0) == 0 { s.sp += 1; }
  }
  // Temporary stat modifiers (good/bad potions) tick down; expired ones stop applying.
  ttv = s.stat_tmp_t;
  for si in 0..NUM_STATS {
    t = ttv[si] ?? 0;
    if t > 0 { ttv[si] = t - 1; }
  }
  if s.detect_t > 0 { s.detect_t = s.detect_t - 1; }   // monster-detection decays
  (pq, pr) = px_to_hex(s.px, s.py);
  flow = compute_flow(s, pq, pr);   // shared by every chasing monster this tick
  pstealth = sim_skill_stealth(s);  // shrinks each monster's wake range this tick
  enemies = s.enemies;
  for et in 0..len(enemies) {
    e = enemies[et];
    if e.alive {
      // Clock-driven speed: bank this tick's energy, spend ENERGY_STEP per action. So a normal
      // monster (speed 10) acts once per tick (keeps pace with the player); a +5 monster banks
      // 15 -> 1 action this tick, 2 the next (1.5x). Leftover energy carries over.
      gain = e.speed;
      if e.stun_until >= s.ticks { gain = 0; }                 // stunned: reeling, banks nothing
      else if e.slow_until >= s.ticks { gain = e.speed / 2; }  // slowed: half pace
      e.energy = e.energy + gain;
      nsteps = e.energy / ENERGY_STEP;
      e.energy = e.energy - nsteps * ENERGY_STEP;
      for _ in 0..nsteps {
        e.cur_q = e.tgt_q;
        e.cur_r = e.tgt_r;
        d = hex_distance(e.cur_q, e.cur_r, pq, pr);
        // Awareness: a sleeping monster wakes when the player is within its
        // vision and in line of sight; once awake it stays awake.
        evis = e.vision - pstealth;        // stealth shrinks how near the player must be to wake it
        if evis < 1 { evis = 1; }          // but it always notices an adjacent / attacking player
        if !e.awake && d <= evis && hex_los(s, e.cur_q, e.cur_r, pq, pr) {
          e.awake = true;
        }
        if e.role != 0 {
          npc_step(s, e);
          if e.role == 7 { npc_trade(s, e); }
          if e.role == 8 { npc_land_cargo(s, e); }
          if e.role == 9 { npc_gather(s, e); }
          if e.role == 10 { npc_mine(s, e); }
        } else if e.awake {
          if d <= 1 {
            hit = false;
            if e.dam > 0 {     // 0-melee monsters (the floating eye — its threat is the GAZE) truly
                               // deal no melee; without this the capped-dmg floor gives them 1
              s.php -= apply_dr(capped_dmg(e.dam, e.mlvl, s.player.clevel), s.pac);  // ratio cap, then armour DR
              sim_log(s, "The {e.name} hits you.");
              hit = true;
              if s.php <= 0 { s.over = true; sim_log(s, "You die."); }
            }
            // GAZE (floating eye): paralyse unless saved. Re-rolled each tick while adjacent — the
            // authentic horror (escapable but lethal). Only the NEW paralysis is announced (no spam).
            if (e.flags & MF_GAZE) != 0 && !s.over && !sim_player_free_action(s) && sim_save_fails(s) {
              was = s.para_until > s.ticks;
              s.para_until = s.ticks + PARA_DUR;
              if !was { sim_log(s, "The {e.name} fixes you with its gaze — you cannot move!"); }
            }
            // POISON (venomous bite): a landed bite can poison, unless warded (antivenin) or saved.
            if (e.flags & MF_POISON) != 0 && hit && !s.over && s.venom_until <= s.ticks && !sim_player_res_poison(s) && sim_save_fails(s) {
              was = s.poison_until > s.ticks;
              s.poison_until = s.ticks + POISON_DUR;
              s.poison_dmg = POISON_DMG;
              if !was { sim_log(s, "The {e.name}'s bite floods you with venom."); }
            }
            // CORRODE (the acid jelly): the touch eats a piece of gear, until a smith mends it.
            // ⚠ NO SAVE, AND THAT IS DELIBERATE. Gaze and venom are re-rolled every tick you
            // stand there, so a save is what keeps them survivable; this fires ONCE per sound
            // piece and then has nothing left to take, which bounds it without a roll. A save
            // would only make the cause harder to attribute — the player must be able to say
            // *the jelly did this*, or `S6` is wear-per-use in an event's clothes.
            if (e.flags & MF_CORRODE) != 0 && !s.over {
              csl = sim_damage_gear(s);
              if csl >= 0 {
                // The PLAIN name here — sim_equipped_name would now append "(damaged)", and
                // "eats into your mail (damaged)" says the outcome twice and the event once.
                sim_log(s, "The {e.name}'s touch eats into your {sim_item_display_name(s, sim_equipped(s, csl))}.");
              }
            }
            e.tgt_q = e.cur_q;
            e.tgt_r = e.cur_r;
          } else if (e.flags & MF_NEVER_MOVE) != 0 {
            e.tgt_q = e.cur_q;         // stationary (molds, eyes): never steps
            e.tgt_r = e.cur_r;
          } else if e.raid == 1 {
            // ⚠ AN INCURSION DOES NOT BREAK FORMATION FOR A HERO IT HAS MERELY SEEN. It
            // fights what stands in its way (the `d <= 1` arm above still runs), and
            // otherwise keeps marching. Measured 2026-08-10 without this: both raiders woke
            // on the way, converged on a hero standing near the town and parked there for
            // seven days — the picking ground was unsafe for 0 ticks, the raid never
            // arrived, and the whole mechanism silently became "monsters walk at the
            // player", which the game already had. It also made the raid PLAYER-KEYED
            // backwards (`F8`): pressure that only lands while nobody is watching is
            // pressure nobody can observe, learn, or act on.
            raider_step(s, e);
          } else {
            (bq, br) = flow_step(s, flow, e.cur_q, e.cur_r, pq, pr);
            e.tgt_q = bq;
            e.tgt_r = br;
          }
        } else if e.raid == 1 {
          raider_step(s, e);           // asleep, and still marching: the march is its state
        } else {
          e.tgt_q = e.cur_q;           // asleep: holds position
          e.tgt_r = e.cur_r;
        }
      }
      enemies[et] = e;
    }
  }
}

// Wait: advance one world tick in place (enemies act, the player doesn't move).
pub fn sim_wait(s: &Sim) {
  if !s.over { sim_tick(s); }
}

// Advance one frame.  fwd in {-1,0,1}, turn in {-1,0,1}, dt seconds.
// Reclaim the grave's gold by standing on the death spot at its depth (any character —
// owner-less, no PvP). Called each frame from sim_step.
fn sim_reclaim_grave(s: &Sim) {
  if s.grave_gold <= 0 { return; }
  if s.depth != s.grave_depth { return; }
  (pq, pr) = px_to_hex(s.px, s.py);
  if pq == s.grave_q && pr == s.grave_r {
    s.player.gold += s.grave_gold;
    s.grave_gold = 0;
  }
}

// Grant gold (quest / reward income; also used by tests).
pub fn sim_grant_gold(s: &Sim, amt: integer) {
  if amt > 0 { s.player.gold += amt; }
}

// ── SPEED: how far the player walks before the world gets a turn (plan #16 `M4`) ─────────────
// The clock is distance-driven — every span of travel is one `sim_tick`, and the span WAS the
// literal `HEX_LEN`. §0 gives Speed *"the distance clock / initiative / reposition"*, and this
// is that: a faster character covers more ground per world turn, so monsters act fewer times
// over the same walk. It is the mirror of the monster energy model (`e.speed`), on the axis the
// player's clock actually has.
//
// ⚠ ONE OWNER, because a span is read at FIVE sites — two `while` loops, `sim_frac`, and the
// enemy interpolation — and a length-driven quantity rots at whichever site forgets to ask.
// (`M3` shipped exactly that bug in the sidebar; this is the same shape, in the clock.)
//
// ⚠ THE CLAMP IS LOAD-BEARING, NOT COSMETIC. The consumers are `while accrued >= span`; a span
// of zero or below never terminates. Drain is real (a stat floors at 1, i.e. -15 here), so the
// floor is what stands between a poison potion and a hung frame.
// ⚠ Sampled ONCE per `sim_step`, not per loop iteration: a tick inside the loop can drain the
// player's Speed, and re-reading mid-loop would make the span depend on how the frame happened
// to divide. One frame of lag, identical on host and replica — which is what the replay
// contract needs (`gameflow`/`replaytest`).
SPEED_PER_POINT = 0.05;   // ±5% span per point off the baseline — race+class spread is -4..+5
fn tick_span(s: Sim) -> float {
  m = 1.0 + ((stat_eff(s, ST_SPEED) - HERO_CON) as float) * SPEED_PER_POINT;
  if m < 0.5 { m = 0.5; }
  if m > 2.0 { m = 2.0; }
  HEX_LEN * m
}

pub fn sim_step(s: &Sim, fwd: integer, turn: integer, dt: float) {
  if s.over { return; }
  // PARALYSED: the player can't act, but the world must still advance (the gaze horror — and the
  // MP-shaped invariant that sim_tick never depends on THIS player's volition). Advance the clock at
  // wait pace, FASTER when the player struggles (presses move), so an impatient player fast-forwards
  // the same ticks, not the outcome. The player does not move.
  if s.para_until > s.ticks {
    rate = MOVE_SPEED;
    if fwd != 0 || turn != 0 { rate = MOVE_SPEED * (STRUGGLE_X as float); }
    s.accrued += rate * dt;
    span = tick_span(s);
    while s.accrued >= span {
      s.accrued -= span;
      sim_tick(s);
    }
    return;
  }
  if turn != 0 {
    s.heading += (turn as float) * TURN_SPEED * dt;
  }
  if fwd != 0 {
    step = (fwd as float) * MOVE_SPEED * dt;
    dx = cos(s.heading) * step;
    dy = sin(s.heading) * step;
    // SWEPT along the whole path, then slid along whatever stopped it (I-CROSS). The old
    // form probed one point per axis, so the set of walls that stopped you was a function
    // of the frame rate: at a fall-sized step it missed 54% of them.
    (wx2, wy2) = swept_step(s, s.px, s.py, dx, dy);
    moved_x = wx2 - s.px;
    moved_y = wy2 - s.py;
    // Enemies and open water are CELL occupancy, not field geometry, so they stay a veto
    // on the destination rather than something the swept path can express.
    (dq2, dr2) = px_to_hex(wx2, wy2);
    if enemy_blocks(s, dq2, dr2) || water_blocked(s, dq2, dr2) {
      moved_x = 0.0;
      moved_y = 0.0;
    } else {
      s.px = wx2;
      s.py = wy2;
    }
    dist = sqrt(moved_x * moved_x + moved_y * moved_y) ?? 0.0;
    // Pressing forward into an enemy = melee: advance the clock at walking pace
    // even though the player can't move, landing a hit each tick.
    fe = if fwd > 0 { front_enemy(s) } else { -1 };
    sd = abs(step);
    if fe >= 0 && dist < sd { dist = sd; }
    s.accrued += dist;
    span = tick_span(s);
    while s.accrued >= span {
      s.accrued -= span;
      if fe >= 0 {
        ev = s.enemies;
        e = ev[fe];
        // a SHRINE (the spawning crystal): bumping it INTERACTS — never melee. (Ranged
        // fire can still destroy it; that loss is the player's own choice.)
        if (e.flags & MF_SHRINE) != 0 {
          s.shrine_ev = 1;
          if s.anc_kind != 2 { sim_log(s, "The crystal hums - this place will hold you."); }
          sim_anchor_here(s, 2);
        }
        else if e.role != 0 { sim_talk_to(s, fe); }   // walking into a civilian TALKS, never strikes
        else { player_attack(s, fe); }
      }
      sim_tick(s);
    }
  }
  sim_quest_walkons(s);      // notice boards + magical pools read/act on walk-on
  sim_autocollect_gold(s);   // walking over a gold pile picks it up
  sim_reclaim_grave(s);      // standing on your grave reclaims its staked gold
}

// ── plan #17 `S4` — THE SETTLEMENT SAYS SO, IN THE WORLD ──────────────────────────────
//
// I-SAY: **what a worker says about its work is read from the same term that decides
// whether it goes.** No flag, no schedule, no second state — so the line cannot drift from
// the world, and a settlement can never claim a trouble it does not have.
//
// ⚠ THIS ANSWERS `F6`, WHICH `CRAFTING.md` CALLS THE REAL RISK: a loop that cannot be seen
// in one session is a simulation nobody plays. Three of the four signals the design named
// already ship — thinner stalls and a skipped rotation (`S3` draws once per potion, so a
// half-supplied workshop makes a short batch), and an unwalked route (`S2`'s site veto keeps
// the worker at home). **This is the fourth, and it is the only one a player can read
// WITHOUT A BASELINE**: a stall holding four potions instead of five says nothing at all to
// someone who has never seen five, and an idle worker is indistinguishable from a worker who
// is simply idle.
//
// ⚠ A PERSON SPEAKING IS NOT A MARKER. `SCRIPTING.md`'s *no markers* rule forbids the UI
// pointing at things; the design's own list of four signals ends with "the innkeeper says
// the roads are bad". It also costs **zero new keys** — bumping a civilian already talks
// (DESIGN §3a pillar #7, lean inputs).
//
// ⚠ AND IT NAMES THE CAUSE, WHICH IS WHAT MAKES IT ACTIONABLE. "Something is wrong" is a
// mood; "an ogre at the mine, west of here" is somewhere to go. Both the creature and the
// bearing are DERIVED from the world at the moment of asking, never authored — so the line
// is produced, not stored, and it stays true as the world moves.

// The compass word from (fq,fr) toward (tq,tr). `+q` is east and `+r` is south, and a row
// step is 0.866 of a column step (moros pointy-top), so the vertical delta is scaled before
// the two are compared — otherwise everything north of you reads as north-east.
fn bearing_word(fq: integer, fr: integer, tq: integer, tr: integer) -> text {
  dq = tq - fq;
  dr = tr - fr;
  adq = dq;
  if adq < 0 { adq = -adq; }
  adr = ((dr * 866) / 1000) ?? 0;          // to column units, integer
  if adr < 0 { adr = -adr; }
  if adq == 0 && adr == 0 { return "here"; }
  ns = "";
  if dr < 0 { ns = "north"; }
  if dr > 0 { ns = "south"; }
  ew = "";
  if dq > 0 { ew = "east"; }
  if dq < 0 { ew = "west"; }
  if adq > adr * 2 { return ew; }          // flat enough to be plain east/west
  if adr > adq * 2 { return ns; }          // steep enough to be plain north/south
  if ns == "" { return ew; }
  if ew == "" { return ns; }
  "{ns}-{ew}"
}

// The living hostile nearest (q,r) within `THREAT_R` — the one `hex_safe` is objecting to.
// Empty only in principle: the sole way `hex_safe` answers false is that one of these is
// standing there, so a worker who refuses always has something to point at.
fn threat_name_near(s: Sim, q: integer, r: integer) -> text {
  es = s.enemies;
  bn = "";
  bd = 9999;
  for i in 0..len(es) {
    e = es[i];
    if e != null && e.alive && e.role == 0 {
      d = hex_distance(e.cur_q, e.cur_r, q, r);
      if d <= THREAT_R && d < bd { bd = d; bn = e.name; }
    }
  }
  bn
}

// "A" or "An" for a creature name. Monster keys are lowercase, so the first letter decides.
fn article_for(t: text) -> text {
  if starts_with(t, "a") || starts_with(t, "e") || starts_with(t, "i")
     || starts_with(t, "o") || starts_with(t, "u") { return "An"; }
  "A"
}

// What this trade calls its workplace, and what the town loses while nobody is at it.
// ⚠ THE WORDS ARE THE ONLY AUTHORED PART OF THIS, and they are the part that belongs
// bundle-side the day a dialogue seam exists (BUNDLE.md's standing check — mechanism
// engine-side, content content-side). The mechanism above reads the world; this reads a
// role. Kept in one function so the move is one function.
fn work_words(role: integer) -> (text, text) {
  if role == 9 { return ("the picking ground", "The stills will run dry."); }
  if role == 10 { return ("the ore face", "No ore comes down today."); }
  if role == 2 { return ("the field", "The stalls will be thin."); }
  if role == 4 { return ("the water", "No catch today."); }
  if role == 1 { return ("the square", "Nobody's trading today."); }
  if role == 8 { return ("the sea lane", "No cargo lands today."); }
  // ⚠ No arm for role 7 (the merchant cart) ON PURPOSE: its own quest arm in `sim_talk_to`
  // returns before this one is reached, so an entry here would be a line nobody can hear.
  // Quest speech pre-empting ambient speech is the right order — a quest line is one-shot
  // and this one repeats — but it does mean the cart never reports a bad road.
  ("my work", "It'll keep.")
}

// THE SMITH MENDS ONE PIECE, AND ONLY IF THE ORE CAME DOWN (plan #17 `S6`).
//
// ⚠ BUMP-TO-ASK, so the repair costs ZERO keys — the same seam that already carries the
// bounty and the Circle's favour (`DESIGN.md` §3a #7). No repair menu, no parts, no material
// cost to the player: `CRAFTING.md` refuses all three, because the moment it needs an
// inventory of parts it is crafting, and the hero does not craft.
//
// ⚠ ONE PIECE PER ASK is what keeps a bad valley legible. A smith who mended everything in
// one bump would turn an empty store into a single "no" the player hears once; mending one at
// a time means a half-supplied forge fixes the sword and not the mail — the same readable
// thinning `S4` shows at the stalls.
//
// Split out of `sim_talk_to` rather than written inline: it is DIALOGUE over one decision
// (`sim_smith_mend`), and inline it pushed that function past the complexity nudge.
fn smith_talk(s: &Sim) {
  d9 = sim_next_damaged(s);          // read the NAME first — after the mend it is gone
  r9 = sim_smith_mend(s);
  if r9 == 0 {
    sim_log(s, "The smith turns your gear over and hands it back. 'Sound enough.'");
  } else if r9 > 0 {
    sim_log(s, "The smith works your {sim_item_display_name(s, d9)} back to true.");
  } else {
    sim_log(s, "The smith spreads their hands: 'Nothing's come down from the ore");
    sim_log(s, "face. Bring me iron, or make the road safe for them that carry it.'");
  }
}

// THE GUARD MASTER ON THE MILITIA (plan #17 `S7`) — the petition, and the report afterwards.
// Answers whether it had anything to say; a stranger with no militia has not, and the older
// poster lines carry the bump instead.
//
// ⚠ THE STANDING CATEGORY IS SAID, NEVER SHOWN (I-SAY, `S4`). There is no reputation bar
// anywhere: what the player learns about where they stand, they learn from a man saying it,
// read off the same number that gates the militia — so the line cannot drift from the world.
//
// Split out of `sim_talk_to` for the reason `smith_talk` was: it is DIALOGUE over one decision
// (`sim_militia_petition`), and inline it pushes that function past the complexity nudge.
fn guard_master_militia(s: &Sim) -> boolean {
  if sim_militia(s) < 0 && sim_standing(s) < STAND_KNOWN { return false; }
  // ⚠ THE MAN SPEAKS BEFORE THE TOWN MOVES. The petition logs the picket marching out, so
  // asking first and answering afterwards printed the consequence above its cause — the
  // player read that the watch had marched before anyone had agreed to send it.
  if sim_militia(s) < 0 && sim_standing(s) >= STAND_TRUST {
    sim_log(s, "The guard master spits. 'Right. I can spare a few - yours as long");
    sim_log(s, "as they hold ground.'");
    sim_militia_petition(s);
    return true;
  }
  r = sim_militia_petition(s);
  if r == 1 {
    sim_log(s, "The guard master looks you over. 'You've done this town a service");
    sim_log(s, "or two. Do a little more and I'd put men under you.'");
    return true;
  }
  if r == 3 {
    sim_log(s, "'The line's still pushing out,' says the guard master. 'Give it days.'");
    return true;
  }
  if r == 4 {
    (bq, br) = militia_site(s, true);
    (sq, sr) = town_seat(s);
    what = src_name_near(s, bq, br);
    if what != "" {
      sim_log(s, "'The line's stopped,' says the guard master. '{article_for(what)} {what},");
      sim_log(s, "{bearing_word(sq, sr, bq, br)} of here. Break that and we'll push on.'");
      return true;
    }
  }
  if r == 5 {
    sim_log(s, "'The watch stands on every road we work,' says the guard master.");
    sim_log(s, "'Find us more roads.'");
    return true;
  }
  false
}

// TALK: bumping a civilian speaks. The town carries its quest lines here —
// merchants point at the Circle, the Circle's mages ask their favour (and pay
// for it), the rest of the town nods. Bump-triggered, so it never spams.
pub fn sim_talk_to(s: &Sim, idx: integer) {
  ev = s.enemies;
  if idx < 0 || idx >= len(ev) { return; }
  e = ev[idx];
  if e.role == 7 {
    if s.q_mage == 0 {
      s.q_mage = 1;
      sim_log(s, "The merchant leans down: 'The old one of the Circle - the round");
      sim_log(s, "tower north-west, up in the crags - pays for a sword-arm.");
      sim_log(s, "Something in the sands has him spooked.'");
    } else {
      sim_log(s, "'Fine wares, fair prices,' calls the merchant.");
    }
    return;
  }
  if e.key == "guard_master" {
    if s.q_poster == 2 {
      s.q_poster = 3;
      sim_grant_gold(s, 150);
      sim_log(s, "The guard master grips your wrist and counts the bounty into");
      sim_log(s, "your palm: 150 gold. 'The roads breathe easier.'");
      return;
    }
    // THE PETITION (plan #17 `S7`). ⚠ AFTER the bounty, which is owed, and BEFORE the poster
    // lines, which repeat — a one-shot payment must never be pre-empted by ambient speech, and
    // ambient speech should say the newest true thing about the town.
    if guard_master_militia(s) { return; }
    if s.q_poster == 1 {
      sim_log(s, "'Bring me that brute's head and the gold is yours,' says the");
      sim_log(s, "guard master.");
    } else if s.q_poster == 3 {
      sim_log(s, "'The roads thank you,' the guard master nods.");
    } else {
      sim_log(s, "'Work? Read the watch's board,' says the guard master.");
    }
    return;
  }
  if e.key == "smith" { smith_talk(s); return; }   // the repair (plan #17 `S6`) — see smith_talk
  if e.key == "wizard" {
    if s.boss_slain == 1 && s.q_mage < 3 {
      s.q_mage = 3;
      sim_grant_gold(s, 250);
      sim_give_item(s, "circle_writ");
      sim_give_item(s, "circle_phial");
      sim_log(s, "The wizard's eyes glitter. 'Done? Then the Circle is in your");
      sim_log(s, "debt - 250 gold, as promised. And now it can be told: read the");
      sim_log(s, "writ. The POOL she nested on is what we wanted all along.'");
    } else if s.q_mage >= 3 {
      bslot = sim_find_item(s, "phial_brimming");
      if bslot >= 0 {
        itbl2 = game_items();
        eidx = item_index(itbl2, "circle_phial");
        iv2 = s.inv;
        if eidx >= 0 && bslot < len(iv2) {
          iv2[bslot] = eidx;
          idg7 = s.inv_dmg;
          if bslot < len(idg7) { idg7[bslot] = 0; }   // a slot re-used for another item starts sound
          sim_grant_gold(s, 60);
          sim_log(s, "The wizard decants your phial with shaking care: 60 gold,");
          sim_log(s, "and the empty glass back in your hand. 'Again, when you can.'");
        }
      } else {
        sim_log(s, "'The stills run low,' the wizard mutters. 'Pool-water, by");
        sim_log(s, "the phial - the Circle pays.'");
      }
    } else if s.q_mage < 2 {
      s.q_mage = 2;
      sim_log(s, "The wizard grips your arm: 'Kill the dweller in the sands far");
      sim_log(s, "to the east - below the desert gate, on the third deep.");
      sim_log(s, "Do not ask why. The Circle pays well.'");
    } else {
      sim_log(s, "'The sands, sword-arm. The Circle waits.'");
    }
    return;
  }
  // ⚠ A WORKER WHO IS NOT AT WORK SAYS WHY, AND IT IS THE SAME TERM THAT KEPT THEM HOME
  // (I-SAY, plan #17 `S4`). Read at the moment of asking, so it is true when said and gone
  // when the ground is. Guards and wild things are exempt here exactly as in `npc_target` —
  // walking toward trouble is the job, and the wild keeps its own counsel.
  if e.role != 0 && e.role != 3 && e.role != 12 && !hex_safe(s, e.wq2, e.wr2) {
    (place, cost) = work_words(e.role);
    what = threat_name_near(s, e.wq2, e.wr2);
    where = bearing_word(e.cur_q, e.cur_r, e.wq2, e.wr2);
    if what != "" {
      sim_log(s, "The {e.name} shakes their head: '{article_for(what)} {what} on {place},");
      sim_log(s, "{where} of here. I'll not go while it stands.' {cost}");
      return;
    }
  }
  if e.role != 0 { sim_log(s, "The {e.name} nods at you."); }
}

// Walk-on quest features: a NOTICE BOARD (tile 8) reads its poster / pays its
// bounty; a MAGICAL POOL (tile 9) fills a carried Circle phial. State-change
// gated, so standing still never spams the log.
fn sim_quest_walkons(s: &Sim) {
  (pq, pr) = px_to_hex(s.px, s.py);
  t = tile_at(s, pq, pr);
  if t == 8 {
    if s.q_poster == 0 {
      s.q_poster = 1;
      sim_log(s, "WANTED: the marauder chief that haunts the old ruins, north-west");
      sim_log(s, "beyond the fields. 150 gold for its head - claim with the");
      sim_log(s, "guard master.");
    }
  }
  if t == 9 {
    slot = sim_find_item(s, "circle_phial");
    if slot >= 0 {
      itbl = game_items();
      bidx = item_index(itbl, "phial_brimming");
      iv = s.inv;
      if bidx >= 0 && slot < len(iv) {
        iv[slot] = bidx;
        idg8 = s.inv_dmg;
        if slot < len(idg8) { idg8[slot] = 0; }   // a slot re-used for another item starts sound
        sim_log(s, "You stoop and fill the phial; the water hums against the glass.");
      }
    }
  }
}

// ── Read-only accessors for the view / tests ────────────────────────

// Progress towards the next tick, in [0, 1] — the view's sub-tick interpolation. ⚠ Divides by
// `tick_span`, not `HEX_LEN`: with Speed keyed into the clock those differ, and a stale
// denominator here would desync every enemy's drawn position from the tick it is walking to.
// Clamped because the span can SHRINK under the accrued distance when a Speed buff expires
// mid-stride; the `while` loop settles that on the next step, and the view must not see >1 meanwhile.
pub fn sim_frac(s: Sim) -> float {
  f = s.accrued / tick_span(s) ?? 0.0;
  if f < 0.0 { f = 0.0; }
  if f > 1.0 { f = 1.0; }
  f
}

pub fn sim_player_hex(s: Sim) -> (integer, integer) { px_to_hex(s.px, s.py) }

pub fn sim_enemy_count(s: Sim) -> integer { len(s.enemies) }

// ---- Dungeon persistence: deterministic base + a stored DEATH delta --------------------------
// A level is a pure function of its seed (world_key_seed -> gen), so the layout + surviving
// monsters (at their natural spawns) come free on re-entry. The ONLY thing persisted is what
// diverged: which spawns died. sim_dead_indices extracts that delta; sim_apply_dead replays it
// onto a freshly regenerated level. Round-trip = identity. (Location/HP/effects/taken-items/
// tombstones can join the delta later for deeper persistence — death-only is the cheap default.)
pub fn sim_dead_indices(s: Sim) -> vector<integer> {
  enemies = s.enemies;
  out: vector<integer> = [];
  for i in 0..len(enemies) {
    e = enemies[i];
    if !e.alive { out += [i]; }
  }
  out
}

pub fn sim_apply_dead(s: &Sim, dead: vector<integer>) {
  enemies = s.enemies;
  for k in 0..len(dead) {
    i = dead[k] ?? -1;
    if i >= 0 && i < len(enemies) {
      e = enemies[i];
      e.alive = false;
      enemies[i] = e;
    }
  }
}

// Store a level's death delta into its per-depth block (OVERWRITE — no growth, bounded).
pub fn sim_store_dead(s: &Sim, depth: integer, dead: vector<integer>) {
  if depth < 0 || depth >= DEPTH_MAX { return; }
  di = s.dd_idx;
  dn = s.dd_n;
  base = depth * MAX_SPAWNS;
  cnt = 0;
  for k in 0..len(dead) {
    i = dead[k] ?? -1;
    if i >= 0 && cnt < MAX_SPAWNS && (base + cnt) < len(di) {
      di[base + cnt] = i;
      cnt = cnt + 1;
    }
  }
  if depth >= 0 && depth < len(dn) { dn[depth] = cnt; }
}

// Replay a level's stored death delta onto its freshly regenerated spawns (on re-entry).
pub fn sim_apply_stored_dead(s: &Sim, depth: integer) {
  if depth < 0 || depth >= DEPTH_MAX { return; }
  dn = s.dd_n;
  c = dn[depth] ?? 0;
  di = s.dd_idx;
  enemies = s.enemies;
  base = depth * MAX_SPAWNS;
  for k in 0..c {
    if (base + k) < len(di) {
      i = di[base + k] ?? -1;
      if i >= 0 && i < len(enemies) {
        e = enemies[i];
        e.alive = false;
        enemies[i] = e;
      }
    }
  }
}

pub fn sim_enemy_alive(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  alive = false;
  if i < len(enemies) {
    e = enemies[i];
    alive = e.alive;
  }
  alive
}

pub fn sim_enemy_cur(s: Sim, i: integer) -> (integer, integer) {
  enemies = s.enemies;
  rq = 0;
  rr = 0;
  if i < len(enemies) {
    e = enemies[i];
    rq = e.cur_q;
    rr = e.cur_r;
  }
  (rq, rr)
}

// The enemy's HEX, beside the float position the view draws with — a gate reasons in hexes.
pub fn sim_enemy_hex(s: Sim, i: integer) -> (integer, integer) {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return (e.cur_q, e.cur_r); }
  }
  (0, 0)
}

// 0 = hostile, and everything else is a civilian trade (3 = guard, 9 = gatherer, …).
// Exposed for the same reason as the hex above: safety is a rule ABOUT roles, so a gate
// that cannot read one cannot check it.
pub fn sim_enemy_role(s: Sim, i: integer) -> integer {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return e.role; }
  }
  -1
}

// Where this civilian WORKS — the field, the fishing spot, the picking ground, patrol leg A.
// ⚠ This is the hex `I-SAFE` actually turns on. A settlement's unsafe FRACTION says nothing
// on its own: unsafe empty hillside costs it nothing, and one unsafe field costs it a crop.
// Exposed so that overlap can be gated rather than estimated from area.
pub fn sim_enemy_work(s: Sim, i: integer) -> (integer, integer) {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return (e.wq2, e.wr2); }
  }
  (0, 0)
}

// The OTHER patrol leg / the food stall — the second end of a two-leg route. Read-only, and
// it exists because a guard's cover is a property of its WHOLE walk (plan #17 `S7`,
// `hex_held`): a gate given only `sim_enemy_work` can see where a picket goes and not whether
// it ever leaves the ground it was posted to hold.
pub fn sim_enemy_alt(s: Sim, i: integer) -> (integer, integer) {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return (e.aq2, e.ar2); }
  }
  (0, 0)
}

// Home / night anchor — the other end of every daily route.
pub fn sim_enemy_home(s: Sim, i: integer) -> (integer, integer) {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return (e.hq, e.hr); }
  }
  (0, 0)
}

// Surface terrain kind at (q,r) — the STORED form (kind + 1, 0 = dungeon/none), as the level
// arrays hold it. Read-only; the siting scans read the same array directly because they run
// before a `Sim` exists, and a gate that wants to ask "is there rock beside this hex" needs
// the answer through the Sim.
pub fn sim_terrain_at(s: Sim, q: integer, r: integer) -> integer {
  if q < 0 || r < 0 || q >= s.lw || r >= s.lh { return 0; }
  ti = r * s.lw + q;
  if ti < len(s.tkind) { return s.tkind[ti] ?? 0; }
  0
}

// THE WINDOW FRAME — where a level's hex lattice sits in the wilderness. ONE OWNER, because
// two answers to "which world point is hex (q,r)" is a near field standing somewhere the far
// field is not, and that seam is exactly what I-HORIZON is about (plan #11 P6).
//
// Returns the anchor (ax, ay) — the window's centre in natural metres — and (cwx, cwy), the
// lattice offset of the centre hex, so a caller converts either way:
//
//     hex (q,r)  ->  world:  ax + hx - cwx        where (hx,hy) = ov_hex_world(q, r)
//     world      ->  hex:    (x - ax + cwx) / step
//
// Both directions are used in this file; before P6 the forward one was written out inline in
// the generator, which is why nothing outside it could ask where the window stands.
fn window_anchor(ovw: Overland, wwx: integer, wwy: integer, w: integer, h: integer)
    -> (float, float, float, float) {
  ax = 7500.0;
  ay = 5800.0;
  t0 = ovw.ov_towns[ov_home_town(ovw)];
  if t0 != null { ax = t0.ot_x; ay = t0.ot_y; }
  // MULTI-WINDOW: (wwx, wwy) picks WHICH 1.5 km window of the wilderness this Sim is.
  // (0,0) anchors at the home town; neighbours overlap by a few hexes so walking off an
  // edge crosses into continuous terrain.
  (spanx, _) = ov_hex_world(w - 4, 0);
  (_, spany) = ov_hex_world(0, h - 4);
  ax = ax + (wwx as float) * spanx;
  ay = ay + (wwy as float) * spany;
  (cwx, cwy) = ov_hex_world(w / 2, h / 2);
  (ax, ay, cwx, cwy)
}

// GROUND HEIGHT at (q,r) in world units above sea level — the near reading of I-HORIZON
// (plan #11 P6). A dungeon level, and anything off the window, is flat at 0.
//
// ⚠ Height is a RENDERING property at this phase and nothing else: passability is still the
// edge field, so a slope neither blocks nor slows. Whether a gradient should cost the walker
// anything is a gameplay question with its own keys, and inventing one here would be exactly
// the bounded-simulation trap (DESIGN §3a pillar 0).
pub fn sim_ground_z(s: Sim, q: integer, r: integer) -> float {
  if q < 0 || r < 0 || q >= s.lw || r >= s.lh { return 0.0; }
  ti = r * s.lw + q;
  if ti < len(s.theight) { return s.theight[ti] ?? 0.0; }
  0.0
}

// Does this level HAVE a height reading at (q,r)? The averaging that makes the drawn surface
// continuous has to tell "flat here" from "no sample here" — off the window edge it must skip
// the neighbour rather than average a zero in, which would pull every border hex to sea level.
pub fn sim_has_ground(s: Sim, q: integer, r: integer) -> boolean {
  if q < 0 || r < 0 || q >= s.lw || r >= s.lh { return false; }
  r * s.lw + q < len(s.theight)
}

// THE FRAME, EXPOSED — so the far field and any gate can ask where a near hex stands in the
// wilderness instead of rebuilding the anchoring. Costs one `overland_new`, so a caller takes
// it ONCE and maps with `window_hex_world` below.
pub fn sim_window_frame(s: Sim) -> (float, float, float, float) {
  ovw = overland_new();
  window_anchor(ovw, s.win_x, s.win_y, s.lw, s.lh)
}

// Hex (q,r) of that window, in natural metres. THE mapping — the generator samples the
// terrain through this function and so does everyone else.
//
// ⚠ It exists as a function for a reason that looks like pedantry and is not: written out at
// the call site as `ax + hx - cwx`, an equally correct caller writing `(ax - cwx) + hx` gets
// a DIFFERENT number — float addition does not associate — and the near and far readings then
// disagree by ~1e-13 wu everywhere. Measured, before this was one expression. That residue is
// harmless in metres and fatal to the gate, because a bound of "close enough" cannot then
// tell a rounding difference from a real frame error. One expression, and the diff is 0.
pub fn window_hex_world(ax: float, ay: float, cwx: float, cwy: float,
                        q: integer, r: integer) -> (float, float) {
  (hx, hy) = hex_to_px(q, r);
  window_pt_world(ax, ay, cwx, cwy, hx, hy)
}

// The same mapping for a CONTINUOUS point, in world units rather than a hex index — what the
// far field needs, since its vertices are not on the lattice. `ov_hex_world` is exactly
// `hex_to_px` scaled by this same factor, so the two agree bit-for-bit and the seam between
// the near window and the terrain beyond it cannot drift.
pub fn window_pt_world(ax: float, ay: float, cwx: float, cwy: float,
                       x: float, y: float) -> (float, float) {
  ms = OV_STEP / HEX_LEN ?? 0.0;
  (ax + x * ms - cwx, ay + y * ms - cwy)
}

// The SECOND end of a two-ended route — the stall a farmer carries to, the furnace a miner
// delivers ore to, patrol leg B. Roles with one destination repeat their work hex here.
// ⚠ A route is only walkable if BOTH ends are, and the delivery end is the one a supply
// chain actually turns on: a miner that can reach its ore face and not its furnace raises
// no stock at all (`I-WALK`).
pub fn sim_enemy_anchor(s: Sim, i: integer) -> (integer, integer) {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return (e.aq2, e.ar2); }
  }
  (0, 0)
}

// The gatherer's bag (plan #17 `S3`): 1 = carrying a pick home, 0 = empty. Read-only, and
// exposed so a gate can watch the round trip rather than infer it from the stock.
pub fn sim_enemy_carry(s: Sim, i: integer) -> integer {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return e.carry; }
  }
  0
}

// Is this hostile an incursion (plan #17 `S5`)? Read-only.
pub fn sim_enemy_raid(s: Sim, i: integer) -> integer {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return e.raid; }
  }
  0
}

// Kill an enemy outright — the gate's stand-in for the hero clearing a source, so
// "a cleared source stays cleared" can be asserted without staging a fight.
//
// ⚠ IT GOES THROUGH THE SAME CHOKEPOINT the three real kill paths do, so a gate that clears a
// den earns the standing a player would have earned for it (plan #17 `S7`). A stand-in that
// took a shortcut past the accounting would let the gate assert a world the game cannot reach.
pub fn sim_slay(s: &Sim, i: integer) {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null {
      e.alive = false;
      on_hostile_slain(s, e.role, e.tags, e.raid);
    }
  }
}

// Is this actor a militia picket (plan #17 `S7`)? Read-only.
pub fn sim_enemy_picket(s: Sim, i: integer) -> integer {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { return e.picket; }
  }
  0
}

// Run one dawn's sends now, without waiting a day for it. Test-facing, like `sim_slay`
// above — and it is honest here for a reason worth stating: the eligibility rule has NO
// time term at all (leader alive, fewer than `RAID_CAP` out), so ten calls in a row are a
// faithful stand-in for ten dawns. If calling it repeatedly ever stopped matching the
// clock, that would mean a timer had crept into the mechanism, which is the thing `S5`
// exists to avoid. ⚠ It does not replace gating the CLOCK: `incursiontest` still ticks the
// world once and requires a raider to appear, or nothing would prove the dawn is wired.
// ⚠ THE WHOLE DAWN, both directions — the sources send and the militia advances. A hook that
// ran only the world's half would let a gate prove pressure arrives while never once seeing
// the settlement answer it.
pub fn sim_dawn(s: &Sim) {
  send_incursions(s);
  militia_advance(s);
}

// Set the bag, so a gate can put a gatherer on its return leg without simulating the days
// it takes to walk there. Test-facing, like `sim_set_awake` beside it.
pub fn sim_set_carry(s: &Sim, i: integer, v: integer) {
  es = s.enemies;
  if i < len(es) {
    e = es[i];
    if e != null { e.carry = v; }
  }
}

// Smoothly-interpolated enemy world position (cur -> tgt by clock fraction).
pub fn sim_enemy_pos(s: Sim, i: integer) -> (float, float) {
  enemies = s.enemies;
  ex = 0.0;
  ey = 0.0;
  if i < len(enemies) {
    e = enemies[i];
    (acx, acy) = hex_to_px(e.cur_q, e.cur_r);
    (atx, aty) = hex_to_px(e.tgt_q, e.tgt_r);
    f = sim_frac(s);   // the SAME span the clock uses (tick_span), clamped — never HEX_LEN
    ex = acx + (atx - acx) * f;
    ey = acy + (aty - acy) * f;
  }
  (ex, ey)
}

// Set monster i's per-tick energy gain (ENERGY_STEP = normal pace; higher = faster, lower =
// slower). The hook for the speed potion (slow others), a haste/slow-monster effect, and tests.
pub fn sim_set_speed(s: &Sim, i: integer, gain: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.speed = gain;
  enemies[i] = e;
}

// Afflict monster i with a status (ST_SLOW/ST_STUN) for `turns` ticks. The stop tick is
// PRE-CALCULATED (until = ticks + turns) and stored; the status then auto-expires when the
// clock passes it — no per-tick countdown. The hook for spells / thrown potions / the speed potion.
pub fn sim_afflict_enemy(s: &Sim, i: integer, kind: integer, turns: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  until = s.ticks + turns;
  if kind == ST_SLOW { e.slow_until = until; }
  if kind == ST_STUN { e.stun_until = until; }
  enemies[i] = e;
}

// Is monster i currently under status `kind`? (the clock has not yet passed the stored expiry)
pub fn sim_enemy_afflicted(s: Sim, i: integer, kind: integer) -> boolean {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return false; }
  e = enemies[i];
  if kind == ST_SLOW { return e.slow_until >= s.ticks; }
  if kind == ST_STUN { return e.stun_until >= s.ticks; }
  false
}

// Wake or lull monster i (scripted ambush / sleep; tests).
pub fn sim_set_awake(s: &Sim, i: integer, awake: boolean) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.awake = awake;
  enemies[i] = e;
}

// Hex distance from the player to monster i (AI / perception / tests). -1 if no such monster.
pub fn sim_enemy_dist(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return -1; }
  e = enemies[i];
  (pq, pr) = px_to_hex(s.px, s.py);
  hex_distance(pq, pr, e.cur_q, e.cur_r)
}

pub fn sim_player_hp(s: Sim) -> integer { s.php }
pub fn sim_player_hp_max(s: Sim) -> integer { s.phpmax }
pub fn sim_over(s: Sim) -> boolean { s.over }

pub fn sim_clevel(s: Sim) -> integer { s.player.clevel }
pub fn sim_xp(s: Sim) -> integer { s.player.xp }
pub fn sim_gold(s: Sim) -> integer { s.player.gold }

// Fraction from the current level toward the next (0..1) — for the XP bar.
pub fn sim_xp_frac(s: Sim) -> float {
  lo = xp_need(s, s.player.clevel);       // the XP bar tracks the race-scaled curve (expfact)
  hi = xp_need(s, s.player.clevel + 1);
  f = 0.0;
  if hi > lo {
    f = (s.player.xp - lo) as float / (hi - lo) as float ?? 0.0;
  }
  if f < 0.0 { f = 0.0; }
  if f > 1.0 { f = 1.0; }
  f
}

pub fn sim_inv_count(s: Sim) -> integer { s.ninv }

// ── Equipment queries (HUD + tests) ──────────────────────────────────
pub fn sim_player_dam(s: Sim) -> integer { s.wdam }   // melee damage (base + weapon)
pub fn sim_player_ac(s: Sim) -> integer { s.pac }     // armour class (HP + damage-reduction)
// Item def index equipped in `slot`, or -1 if empty.
pub fn sim_equipped(s: Sim, slot: integer) -> integer {
  eq = s.eq;
  e = eq[slot] ?? 0;
  if e > 0 { return e - 1; }
  -1
}

// Display name of the item worn in `slot`, or "" if empty (the inventory hub's equipped column).
pub fn sim_equipped_name(s: Sim, slot: integer) -> text {
  d = sim_equipped(s, slot);
  if d < 0 { return ""; }
  "{sim_item_display_name(s, d)}{dmg_suffix(sim_eq_damaged(s, slot))}"
}

// ── Damaged gear: is this one, and how it reads (plan #17 `S6`) ─────────────────────────
//
// ⚠ THE SUFFIX IS THE WHOLE INTERFACE. `F2`'s budget is spent by any screen that shows a
// number, so a damaged item says so in the name it already prints and costs nothing: no
// condition bar, no repair menu, no key. The player learns the state from the blow that
// caused it and reads it back off the list they already open.
fn dmg_suffix(damaged: boolean) -> text {
  if damaged { return " (damaged)"; }
  ""
}
pub fn sim_eq_damaged(s: Sim, slot: integer) -> boolean {
  ed = s.eq_dmg;
  if slot < 0 || slot >= len(ed) { return false; }
  (ed[slot] ?? 0) != 0
}
pub fn sim_inv_damaged(s: Sim, slot: integer) -> boolean {
  idg = s.inv_dmg;
  if slot < 0 || slot >= s.ninv || slot >= len(idg) { return false; }
  (idg[slot] ?? 0) != 0
}
// How many pieces the player owns that a smith would work on — the gate's one-number read,
// and what the smith counts when asked.
pub fn sim_damaged_count(s: Sim) -> integer {
  n = 0;
  for sl in 0..NUM_SLOTS { if sim_eq_damaged(s, sl) { n += 1; } }
  for i in 0..s.ninv { if sim_inv_damaged(s, i) { n += 1; } }
  n
}
// Damage `raw` would deal after the player's armour DR (never below 1).
pub fn sim_mitigate(s: Sim, raw: integer) -> integer { apply_dr(raw, s.pac) }
pub fn sim_floor_count(s: Sim) -> integer { s.fi_n }

pub fn sim_floor_live(s: Sim, i: integer) -> boolean {
  fl = s.fi_live;
  v = false;
  if i < len(fl) { v = (fl[i] ?? 0) == 1; }
  v
}

// World position of floor item i.
pub fn sim_floor_pos(s: Sim, i: integer) -> (float, float) {
  fq = s.fi_q;
  fr = s.fi_r;
  x = 0.0;
  y = 0.0;
  if i < len(fq) && i < len(fr) {
    q = fq[i] ?? 0;
    r = fr[i] ?? 0;
    (x, y) = hex_to_px(q, r);
  }
  (x, y)
}

pub fn sim_floor_is_gold(s: Sim, i: integer) -> boolean {
  fg = s.fi_gold;
  v = false;
  if i < len(fg) { v = (fg[i] ?? 0) > 0; }
  v
}

pub fn sim_floor_cat(s: Sim, i: integer) -> integer {
  fc = s.fi_cat;
  c = 0;
  if i < len(fc) { c = fc[i] ?? 0; }
  c
}

pub fn sim_enemy_hp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 0;
  if i < len(enemies) { e = enemies[i]; v = e.hp; }
  v
}

pub fn sim_enemy_maxhp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 1;
  if i < len(enemies) { e = enemies[i]; v = e.maxhp; }
  v
}

// Enemy display colour (0..255), from its monster-DB definition.
pub fn sim_enemy_color(s: Sim, i: integer) -> (integer, integer, integer) {
  enemies = s.enemies;
  ecr = 200;
  ecg = 60;
  ecb = 50;
  if i < len(enemies) { e = enemies[i]; ecr = e.cr; ecg = e.cg; ecb = e.cb; }
  (ecr, ecg, ecb)
}

// Is enemy i awake (has it perceived the player)?
pub fn sim_enemy_awake(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  a = false;
  if i < len(enemies) { e = enemies[i]; a = e.awake; }
  a
}

// Monster i's NATIVE dungeon depth (m_depth) — for the slice depth-pool guard + the bestiary UI.
pub fn sim_enemy_mlvl(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 0;
  if i < len(enemies) { e = enemies[i]; v = e.mlvl; }
  v
}

// Enemy single-char map glyph (e.g. "r", "k", "o").
pub fn sim_enemy_glyph(s: Sim, i: integer) -> text {
  enemies = s.enemies;
  g = "r";
  if i < len(enemies) { e = enemies[i]; g = e.glyph ?? "r"; }
  g
}

// Enemy display name (for the message log).
// Monster-def key of enemy `i` ("" out of range) — the view maps it to assets/sprites/<key>.png
// (and <key>_gaze.png for an ACTION variant), falling back to the glyph when no sprite exists.
pub fn sim_enemy_key(s: Sim, i: integer) -> text {
  enemies = s.enemies;
  k = "";
  if i >= 0 && i < len(enemies) { e = enemies[i]; k = e.key; }
  k
}

pub fn sim_enemy_name(s: Sim, i: integer) -> text {
  enemies = s.enemies;
  n = "";
  if i >= 0 && i < len(enemies) { e = enemies[i]; n = e.name ?? ""; }
  n
}

// World-space angle the enemy faces: its current move (cur→tgt), or — when it
// isn't moving — toward the player. Feeds the rotating sprite (the view snaps it
// to the 12-direction model). Hex-locked, so a moving facing is one of 6 dirs.
pub fn sim_enemy_facing(s: Sim, i: integer) -> float {
  enemies = s.enemies;
  a = PI / 2.0;
  if i >= 0 && i < len(enemies) {
    e = enemies[i];
    if e.tgt_q != e.cur_q || e.tgt_r != e.cur_r {
      (cx, cy) = hex_to_px(e.cur_q, e.cur_r);
      (tx, ty) = hex_to_px(e.tgt_q, e.tgt_r);
      a = atan2(ty - cy, tx - cx);
    } else {
      (ecx, ecy) = hex_to_px(e.cur_q, e.cur_r);
      a = atan2(s.py - ecy, s.px - ecx);
    }
  }
  a
}

// ── Construction ─────────────────────────────────────────────────────

pub fn sim_new() -> Sim {
  w = 21;
  h = 21;
  tiles: vector<integer> = [];
  for gr in 0..h {
    for gq in 0..w {
      edge = gq == 0 || gr == 0 || gq == w - 1 || gr == h - 1;
      tiles += [if edge { 1 } else { 0 }];
    }
  }
  // a couple of deterministic interior walls for visual reference
  for wr in 5..13 {
    wi = wr * w + 7;
    if wi < len(tiles) { tiles[wi] = 1; }
  }
  for wq in 9..16 {
    wj = 9 * w + wq;
    if wj < len(tiles) { tiles[wj] = 1; }
  }

  // Demo: a stepped diagonal line of solid hexes (SW corner) — its silhouette
  // should straighten into a clean diagonal wall, showing the wobble-averaging
  // produce an intermediate (non-edge) direction. Off the self-test paths.
  ds_q = [3, 4, 4, 5, 5, 6];
  ds_r = [3, 3, 4, 4, 5, 5];
  for di in 0..len(ds_q) {
    dq = ds_q[di] ?? 0;
    dr = ds_r[di] ?? 0;
    didx = dr * w + dq;
    if didx < len(tiles) { tiles[didx] = 1; }
  }

  // Edge walls: a 3-edge wall stub on hex (12,7), a low barrier you can bump
  // into — demonstrates edge walls alongside the full-hex walls above.
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  ewi = (7 * w + 12) * 3;
  for ee in 0..3 {
    eidx = ewi + ee;
    if eidx < len(walls) { walls[eidx] = 1; }
  }

  (spx, spy) = hex_to_px(10, 10);
  e0 = Enemy { cur_q: 10, cur_r: 16, tgt_q: 10, tgt_r: 16, hp: 8, maxhp: 8, dam: 3,
    xp: 2, mlvl: 1, vision: 8, flags: 0, tags: 0, awake: true, speed: ENERGY_STEP, energy: 0,
    slow_until: 0, stun_until: 0,
    cr: 200, cg: 60, cb: 50, glyph: "r", key: "giant_rat", name: "training rat", alive: true };
  enemies: vector<Enemy> = [e0];

  fsolid = build_solid(tiles, w, h);          // hoisted: never inline a struct-returning
  ffield = build_field(fsolid, walls, w, h);  //   call into a literal (survival guide)
  s = Sim {
    tkind: zeros(w * h),
    theight: [],                              // the sandbox level is flat, like a dungeon
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    solid: fsolid, field: ffield,
    seen: zeros(w * h), vis: zeros(w * h),
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1), phpmax: hero_maxhp(1), over: false,
    player: Player { pid: 0, clevel: 1, xp: 0, gold: 0 }, race: "human", pclass: "", sp: 0, spmax: 0,
    rc_flags: 0, rc_melee: 0, rc_bow: 0, rc_stealth: 0, rc_save: 0,
    rc_hd: 0, rc_xpf: 100, rc_realm: "none", rc_spi: -1, shrine_ev: 0,
    stat_max: start_stats(), stat_cur: start_stats(), stat_tmp: zeros(NUM_STATS), stat_tmp_t: zeros(NUM_STATS),
    stat_pts: 0, stat_grown_at: zeros(NUM_STATS), detect_t: 0,
    depth: 1, wseed: 0, win_x: 0, win_y: 0, save_depth: 1,
    anc_kind: 0, anc_depth: 1, anc_wx: 0, anc_wy: 0, anc_q: 0, anc_r: 0,
    q_poster: 0, q_mage: 0,
    up_q: 10, up_r: 10, dn_q: 10, dn_r: 16,
    grave_depth: 0, grave_q: 0, grave_r: 0, grave_gold: 0, boss_slain: 0,
    msg_q: [for _ in 0..MSG_MAX { "" }], msg_n: 0,
    para_until: 0, poison_until: 0, poison_dmg: 0, venom_until: 0,
    rs1: 0, rs2: 0, ninv: 0, inv: zeros(INV_MAX),
    eq: zeros(NUM_SLOTS), qs: zeros(QS_N), wdam: PLAYER_DAM, pac: 0,
    eq_dmg: zeros(NUM_SLOTS), inv_dmg: zeros(INV_MAX),
    fi_n: 0, fi_q: zeros(FLOOR_MAX), fi_r: zeros(FLOOR_MAX), fi_gold: zeros(FLOOR_MAX),
    fi_cat: zeros(FLOOR_MAX), fi_def: zeros(FLOOR_MAX), fi_live: zeros(FLOOR_MAX),
    prod_stock: zeros(NUM_PRODUCERS),
    stand: [],
    flowd_q: [], flowd_r: [], flowd_cls: [], flowd_data: [],
    dd_idx: zeros(DEPTH_MAX * MAX_SPAWNS), dd_n: zeros(DEPTH_MAX),
    known: zeros(len(game_items())), flavour_idx: zeros(len(game_items())),
    room_q0: [], room_r0: [], room_w: [], room_h: [],   // hand-built level: no rooms → pure smooth
  };
  assign_flavours(s, 12345);   // training stub: a fixed-seed flavour map (real games key off the world seed)
  sim_seed_rolls(s, 12345);
  s
}

// Seed the Sim's combat-roll stream (rs1/rs2) from `seed` — called once after each Sim
// construction (the literal can't run seed_stream). Pub: tests pin their roll stream.
pub fn sim_seed_rolls(s: &Sim, seed: integer) {
  st = random::seed_stream(seed);
  s.rs1 = st.s1;
  s.rs2 = st.s2;
}

// ── Monster placement (Angband get_mon_num) ──────────────────────────
// Placement draws from its OWN RandStream (random lib) so generation stays a pure
// function of (seed, depth) no matter what combat rolled before regeneration.

// Monster selection (get_mon_num) lives in monsters.loft as mon_choose —
// iterating the MonsterDef table with a struct fallback SIGSEGVs the interpreter
// from this module, but is fine inside monsters.loft where the type is defined.

// Build a live (asleep) Enemy from a MonsterDef at a hex. (The glyph is guarded
// to "?" — a struct-copy through the selection chain can drop the text field.)
fn mk_enemy(md: MonsterDef, q: integer, r: integer) -> Enemy {
  g = md.m_glyph;
  if len(g) == 0 { g = "?"; }
  Enemy { cur_q: q, cur_r: r, tgt_q: q, tgt_r: r,
    hp: md.m_hp, maxhp: md.m_hp, dam: md.m_dam,
    xp: md.m_xp, mlvl: md.m_depth,
    vision: md.m_vision, flags: md.m_flags, tags: md.m_tags ?? 0, awake: false,
    speed: ENERGY_STEP + md.m_speed, energy: 0,
    slow_until: 0, stun_until: 0,
    cr: md.m_cr, cg: md.m_cg, cb: md.m_cb, glyph: g, key: md.m_key, name: md.m_name, alive: true,
    role: 0, hq: q, hr: r, wq2: q, wr2: r, aq2: q, ar2: r, c1g: -1, c2g: -1, carry: 0, raid: 0,
    picket: 0 }
}

// A CIVILIAN: harmless, scheduled, never aggressive (and never punched: the
// player's bump slides past them — interaction comes later).
fn mk_npc(role: integer, key: text, name: text, glyph: text,
          cr: integer, cg: integer, cb: integer,
          q: integer, r: integer, hq: integer, hr: integer,
          wq: integer, wr: integer, aq: integer, ar: integer) -> Enemy {
  Enemy { cur_q: q, cur_r: r, tgt_q: q, tgt_r: r,
    hp: 6, maxhp: 6, dam: 0, xp: 0, mlvl: 0, vision: 0, flags: 0, tags: 0, awake: true,
    speed: ENERGY_STEP - 2, energy: 0, slow_until: 0, stun_until: 0,
    cr: cr, cg: cg, cb: cb, glyph: glyph, key: key, name: name, alive: true,
    role: role, hq: hq, hr: hr, wq2: wq, wr2: wr, aq2: aq, ar2: ar, c1g: -1, c2g: -1, carry: 0, raid: 0,
    picket: 0 }
}

// Is a LIVING actor standing on this hex?
//
// ⚠ THE DEAD DO NOT HOLD GROUND. A slain actor keeps its `cur_q`/`cur_r` forever — nothing
// clears them, because the corpse is what the level's dead list is drawn from — so without
// the `alive` test every kill left a permanent roadblock on the map. It is a roadblock with
// no cause a player can see and no way to clear it: unlike a monster, a corpse never moves
// on, and unlike a wall it is invisible to every path the field was built from. `npc_step`
// only ever takes a strictly-improving neighbour, so one corpse in a one-hex gap freezes a
// worker for the rest of the game.
//
// Two callers, and the test is inert for one of them: worldgen's placement dedup runs while
// everything it has placed is alive, so this only changes the RUNTIME callers — civilian
// stepping and the incursion's spawn pick.
fn occupied_hex(enemies: vector<Enemy>, q: integer, r: integer) -> boolean {
  found = false;
  for oi in 0..len(enemies) {
    e = enemies[oi];
    if e.alive && e.cur_q == q && e.cur_r == r { found = true; }
  }
  found
}

// Read-only, for the gate. ⚠ Pub for the reason `npc_may_enter` and `prod_draw_when` are: a
// predicate reachable only through a day of simulation is one whose branches nobody can gate
// directly, and this one's whole defect was a branch that never went false.
pub fn sim_hex_occupied(s: Sim, q: integer, r: integer) -> boolean {
  occupied_hex(s.enemies, q, r)
}

// Is (q,r) solid rock or off-map in this tile array?  The generation-time
// spelling of field_blocked(.., DIR_HEX): same solid_kind rule, but on the bare
// tile array, because no Sim exists yet while the level is being stamped.
fn tile_solid(tiles: vector<integer>, w: integer, h: integer, q: integer, r: integer) -> boolean {
  if q < 0 || r < 0 || q >= w || r >= h { return true; }
  ti = r * w + q;
  solid = true;
  if ti < len(tiles) {
    solid = solid_kind(tiles[ti] ?? 1);
  }
  solid
}

// Procedural dungeon: rooms + corridors from gen_dungeon (world-keyed seed),
// the player placed in room 0; monsters scattered onto legal floor by the
// Angband placement pass (budget → get_mon_num → start-safe spot → groups).
// Renderer-agnostic — no graphics here.
// Thin wrapper: the common 2-arg entry (tests, the open arena) generates with NO quest progress —
// so a bare sim_new_gen never triggers the bundle's "way out" infestation. The game path
// (sim_descend) passes the carried boss_slain so the brood appears only after the boss dies.
// Per-GAME flavour assignment (the Angband "mystery"): give each unknown-type def a flavour index,
// shuffled per category from the world seed, so the flavour↔kind mapping changes each game. `known`
// stays all-0 (nothing identified yet). Deterministic + self-contained (its own LCG; level-independent
// — keyed on the pure world `seed`, not the per-depth gseed — so descend/respawn see the same map).
fn assign_flavours(s: &Sim, seed: integer) {
  itbl = game_items();
  n = len(itbl);
  fl = s.flavour_idx;                       // captured field vector — index-writes persist (C18)
  cats = [IT_POTION, IT_SCROLL, IT_WAND, IT_STAFF, IT_RING, IT_AMULET];
  sm = seed % 2147483647 ?? 0;               // trap-safe reduction before mixing
  for ci in 0..len(cats) {
    cat = cats[ci] ?? 0;
    // one independent stream per category (random lib): re-seeded per call, so the map is a
    // pure function of (seed, cat) — the per-category Fisher–Yates is the lib's indices()
    st = random::seed_stream(sm * 31 + (cat + 1) * 1610612741);
    pool = st.indices(FLAVOUR_POOL);
    t = 0;                                   // hand each def of this category the next shuffled flavour
    for i in 0..n {
      if i < len(itbl) {
        m = itbl[i];
        if m.i_cat == cat {
          fl[i] = pool[t % FLAVOUR_POOL ?? 0] ?? 0;
          t += 1;
        }
      }
    }
  }
}

// ── surface architecture stamps (walls into tiles, ground kind into tk) ────
fn st_set(tiles: vector<integer>, tk: vector<integer>, w: integer, h: integer,
          q: integer, r: integer, v: integer, kind: integer) {
  if q >= 1 && q < w - 1 && r >= 1 && r < h - 1 {
    ti = r * w + q;
    if ti < len(tiles) { tiles[ti] = v; }
    if kind >= 0 && ti < len(tk) { tk[ti] = kind + 1; }
  }
}

// a small rectangular HOUSE: walls + a door in the middle of one side
// (doorside: 0=N 1=E 2=S 3=W)
fn stamp_house(tiles: vector<integer>, tk: vector<integer>, w: integer, h: integer,
               x0: integer, y0: integer, ww: integer, hh: integer, doorside: integer) {
  for rr in 0..hh {
    for qq in 0..ww {
      edge = qq == 0 || rr == 0 || qq == ww - 1 || rr == hh - 1;
      v = 0;
      if edge { v = 1; }
      if doorside == 0 && rr == 0 && qq == ww / 2 { v = 0; }
      if doorside == 1 && qq == ww - 1 && rr == hh / 2 { v = 0; }
      if doorside == 2 && rr == hh - 1 && qq == ww / 2 { v = 0; }
      if doorside == 3 && qq == 0 && rr == hh / 2 { v = 0; }
      st_set(tiles, tk, w, h, x0 + qq, y0 + rr, v, K_GRASS);
    }
  }
}

// a ROUND TOWER: a hex-distance ring of wall with a cleared interior + a door
fn stamp_round_tower(tiles: vector<integer>, tk: vector<integer>, w: integer, h: integer,
                     cx: integer, cy: integer, rad: integer) {
  doored = false;
  for rr in 0..(rad * 2 + 1) {
    for qq in 0..(rad * 2 + 1) {
      tq = cx + qq - rad;
      tr = cy + rr - rad;
      d = hex_distance(tq, tr, cx, cy);
      if d < rad { st_set(tiles, tk, w, h, tq, tr, 0, K_GRASS); }
      if d == rad {
        v = 4;                       // ROUND wall: detectable later as a circle
        if !doored && tr > cy && tq == cx { v = 0; doored = true; }   // the door
        st_set(tiles, tk, w, h, tq, tr, v, K_GRASS);
      }
    }
  }
}

pub fn sim_new_gen(seed: integer, depth: integer) -> Sim {
  sim_new_gen_s(seed, depth, 0, 0, 0, 0)
}

pub fn sim_new_gen_s(seed: integer, depth: integer, infest: integer, style: integer,
                     wwx: integer, wwy: integer) -> Sim {
  w = 41;
  h = 41;
  if depth == 0 { w = 101; h = 101; }   // the surface: a wilderness WINDOW (1.5 km across)
  // Per-level gen seed = mix(world seed, depth) so each depth has its own layout.
  gseed = (seed ^ world_key_seed(1, 1, depth)) & 2147483647;
  lvl = gen_dungeon(gseed, w, h, 24);   // more tries: overlap-rejection thins them to distinct rooms
  if style == 1 && depth > 0 {
    lvl = gen_cave(gseed ^ 777, w, h);  // NATURAL CAVES: narrow, never-straight
  }
  tiles = lvl.g_tiles;
  tk = zeros(w * h);
  th: vector<float> = [];
  if depth == 0 {
    // The CONTRACT WILDERNESS (OVERLAND.md 12): the window anchors at the
    // biggest town of the example world; each walked hex samples the pure
    // terrain function at OV_STEP natural meters per step. Town life (houses,
    // people, harbor, industry) belongs to the home window only; the land's own
    // features (ruins, forts, caves, towers, wilds) place by WORLD coordinates
    // and appear in whichever window holds them.
    ovw = overland_new();
    (ax, ay, cwx, cwy) = window_anchor(ovw, wwx, wwy, w, h);
    t0 = ovw.ov_towns[ov_home_town(ovw)];   // the home town's own record (its size builds the village)
    intown = wwx == 0 && wwy == 0;
    for _ in 0..w * h { th += [0.0]; }
    for sr3 in 0..h {
      for sq3 in 0..w {
        (wx3, wy3) = window_hex_world(ax, ay, cwx, cwy, sq3, sr3);
        // THE HEIGHT IS KEPT NOW (plan #11 P6). This line read `(_, okind)` for the life of
        // the project, which is why the near field was a flat plane: the number was fetched
        // and dropped one character before it could be stored.
        (oh3, okind) = ov_sample(ovw, wx3, wy3);
        ti3 = sr3 * w + sq3;
        if ti3 < len(tk) { tk[ti3] = okind + 1; }
        if ti3 < len(th) { th[ti3] = terrain_m_to_wu(oh3); }
        sv = 0;
        if okind == K_FACE { sv = 1; }
        if ti3 < len(tiles) { tiles[ti3] = sv; }
      }
    }
    // The FARMERS' FENCES: a field bordering the road gets a fence (tile 5,
    // straight + light — keeps travellers out of the crops) with gaps so the
    // farmers themselves get in.
    for fr5 in 1..h - 1 {
      for fq5 in 1..w - 1 {
        ti7 = fr5 * w + fq5;
        isf5 = false;
        if ti7 < len(tk) { isf5 = (tk[ti7] ?? 0) == K_FIELD + 1; }
        if isf5 {
          nearroad = false;
          for d5 in 0..6 {
            (nq5, nr5) = hex_neighbor(fq5, fr5, d5);
            if nq5 >= 0 && nq5 < w && nr5 >= 0 && nr5 < h {
              tj7 = nr5 * w + nq5;
              if tj7 < len(tk) && (tk[tj7] ?? 0) == K_ROAD + 1 { nearroad = true; }
            }
          }
          if nearroad && ((fq5 * 31 + fr5 * 17) & 7) != 0 {
            if ti7 < len(tiles) { tiles[ti7] = 5; }
          }
        }
      }
    }

    // THE TOWN'S ARCHITECTURE: small HOUSES (count by size); larger towns get
    // ROUND TOWERS; the big town gets a WALL around it with LOOKOUT TOWERS in
    // it, gated wherever a road crosses the ring.
    tsize = 1;
    if t0 != null { tsize = t0.ot_size; }
    nhouse = 3 + tsize * 2;
    // SPACING, DERIVED FROM THE HOUSE COUNT. A fixed ring crowds itself as the town grows:
    // nine 7.5 m houses on the old 9-14 m ring left 0.6 m between neighbours, which reads as
    // a camp, not a village. Real village frontages sit about 12 m apart, and one hex step is
    // 1.5 m (SCALE.md), so 12 m of frontage is 8 hex steps and the radius follows from the
    // circumference the houses need: nhouse * 8 / 2pi.
    hring = (nhouse as float) * 8.0 / 6.2831853;
    if intown {
    for hb in 0..nhouse {
      hang = (((hb as float) + 0.35) * 6.2831853 / (nhouse as float)) ?? 0.0;
      // Jitter only enough that the ring is not a drawn circle — a village is irregular, but
      // it is not scattered, and the old +-3.5 was most of the radius.
      hrad = hring + 1.2 * (((hb * 2654435761) & 1023) as float / 1023.0);
      hx0 = w / 2 + round(hrad * cos(hang)) as integer - 2;
      // A CIRCLE, not an ellipse. World x = sqrt(3)*dq but world y = 1.5*dr, so a circular
      // ring needs the r offset scaled by sqrt(3)/1.5 = 1.1547. The old 0.866 was that factor
      // INVERTED, which squashed every town ring to 0.75 of its own width.
      hy0 = h / 2 + round(hrad * sin(hang) * 1.1547) as integer - 1;
      ds = 0;
      if hy0 < h / 2 { ds = 2; }                       // door faces the square
      stamp_house(tiles, tk, w, h, hx0, hy0, 5, 4, ds);
    }
    if tsize >= 2 {
      // Just outside the house ring, on the diagonal, so they scale with the town instead of
      // sitting at two hardcoded offsets that land inside the houses once the ring grows.
      trad = hring + 2.5;
      tqo = round(trad * 0.7071) as integer;
      tro = round(trad * 0.7071 * 1.1547) as integer;
      stamp_round_tower(tiles, tk, w, h, w / 2 + tqo, h / 2 - tro, 2);
      stamp_round_tower(tiles, tk, w, h, w / 2 - tqo, h / 2 + tro, 2);
    }
    if tsize >= 3 {
      // the town WALL: a hex-distance ring, roads make the gates. Derived too — it has to
      // clear the house ring with a street's width (4 hex steps = 6 m) inside it, or the
      // wall lands on the houses as soon as the town grows.
      wrad = round(hring) as integer + 4;
      for wr2 in 0..h {
        for wq2 in 0..w {
          if hex_distance(wq2, wr2, w / 2, h / 2) == wrad {
            ti6 = wr2 * w + wq2;
            road6 = false;
            if ti6 < len(tk) { road6 = (tk[ti6] ?? 0) == K_ROAD + 1; }
            if !road6 { st_set(tiles, tk, w, h, wq2, wr2, 1, -1); }
          }
        }
      }
      // LOOKOUT TOWERS in the wall, one per 60 degrees
      for lt in 0..6 {
        lang = (lt as float) * 1.0471976 + 0.5236;
        lq = w / 2 + round((wrad as float) * cos(lang)) as integer;
        lr = h / 2 + round((wrad as float) * sin(lang) * 0.866) as integer;
        stamp_round_tower(tiles, tk, w, h, lq, lr, 2);
      }
      // ⚠ AND THEN THE GATES ARE CUT, BECAUSE "ROADS MAKE THE GATES" MADE NONE.
      //
      // Measured 2026-08-10 on the shipped world: the ring carried NO road hex anywhere, so
      // every hex of it was stamped solid and the wall closed completely. The town's own
      // people were sealed inside it — **498 of 9801 hexes reachable**, and every worker
      // whose job is outside walked at a wall for the life of the world: both farmers (the
      // field), the fisher (the water), two of the guards (their outer legs), and both
      // miners (the ore face, 42 hexes out with no path). Nothing reported it, because until
      // `S6` made the forge depend on the ore arriving, nothing depended on any of them
      // arriving. THREE earlier bugs in this file are the same defect one level down
      // (`raid_objective`'s unreachable field, `walk_reach`'s picking grounds, the mine) —
      // they were all *this*, seen from the outside.
      //
      // ⚠ A GATE THAT DEPENDS ON A COINCIDENCE IS A GATE THAT IS SOMETIMES ABSENT. Roads
      // still open the ring wherever they cross it — that is the intent and it is kept —
      // but six gates are now cut REGARDLESS, one per hex direction. Walking `wrad` steps
      // out from the centre in direction `gd` lands exactly on the ring by construction, so
      // there is no rounding to get wrong; the ±2 either side clears a lookout tower
      // standing on that bearing, which would otherwise re-seal the gate it was stamped
      // after. Terrain is left alone (`-1`) — a gate is a hole in a wall, not a new road.
      for gdir in 0..6 {
        ggq = w / 2;
        ggr = h / 2;
        for _gs in 0..(wrad - 2) { (ggq, ggr) = hex_neighbor(ggq, ggr, gdir); }
        for _gs2 in 0..5 {
          st_set(tiles, tk, w, h, ggq, ggr, 0, -1);
          (ggq, ggr) = hex_neighbor(ggq, ggr, gdir);
        }
      }
    }
    }
    // THE FORTRESS: above and away, watching the ways — a walled keep with
    // four ROUND corner towers, its gate facing the town it protects
    sstep = OV_STEP / HEX_LEN;
    for ff in 0..len(ovw.ov_forts) {
      ft = ovw.ov_forts[ff];
      if ft != null && ft.of_tw == 0 {
        fux = (ft.of_x - ax + cwx) / sstep ?? 0.0;
        fuy = (ft.of_y - ay + cwy) / sstep ?? 0.0;
        (fq, fr) = px_to_hex(fux, fuy);
        if fq >= 8 && fq < w - 8 && fr >= 7 && fr < h - 7 {
          ds2 = 0;
          if fr < h / 2 { ds2 = 2; }                   // the gate faces the town
          stamp_house(tiles, tk, w, h, fq - 5, fr - 4, 11, 9, ds2);
          stamp_round_tower(tiles, tk, w, h, fq - 5, fr - 4, 2);
          stamp_round_tower(tiles, tk, w, h, fq + 5, fr - 4, 2);
          stamp_round_tower(tiles, tk, w, h, fq - 5, fr + 4, 2);
          stamp_round_tower(tiles, tk, w, h, fq + 5, fr + 4, 2);
        }
      }
    }
    // THE HARBOR: the nearest shore within reach gets a PIER (planks over the
    // water — K_ROAD on water is walkable) and an anchorage at its head where
    // the boats moor and are repaired at night.
    pier_aq = -1;
    pier_ar = -1;
    pier_sea = false;
    bestsh = 999;
    shq = -1;
    shr = -1;
    shd = -1;
    if intown {
    for hr2 in 2..h - 2 {
      for hq2 in 2..w - 2 {
        dd2 = hex_distance(hq2, hr2, w / 2, h / 2);
        if dd2 < bestsh && dd2 < 42 {
          ti8 = hr2 * w + hq2;
          tk8 = 0;
          if ti8 < len(tk) { tk8 = tk[ti8] ?? 0; }
          land8 = tk8 != 0 && tk8 != K_LAKE + 1 && tk8 != K_SEA + 1 && (tiles[ti8] ?? 1) == 0;
          if land8 {
            for d8 in 0..6 {
              (nq8, nr8) = hex_neighbor(hq2, hr2, d8);
              if nq8 >= 1 && nq8 < w - 1 && nr8 >= 1 && nr8 < h - 1 {
                tj8 = nr8 * w + nq8;
                tw8 = 0;
                if tj8 < len(tk) { tw8 = tk[tj8] ?? 0; }
                if tw8 == K_LAKE + 1 || tw8 == K_SEA + 1 {
                  bestsh = dd2;
                  shq = hq2;
                  shr = hr2;
                  shd = d8;
                  pier_sea = tw8 == K_SEA + 1;
                }
              }
            }
          }
        }
      }
    }
    if shq >= 0 {
      pq8 = shq;
      pr8 = shr;
      for _pl9 in 0..5 {
        (pq8, pr8) = hex_neighbor(pq8, pr8, shd);
        ti9 = pr8 * w + pq8;
        if ti9 >= 0 && ti9 < len(tk) {
          tk[ti9] = K_ROAD + 1;            // the pier planks
          if ti9 < len(tiles) { tiles[ti9] = 0; }
        }
      }
      (pier_aq, pier_ar) = hex_neighbor(pq8, pr8, shd);   // the anchorage
      stamp_house(tiles, tk, w, h, shq - 4, shr - 1, 4, 3, 1);   // the harbor hut
    }
    }

    // the village SQUARE: keep the start / crystal area open (home window)
    if intown {
    for cr3 in 0..h {
      for cq3 in 0..w {
        if hex_distance(cq3, cr3, w / 2, h / 2) <= 4
           || hex_distance(cq3, cr3, w / 2 - 6, h / 2) <= 1
           || hex_distance(cq3, cr3, w / 2 + 3, h / 2) <= 1 {
          ti5 = cr3 * w + cq3;
          if ti5 < len(tk) { tk[ti5] = K_GRASS + 1; }
          if ti5 < len(tiles) { tiles[ti5] = 0; }
        }
      }
    }
    // NOTICE BOARDS on the square (tile 8): the watch hangs its WANTED posters
    // here — walking up reads them; the bounty pays out at the same board
    st_set(tiles, tk, w, h, w / 2 + 3, h / 2, 8, K_GRASS);
    st_set(tiles, tk, w, h, w / 2 - 2, h / 2 + 3, 8, K_GRASS);
    }
  }
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  rqs = lvl.g_rq;
  rrs = lvl.g_rr;
  rq0s = lvl.g_rq0;
  rr0s = lvl.g_rr0;
  rws = lvl.g_rw;
  rhs = lvl.g_rh;
  nrm = len(rqs);

  // Player in the first room.
  pq = w / 2;
  pr = h / 2;
  if nrm > 0 {
    pq = rqs[0] ?? (w / 2);
    pr = rrs[0] ?? (h / 2);
  }
  if depth == 0 { pq = w / 2; pr = h / 2; }   // surface: stand at the centre of the open desert
  (spx, spy) = hex_to_px(pq, pr);

  // Collect legal floor far from the player start, then sample the budget from
  // it directly (robust even when open floor is a small fraction of the map).
  table = monster_table();
  rng = random::seed_stream(gseed ^ 20771);
  safe = 8;                             // keep spawns this far from the start
  candq: vector<integer> = [];
  candr: vector<integer> = [];
  for ccr in 1..(h - 1) {
    for ccq in 1..(w - 1) {
      if !tile_solid(tiles, w, h, ccq, ccr) && hex_distance(ccq, ccr, pq, pr) >= safe {
        candq += [ccq];
        candr += [ccr];
      }
    }
  }
  ncand = len(candq);
  budget = 10 + (rng.get(0, 8) ?? 0);   // ~10–18
  if depth == 0 { budget = 0; }    // empty desert — no dungeon spawns (the crystal knot is step 3)
  if budget > ncand { budget = ncand; }
  enemies: vector<Enemy> = [];
  placed = 0;
  guard = 0;
  // Dedup is handled by occupied_hex (re-picking a taken cell just retries) —
  // a `used` marker vector built by comprehension read back null here.
  while placed < budget && guard < ncand * 4 + 100 {
    guard += 1;
    if ncand > 0 {
      k = rng.get(0, ncand - 1) ?? 0;
      sq = candq[k] ?? 1;
      sr = candr[k] ?? 1;
      if !occupied_hex(enemies, sq, sr) {
        eff = depth;
        if (rng.get(0, 24) ?? 0) == 0 { eff = depth + (rng.get(1, 4) ?? 1); }   // out-of-depth
        md = mon_choose(table, eff, rng.get(0, 2000000000) ?? 0);
        if md.m_hp > 0 {
          ne = mk_enemy(md, sq, sr); enemies += [ne];
          placed += 1;
          if (md.m_flags & MF_GROUP) != 0 {
            gsz = rng.get(2, 4) ?? 2;
            for gk in 0..gsz {
              if placed < budget {
                (gq, gr) = hex_neighbor(sq, sr, gk % 6 ?? 0);
                if !tile_solid(tiles, w, h, gq, gr) && hex_distance(gq, gr, pq, pr) >= safe && !occupied_hex(enemies, gq, gr) {
                  ne = mk_enemy(md, gq, gr); enemies += [ne];
                  placed += 1;
                }
              }
            }
          }
        }
      }
    }
  }

  // The surface's spawning crystal + its knot (SLICE step 3, rough v1: pre-placed, no runtime
  // growth). A stationary crystal a few steps west of the start, ringed by a small knot of weak
  // (depth-1) monsters it has "spawned" — the entrance is to the east, so the player chooses to
  // engage the crystal or head straight in.
  if depth == 0 && wwx == 0 && wwy == 0 {
    ctbl = monster_table();
    cx = pq - 6;
    cy = pr;
    cd = mon_find(ctbl, "spawn_crystal");
    if cd.m_hp > 0 {
      ne = mk_enemy(cd, cx, cy); enemies += [ne];
      for gk in 0..4 {
        (gq, gr) = hex_neighbor(cx, cy, gk);
        wk = mon_choose(ctbl, 1, (gseed ^ ((gk + 1) * 2654435761)) & 2147483647);
        if wk.m_hp > 0 && !tile_solid(tiles, w, h, gq, gr) && !occupied_hex(enemies, gq, gr) {
          ne = mk_enemy(wk, gq, gr); enemies += [ne];
        }
      }
    }
  }

  if depth == 0 {
    if intown {
    // THE PEOPLE: the daily loop — villagers, farmers (field -> food stall),
      // guards (walls + the fortress), fishers, a lake boat, a sea ship.
      sqq = w / 2 + 2;
      sqr = h / 2 - 2;                      // the food stalls on the square
      for hb in 0..nhouse {
        hang = (((hb as float) + 0.35) * 6.2831853 / (nhouse as float)) ?? 0.0;
        hrad = 6.0 + 3.5 * (((hb * 2654435761) & 1023) as float / 1023.0);
        hx5 = w / 2 + round(hrad * cos(hang)) as integer;
        hy5 = h / 2 + round(hrad * sin(hang) * 0.866) as integer;
        if hb < 2 {
          // FARMERS: home -> the nearest field -> the stall, round and round
          fldq = -1;
          fldr = -1;
          bfd = 999;
          for fr8 in 1..h - 1 {
            for fq8 in 1..w - 1 {
              tif = fr8 * w + fq8;
              if tif < len(tk) && (tk[tif] ?? 0) == K_FIELD + 1 {
                df8 = hex_distance(fq8, fr8, hx5, hy5);
                if df8 < bfd { bfd = df8; fldq = fq8; fldr = fr8; }
              }
            }
          }
          if fldq >= 0 {
            enemies += [mk_npc(2, "farmer", "farmer", "p", 205, 185, 95,
                               hx5, hy5, hx5, hy5, fldq, fldr, sqq, sqr)];
          }
        } else if hb == 2 {
          // THE FISHER: home -> the water's edge
          fsq = -1;
          fsr = -1;
          bfs = 999;
          for fr9 in 1..h - 1 {
            for fq9 in 1..w - 1 {
              tig = fr9 * w + fq9;
              tk9 = 0;
              if tig < len(tk) { tk9 = tk[tig] ?? 0; }
              land9 = tk9 != 0 && tk9 != K_LAKE + 1 && tk9 != K_SEA + 1 && (tiles[tig] ?? 1) == 0;
              if land9 {
                wet9 = false;
                for d9 in 0..6 {
                  (nq9, nr9) = hex_neighbor(fq9, fr9, d9);
                  if nq9 >= 0 && nq9 < w && nr9 >= 0 && nr9 < h {
                    tj9 = nr9 * w + nq9;
                    tw9 = 0;
                    if tj9 < len(tk) { tw9 = tk[tj9] ?? 0; }
                    if tw9 == K_LAKE + 1 || tw9 == K_RIVER + 1 || tw9 == K_SEA + 1 { wet9 = true; }
                  }
                }
                if wet9 {
                  df9 = hex_distance(fq9, fr9, hx5, hy5);
                  if df9 < bfs { bfs = df9; fsq = fq9; fsr = fr9; }
                }
              }
            }
          }
          if fsq >= 0 {
            enemies += [mk_npc(4, "fisher", "fisher", "f", 150, 190, 210,
                               hx5, hy5, hx5, hy5, fsq, fsr, fsq, fsr)];
          }
        } else if hb == 3 {
          // THE SMITH (plan #17 `S6`): the one townsperson who works on the PLAYER's gear.
          //
          // ⚠ AT THE MARKET SEAT, not out at the furnace. The seat is where the forge sets
          // its day's work out (`sim_tick`) and where the guard master's beat holds ground
          // safe, so the smith is somewhere a player can reliably find — and a smith who
          // refused to stand at an unsafe furnace would read as a bug rather than as a
          // rule, since nothing tells the player why the shop is shut. What the FURNACE
          // decides is whether there is any iron to work; that is `npc_mine`'s business.
          enemies += [mk_npc(1, "smith", "smith", "p", 200, 140, 100,
                             hx5, hy5, hx5, hy5, w / 2 + 2, h / 2 - 2, w / 2 + 2, h / 2 - 2)];
        } else {
          // VILLAGERS: sleep home, take the square by day
          enemies += [mk_npc(1, "villager", "villager", "p", 228, 205, 160,
                             hx5, hy5, hx5, hy5, w / 2, h / 2, w / 2, h / 2)];
        }
      }
      // GUARDS: the walls and the land — legs between lookout points
      ngd = 1 + tsize;
      for gd2 in 0..ngd {
        ga1 = (gd2 as float) * 2.0943951;
        ga2 = ga1 + 3.1415927;
        grad = 15.0;
        if tsize < 3 { grad = 10.0; }
        g1q = w / 2 + round(grad * cos(ga1)) as integer;
        g1r = h / 2 + round(grad * sin(ga1) * 0.866) as integer;
        g2q = w / 2 + round(grad * cos(ga2)) as integer;
        g2r = h / 2 + round(grad * sin(ga2) * 0.866) as integer;
        if gd2 == 0 {
          // THE GUARD MASTER HOLDS THE TOWN'S OWN SEAT (user, 2026-08-10, plan #17).
          //
          // ⚠ A TOWN THAT DOES NOT HOLD ITS OWN CENTRE HAS NO SAFETY TERM AT ALL. Every
          // guard used to walk the ring at `grad`, transiting the middle and never resting
          // in it, so `GUARD_R` almost never covered the square: measured 2026-08-10, the
          // market was unsafe **143 of 400 ticks a day** in the shipped starting town, from
          // ambient wildlife alone. Nothing read that until `npc_target` began asking
          // whether a work site is safe — and then six villagers stopped going to work for
          // a third of every day because a jackal was loose. `S1`'s guard rail is exactly
          // this: *guards are a term in the safety expression, not spectators.*
          //
          // His beat is the two hexes the town lives on — the centre where the villagers
          // work and the market seat where the makers set out the day's goods. They are 2
          // apart, so **both stay inside `GUARD_R` from every point of the walk**: the
          // square is held continuously rather than whenever a patrol happens by, and he
          // still moves, so the post reads as a watch and not as a statue.
          //
          // ⚠ THE RING LOSES NOTHING. Legs are `gd2 * 120°` and its opposite, and `gd2`
          // runs `0..ngd`, so with `ngd = 4` guard 3 walks 360° — guard 0's leg exactly.
          // The senior guard was patrolling a duplicate; only the duplicate is spent here.
          //
          // It also puts him where the fiction already said he was: the watch's bounties
          // are claimed from him IN PERSON, and until now he was never at the seat to ask.
          enemies += [mk_npc(3, "guard_master", "guard master", "g", 210, 190, 150,
                             w / 2 + 1, h / 2 + 1, w / 2, h / 2,
                             w / 2, h / 2, w / 2 + 2, h / 2 - 2)];
        } else {
          enemies += [mk_npc(3, "guard", "town guard", "g", 175, 180, 210,
                             w / 2 + 1, h / 2 + 1, w / 2, h / 2, g1q, g1r, g2q, g2r)];
        }
      }
      // BOATS: a small one on the lake, a bigger one at sea; both anchor at the
      // pier (or hold their water) for the night's repairs
      lkq = -1;
      lkr = -1;
      seq = -1;
      ser = -1;
      for br9 in 1..h - 1 {
        for bq9 in 1..w - 1 {
          tib = br9 * w + bq9;
          tkb = 0;
          if tib < len(tk) { tkb = tk[tib] ?? 0; }
          if tkb == K_LAKE + 1 && lkq < 0 { lkq = bq9; lkr = br9; }
          if tkb == K_SEA + 1 && seq < 0 { seq = bq9; ser = br9; }
        }
      }
      if lkq >= 0 {
        baq = lkq;
        bar = lkr;
        if pier_aq >= 0 && !pier_sea { baq = pier_aq; bar = pier_ar; }
        enemies += [mk_npc(5, "boat", "fishing boat", "b", 170, 130, 80,
                           lkq, lkr, baq, bar, lkq, lkr, lkq, lkr)];
      }
      if seq >= 0 {
        saq = seq;
        sar = ser;
        if pier_aq >= 0 && pier_sea { saq = pier_aq; sar = pier_ar; }
        // the working sea boat is a FISHER with nets
        enemies += [mk_npc(6, "fishing_ship", "fishing ship", "S", 150, 190, 210,
                           seq, ser, saq, sar, seq, ser, seq, ser)];
        // the MERCHANT SHIP brings the goods in from BEYOND the map: it sails
        // between open water at the window's edge and the harbor anchorage
        edgeq = seq;
        edger = ser;
        bedge = -1;
        for er9 in 1..h - 1 {
          for eq9 in 1..w - 1 {
            tie = er9 * w + eq9;
            if tie < len(tk) && (tk[tie] ?? 0) == K_SEA + 1 {
              de9 = hex_distance(eq9, er9, w / 2, h / 2);
              if de9 > bedge { bedge = de9; edgeq = eq9; edger = er9; }
            }
          }
        }
        msq = saq;
        msr = sar;
        if pier_aq >= 0 && pier_sea { msq = pier_aq; msr = pier_ar; }
        enemies += [mk_npc(8, "merchant_ship", "merchant ship", "S", 190, 150, 90,
                           edgeq, edger, msq, msr, edgeq, edger, msq, msr)];
      }

    }
      // THE RUINS: where the maximal history broke — tumbled houses, breached
      // walls, rubble ground; goblins nest in them (a band + its leader),
      // asleep until someone comes poking
      ctbl2 = monster_table();
      for rui in 0..len(ovw.ov_ruins) {
        ru2 = ovw.ov_ruins[rui];
        if ru2 != null {
          rux = ((ru2.ru_x - ax + cwx) / sstep) ?? 0.0;
          ruy = ((ru2.ru_y - ay + cwy) / sstep) ?? 0.0;
          (ruq, rur) = px_to_hex(rux, ruy);
          if ruq >= 8 && ruq < w - 8 && rur >= 7 && rur < h - 7 {
            // broken houses: stamped, then the years knock holes in them
            nrh = 2 + ru2.ru_size;
            for rh2 in 0..nrh {
              rang = (((rh2 as float) + 0.6) * 6.2831853 / (nrh as float)) ?? 0.0;
              rhx = ruq + round(5.0 * cos(rang)) as integer - 2;
              rhy = rur + round(5.0 * sin(rang) * 0.866) as integer - 1;
              stamp_house(tiles, tk, w, h, rhx, rhy, 5, 4, 2);
            }
            if ru2.ru_size >= 2 {
              stamp_round_tower(tiles, tk, w, h, ruq + 6, rur - 4, 2);
            }
            if ru2.ru_size >= 3 {
              for wr3 in 0..h {
                for wq3 in 0..w {
                  if hex_distance(wq3, wr3, ruq, rur) == 10 {
                    ti11 = wr3 * w + wq3;
                    if ((wq3 * 53 + wr3 * 29) & 7) < 4 {
                      if ti11 < len(tiles) { tiles[ti11] = 1; }
                    }
                  }
                }
              }
            }
            // the years: knock holes, scatter rubble
            for br3 in 0..15 {
              for bq3 in 0..15 {
                dq3 = ruq + bq3 - 7;
                dr3 = rur + br3 - 7;
                if dq3 >= 1 && dq3 < w - 1 && dr3 >= 1 && dr3 < h - 1 {
                  ti12 = dr3 * w + dq3;
                  hbreak = (dq3 * 2654435761 ^ dr3 * 40503) & 15;
                  if ti12 < len(tiles) && (tiles[ti12] ?? 0) == 1 && hbreak < 6 {
                    tiles[ti12] = 0;                       // a breach
                    if hbreak < 3 && ti12 < len(tk) { tk[ti12] = K_SCREE + 1; }
                  }
                  if ti12 < len(tiles) && (tiles[ti12] ?? 0) == 0 && hbreak == 7 {
                    if ti12 < len(tk) { tk[ti12] = K_SCREE + 1; }   // rubble drifts
                  }
                }
              }
            }
            // the nest: whoever nests in broken places, and their leader,
            // sleeping among the stones (trait-picked — never by key)
            rsalt = (ruq * 2654435761 ^ rur * 40503) & 2147483647;
            gld = mon_pick_tag(ctbl2, TAG_RUIN_BOSS, rsalt);
            if gld.m_hp > 0 && !occupied_hex(enemies, ruq, rur) {
              ne = mk_enemy(gld, ruq, rur); enemies += [ne];
            }
            gob = mon_pick_tag(ctbl2, TAG_RUIN_NEST, rsalt);
            if gob.m_hp > 0 {
              ngob = 2 + ru2.ru_size;
              for gb2 in 0..ngob {
                (gq3, gr3) = hex_neighbor(ruq, rur, gb2 % 6 ?? 0);
                if !tile_solid(tiles, w, h, gq3, gr3) && !occupied_hex(enemies, gq3, gr3) {
                  ne = mk_enemy(gob, gq3, gr3); enemies += [ne];
                }
              }
            }
            if ru2.ru_size >= 3 {
              // the DEAD CITY keeps its dead
              skl = mon_pick_tag(ctbl2, TAG_GRAVE, rsalt);
              zmb = mon_pick_tag(ctbl2, TAG_GRAVE, rsalt + 1);
              if skl.m_hp > 0 && !occupied_hex(enemies, ruq + 3, rur + 2) {
                ne = mk_enemy(skl, ruq + 3, rur + 2); enemies += [ne];
              }
              if zmb.m_hp > 0 && !occupied_hex(enemies, ruq - 3, rur - 2) {
                ne = mk_enemy(zmb, ruq - 3, rur - 2); enemies += [ne];
              }
            }
          }
        }
      }

      // NATURAL CAVES: where running water undercuts steep rock — a floor hex
      // beside both a FACE wall and the river gets a cave mouth (way down,
      // cave-style); a bat sleeps at each
      ncave = 0;
      for cvr in 2..h - 2 {
        for cvq in 2..w - 2 {
          if ncave < 2 {
            tic2 = cvr * w + cvq;
            if (tiles[tic2] ?? 1) == 0 {
              hasface = false;
              haswater = false;
              for d12 in 0..6 {
                (nq12, nr12) = hex_neighbor(cvq, cvr, d12);
                if nq12 >= 0 && nq12 < w && nr12 >= 0 && nr12 < h {
                  tj12 = nr12 * w + nq12;
                  if tj12 < len(tk) {
                    if (tk[tj12] ?? 0) == K_FACE + 1 { hasface = true; }
                    if (tk[tj12] ?? 0) == K_RIVER + 1 { haswater = true; }
                  }
                }
              }
              if hasface && haswater {
                if tic2 < len(tiles) { tiles[tic2] = 6; }
                bat2 = mon_pick_tag(ctbl2, TAG_CAVE_ROOST, cvq * 31 + cvr);
                if bat2.m_hp > 0 && !occupied_hex(enemies, cvq + 1, cvr) {
                  ne = mk_enemy(bat2, cvq + 1, cvr); enemies += [ne];
                }
                ncave = ncave + 1;
              }
            }
          }
        }
      }

      // WIZARD TOWERS within the window: the living one keeps its wizard at
      // home; the abandoned one stands breached with a skeleton in the dust
      for wzi2 in 0..len(ovw.ov_wiz) {
        wz2 = ovw.ov_wiz[wzi2];
        if wz2 != null {
          wzx = ((wz2.wz_x - ax + cwx) / sstep) ?? 0.0;
          wzy = ((wz2.wz_y - ay + cwy) / sstep) ?? 0.0;
          (wzq, wzr) = px_to_hex(wzx, wzy);
          if wzq >= 6 && wzq < w - 6 && wzr >= 5 && wzr < h - 5 {
            stamp_round_tower(tiles, tk, w, h, wzq, wzr, 3);
            if wz2.wz_dead == 1 {
              for br4 in 0..9 {
                for bq4 in 0..9 {
                  dq4 = wzq + bq4 - 4;
                  dr4 = wzr + br4 - 4;
                  if dq4 >= 1 && dq4 < w - 1 && dr4 >= 1 && dr4 < h - 1 {
                    ti14 = dr4 * w + dq4;
                    if ti14 < len(tiles) && (tiles[ti14] ?? 0) == 4
                       && ((dq4 * 2654435761 ^ dr4 * 40503) & 7) < 3 {
                      tiles[ti14] = 0;
                      if ti14 < len(tk) { tk[ti14] = K_SCREE + 1; }
                    }
                  }
                }
              }
              skl2 = mon_pick_tag(ctbl2, TAG_TOWER_DWELLER, wzi2);
              if skl2.m_hp > 0 && !occupied_hex(enemies, wzq, wzr) {
                ne = mk_enemy(skl2, wzq, wzr); enemies += [ne];
              }
            } else {
              enemies += [mk_npc(1, "wizard", "wizard", "@", 170, 140, 220,
                                 wzq, wzr, wzq, wzr, wzq, wzr, wzq, wzr)];
            }
          }
        }
      }

      // THE WILDS: the land carries its natural fauna — habitat-keyed, far
      // from town (distance = danger), asleep until disturbed
      wguard = 0;
      wplaced = 0;
      while wplaced < 10 && wguard < 200 {
        wguard = wguard + 1;
        wq9 = rng.get(3, w - 4) ?? 3;
        wr9 = rng.get(3, h - 4) ?? 3;
        wd9 = hex_distance(wq9, wr9, w / 2, h / 2);
        if wd9 >= 25 && !tile_solid(tiles, w, h, wq9, wr9) && !occupied_hex(enemies, wq9, wr9) {
          tiw = wr9 * w + wq9;
          tkw = (tk[tiw] ?? 1) - 1;
          if tkw != K_LAKE && tkw != K_SEA && tkw != K_RIVER && tkw != K_ROAD && tkw != K_FIELD {
            wtier = 1;
            if wd9 >= 40 { wtier = 2; }
            wdef = mon_choose_habitat(ctbl2, tkw, wtier, rng.get(0, 2000000000) ?? 0);
            if wdef.m_hp > 0 {
              ne = mk_enemy(wdef, wq9, wr9); enemies += [ne];
              wplaced = wplaced + 1;
            }
          }
        }
      }

      // ROAD STOPS within the window get a waystation hut; the MERCHANT CART
      // runs the multi-day route (far road end <-> the home market) and parks
      // the night at the nearest stop (or on the square if none is visible)
      sstep2 = OV_STEP / HEX_LEN;
      stq = -1;
      str2 = -1;
      for sp2 in 0..len(ovw.ov_stops) {
        st2 = ovw.ov_stops[sp2];
        if st2 != null {
          sux = ((st2.op2_x - ax + cwx) / sstep2) ?? 0.0;
          suy = ((st2.op2_y - ay + cwy) / sstep2) ?? 0.0;
          (sq5, sr5) = px_to_hex(sux, suy);
          if sq5 >= 5 && sq5 < w - 5 && sr5 >= 4 && sr5 < h - 4 {
            stamp_house(tiles, tk, w, h, sq5 + 1, sr5 - 1, 4, 3, 3);
            if stq < 0 { stq = sq5; str2 = sr5; }
          }
        }
      }
      if intown {
      farq = w / 2;
      farr = h / 2;
      bfar = -1;
      for rr7 in 1..h - 1 {
        for rq7 in 1..w - 1 {
          ti10 = rr7 * w + rq7;
          if ti10 < len(tk) && (tk[ti10] ?? 0) == K_ROAD + 1 {
            dr10 = hex_distance(rq7, rr7, w / 2, h / 2);
            if dr10 > bfar { bfar = dr10; farq = rq7; farr = rr7; }
          }
        }
      }
      if bfar > 12 {
        parkq = stq;
        parkr = str2;
        if parkq < 0 { parkq = w / 2 + 1; parkr = h / 2 - 1; }
        enemies += [mk_npc(7, "merchant", "merchant cart", "M", 190, 150, 90,
                           w / 2 + 2, h / 2 + 2, w / 2 + 2, h / 2 + 2,
                           farq, farr, parkq, parkr)];
      }
      }
      // LIVESTOCK: cows and horses — the hides come from somewhere. A fenced
      // PEN beside the first farmhouse; they graze the nearby grass by day.
      if intown {
      ph1 = w / 2 + 9;
      pr1 = h / 2 + 5;
      for pf in 0..12 {
        pang = (pf as float) * 0.5235988;
        pq9 = ph1 + round(2.2 * cos(pang)) as integer;
        pr9 = pr1 + round(2.2 * sin(pang) * 0.866) as integer;
        if pf != 0 {                                   // the gap is the gate
          st_set(tiles, tk, w, h, pq9, pr9, 5, -1);    // fence posts
        }
      }
      enemies += [mk_npc(11, "cow", "cow", "q", 205, 195, 175,
                         ph1, pr1, ph1, pr1, ph1 + 4, pr1 + 1, ph1, pr1)];
      enemies += [mk_npc(11, "cow", "cow", "q", 195, 185, 160,
                         ph1 - 1, pr1, ph1 - 1, pr1, ph1 + 3, pr1 + 2, ph1, pr1)];
      enemies += [mk_npc(11, "horse", "horse", "q", 150, 110, 70,
                         ph1 + 1, pr1, ph1 + 1, pr1, ph1 + 5, pr1 - 1, ph1, pr1)];
      enemies += [mk_npc(11, "horse", "horse", "q", 140, 100, 65,
                         ph1, pr1 + 1, ph1, pr1 + 1, ph1 + 4, pr1 - 2, ph1, pr1)];
      // WILDLIFE for the trapper's rounds: a beaver by the water, a fox in
      // the woods, a goat on the rough ground — where the window provides
      for wk9 in 0..3 {
        wkq = -1;
        wkr = -1;
        bwk = 999;
        for ar9 in 2..h - 2 {
          for aq9 in 2..w - 2 {
            daw = hex_distance(aq9, ar9, w / 2, h / 2);
            if daw >= 15 && daw < bwk {
              tia = ar9 * w + aq9;
              tka = 0;
              if tia < len(tk) { tka = tk[tia] ?? 0; }
              suit = false;
              if wk9 == 0 {                       // the beaver wants the bank
                if (tiles[tia] ?? 1) == 0 && tka != K_LAKE + 1 && tka != K_SEA + 1 {
                  for d10 in 0..6 {
                    (nq10, nr10) = hex_neighbor(aq9, ar9, d10);
                    if nq10 >= 0 && nq10 < w && nr10 >= 0 && nr10 < h {
                      tja = nr10 * w + nq10;
                      tkj = 0;
                      if tja < len(tk) { tkj = tk[tja] ?? 0; }
                      if tkj == K_RIVER + 1 || tkj == K_LAKE + 1 { suit = true; }
                    }
                  }
                }
              }
              if wk9 == 1 { suit = tka == K_FOREST + 1; }
              if wk9 == 2 { suit = tka == K_SCREE + 1 || tka == K_MEADOW + 1; }
              if suit { bwk = daw; wkq = aq9; wkr = ar9; }
            }
          }
        }
        if wkq >= 0 {
          wglyph = "r";
          wcr = 120; wcg = 90; wcb = 60;
          if wk9 == 1 { wglyph = "f"; wcr = 200; wcg = 120; wcb = 60; }
          if wk9 == 2 { wglyph = "q"; wcr = 190; wcg = 180; wcb = 160; }
          wkey = "beaver";
          if wk9 == 1 { wkey = "fox"; }
          if wk9 == 2 { wkey = "goat"; }
          enemies += [mk_npc(12, wkey, wkey,
                             wglyph, wcr, wcg, wcb,
                             wkq, wkr, wkq, wkr, wkq, wkr, wkq, wkr)];
        }
      }

      }
      // THE MINE + the big SLAG-FURNACE outside the walls (dirty industry
      // stays out of town): miners cycle ore from the mountain face to the
      // furnace, day in day out
      if intown && tsize >= 2 {
        // ⚠ REACHABLE FIRST, NEAREST SECOND — `walk_reach`'s rule, and the MINE is the third
        // site this repo has had to learn it on (`raid_objective`'s 45-hex field, the
        // gatherer's picking grounds, now this). Measured before the fix, on the shipped
        // world: the ore face sat at (7,49), 42 hexes from the miner's home at (47,53), with
        // NO PATH between them — and its open neighbours were equally cut off, so it was the
        // SITE that was unreachable, not the cave mouth. Two miners walked at it for the life
        // of the world and delivered nothing, and nothing reported it, because until `S6` gave
        // the forge an input stream nothing depended on their arriving.
        mhq = w / 2 - 3;                                     // the miners' own doorstep
        mhr = h / 2 + 3;
        reachm = walk_reach(tiles, tk, w, h, mhq, mhr);
        mnq = -1;
        mnr = -1;
        bmn = 999;
        farmq = -1;      // the farthest reachable face, for when none is >= 16 out
        farmr = -1;
        bfarm = -1;
        // ⚠ AND THE NEAREST REACHABLE FACE AT *ANY* DISTANCE (plan #11 P6). A valley town's
        // rock can sit beyond `WORK_MAX_D` — town 2's nearest is 46 hexes — and the branch
        // that used to catch that put the mouth at the WINDOW EDGE, which is a site pointing
        // at rock rather than a site ON it. Aiming at the real face instead is what makes the
        // "does a distant mine work?" question answerable: the furnace follows the mine and a
        // guard walks the works, so what has to be short is the mine->furnace leg, not the
        // town's view of it. `reachm` already gates this on reachability.
        nearq = -1;
        nearr = -1;
        bnear = 9999;
        for mr8 in 2..h - 2 {
          for mq8 in 2..w - 2 {
            tim = mr8 * w + mq8;
            if tim < len(tiles) && (tiles[tim] ?? 1) == 0 && (reachm[tim] ?? 0) == 1 {
              facenb = false;
              for d6 in 0..6 {
                (nq6, nr6) = hex_neighbor(mq8, mr8, d6);
                if nq6 >= 0 && nq6 < w && nr6 >= 0 && nr6 < h {
                  tj6 = nr6 * w + nq6;
                  if tj6 < len(tk) && (tk[tj6] ?? 0) == K_FACE + 1 { facenb = true; }
                }
              }
              if facenb {
                dmn = hex_distance(mq8, mr8, w / 2, h / 2);
                if dmn < bnear { bnear = dmn; nearq = mq8; nearr = mr8; }
                // ⚠ AND WITHIN A DAY'S WALK (`WORK_MAX_D`) — the ore face the old scan chose
                // sat 43 hexes out, and a miner whose leg flips every 90 ticks never
                // completes that round trip even with a clear path the whole way.
                if dmn <= WORK_MAX_D {
                  if dmn >= 16 && dmn < bmn { bmn = dmn; mnq = mq8; mnr = mr8; }
                  if dmn > bfarm { bfarm = dmn; farmq = mq8; farmr = mr8; }
                }
              }
            }
          }
        }
        // Dirty industry belongs out of town, but that is the INTENT and not a requirement:
        // a rock face the miners can walk to at 9 hexes beats one at 20 they cannot. The
        // gatherer's fallback, for the gatherer's reason.
        if mnq < 0 { mnq = farmq; mnr = farmr; }
        if mnq < 0 { mnq = nearq; mnr = nearr; }
        if mnq < 0 {
          // no rock in this window: the mine lies BEYOND it — its mouth sits
          // at the window edge toward the nearest mountain/hill cell
          bdc = 1.0e18;
          mdx = 1.0;
          mdy = 0.0;
          for mc9 in 0..9 {
            for mr9 in 0..7 {
              mt9 = ov_cell_mat(ovw, mc9, mr9);
              if mt9 == 4 || mt9 == 5 {
                (mcx, mcy) = ov_cell_center(mc9, mr9);
                dcx = mcx - ax;
                dcy = mcy - ay;
                dc9 = dcx * dcx + dcy * dcy;
                if dc9 < bdc { bdc = dc9; mdx = dcx; mdy = dcy; }
              }
            }
          }
          mdl = sqrt(mdx * mdx + mdy * mdy) ?? 0.0;
          if mdl > 0.001 {
            exq = w / 2 + round(((mdx / mdl) ?? 0.0) * ((w / 2 - 5) as float)) as integer;
            exr = h / 2 + round(((mdy / mdl) ?? 0.0) * ((h / 2 - 5) as float)) as integer;
            // settle on the nearest walkable hex around that edge spot
            for sr9 in 0..7 {
              for sq9 in 0..7 {
                cq9 = exq + sq9 - 3;
                cr9 = exr + sr9 - 3;
                if mnq < 0 && cq9 >= 2 && cq9 < w - 2 && cr9 >= 2 && cr9 < h - 2 {
                  tic = cr9 * w + cq9;
                  tkc = 0;
                  if tic < len(tk) { tkc = tk[tic] ?? 0; }
                  // ⚠ AND REACHABLE, AND WITHIN A DAY'S WALK. "Walkable" is a property of the
                  // hex; "reachable" is a property of the hex AND the town; "workable" is a
                  // property of the ROUTE. This branch puts the mouth at the WINDOW EDGE, ~45
                  // hexes out, so it fails the third — and a mine nobody can round-trip is
                  // not a mine, it is two miners standing still forever. Measured: the camp
                  // out there is unsafe 1600 of 1600 ticks (no guard reaches it), delivers
                  // nothing ever, and absorbs every incursion the den sends — which took the
                  // pressure OFF the chain `I-SAFE` is measured on.
                  // ⚠ SO A VALLEY TOWN SIMPLY HAS NO MINE, and that is the honest answer:
                  // `walk_reach`'s own rule ("no reachable picking ground means no gatherer")
                  // applied to the trade whose rock is beyond a day's walk.
                  if (tiles[tic] ?? 1) == 0 && tkc != K_LAKE + 1 && tkc != K_SEA + 1
                     && (reachm[tic] ?? 0) == 1 {
                    mnq = cq9;
                    mnr = cr9;
                  }
                }
              }
            }
          }
        }
        if mnq >= 0 {
          ti13 = mnr * w + mnq;
          if ti13 < len(tiles) { tiles[ti13] = 6; }   // the mine IS a cave mouth
          // THE FURNACE SITS BETWEEN THE TOWN AND THE MINE, AND NEVER FAR FROM THE MINE.
          //
          // ⚠ IT USED TO SIT AT A FIXED 20 HEXES FROM THE TOWN, WHICH IS THE WRONG END OF
          // THE ROUTE. The miners' day is mine -> furnace -> mine, so what has to be short
          // is *that* leg, not the town's view of it: with an ore face at the window edge
          // the old placement left a 23-hex haul each way and the miners delivered nothing
          // in four days. Ore is heavy and slag is filthy — a real works stands at the foot
          // of the mountain, not at the town's gate.
          //
          // So: four hexes back down the line toward town, but never inside the walls
          // (`wrad + 3`) — dirty industry still stays out of town, which was the original
          // and correct half of this rule.
          fdx = (mnq - w / 2) as float;
          fdy = (mnr - h / 2) as float;
          fdl = sqrt(fdx * fdx + fdy * fdy) ?? 0.0;
          fdist = fdl - 4.0;
          fmin = (round(hring) as integer + 7) as float;
          if fdist < fmin { fdist = fmin; }
          if fdist > fdl { fdist = fdl; }
          fux2 = ((fdx / fdl) ?? 0.0) * fdist;
          fuy2 = ((fdy / fdl) ?? 0.0) * fdist;
          fnq = w / 2 + round(fux2) as integer;
          fnr = h / 2 + round(fuy2) as integer;
          stamp_round_tower(tiles, tk, w, h, fnq, fnr, 3);   // the BIG furnace
          for d7 in 0..6 {                                   // its slag ground
            (sq7, sr7) = hex_neighbor(fnq, fnr, d7);
            ti7b = sr7 * w + sq7;
            if ti7b >= 0 && ti7b < len(tk) && (tk[ti7b] ?? 0) != 0
               && hex_distance(sq7, sr7, fnq, fnr) > 3 {
              tk[ti7b] = K_SCREE + 1;
            }
          }
          // ⚠ AND THE DELIVERY END, WHICH IS THE ONE THE STOCK TURNS ON. A route is only as
          // walkable as its WORSE end: a miner that reaches its ore face and not its furnace
          // raises nothing, and `npc_mine` empties the bag HERE. The ideal spot is four hexes
          // out from the furnace mouth; take the reachable hex nearest to it instead, and
          // never one inside the tower itself (radius 3, and stamped after the reach map).
          daq = fnq;
          dar = fnr + 4;
          bda = 9999;
          for ar9 in 0..9 {
            for aq9 in 0..9 {
              cq8 = fnq + aq9 - 4;
              cr8 = fnr + ar9 - 4;
              if cq8 >= 1 && cq8 < w - 1 && cr8 >= 1 && cr8 < h - 1 {
                ti8 = cr8 * w + cq8;
                if ti8 >= 0 && ti8 < len(tiles) && (reachm[ti8] ?? 0) == 1
                   && hex_distance(cq8, cr8, fnq, fnr) > 3 {
                  d8 = hex_distance(cq8, cr8, fnq, fnr + 4);
                  if d8 < bda { bda = d8; daq = cq8; dar = cr8; }
                }
              }
            }
          }
          // ⚠ AND THE MINERS LIVE AT THE WORKS, NOT IN TOWN. They used to sleep on the
          // town's doorstep and commute to whatever face worldgen had found — which is only
          // sane when the rock is a short walk away, and on the shipped world it is 43 hexes.
          // A mining camp at the foot of the mountain is both the working arrangement and
          // the real one; the ore still reaches the town's forge, because the stock belongs
          // to the SETTLEMENT and the furnace is where it is raised (`npc_mine`).
          (m2q, m2r) = hex_neighbor(daq, dar, 3);
          enemies += [mk_npc(10, "miner", "miner", "m", 140, 120, 100,
                             daq, dar, daq, dar,
                             mnq, mnr, daq, dar)];
          enemies += [mk_npc(10, "miner", "miner", "m", 140, 120, 100,
                             m2q, m2r, m2q, m2r,
                             mnq, mnr, daq, dar)];
          // ⚠ AND THE SETTLEMENT POSTS A GUARD ON ITS OWN WORKS (user, 2026-08-10).
          //
          // Without one the camp is unsafe **1600 of 1600 ticks** — no guard's `GUARD_R`
          // reaches the foot of the mountain — so `npc_target` keeps the miners home every
          // tick of every day and the trade is not merely hindered, it is permanently dead.
          // That is not `I-SAFE` working: a lever the world holds at zero is not a lever.
          // It is the same argument that moved the guard master onto the town's own seat —
          // *guards are a term in the safety expression, not spectators* (`S1`) — applied to
          // the works instead of the square.
          //
          // ⚠ ONE GUARD, WALKING THE WORKS: legs at the ore face and the camp, so each end is
          // held when the watch is at it and exposed when it is not. That is deliberately not
          // total cover — the mine still stops when something is standing on it and the guard
          // is at the other end, which is what leaves `S7`'s pickets something to buy and
          // keeps the den's raids able to bite.
          //
          // ✅ AND `S7` BOUGHT IT (2026-08-10): a picket posted for the ore face takes it from
          // **775 of 1600 unsafe ticks to 0** and the deliveries from 3 to 6, with the den
          // alive throughout. ⚠ The picket stands two hexes BEYOND the face rather than on it
          // — this guard's own ore-face leg is why that rule exists (`militia_stand`).
          enemies += [mk_npc(3, "guard", "works guard", "g", 175, 180, 210,
                             daq, dar, daq, dar,
                             mnq, mnr, daq, dar)];
        }
      }

      // THE MILL grinds the bread grain: WATER-powered at the riverbank if
      // the window has running water, WIND-powered on open ground otherwise
      if intown {
      mlq = -1;
      mlr = -1;
      bml = 999;
      for vr8 in 2..h - 2 {
        for vq8 in 2..w - 2 {
          dml = hex_distance(vq8, vr8, w / 2, h / 2);
          if dml >= 8 && dml < bml {
            tiv = vr8 * w + vq8;
            tkv = 0;
            if tiv < len(tk) { tkv = tk[tiv] ?? 0; }
            if (tiles[tiv] ?? 1) == 0 && tkv != K_LAKE + 1 && tkv != K_SEA + 1 {
              wetv = false;
              for d11 in 0..6 {
                (nq11, nr11) = hex_neighbor(vq8, vr8, d11);
                if nq11 >= 0 && nq11 < w && nr11 >= 0 && nr11 < h {
                  tjv = nr11 * w + nq11;
                  if tjv < len(tk) && (tk[tjv] ?? 0) == K_RIVER + 1 { wetv = true; }
                }
              }
              if wetv { bml = dml; mlq = vq8; mlr = vr8; }
            }
          }
        }
      }
      if mlq < 0 {
        // no running water: the WINDMILL stands on open ground instead
        mlq = w / 2 + 14;
        mlr = h / 2 - 10;
      }
      stamp_round_tower(tiles, tk, w, h, mlq, mlr, 2);
      }

      // THE ALCHEMIST'S GATHERER: a rugged traveler fetching the special
      // ingredients — met on the roads or the hillsides, shunning the deeper
      // mountains. There are not many of them: ONE walks the home window.
      if intown && tsize >= 3 {
        // ⚠ REACHABLE FIRST, NEAREST SECOND. The picking ground has to be somewhere the
        // gatherer can actually walk to; on world 777 the nearest one at the old ≥14 bound
        // had NO path from town, so the worker stood still for the life of the world.
        ghq = w / 2 + 3;
        ghr = h / 2 + 3;
        reach8 = walk_reach(tiles, tk, w, h, ghq, ghr);
        // ⚠ PICKING GROUND IS A RANKED PREFERENCE, NOT ONE TERRAIN. It used to be meadow or
        // scree only — the alpine shelves, which is the right *first* choice and was the only
        // one. Measured on world 777: of 9801 hexes the town can walk to just 498, and they
        // are 467 grass + 31 road — no meadow, no scree, no forest anywhere inside the
        // pocket. A gatherer that only picks alpine herbs cannot work in a grass valley, so
        // it took the best ground it could see and stood 37 hexes short of it forever.
        bestrank = 99;
        hsq = -1;
        hsr = -1;
        bhs = 999;
        farq2 = -1;      // within the best rank present: the farthest, when none is >= 14
        farr2 = -1;
        bfar2 = -1;
        for gr8 in 1..h - 1 {
          for gq8 in 1..w - 1 {
            tih = gr8 * w + gq8;
            tkh = 0;
            if tih < len(tk) { tkh = tk[tih] ?? 0; }
            rank = pick_rank(tkh);
            if rank >= 0 && rank <= bestrank && (reach8[tih] ?? 0) == 1 {
              dh8 = hex_distance(gq8, gr8, ghq, ghr);
              if dh8 > 0 && dh8 <= WORK_MAX_D {
                if rank < bestrank {      // a better ground exists: forget the poorer ones
                  bestrank = rank;
                  hsq = -1; hsr = -1; bhs = 999;
                  farq2 = -1; farr2 = -1; bfar2 = -1;
                }
                if dh8 >= 14 && dh8 < bhs { bhs = dh8; hsq = gq8; hsr = gr8; }
                if dh8 > bfar2 { bfar2 = dh8; farq2 = gq8; farr2 = gr8; }
              }
            }
          }
        }
        // Working far out is the intent, not a requirement — the farthest reachable ground
        // beats a distant unreachable one, and beats no gatherer at all.
        if hsq < 0 { hsq = farq2; hsr = farr2; }
        // ⚠ NO REACHABLE PICKING GROUND MEANS NO GATHERER. Spawning one anyway is how role 9
        // came to exist as decoration: placed, walking, and structurally unable to work.
        if hsq >= 0 && bfar > 12 {
          enemies += [mk_npc(9, "gatherer", "rugged traveler", "t", 160, 150, 120,
                             ghq, ghr, ghq, ghr,
                             hsq, hsr, farq, farr)];
        }

        // THE DEN OVER THE RIDGE (plan #17 `S5`) — the settlement's own source of pressure,
        // sited at the FARTHEST hex the town can walk to.
        //
        // ⚠ IT IS HERE BECAUSE THE MECHANISM HAD NO CONSUMER, and a seam with no consumer is
        // a seam with no test (STATE.md, from `producttest`). Measured 2026-08-10 on world
        // 777: all three ruin bosses stand in windows holding 0 guards and 0 civilians, and
        // the home window — 4 guards, 24 civilians, the one gatherer, the whole economy —
        // holds no tagged monster at all. So `send_incursions` was correct code that could
        // never fire on a settlement in any window of the shipped world.
        //
        // ⚠ FARTHEST-REACHABLE IS THE SITING RULE, and it does two jobs. It is *over the
        // ridge* rather than next door, so it does not make the first minute of a level-1
        // game lethal; and it is inside the walkable pocket, so the player can go at the
        // cause on foot and the raiders have a path back in. ⚠ It does NOT try to place the
        // den near the work it will press on — an earlier version of this comment claimed
        // the march would cross the picking ground and the measurement said otherwise (0
        // unsafe ticks in seven days). Where the raid BITES is decided by `raid_objective`,
        // which aims it at the work; the siting only decides how far away the cause lives.
        //
        // ⚠ AND IT MAKES THE STARTING NEIGHBOURHOOD HARDER, on top of a curve STATE.md
        // already records as unowned (a gnoll 8 hexes from the vantage, a level-1 hero dead
        // on tick 13). `RAID_CAP` is 2, so this is +1 leader +3 nest and at most 2 walking:
        // small against the 15 hostiles already here, and it is the first danger in the game
        // with a CAUSE the player can end. Flagged in the plan, not decided here.
        //
        // ⚠ AND IT NEEDS ROOM. Plain farthest-reachable is a CUL-DE-SAC by construction —
        // the deepest hex of a pocket has the fewest ways out. Measured 2026-08-10: the den
        // landed with one free neighbour, its three sleepers took it, and the source could
        // field exactly ONE raider for seven days running. `RAID_CAP` was never the binding
        // constraint; the geometry was, silently. So a den hex needs four walkable
        // neighbours — enough for its band and a way out for its people.
        dnq2 = -1;
        dnr2 = -1;
        bdn = 20;                       // never nearer than 20 hexes (300 m) to the square
        for dr8 in 1..h - 1 {
          for dq8 in 1..w - 1 {
            tid = dr8 * w + dq8;
            if (reach8[tid] ?? 0) == 1 {
              dd8 = hex_distance(dq8, dr8, ghq, ghr);
              if dd8 > bdn {
                room = 0;
                for dnb in 0..6 {
                  (rq8, rr8) = hex_neighbor(dq8, dr8, dnb);
                  if rq8 >= 1 && rr8 >= 1 && rq8 < w - 1 && rr8 < h - 1 {
                    if (reach8[rr8 * w + rq8] ?? 0) == 1 { room += 1; }
                  }
                }
                if room >= 4 { bdn = dd8; dnq2 = dq8; dnr2 = dr8; }
              }
            }
          }
        }
        if dnq2 >= 0 {
          dtbl = game_monsters();
          dsalt = (dnq2 * 2654435761 ^ dnr2 * 40503) & 2147483647;
          dld = mon_pick_tag(dtbl, TAG_RUIN_BOSS, dsalt);
          if dld.m_hp > 0 && !occupied_hex(enemies, dnq2, dnr2) {
            ne = mk_enemy(dld, dnq2, dnr2); enemies += [ne];
            // its people, asleep around it — the same construction as a ruin nest, because
            // it is the same thing: whoever nests in the broken places, nesting here.
            dgb = mon_pick_tag(dtbl, TAG_RUIN_NEST, dsalt);
            if dgb.m_hp > 0 {
              for db2 in 0..3 {
                (dgq, dgr) = hex_neighbor(dnq2, dnr2, db2 * 2 % 6 ?? 0);
                if !tile_solid(tiles, w, h, dgq, dgr) && !occupied_hex(enemies, dgq, dgr) {
                  ne = mk_enemy(dgb, dgq, dgr); enemies += [ne];
                }
              }
            }
          }
        }
      }
  }

  // Stairs: up at the player start, down at the farthest reachable floor hex.
  dnq = pq;
  dnr = pr;
  bestdd = -1;
  for si in 0..ncand {
    if si < ncand {
      cq = candq[si] ?? pq;
      cr = candr[si] ?? pr;
      dd = hex_distance(cq, cr, pq, pr);
      if dd > bestdd { bestdd = dd; dnq = cq; dnr = cr; }
    }
  }
  if depth == 0 {
    // THE DESERT GATE: the way into the deep dungeon opens from the RAIN-SHADOW
    // DESERT, not the town square — and on true desert sand, never the beaches
    // (the gate hex is material-6 desert by construction; a dryness ring keeps
    // it off any waterside sand). Find the desert cell nearest the home town;
    // if it lies in THIS window, sink the entrance into the dry sand.
    dnq = -1;
    dnr = -1;
    t0x9 = 7500.0;
    t0y9 = 5800.0;
    t9 = ovw.ov_towns[ov_home_town(ovw)];
    if t9 != null { t0x9 = t9.ot_x; t0y9 = t9.ot_y; }
    bdd9 = 1.0e18;
    bdx9 = 0.0;
    bdy9 = 0.0;
    bok9 = 0;
    for dgr9 in 0..7 {
      for dgc9 in 0..9 {
        if ov_cell_mat(ovw, dgc9, dgr9) == 6 {
          (ccx9, ccy9) = ov_cell_center(dgc9, dgr9);
          dd9 = (ccx9 - t0x9) * (ccx9 - t0x9) + (ccy9 - t0y9) * (ccy9 - t0y9);
          if dd9 < bdd9 { bdd9 = dd9; bdx9 = ccx9; bdy9 = ccy9; bok9 = 1; }
        }
      }
    }
    if bok9 == 1 {
      sst9 = OV_STEP / HEX_LEN;
      eux9 = ((bdx9 - ax + cwx) / sst9) ?? 0.0;
      euy9 = ((bdy9 - ay + cwy) / sst9) ?? 0.0;
      (ehq9, ehr9) = px_to_hex(eux9, euy9);
      if ehq9 >= 3 && ehq9 < w - 3 && ehr9 >= 3 && ehr9 < h - 3 {
        bsd9 = 999;
        for sr9 in 3..h - 3 {
          for sq9 in 3..w - 3 {
            dsn9 = hex_distance(sq9, sr9, ehq9, ehr9);
            if dsn9 < bsd9 {
              tis9 = sr9 * w + sq9;
              sandy9 = false;
              if tis9 < len(tk) { sandy9 = (tk[tis9] ?? 0) == K_SAND + 1 && (tiles[tis9] ?? 1) == 0; }
              if sandy9 {
                dry9 = true;
                for dn9 in 0..6 {
                  (nq9b, nr9b) = hex_neighbor(sq9, sr9, dn9);
                  if nq9b >= 0 && nq9b < w && nr9b >= 0 && nr9b < h {
                    tjn9 = nr9b * w + nq9b;
                    tkn9 = 0;
                    if tjn9 < len(tk) { tkn9 = tk[tjn9] ?? 0; }
                    if tkn9 == K_RIVER + 1 || tkn9 == K_LAKE + 1 || tkn9 == K_SEA + 1 { dry9 = false; }
                  }
                }
                if dry9 { bsd9 = dsn9; dnq = sq9; dnr = sr9; }
              }
            }
          }
        }
      }
    }
  }
  ti_up = pr * w + pq;
  if depth != 0 && ti_up >= 0 && ti_up < len(tiles) { tiles[ti_up] = 3; }   // no up-stair on the surface
  ti_dn = dnr * w + dnq;
  dnv = 2;
  if style == 1 && depth > 0 { dnv = 6; }   // deeper into the cave, cave-style
  if dnq >= 0 && ti_dn >= 0 && ti_dn < len(tiles) { tiles[ti_dn] = dnv; }

  // ── World-bundle PLACEMENT (the engine executor; the rules + content are bundle-side) ──────────
  // The active overlay (world_place_gen, generated from bundles/desert_surprise) decides; we stamp.
  // Mutating the LOCAL enemies vector + tiles here is C18/C4-safe (still construction-time, same
  // module). Deterministic, so re-entry regenerates identically.
  if world_has_placement() == 1 {
    pl = world_placement();
    gm = game_monsters();          // merged catalog (base + bundle) — for the by-key boss/guard lookups
    // SET-PIECE: stamp the configured stencil around the stair-down at its depth (the boss gates it).
    if depth == pl.setpiece_depth {
      stl = world_stencils();
      rad = 0; bkey = ""; gkey = ""; gnum = 0; spool = 0;
      for si in 0..len(stl) {
        if si < len(stl) {
          st = stl[si];
          if st.sk == pl.setpiece_stencil && st.shape == "round" {
            rad = st.radius; bkey = st.boss; gkey = st.guard; gnum = st.guards;
            spool = st.pool ?? 0;
          }
        }
      }
      if rad > 0 {
        span = 2 * rad + 1;
        for ry in 0..span {
          for rx in 0..span {
            tq2 = dnq + rx - rad;
            tr2 = dnr + ry - rad;
            if tq2 >= 1 && tr2 >= 1 && tq2 < w - 1 && tr2 < h - 1 {
              if hex_distance(tq2, tr2, dnq, dnr) <= rad {
                ti2 = tr2 * w + tq2;
                if ti2 >= 0 && ti2 < len(tiles) { tiles[ti2] = 0; }
              }
            }
          }
        }
        // the stencil's MAGICAL POOL: shallow walkable water (tile 9) ringing
        // the centre — a phial can be filled from it (the quest verb)
        if spool > 0 {
          for py2 in 0..(spool * 2 + 1) {
            for px2 in 0..(spool * 2 + 1) {
              plq = dnq + px2 - spool;
              plr = dnr + py2 - spool;
              if plq >= 1 && plr >= 1 && plq < w - 1 && plr < h - 1
                 && hex_distance(plq, plr, dnq, dnr) <= spool {
                tip = plr * w + plq;
                if tip >= 0 && tip < len(tiles) { tiles[tip] = 9; }
              }
            }
          }
        }
        if ti_dn >= 0 && ti_dn < len(tiles) { tiles[ti_dn] = 2; }   // re-stamp the stair we carved over
        (bq, br) = hex_neighbor(dnq, dnr, 0);
        bd = mon_find(gm, bkey);
        if bd.m_hp > 0 && !tile_solid(tiles, w, h, bq, br) && !occupied_hex(enemies, bq, br) {
          ne = mk_enemy(bd, bq, br); enemies += [ne];
        }
        gd = mon_find(gm, gkey);
        if gd.m_hp > 0 {
          for gki in 0..gnum {
            (gq, gr) = hex_neighbor(bq, br, gki % 6 ?? 0);
            if !tile_solid(tiles, w, h, gq, gr) && !occupied_hex(enemies, gq, gr) && hex_distance(gq, gr, pq, pr) >= 2 {
              ne = mk_enemy(gd, gq, gr); enemies += [ne];
            }
          }
        }
      }
    }
    // INFESTATION: once the set-piece boss has died (infest carried in), flood the way OUT — the
    // brood thickens toward the surface. Deterministic placement onto the level's floor candidates.
    if infest == 1 && pl.infest_trigger == "boss_slain" {
      icount = 0;
      if depth == 1 { icount = pl.infest_d1; }
      if depth == 2 { icount = pl.infest_d2; }
      if icount > 0 && ncand > 0 {
        sa = mon_find(gm, pl.infest_a);
        sb = mon_find(gm, pl.infest_b);
        iplaced = 0; ig = 0;
        while iplaced < icount && ig < ncand * 4 + 100 {
          ig += 1;
          kk = (((gseed ^ ((ig + 1) * 2654435761)) & 2147483647) % ncand) ?? 0;
          sq2 = candq[kk] ?? 1;
          sr2 = candr[kk] ?? 1;
          if !occupied_hex(enemies, sq2, sr2) {
            // no md2 = sa/sb temp: a struct reassign-from-variable borrows instead of
            // copying on the 2026.6 toolchain, and the overwrite clobbers the source
            if (iplaced % 2 ?? 0) == 1 {
              if sb.m_hp > 0 { enemies += [mk_enemy(sb, sq2, sr2)]; iplaced += 1; }
            } else {
              if sa.m_hp > 0 { enemies += [mk_enemy(sa, sq2, sr2)]; iplaced += 1; }
            }
          }
        }
      }
    }
  }

  gsolid = build_solid(tiles, w, h);
  gfield = build_field(gsolid, walls, w, h);
  s = Sim {
    tkind: tk,
    theight: th,
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    solid: gsolid, field: gfield,
    seen: zeros(w * h), vis: zeros(w * h),
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1), phpmax: hero_maxhp(1), over: false,
    player: Player { pid: 0, clevel: 1, xp: 0, gold: 0 }, race: "human", pclass: "", sp: 0, spmax: 0,
    rc_flags: 0, rc_melee: 0, rc_bow: 0, rc_stealth: 0, rc_save: 0,
    rc_hd: 0, rc_xpf: 100, rc_realm: "none", rc_spi: -1, shrine_ev: 0,
    stat_max: start_stats(), stat_cur: start_stats(), stat_tmp: zeros(NUM_STATS), stat_tmp_t: zeros(NUM_STATS),
    stat_pts: 0, stat_grown_at: zeros(NUM_STATS), detect_t: 0,
    depth: depth, wseed: seed, win_x: wwx, win_y: wwy, save_depth: depth,
    anc_kind: 0, anc_depth: depth, anc_wx: wwx, anc_wy: wwy, anc_q: pq, anc_r: pr,
    q_poster: 0, q_mage: 0,
    up_q: pq, up_r: pr, dn_q: dnq, dn_r: dnr,
    grave_depth: 0, grave_q: 0, grave_r: 0, grave_gold: 0, boss_slain: 0,
    msg_q: [for _ in 0..MSG_MAX { "" }], msg_n: 0,
    para_until: 0, poison_until: 0, poison_dmg: 0, venom_until: 0,
    rs1: 0, rs2: 0, ninv: 0, inv: zeros(INV_MAX),
    eq: zeros(NUM_SLOTS), qs: zeros(QS_N), wdam: PLAYER_DAM, pac: 0,
    eq_dmg: zeros(NUM_SLOTS), inv_dmg: zeros(INV_MAX),
    fi_n: 0, fi_q: zeros(FLOOR_MAX), fi_r: zeros(FLOOR_MAX), fi_gold: zeros(FLOOR_MAX),
    fi_cat: zeros(FLOOR_MAX), fi_def: zeros(FLOOR_MAX), fi_live: zeros(FLOOR_MAX),
    prod_stock: zeros(NUM_PRODUCERS),
    stand: [],
    flowd_q: [], flowd_r: [], flowd_cls: [], flowd_data: [],
    dd_idx: zeros(DEPTH_MAX * MAX_SPAWNS), dd_n: zeros(DEPTH_MAX),
    known: zeros(len(game_items())), flavour_idx: zeros(len(game_items())),
    room_q0: rq0s, room_r0: rr0s, room_w: rws, room_h: rhs,
  };
  assign_flavours(s, seed);  // per-GAME flavour map from the world seed (descend/respawn carry it forward)
  sim_seed_rolls(s, gseed ^ 99173);
  sim_starting_loadout(s);   // every new character starts with its class kit (§3a #4)
  // World-bundle QUEST GRANT: hand the player the bundle's keepsake on its quest depth (the surface).
  // Only the genuine start sticks — descending overwrites the inventory with the carried one.
  if world_has_placement() == 1 {
    qp = world_placement();
    if depth == qp.quest_depth && qp.quest_item != "" {
      sim_give_item(s, qp.quest_item);
      sim_log(s, "{sim_item_display_name(s, item_index(game_items(), qp.quest_item))} is pressed into your hand.");
    }
  }
  s
}

// Move between levels: dir +1 descends, -1 ascends (clamped to depth >= 1).
// Regenerates the destination deterministically from (wseed, new depth), carries
// the player's HP, and places them on the arrival stair (down → the new level's
// up-stair, which is where sim_new_gen already drops the player; up → its
// down-stair).
// A level is a save point at depths 1, 1+SAVE_INTERVAL, … (the home/bed is depth 1).
fn is_save_depth(d: integer) -> integer {
  if (d % SAVE_INTERVAL ?? 0) == 1 { return 1; }
  0
}

pub fn sim_descend(s: Sim, dir: integer) -> Sim {
  nd = s.depth + dir;
  if nd < 0 { nd = 0; }   // depth 0 = the surface: climbing OUT is how rewards get claimed
  style = 0;
  if dir > 0 && sim_stair_under(s) == 6 { style = 1; }   // a NATURAL CAVE way
  ns = sim_new_gen_s(s.wseed, nd, s.boss_slain, style, s.win_x, s.win_y);  // carry quest progress so the way-out infestation fires
  // Per-level persistence: carry the delta store, record the level we're leaving (its dead
  // spawns), then replay the destination depth's stored deaths onto its fresh spawns. A
  // never-visited depth has an empty block, so this is a no-op and generation is unchanged.
  ns.dd_idx = s.dd_idx;
  ns.dd_n = s.dd_n;
  sim_store_dead(ns, s.depth, sim_dead_indices(s));
  sim_apply_stored_dead(ns, nd);
  ns.php = s.php;
  ns.phpmax = s.phpmax;
  ns.over = s.over;
  ns.player.clevel = s.player.clevel;   // carry the hero across levels
  ns.player.xp = s.player.xp;
  ns.player.gold = s.player.gold;
  ns.race = s.race;       // the chosen race + class travel with the character
  ns.pclass = s.pclass;
  ns.sp = s.sp;           // the mana pool persists across levels (like HP)
  ns.spmax = s.spmax;
  ns.rc_flags = s.rc_flags;     // the baked race+class cache travels too (apply_creation's output)
  ns.rc_melee = s.rc_melee;
  ns.rc_bow = s.rc_bow;
  ns.rc_stealth = s.rc_stealth;
  ns.rc_save = s.rc_save;
  ns.rc_hd = s.rc_hd;
  ns.rc_xpf = s.rc_xpf;
  ns.rc_realm = s.rc_realm;
  ns.rc_spi = s.rc_spi;
  ns.stat_max = s.stat_max;     // carry the stat block: innate + current + active temp mods
  ns.stat_cur = s.stat_cur;
  ns.stat_tmp = s.stat_tmp;
  ns.stat_tmp_t = s.stat_tmp_t;
  ns.stat_pts = s.stat_pts;             // carry banked stat points + their cooldowns across levels
  ns.stat_grown_at = s.stat_grown_at;
  ns.detect_t = s.detect_t;     // detection keeps ticking down across a level change
  ns.inv = s.inv;         // carry the inventory; floor items stay on their level
  ns.ninv = s.ninv;
  ns.eq = s.eq;           // carry equipment + its cached effects across levels
  ns.eq_dmg = s.eq_dmg;   // ⚠ and the DAMAGE those items carry (I-MEND): a stair is not a smith
  ns.inv_dmg = s.inv_dmg;
  ns.qs = s.qs;           // carry the quick-slot bindings across levels (like inventory)
  ns.wdam = s.wdam;
  ns.pac = s.pac;
  ns.rs1 = s.rs1;         // the combat-roll stream continues across the stairs
  ns.rs2 = s.rs2;
  ns.heading = s.heading;
  ns.save_depth = s.save_depth;                                          // carry the checkpoint
  ns.anc_kind = s.anc_kind;       // the spawn anchor rides along
  ns.anc_depth = s.anc_depth;
  ns.anc_wx = s.anc_wx;
  ns.anc_wy = s.anc_wy;
  ns.anc_q = s.anc_q;
  ns.anc_r = s.anc_r;
  ns.q_poster = s.q_poster;      // quest progress rides along
  ns.q_mage = s.q_mage;
  ns.stand = s.stand;            // …and so does what the settlements make of you (plan #17 `S7`)
  militia_repost(ns);            //    a picket already bought is re-derived, never re-earned
  if is_save_depth(nd) != 0 && nd > ns.save_depth {
    ns.save_depth = nd;                  // advance at save points: the stair claims the spawn
    ns.anc_kind = 1;
    ns.anc_depth = nd;
    ns.anc_wx = ns.win_x;
    ns.anc_wy = ns.win_y;
    ns.anc_q = ns.up_q;
    ns.anc_r = ns.up_r;
  }
  ns.grave_depth = s.grave_depth;   // carry the death-stake grave across levels
  ns.grave_q = s.grave_q;
  ns.grave_r = s.grave_r;
  ns.grave_gold = s.grave_gold;
  ns.boss_slain = s.boss_slain;     // carry quest progress (gates the infestation on the way out)
  ns.msg_q = s.msg_q;               // the message log is continuous across levels
  ns.msg_n = s.msg_n;
  ns.known = s.known;               // identifications + the per-game flavour map carry across levels
  ns.flavour_idx = s.flavour_idx;
  if dir > 0 { sim_log(ns, "You descend to depth {nd}."); }
  if dir < 0 { sim_log(ns, "You climb to depth {nd}."); }
  if dir < 0 && ns.dn_q >= 0 {   // surface windows without a gate keep the default start
    (ax, ay) = hex_to_px(ns.dn_q, ns.dn_r);
    ns.px = ax;
    ns.py = ay;
  }
  ns
}

// Respawn after death — NOT permadeath (§3a #5): rebuild the last save-point level and
// keep the character (level/XP/gold/items/equipment), full-healed. The dive is lost (the
// save-point level regenerates; the dungeon state explored since is discarded).
pub fn sim_respawn(s: Sim) -> Sim {
  rd = s.save_depth;            // legacy fallback: the save-point level's own start
  rwx = 0;
  rwy = 0;
  if s.anc_kind != 0 { rd = s.anc_depth; rwx = s.anc_wx; rwy = s.anc_wy; }
  rs = sim_new_gen_s(s.wseed, rd, s.boss_slain, 0, rwx, rwy);
  rs.player.clevel = s.player.clevel;
  rs.player.xp = s.player.xp;
  rs.race = s.race;             // race + class persist through death (identity)
  rs.pclass = s.pclass;
  rs.rc_flags = s.rc_flags;     // the baked race+class cache survives with them
  rs.rc_melee = s.rc_melee;
  rs.rc_bow = s.rc_bow;
  rs.rc_stealth = s.rc_stealth;
  rs.rc_save = s.rc_save;
  rs.rc_hd = s.rc_hd;
  rs.rc_xpf = s.rc_xpf;
  rs.rc_realm = s.rc_realm;
  rs.rc_spi = s.rc_spi;
  rs.stat_max = s.stat_max;     // keep innate stats + any permanent drain across death;
  rs.stat_cur = s.stat_cur;     // temporary modifiers reset (fresh from sim_new_gen) on respawn
  rs.stat_pts = s.stat_pts;             // banked stat points + cooldowns survive death (progression)
  rs.stat_grown_at = s.stat_grown_at;
  // Souls stake: leave GRAVE_PCT% of gold as a grave at the death spot. SP keeps one
  // grave, so a fresh death forfeits any prior one (MP would append — §3a #5).
  drop = s.player.gold * GRAVE_PCT / 100 ?? 0;
  rs.player.gold = s.player.gold - drop;
  (dq, dr) = px_to_hex(s.px, s.py);
  rs.grave_depth = s.depth;
  rs.grave_q = dq;
  rs.grave_r = dr;
  rs.grave_gold = drop;
  rs.inv = s.inv;
  rs.ninv = s.ninv;
  rs.eq = s.eq;
  rs.eq_dmg = s.eq_dmg;   // ⚠ death is a setback, not a repair shop (I-MEND)
  rs.inv_dmg = s.inv_dmg;
  rs.qs = s.qs;           // quick-slot bindings survive death (kept like inventory/equipment)
  rs.boss_slain = s.boss_slain;   // quest progress survives death (the brood stays loose)
  rs.msg_q = s.msg_q;             // the log persists through death
  rs.msg_n = s.msg_n;
  rs.known = s.known;             // what you've identified survives death (the mapping is per-game)
  rs.flavour_idx = s.flavour_idx;
  sim_log(rs, anchor_wake(s.anc_kind));
  rs.wdam = s.wdam;
  rs.pac = s.pac;
  rs.phpmax = s.phpmax;
  rs.php = s.phpmax;          // full heal on respawn
  rs.spmax = s.spmax;
  rs.sp = s.spmax;            // and a full mind
  rs.save_depth = s.save_depth;
  rs.anc_kind = s.anc_kind;       // the anchor itself survives death
  rs.anc_depth = s.anc_depth;
  rs.anc_wx = s.anc_wx;
  rs.anc_wy = s.anc_wy;
  rs.anc_q = s.anc_q;
  rs.anc_r = s.anc_r;
  rs.q_poster = s.q_poster;       // quests survive death
  rs.q_mage = s.q_mage;
  rs.stand = s.stand;             // ⚠ and so does standing: dying is not a betrayal, and a town
  militia_repost(rs);             //   that forgot you every time would make death a reset
  if s.anc_kind != 0 {
    (apx, apy) = hex_to_px(s.anc_q, s.anc_r);
    rs.px = apx;                  // wake ON the anchor, not at the level default
    rs.py = apy;
  }
  rs.over = false;
  rs
}

pub fn sim_depth(s: Sim) -> integer { s.depth }
// WHICH WINDOW holds a world point — the inverse of the anchoring in gen_level's depth-0
// arm, which offsets the home town by (wwx, wwy) whole window spans.
//
// ⚠ Exists because hard-coding a window offset bakes the home town's position into the
// caller. `questtest` used to jump to the wizard's tower with a literal `(-3, -2)`, correct
// only while the home window sat where it sat; re-anchoring the home town at the alpine
// settlement found no wizard and failed three quest rows for a reason that had nothing to
// do with quests. Ask the world where a thing is instead.
pub fn sim_window_of(x: float, y: float) -> (integer, integer) {
  ovw = overland_new();
  t0 = ovw.ov_towns[ov_home_town(ovw)];
  ax = 7500.0;
  ay = 5800.0;
  if t0 != null { ax = t0.ot_x; ay = t0.ot_y; }
  (spanx, _) = ov_hex_world(101 - 4, 0);
  (_, spany) = ov_hex_world(0, 101 - 4);
  wx = 0;
  wy = 0;
  if spanx != 0.0 { wx = round((x - ax) / spanx ?? 0.0) as integer; }
  if spany != 0.0 { wy = round((y - ay) / spany ?? 0.0) as integer; }
  (wx, wy)
}

// WHERE THE DESERT GATE STANDS, in world coordinates — the desert cell nearest the home
// town, which is what gen_level's depth-0 arm sinks the dungeon entrance into. Mirrors that
// selection exactly; if the two ever drift apart the gate rows in `traveltest` say so.
pub fn sim_desert_gate_world() -> (float, float) {
  ovw = overland_new();
  t0x = 7500.0;
  t0y = 5800.0;
  t9 = ovw.ov_towns[ov_home_town(ovw)];
  if t9 != null { t0x = t9.ot_x; t0y = t9.ot_y; }
  bdd = 1.0e18;
  bdx = 0.0;
  bdy = 0.0;
  for dgr in 0..7 {
    for dgc in 0..9 {
      if ov_cell_mat(ovw, dgc, dgr) == 6 {
        (ccx, ccy) = ov_cell_center(dgc, dgr);
        dd = (ccx - t0x) * (ccx - t0x) + (ccy - t0y) * (ccy - t0y);
        if dd < bdd { bdd = dd; bdx = ccx; bdy = ccy; }
      }
    }
  }
  (bdx, bdy)
}

// The RUINS in world coordinates — the ruin nests (and their trait-tagged bosses) stand at
// these. Same reason as the tower above: a caller should ask where the ruins are, not encode
// which window one happened to fall in.
pub fn sim_ruin_count() -> integer {
  ovw = overland_new();
  len(ovw.ov_ruins)
}

pub fn sim_ruin_pos(i: integer) -> (float, float) {
  ovw = overland_new();
  if i >= 0 && i < len(ovw.ov_ruins) {
    ru = ovw.ov_ruins[i];
    if ru != null { return (ru.ru_x, ru.ru_y); }
  }
  (0.0, 0.0)
}

// The LIVING wizard's tower in world coordinates (wz_dead == 0), (0,0) if there is none.
pub fn sim_wizard_tower() -> (float, float) {
  ovw = overland_new();
  for wi in 0..len(ovw.ov_wiz) {
    wz = ovw.ov_wiz[wi];
    if wz != null && wz.wz_dead == 0 { return (wz.wz_x, wz.wz_y); }
  }
  (0.0, 0.0)
}

pub fn sim_npc_count(s: Sim) -> integer {
  n = 0;
  for ni in 0..len(s.enemies) {
    e = s.enemies[ni];
    if e.alive && e.role != 0 && e.role != 12 { n = n + 1; }
  }
  n
}
pub fn sim_npc_role(s: Sim, i: integer) -> integer {
  e = s.enemies[i] ?? s.enemies[0];
  if e != null { e.role } else { 0 }
}
pub fn sim_save_depth(s: Sim) -> integer { s.save_depth }   // checkpoint depth (respawn target)
pub fn sim_grave_gold(s: Sim) -> integer { s.grave_gold }   // gold staked on the grave (0 = none)
pub fn sim_grave_depth(s: Sim) -> integer { s.grave_depth } // depth the grave is on
pub fn sim_grave_q(s: Sim) -> integer { s.grave_q }         // grave hex (for the view marker)
pub fn sim_grave_r(s: Sim) -> integer { s.grave_r }

// Tile under the player: 2 = down-stair, 3 = up-stair, else floor/wall.
pub fn sim_stair_under(s: Sim) -> integer {
  (pq, pr) = px_to_hex(s.px, s.py);
  t = tile_at(s, pq, pr);
  t
}
// (sim_player_hex — the player's current hex, used by the walk-onto-stairs
//  edge-trigger — already defined above near the enemy/FOV accessors.)

pub fn sim_down_hex(s: Sim) -> (integer, integer) { (s.dn_q, s.dn_r) }
pub fn sim_up_hex(s: Sim) -> (integer, integer) { (s.up_q, s.up_r) }

// THE TRAIT SEAM's honesty check: every wild creature on the surface that
// DECLARES a habitat is standing on terrain it claims (either tier). Civilians,
// nests/roosts (tag-placed) and the crystal pass through. 1 = all good.
pub fn sim_wilds_ok(s: Sim) -> integer {
  tbl = game_monsters();
  for ei in 0..len(s.enemies) {
    e = s.enemies[ei];
    dfar = 0;
    if e != null { dfar = hex_distance(e.cur_q, e.cur_r, s.lw / 2, s.lh / 2); }
    if e != null && e.alive && e.role == 0 && dfar >= 25 {
      md = mon_find(tbl, e.key);
      hb = md.m_habitat ?? 0;
      if hb != 0 {
        tkk = sim_tile_kind(s, e.cur_q, e.cur_r);
        if tkk >= 0 {
          bits = (1 << tkk) | ((1 << tkk) * HB_T2);
          if (hb & bits) == 0 { return 0; }
        }
      }
    }
  }
  1
}

// ── MULTI-WINDOW TRAVEL: the wilderness continues past the window's edge ──────
pub fn sim_window(s: Sim) -> (integer, integer) { (s.win_x, s.win_y) }

// On the surface, standing in the outermost ring arms a window crossing:
// 1 = east, 2 = west, 3 = south, 4 = north (0 = not at an edge).
pub fn sim_edge_exit(s: Sim) -> integer {
  if s.depth != 0 { return 0; }
  (pq, pr) = px_to_hex(s.px, s.py);
  if pq >= s.lw - 2 { return 1; }
  if pq <= 1 { return 2; }
  if pr >= s.lh - 2 { return 3; }
  if pr <= 1 { return 4; }
  0
}

// Walking off the window's edge crosses into the NEIGHBOURING stretch of the
// same wilderness (the next 1.5 km window, deterministic from (wseed, window)).
// The hero carries over exactly like a stair change; the arrival is the nearest
// open dry ground just inside the opposite edge. Window state is not stored —
// a revisited window regenerates fresh (its wilds respawn; the town window's
// life regenerates identically by construction).
pub fn sim_travel(s: Sim) -> Sim {
  ed = sim_edge_exit(s);
  nwx = s.win_x;
  nwy = s.win_y;
  if ed == 1 { nwx += 1; }
  if ed == 2 { nwx -= 1; }
  if ed == 3 { nwy += 1; }
  if ed == 4 { nwy -= 1; }
  ns = sim_new_gen_s(s.wseed, 0, s.boss_slain, 0, nwx, nwy);
  // the hero crosses over — the same carry list as sim_descend (kept inline on
  // BOTH sides: a shared helper would pass the big Sim by value per call, the
  // exact store-pressure shape the kernel bans)
  ns.php = s.php;
  ns.phpmax = s.phpmax;
  ns.over = s.over;
  ns.player.clevel = s.player.clevel;   // carry the hero across levels
  ns.player.xp = s.player.xp;
  ns.player.gold = s.player.gold;
  ns.race = s.race;       // the chosen race + class travel with the character
  ns.pclass = s.pclass;
  ns.sp = s.sp;           // the mana pool persists across levels (like HP)
  ns.spmax = s.spmax;
  ns.rc_flags = s.rc_flags;     // the baked race+class cache travels too (apply_creation's output)
  ns.rc_melee = s.rc_melee;
  ns.rc_bow = s.rc_bow;
  ns.rc_stealth = s.rc_stealth;
  ns.rc_save = s.rc_save;
  ns.rc_hd = s.rc_hd;
  ns.rc_xpf = s.rc_xpf;
  ns.rc_realm = s.rc_realm;
  ns.rc_spi = s.rc_spi;
  ns.stat_max = s.stat_max;     // carry the stat block: innate + current + active temp mods
  ns.stat_cur = s.stat_cur;
  ns.stat_tmp = s.stat_tmp;
  ns.stat_tmp_t = s.stat_tmp_t;
  ns.stat_pts = s.stat_pts;             // carry banked stat points + their cooldowns across levels
  ns.stat_grown_at = s.stat_grown_at;
  ns.detect_t = s.detect_t;     // detection keeps ticking down across a level change
  ns.inv = s.inv;         // carry the inventory; floor items stay on their level
  ns.ninv = s.ninv;
  ns.eq = s.eq;           // carry equipment + its cached effects across levels
  ns.eq_dmg = s.eq_dmg;   // ⚠ and the DAMAGE those items carry (I-MEND): a stair is not a smith
  ns.inv_dmg = s.inv_dmg;
  ns.qs = s.qs;           // carry the quick-slot bindings across levels (like inventory)
  ns.wdam = s.wdam;
  ns.pac = s.pac;
  ns.rs1 = s.rs1;         // the combat-roll stream continues across the stairs
  ns.rs2 = s.rs2;
  ns.heading = s.heading;
  ns.save_depth = s.save_depth;                                          // carry the checkpoint
  ns.anc_kind = s.anc_kind;       // the spawn anchor rides along
  ns.anc_depth = s.anc_depth;
  ns.anc_wx = s.anc_wx;
  ns.anc_wy = s.anc_wy;
  ns.anc_q = s.anc_q;
  ns.anc_r = s.anc_r;
  ns.q_poster = s.q_poster;      // quest progress rides along
  ns.q_mage = s.q_mage;
  ns.stand = s.stand;            // standing is per SETTLEMENT and the map carries every one of
  militia_repost(ns);            //   them, so crossing a window changes which one is read
  ns.grave_depth = s.grave_depth;   // carry the death-stake grave across levels
  ns.grave_q = s.grave_q;
  ns.grave_r = s.grave_r;
  ns.grave_gold = s.grave_gold;
  ns.boss_slain = s.boss_slain;     // carry quest progress (gates the infestation on the way out)
  ns.msg_q = s.msg_q;               // the message log is continuous across levels
  ns.msg_n = s.msg_n;
  ns.known = s.known;               // identifications + the per-game flavour map carry across levels
  ns.flavour_idx = s.flavour_idx;
  (pq, pr) = px_to_hex(s.px, s.py);
  aq = pq;
  ar = pr;
  if ed == 1 { aq = 3; }
  if ed == 2 { aq = ns.lw - 4; }
  if ed == 3 { ar = 3; }
  if ed == 4 { ar = ns.lh - 4; }
  bopen = 9999;
  fq = aq;
  fr = ar;
  for rr in 1..ns.lh - 1 {
    for qq in 1..ns.lw - 1 {
      if tile_at(ns, qq, rr) == 0 && !water_blocked(ns, qq, rr) {
        dd = hex_distance(qq, rr, aq, ar);
        if dd < bopen { bopen = dd; fq = qq; fr = rr; }
      }
    }
  }
  (npx, npy) = hex_to_px(fq, fr);
  ns.px = npx;
  ns.py = npy;
  if ed != 0 { sim_log(ns, "You cross into the next stretch of wilderness."); }
  ns
}
