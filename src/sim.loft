// sim — the renderer-agnostic roguelike kernel (M0).
//
// Continuous player (position + heading) over a hex tile grid; hex-locked
// enemies; a distance-driven clock: every HEX_LEN of player travel = one tick,
// turning costs no distance and therefore no time.  NO graphics dependency.

use hexgeo;
use gen;
use monsters;

MOVE_SPEED = 6.0;     // world units / second (brisk, Angband-paced; clock is distance)
TURN_SPEED = 2.6;     // radians / second
PLAYER_RADIUS = 0.45; // collision radius; ~half the marker, < hex apothem (0.866)
PLAYER_DAM = 6;       // player melee damage per hit (placeholder)
FLOW_BIG   = 1000000; // unreachable / unset distance in the flow field
HERO_CON   = 16;      // starting Constitution (drives HP growth; full stat block = H2)
MAX_CLEVEL = 50;      // character-level cap

pub struct Enemy {
  cur_q: integer not null,
  cur_r: integer not null,
  tgt_q: integer not null,
  tgt_r: integer not null,
  hp:    integer not null,
  maxhp: integer not null,
  dam:   integer not null,
  xp:     integer not null,   // experience awarded on death (m_xp)
  mlvl:   integer not null,   // native level (m_depth) — scales the kill XP
  vision: integer not null,   // aggro / detection range in hexes (from the DB)
  flags:  integer not null,   // MF_* bitmask (from the DB)
  awake:  boolean not null,   // false = asleep: won't act until it perceives you
  cr:    integer not null,    // display colour 0..255 (from the monster DB)
  cg:    integer not null,
  cb:    integer not null,
  glyph: text,                // single-char map symbol (e.g. "r", "k", "o")
  alive: boolean not null,
}

pub struct Sim {
  lw:      integer not null,
  lh:      integer not null,
  qmin:    integer not null,
  rmin:    integer not null,
  tiles:   vector<integer> not null,   // hex kind: 0 floor, 1 solid full-hex wall
  walls:   vector<integer> not null,   // edge walls: idx = hex*3 + edge(0=N,1=NE,2=SE)
  px:      float not null,
  py:      float not null,
  heading: float not null,             // radians; forward = (cos,sin)
  accrued: float not null,             // remainder distance in [0, HEX_LEN)
  ticks:   integer not null,
  enemies: vector<Enemy> not null,
  php:     integer not null,   // player hit points
  phpmax:  integer not null,
  over:    boolean not null,   // game over (player died)
  clevel:  integer not null,   // character level (1..MAX_CLEVEL)
  xp:      integer not null,   // experience points
  gold:    integer not null,   // gold (income arrives with items, I1)
  hcon:    integer not null,   // Constitution — drives HP growth
  depth:   integer not null,   // dungeon level (1 = shallowest)
  wseed:   integer not null,   // world seed (per-level gen seed = mix(wseed, depth))
  up_q:    integer not null,   // up-stair hex (player start / arrival from below)
  up_r:    integer not null,
  dn_q:    integer not null,   // down-stair hex
  dn_r:    integer not null,
}

// ── World queries ────────────────────────────────────────────────────

pub fn tile_at(s: Sim, q: integer, r: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 1;
  }
  tiles = s.tiles;
  ti = (r - s.rmin) * s.lw + (q - s.qmin);
  if ti < len(tiles) { tiles[ti] } else { 1 }
}

pub fn is_wall(s: Sim, q: integer, r: integer) -> boolean {
  tile_at(s, q, r) == 1
}

// Read a stored canonical edge wall directly (edge 0=N,1=NE,2=SE on this hex).
pub fn edge_wall_raw(s: Sim, q: integer, r: integer, edge: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 0;
  }
  ws = s.walls;
  ei = ((r - s.rmin) * s.lw + (q - s.qmin)) * 3 + edge;
  if ei < len(ws) { ws[ei] } else { 0 }
}

// Wall value on the edge leaving (q,r) in direction `dir` (resolves the
// canonical owner: dirs 3,4,5 read the neighbour's edge).
pub fn edge_wall(s: Sim, q: integer, r: integer, dir: integer) -> integer {
  (oq, owr, oe) = canon_edge(q, r, dir);
  edge_wall_raw(s, oq, owr, oe)
}

// Is a single-hex step from (q1,r1) to (q2,r2) blocked? Blocked if the
// target is a solid full-hex wall (or out of bounds), or an edge wall sits
// on the shared edge.
pub fn is_blocked_move(s: Sim, q1: integer, r1: integer, q2: integer, r2: integer) -> boolean {
  if is_wall(s, q2, r2) { return true; }
  bd = neighbor_dir(q1, r1, q2, r2);
  if bd < 0 { return false; }
  edge_wall(s, q1, r1, bd) != 0
}

// Can the player's centre at (fromx,fromy) advance so its probe point lands at
// (tox,toy)?  Returns true if that probe enters a solid hex, an enemy hex, or
// crosses a walled edge.  Used per-axis with the probe offset one radius ahead.
fn pos_blocked(s: Sim, fromx: float, fromy: float, tox: float, toy: float) -> boolean {
  (aq, ar) = px_to_hex(fromx, fromy);
  (bq, br) = px_to_hex(tox, toy);
  if enemy_blocks(s, bq, br) { return true; }
  if aq == bq && ar == br { return is_wall(s, bq, br); }
  is_blocked_move(s, aq, ar, bq, br)
}

fn enemy_blocks(s: Sim, q: integer, r: integer) -> boolean {
  enemies = s.enemies;
  hit = false;
  for eb in 0..len(enemies) {
    e = enemies[eb];
    if e.alive && ((e.cur_q == q && e.cur_r == r) || (e.tgt_q == q && e.tgt_r == r)) {
      hit = true;
    }
  }
  hit
}

// Breadth-first distance field from (pq,pr) over reachable hexes (respecting
// solid hexes AND edge walls via is_blocked_move). flow[idx] = path length to
// the player; FLOW_BIG = unreachable. Recomputed each tick; monsters descend it
// to route around walls (vs. the old greedy step that stuck on corners).
fn compute_flow(s: Sim, pq: integer, pr: integer) -> vector<integer> {
  n = s.lw * s.lh;
  flow: vector<integer> = [];
  for _ in 0..n { flow += [FLOW_BIG]; }
  if pq >= s.qmin && pr >= s.rmin && pq < s.qmin + s.lw && pr < s.rmin + s.lh && !is_wall(s, pq, pr) {
    start = (pr - s.rmin) * s.lw + (pq - s.qmin);
    if start >= 0 && start < len(flow) { flow[start] = 0; }
    frontier: vector<integer> = [];
    frontier += [start];
    head = 0;
    while head < len(frontier) {
      cur = frontier[head] ?? 0;
      head += 1;
      cq = s.qmin + (cur % s.lw ?? 0);
      cr = s.rmin + (cur / s.lw ?? 0);
      cd = flow[cur] ?? FLOW_BIG;
      for fdir in 0..6 {
        (nq, nr) = hex_neighbor(cq, cr, fdir);
        if nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh && !is_blocked_move(s, cq, cr, nq, nr) {
          nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
          if nidx >= 0 && nidx < len(flow) {
            cn = flow[nidx] ?? FLOW_BIG;
            if cn > cd + 1 {
              flow[nidx] = cd + 1;
              frontier += [nidx];
            }
          }
        }
      }
    }
  }
  flow
}

// One step DOWN the flow gradient toward the player (routes around walls);
// never steps onto the player's own hex. Stays put if nothing is closer.
fn flow_step(s: Sim, flow: vector<integer>, eq: integer, er: integer, pq: integer, pr: integer) -> (integer, integer) {
  bq = eq;
  br = er;
  bestd = FLOW_BIG;
  if eq >= s.qmin && er >= s.rmin && eq < s.qmin + s.lw && er < s.rmin + s.lh {
    ci = (er - s.rmin) * s.lw + (eq - s.qmin);
    bestd = flow[ci] ?? FLOW_BIG;
  }
  for sdir in 0..6 {
    (nq, nr) = hex_neighbor(eq, er, sdir);
    if !is_blocked_move(s, eq, er, nq, nr) && !(nq == pq && nr == pr) && nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh {
      nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
      nd = flow[nidx] ?? FLOW_BIG;
      if nd < bestd { bestd = nd; bq = nq; br = nr; }
    }
  }
  (bq, br)
}

// ── Combat ───────────────────────────────────────────────────────────

// Nearest live enemy that is close (adjacent-ish) and ahead of the heading —
// the melee target when pressing forward into it. Returns its index, or -1.
fn front_enemy(s: Sim) -> integer {
  fx = cos(s.heading);
  fy = sin(s.heading);
  reach = HEX_LEN * 1.3;
  best = -1;
  bestd = reach * reach;
  enemies = s.enemies;
  for fe in 0..len(enemies) {
    e = enemies[fe];
    if e.alive {
      (ecx, ecy) = hex_to_px(e.cur_q, e.cur_r);
      rx = ecx - s.px;
      ry = ecy - s.py;
      d2 = rx * rx + ry * ry;
      dot = rx * fx + ry * fy;
      if dot > 0.0 && d2 <= bestd { bestd = d2; best = fe; }
    }
  }
  best
}

// ── Hero progression (XP / level / HP) ───────────────────────────────

fn con_bonus(con: integer) -> integer { (con - 10) / 2 ?? 0 }

// Max HP at a character level (deterministic; per-class hit dice arrive in H2).
fn hero_maxhp(clevel: integer, con: integer) -> integer {
  20 + clevel * (6 + con_bonus(con))
}

// Total XP required to be AT a character level (quadratic growth).
fn xp_for_level(lvl: integer) -> integer {
  if lvl <= 1 { return 0; }
  (lvl - 1) * (lvl - 1) * 10
}

// Award XP and level up while the threshold is met; each level grows max HP and
// heals the gained amount.
pub fn sim_award_xp(s: &Sim, amount: integer) {
  if amount > 0 { s.xp += amount; }
  while s.clevel < MAX_CLEVEL && s.xp >= xp_for_level(s.clevel + 1) {
    s.clevel += 1;
    oldmax = s.phpmax;
    newmax = hero_maxhp(s.clevel, s.hcon);
    s.phpmax = newmax;
    s.php += newmax - oldmax;
  }
}

// Player hits enemy `idx` for PLAYER_DAM; on a kill, awards level-scaled XP.
fn player_attack(s: &Sim, idx: integer) {
  enemies = s.enemies;
  if idx >= 0 && idx < len(enemies) {
    e = enemies[idx];
    if e.alive {
      e.hp -= PLAYER_DAM;
      gain = 0;
      if e.hp <= 0 {
        e.alive = false;
        gain = e.xp * e.mlvl / s.clevel ?? 0;
        if gain < 1 { gain = 1; }
      }
      enemies[idx] = e;
      if gain > 0 { sim_award_xp(s, gain); }
    }
  }
}

// ── Clock & step ─────────────────────────────────────────────────────

// One world tick: each live enemy commits its move; if adjacent to the player
// it attacks (instead of moving), else it steps toward the player.
// Round to nearest integer (as float), correct for negatives — for cube lerp.
// (`as integer` truncates toward zero, so bias by ±0.5 before truncating.)
fn rnd_f(v: float) -> float {
  base = v + 0.5;
  if v < 0.0 { base = v - 0.5; }
  i = base as integer;
  i as float
}

// Hex line-of-sight: true if no solid hex blocks the line between the two hex
// centres (endpoints excluded). Cube-coordinate interpolation + rounding.
pub fn hex_los(s: Sim, q0: integer, r0: integer, q1: integer, r1: integer) -> boolean {
  n = hex_distance(q0, r0, q1, r1);
  blocked = false;
  if n > 1 {
    x0 = q0;
    z0 = r0;
    y0 = 0 - q0 - r0;
    x1 = q1;
    z1 = r1;
    y1 = 0 - q1 - r1;
    for li in 1..n {
      t = li as float / n as float ?? 0.0;
      fx = x0 as float + (x1 - x0) as float * t;
      fy = y0 as float + (y1 - y0) as float * t;
      fz = z0 as float + (z1 - z0) as float * t;
      rx = rnd_f(fx);
      ry = rnd_f(fy);
      rz = rnd_f(fz);
      dx = abs(rx - fx);
      dy = abs(ry - fy);
      dz = abs(rz - fz);
      if dx > dy && dx > dz {
        rx = 0.0 - ry - rz;
      } else if dy > dz {
        ry = 0.0 - rx - rz;
      } else {
        rz = 0.0 - rx - ry;
      }
      if is_wall(s, rx as integer, rz as integer) { blocked = true; }
    }
  }
  !blocked
}

pub fn sim_tick(s: &Sim) {
  s.ticks += 1;
  (pq, pr) = px_to_hex(s.px, s.py);
  flow = compute_flow(s, pq, pr);   // shared by every chasing monster this tick
  enemies = s.enemies;
  for et in 0..len(enemies) {
    e = enemies[et];
    if e.alive {
      e.cur_q = e.tgt_q;
      e.cur_r = e.tgt_r;
      d = hex_distance(e.cur_q, e.cur_r, pq, pr);
      // Awareness: a sleeping monster wakes when the player is within its
      // vision and in line of sight; once awake it stays awake.
      if !e.awake && d <= e.vision && hex_los(s, e.cur_q, e.cur_r, pq, pr) {
        e.awake = true;
      }
      if e.awake {
        if d <= 1 {
          s.php -= e.dam;            // adjacent: strike instead of moving
          e.tgt_q = e.cur_q;
          e.tgt_r = e.cur_r;
          if s.php <= 0 { s.over = true; }
        } else if (e.flags & MF_NEVER_MOVE) != 0 {
          e.tgt_q = e.cur_q;         // stationary (molds, eyes): never steps
          e.tgt_r = e.cur_r;
        } else {
          (bq, br) = flow_step(s, flow, e.cur_q, e.cur_r, pq, pr);
          e.tgt_q = bq;
          e.tgt_r = br;
        }
      } else {
        e.tgt_q = e.cur_q;           // asleep: holds position
        e.tgt_r = e.cur_r;
      }
      enemies[et] = e;
    }
  }
}

// Advance one frame.  fwd in {-1,0,1}, turn in {-1,0,1}, dt seconds.
pub fn sim_step(s: &Sim, fwd: integer, turn: integer, dt: float) {
  if s.over { return; }
  if turn != 0 {
    s.heading += (turn as float) * TURN_SPEED * dt;
  }
  if fwd != 0 {
    step = (fwd as float) * MOVE_SPEED * dt;
    dx = cos(s.heading) * step;
    dy = sin(s.heading) * step;
    moved_x = 0.0;
    moved_y = 0.0;
    // Axis-separated so the player slides along walls; probe one radius ahead
    // in the direction of travel so the centre halts short of the wall face.
    if dx != 0.0 {
      sxr = if dx > 0.0 { PLAYER_RADIUS } else { 0.0 - PLAYER_RADIUS };
      if !pos_blocked(s, s.px, s.py, s.px + dx + sxr, s.py) {
        s.px += dx;
        moved_x = dx;
      }
    }
    if dy != 0.0 {
      syr = if dy > 0.0 { PLAYER_RADIUS } else { 0.0 - PLAYER_RADIUS };
      if !pos_blocked(s, s.px, s.py, s.px, s.py + dy + syr) {
        s.py += dy;
        moved_y = dy;
      }
    }
    dist = sqrt(moved_x * moved_x + moved_y * moved_y);
    // Pressing forward into an enemy = melee: advance the clock at walking pace
    // even though the player can't move, landing a hit each tick.
    fe = if fwd > 0 { front_enemy(s) } else { -1 };
    sd = abs(step);
    if fe >= 0 && dist < sd { dist = sd; }
    s.accrued += dist;
    while s.accrued >= HEX_LEN {
      s.accrued -= HEX_LEN;
      if fe >= 0 { player_attack(s, fe); }
      sim_tick(s);
    }
  }
}

// ── Read-only accessors for the view / tests ────────────────────────

pub fn sim_frac(s: Sim) -> float { s.accrued / HEX_LEN }

pub fn sim_player_hex(s: Sim) -> (integer, integer) { px_to_hex(s.px, s.py) }

pub fn sim_enemy_count(s: Sim) -> integer { len(s.enemies) }

pub fn sim_enemy_alive(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  alive = false;
  if i < len(enemies) {
    e = enemies[i];
    alive = e.alive;
  }
  alive
}

pub fn sim_enemy_cur(s: Sim, i: integer) -> (integer, integer) {
  enemies = s.enemies;
  rq = 0;
  rr = 0;
  if i < len(enemies) {
    e = enemies[i];
    rq = e.cur_q;
    rr = e.cur_r;
  }
  (rq, rr)
}

// Smoothly-interpolated enemy world position (cur -> tgt by clock fraction).
pub fn sim_enemy_pos(s: Sim, i: integer) -> (float, float) {
  enemies = s.enemies;
  ex = 0.0;
  ey = 0.0;
  if i < len(enemies) {
    e = enemies[i];
    (acx, acy) = hex_to_px(e.cur_q, e.cur_r);
    (atx, aty) = hex_to_px(e.tgt_q, e.tgt_r);
    f = s.accrued / HEX_LEN;
    ex = acx + (atx - acx) * f;
    ey = acy + (aty - acy) * f;
  }
  (ex, ey)
}

pub fn sim_player_hp(s: Sim) -> integer { s.php }
pub fn sim_player_hp_max(s: Sim) -> integer { s.phpmax }
pub fn sim_over(s: Sim) -> boolean { s.over }

pub fn sim_clevel(s: Sim) -> integer { s.clevel }
pub fn sim_xp(s: Sim) -> integer { s.xp }
pub fn sim_gold(s: Sim) -> integer { s.gold }

// Fraction from the current level toward the next (0..1) — for the XP bar.
pub fn sim_xp_frac(s: Sim) -> float {
  lo = xp_for_level(s.clevel);
  hi = xp_for_level(s.clevel + 1);
  f = 0.0;
  if hi > lo {
    f = (s.xp - lo) as float / (hi - lo) as float ?? 0.0;
  }
  if f < 0.0 { f = 0.0; }
  if f > 1.0 { f = 1.0; }
  f
}

pub fn sim_enemy_hp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 0;
  if i < len(enemies) { e = enemies[i]; v = e.hp; }
  v
}

pub fn sim_enemy_maxhp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 1;
  if i < len(enemies) { e = enemies[i]; v = e.maxhp; }
  v
}

// Enemy display colour (0..255), from its monster-DB definition.
pub fn sim_enemy_color(s: Sim, i: integer) -> (integer, integer, integer) {
  enemies = s.enemies;
  ecr = 200;
  ecg = 60;
  ecb = 50;
  if i < len(enemies) { e = enemies[i]; ecr = e.cr; ecg = e.cg; ecb = e.cb; }
  (ecr, ecg, ecb)
}

// Is enemy i awake (has it perceived the player)?
pub fn sim_enemy_awake(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  a = false;
  if i < len(enemies) { e = enemies[i]; a = e.awake; }
  a
}

// Enemy single-char map glyph (e.g. "r", "k", "o").
pub fn sim_enemy_glyph(s: Sim, i: integer) -> text {
  enemies = s.enemies;
  g = "r";
  if i < len(enemies) { e = enemies[i]; g = e.glyph ?? "r"; }
  g
}

// ── Construction ─────────────────────────────────────────────────────

pub fn sim_new() -> Sim {
  w = 21;
  h = 21;
  tiles: vector<integer> = [];
  for gr in 0..h {
    for gq in 0..w {
      edge = gq == 0 || gr == 0 || gq == w - 1 || gr == h - 1;
      tiles += [if edge { 1 } else { 0 }];
    }
  }
  // a couple of deterministic interior walls for visual reference
  for wr in 5..13 {
    wi = wr * w + 7;
    if wi < len(tiles) { tiles[wi] = 1; }
  }
  for wq in 9..16 {
    wj = 9 * w + wq;
    if wj < len(tiles) { tiles[wj] = 1; }
  }

  // Demo: a stepped diagonal line of solid hexes (SW corner) — its silhouette
  // should straighten into a clean diagonal wall, showing the wobble-averaging
  // produce an intermediate (non-edge) direction. Off the self-test paths.
  ds_q = [3, 4, 4, 5, 5, 6];
  ds_r = [3, 3, 4, 4, 5, 5];
  for di in 0..len(ds_q) {
    dq = ds_q[di] ?? 0;
    dr = ds_r[di] ?? 0;
    didx = dr * w + dq;
    if didx < len(tiles) { tiles[didx] = 1; }
  }

  // Edge walls: a 3-edge wall stub on hex (12,7), a low barrier you can bump
  // into — demonstrates edge walls alongside the full-hex walls above.
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  ewi = (7 * w + 12) * 3;
  for ee in 0..3 {
    eidx = ewi + ee;
    if eidx < len(walls) { walls[eidx] = 1; }
  }

  (spx, spy) = hex_to_px(10, 10);
  e0 = Enemy { cur_q: 10, cur_r: 16, tgt_q: 10, tgt_r: 16, hp: 8, maxhp: 8, dam: 3,
    xp: 2, mlvl: 1, vision: 8, flags: 0, awake: true,
    cr: 200, cg: 60, cb: 50, glyph: "r", alive: true };
  enemies: vector<Enemy> = [e0];

  Sim {
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1, HERO_CON), phpmax: hero_maxhp(1, HERO_CON), over: false,
    clevel: 1, xp: 0, gold: 0, hcon: HERO_CON,
    depth: 1, wseed: 0, up_q: 10, up_r: 10, dn_q: 10, dn_r: 16,
  }
}

// ── Monster placement (Angband get_mon_num) ──────────────────────────

// Self-contained LCG (gen's RNG lives in another module; `&` mutation only
// propagates within a module, so placement keeps its own in `sim`).
struct SimRng { rs: integer not null }

fn srng_seed(seed: integer) -> SimRng { SimRng { rs: (seed & 2147483647) | 1 } }

fn srng(r: &SimRng, lo: integer, hi: integer) -> integer {
  if hi <= lo { return lo; }
  n = (r.rs * 1103515245 + 12345) & 2147483647;
  r.rs = n;
  span = hi - lo + 1;
  lo + (n % span ?? 0)
}

// Monster selection (get_mon_num) lives in monsters.loft as mon_choose —
// iterating the MonsterDef table with a struct fallback SIGSEGVs the interpreter
// from this module, but is fine inside monsters.loft where the type is defined.

// Build a live (asleep) Enemy from a MonsterDef at a hex. (The glyph is guarded
// to "?" — a struct-copy through the selection chain can drop the text field.)
fn mk_enemy(md: MonsterDef, q: integer, r: integer) -> Enemy {
  g = md.m_glyph;
  if len(g) == 0 { g = "?"; }
  Enemy { cur_q: q, cur_r: r, tgt_q: q, tgt_r: r,
    hp: md.m_hp, maxhp: md.m_hp, dam: md.m_dam,
    xp: md.m_xp, mlvl: md.m_depth,
    vision: md.m_vision, flags: md.m_flags, awake: false,
    cr: md.m_cr, cg: md.m_cg, cb: md.m_cb, glyph: g, alive: true }
}

// Is any already-placed enemy on this hex?
fn occupied_hex(enemies: vector<Enemy>, q: integer, r: integer) -> boolean {
  found = false;
  for oi in 0..len(enemies) {
    e = enemies[oi];
    if e.cur_q == q && e.cur_r == r { found = true; }
  }
  found
}

// Is (q,r) solid rock or off-map in this tile array?
fn tile_solid(tiles: vector<integer>, w: integer, h: integer, q: integer, r: integer) -> boolean {
  if q < 0 || r < 0 || q >= w || r >= h { return true; }
  ti = r * w + q;
  solid = true;
  if ti < len(tiles) { solid = (tiles[ti] ?? 1) == 1; }
  solid
}

// Procedural dungeon: rooms + corridors from gen_dungeon (world-keyed seed),
// the player placed in room 0; monsters scattered onto legal floor by the
// Angband placement pass (budget → get_mon_num → start-safe spot → groups).
// Renderer-agnostic — no graphics here.
pub fn sim_new_gen(seed: integer, depth: integer) -> Sim {
  w = 41;
  h = 41;
  // Per-level gen seed = mix(world seed, depth) so each depth has its own layout.
  gseed = (seed ^ world_key_seed(1, 1, depth)) & 2147483647;
  lvl = gen_dungeon(gseed, w, h, 14);
  tiles = lvl.g_tiles;
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  rqs = lvl.g_rq;
  rrs = lvl.g_rr;
  nrm = len(rqs);

  // Player in the first room.
  pq = w / 2;
  pr = h / 2;
  if nrm > 0 {
    pq = rqs[0] ?? (w / 2);
    pr = rrs[0] ?? (h / 2);
  }
  (spx, spy) = hex_to_px(pq, pr);

  // Collect legal floor far from the player start, then sample the budget from
  // it directly (robust even when open floor is a small fraction of the map).
  table = monster_table();
  rng = srng_seed((gseed ^ 20771) & 2147483647);
  safe = 8;                             // keep spawns this far from the start
  candq: vector<integer> = [];
  candr: vector<integer> = [];
  for ccr in 1..(h - 1) {
    for ccq in 1..(w - 1) {
      if !tile_solid(tiles, w, h, ccq, ccr) && hex_distance(ccq, ccr, pq, pr) >= safe {
        candq += [ccq];
        candr += [ccr];
      }
    }
  }
  ncand = len(candq);
  budget = 10 + srng(rng, 0, 8);   // ~10–18
  if budget > ncand { budget = ncand; }
  enemies: vector<Enemy> = [];
  placed = 0;
  guard = 0;
  // Dedup is handled by occupied_hex (re-picking a taken cell just retries) —
  // a `used` marker vector built by comprehension read back null here.
  while placed < budget && guard < ncand * 4 + 100 {
    guard += 1;
    if ncand > 0 {
      k = srng(rng, 0, ncand - 1);
      sq = candq[k] ?? 1;
      sr = candr[k] ?? 1;
      if !occupied_hex(enemies, sq, sr) {
        eff = depth;
        if srng(rng, 0, 24) == 0 { eff = depth + srng(rng, 1, 4); }   // out-of-depth
        md = mon_choose(table, eff, srng(rng, 0, 2000000000));
        if md.m_hp > 0 {
          enemies += [mk_enemy(md, sq, sr)];
          placed += 1;
          if (md.m_flags & MF_GROUP) != 0 {
            gsz = srng(rng, 2, 4);
            for gk in 0..gsz {
              if placed < budget {
                (gq, gr) = hex_neighbor(sq, sr, gk % 6 ?? 0);
                if !tile_solid(tiles, w, h, gq, gr) && hex_distance(gq, gr, pq, pr) >= safe && !occupied_hex(enemies, gq, gr) {
                  enemies += [mk_enemy(md, gq, gr)];
                  placed += 1;
                }
              }
            }
          }
        }
      }
    }
  }

  // Stairs: up at the player start, down at the farthest reachable floor hex.
  dnq = pq;
  dnr = pr;
  bestdd = -1;
  for si in 0..ncand {
    if si < ncand {
      cq = candq[si] ?? pq;
      cr = candr[si] ?? pr;
      dd = hex_distance(cq, cr, pq, pr);
      if dd > bestdd { bestdd = dd; dnq = cq; dnr = cr; }
    }
  }
  ti_up = pr * w + pq;
  if ti_up >= 0 && ti_up < len(tiles) { tiles[ti_up] = 3; }
  ti_dn = dnr * w + dnq;
  if ti_dn >= 0 && ti_dn < len(tiles) { tiles[ti_dn] = 2; }

  Sim {
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1, HERO_CON), phpmax: hero_maxhp(1, HERO_CON), over: false,
    clevel: 1, xp: 0, gold: 0, hcon: HERO_CON,
    depth: depth, wseed: seed, up_q: pq, up_r: pr, dn_q: dnq, dn_r: dnr,
  }
}

// Move between levels: dir +1 descends, -1 ascends (clamped to depth >= 1).
// Regenerates the destination deterministically from (wseed, new depth), carries
// the player's HP, and places them on the arrival stair (down → the new level's
// up-stair, which is where sim_new_gen already drops the player; up → its
// down-stair).
pub fn sim_descend(s: Sim, dir: integer) -> Sim {
  nd = s.depth + dir;
  if nd < 1 { nd = 1; }
  ns = sim_new_gen(s.wseed, nd);
  ns.php = s.php;
  ns.phpmax = s.phpmax;
  ns.over = s.over;
  ns.clevel = s.clevel;   // carry the hero across levels
  ns.xp = s.xp;
  ns.gold = s.gold;
  ns.hcon = s.hcon;
  ns.heading = s.heading;
  if dir < 0 {
    (ax, ay) = hex_to_px(ns.dn_q, ns.dn_r);
    ns.px = ax;
    ns.py = ay;
  }
  ns
}

pub fn sim_depth(s: Sim) -> integer { s.depth }

// Tile under the player: 2 = down-stair, 3 = up-stair, else floor/wall.
pub fn sim_stair_under(s: Sim) -> integer {
  (pq, pr) = px_to_hex(s.px, s.py);
  tile_at(s, pq, pr)
}

pub fn sim_down_hex(s: Sim) -> (integer, integer) { (s.dn_q, s.dn_r) }
pub fn sim_up_hex(s: Sim) -> (integer, integer) { (s.up_q, s.up_r) }
