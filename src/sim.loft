// sim — the renderer-agnostic roguelike kernel (M0).
//
// Continuous player (position + heading) over a hex tile grid; hex-locked
// enemies; a distance-driven clock: every HEX_LEN of player travel = one tick,
// turning costs no distance and therefore no time.  NO graphics dependency.

use hexgeo;
use gen;
use monsters;
use items;
use catalog;          // game_monsters()/game_items()/race_catalog()/class_catalog() — the merges
use races;            // RaceDef + RF_* ability flags + race_find/race_has_flag (the chosen race applies)
use classes;          // ClassDef + class_find (the chosen class applies: stats/HP/SP/skills/realm)
use worldtypes;       // Stencil / Placement — the world-bundle vocabulary
use world_place_gen;  // world_stencils()/world_placement() — the active bundle's set-piece + rules

MOVE_SPEED = 6.0;     // world units / second (brisk, Angband-paced; clock is distance)
TURN_SPEED = 2.6;     // radians / second
PLAYER_RADIUS = 0.45; // collision radius; ~half the marker, < hex apothem (0.866)
PLAYER_DAM = 6;       // player base melee damage per hit (before the level-ratio cap)
FIRE_RANGE = 10;      // missile range in hexes for the launcher (Q to fire)
FRONT_AIM  = 3.0;     // auto-aim: a dead-ahead target counts as up to this many hexes nearer
pub const QS_N = 11;  // quick-slots: indices 0..8 = number keys 1-9, 9 = active Q, 10 = active E
pub const QS_Q = 9;   // active slot Q (launcher fire / repeated action)
pub const QS_E = 10;  // active slot E (spell / second repeated action)
MSG_MAX = 64;         // message-log ring capacity (the view shows the most recent few)
PARA_DUR   = 2;       // ticks of paralysis per failed gaze save (re-rolled each tick while adjacent)
POISON_DUR = 8;       // ticks a venom dose lasts
POISON_DMG = 2;       // HP lost per poisoned tick
STRUGGLE_X = 4;       // paralysis fast-forward: struggling (pressing move) advances the clock Nx the
                      //   pure-wait pace — same ticks/outcome, just less real-time staring
REGEN_EVERY = 10;     // natural regeneration: +1 HP every N ticks (Angband: wounds slowly knit);
                      //   RF_REGEN (half-troll) halves the interval; poison blocks it entirely
SP_REGEN_EVERY = 6;   // mana returns a little faster than wounds knit; poison does NOT block the mind
COMBAT_DELTA_CAP = 8; // level gap beyond which raw level stops mattering in combat (§3a #2)
COMBAT_STEP = 6;      // % damage per level of (capped) gap — at most ±48%: level alone can't win/lose a fight
FLOW_BIG   = 1000000; // unreachable / unset distance in the flow field
HERO_CON   = 16;      // starting Constitution (full stat block = H2; HP is class-uniform, not con-driven)
NUM_STATS  = 6;       // STR, INT, WIS, DEX, CON, CHR
ST_STR     = 0;       // STR's index in the stat vectors (feeds the melee skill)
ST_DEX     = 3;       // DEX's index in the stat vectors (feeds the stealth skill)
ST_CON     = 4;       // CON's index in the stat vectors (see stat_index)
HERO_HP_BASE      = 28; // base max HP — identical for every class (fair); armour adds HP% (G3, §3a #3)
HERO_HP_PER_LEVEL = 2;  // gentle per-level HP (§3a #2): whole-game span a few×, not 10×+
STAT_COOLDOWN     = 3;  // a given stat can rise at most once per 3 character levels (player-chosen)
MAX_CLEVEL = 50;      // character-level cap
FLOOR_MAX  = 64;      // floor-item slots per level (fixed array — see LOFT_ISSUES)
INV_MAX    = 64;      // inventory slots
NUM_SLOTS  = 13;      // equipment slots, indexed by SLOT_* (0 = SLOT_NONE .. 11 = AMULET, 12 = RING2)
SAVE_INTERVAL = 3;    // a save-point level every 3 levels (depth 1, 4, 7, …) — checkpoint respawn
DEPTH_MAX  = 64;      // dungeon depths the per-level persistence store addresses
MAX_SPAWNS = 32;      // per-depth cap on stored dead-spawn indices (a level carries ~15)
GRAVE_PCT  = 50;      // % of gold left on a grave at the death spot (Souls stake — §3a #5)
VISION_RADIUS = 10;   // FOV radius DIRECTLY AHEAD — a directed lamp; later from the equipped light
// Monster perception channels — how the player knows a monster is there (best channel wins).
pub const SENSE_NONE = 0;   // not perceived
pub const SENSE_HEAR = 1;   // heard — an awake monster nearby, even out of sight (noise)
pub const SENSE_FEEL = 2;   // felt — position known through walls (detection / telepathy)
pub const SENSE_SEE  = 3;   // seen — in the lit field of view
HEAR_RADIUS = 6;      // an awake monster within this is "heard" when not seen
pub const ENERGY_STEP = 10;   // action cost in energy points; a monster banks (10 + m_speed) per
                              // tick and spends 10 per step/attack — m_speed +5 => 1.5 actions/tick
// Status effects — TIMED by a PRE-CALCULATED expiry tick, not a per-tick countdown: applying one
// stores `until = clock.ticks + duration`, and it is ACTIVE while `ticks <= until`, auto-stopping
// when the clock passes it. No decrement runs each tick — the clock is the single timer. slow =
// half the energy gain; stun = banks none (frozen). More kinds (bless/haste/poison) fit the same shape.
pub const ST_SLOW = 0;
pub const ST_STUN = 1;
NEAR_RADIUS = 1;      // always-visible bubble (own + adjacent); also the sight radius behind you

// Fresh zero-filled int vector of length n (build-time append to a local works;
// runtime append to a struct field does not — so floor/inv use fixed arrays).
fn zeros(n: integer) -> vector<integer> {
  v: vector<integer> = [];
  for _ in 0..n { v += [0]; }
  v
}

pub struct Enemy {
  cur_q: integer not null,
  cur_r: integer not null,
  tgt_q: integer not null,
  tgt_r: integer not null,
  hp:    integer not null,
  maxhp: integer not null,
  dam:   integer not null,
  xp:     integer not null,   // experience awarded on death (m_xp)
  mlvl:   integer not null,   // native level (m_depth) — scales the kill XP
  vision: integer not null,   // aggro / detection range in hexes (from the DB)
  flags:  integer not null,   // MF_* bitmask (from the DB)
  awake:  boolean not null,   // false = asleep: won't act until it perceives you
  speed:  integer not null,   // energy banked per clock tick = ENERGY_STEP + m_speed
  energy: integer not null,   // action-credit saved toward the next step (the 0..9 leftover between ticks)
  slow_until: integer not null,  // status expiry ticks (0 = none); active while ticks <= until
  stun_until: integer not null,
  cr:    integer not null,    // display colour 0..255 (from the monster DB)
  cg:    integer not null,
  cb:    integer not null,
  glyph: text,                // single-char map symbol (e.g. "r", "k", "o")
  name:  text,                // display name (for the message log: "You have slain the giant rat.")
  alive: boolean not null,
}

pub struct Sim {
  lw:      integer not null,
  lh:      integer not null,
  qmin:    integer not null,
  rmin:    integer not null,
  tiles:   vector<integer> not null,   // hex kind: 0 floor, 1 solid full-hex wall
  walls:   vector<integer> not null,   // edge walls: idx = hex*3 + edge(0=N,1=NE,2=SE)
  seen:    vector<integer> not null,   // FOV memory: 1 = hex ever seen (revealed map; lost on death)
  vis:     vector<integer> not null,   // FOV current: 1 = hex visible this frame (recomputed)
  px:      float not null,
  py:      float not null,
  heading: float not null,             // radians; forward = (cos,sin)
  accrued: float not null,             // remainder distance in [0, HEX_LEN)
  ticks:   integer not null,
  enemies: vector<Enemy> not null,
  php:     integer not null,   // player hit points
  phpmax:  integer not null,
  over:    boolean not null,   // game over (player died)
  clevel:  integer not null,   // character level (1..MAX_CLEVEL)
  xp:      integer not null,   // experience points
  gold:    integer not null,   // gold (income arrives with items, I1)
  race:    text not null,      // chosen race key (default "human"); its RaceDef applies to stats/HP/skills/flags
  pclass:  text not null,      // chosen class key ("" = the unclassed baseline; the FRONT-END picks the
                               //   quick-start default — story boots a warrior; the crystal re-specs)
  sp:      integer not null,   // spell points (0/0 for realm-less classes; regenerates over the clock)
  spmax:   integer not null,
  // CACHED race+class derivations (the wdam/pac idiom): apply_creation bakes these so the hot
  // paths (skills per tick, save rolls, xp checks, regen) read FIELDS — never re-merging the
  // race/class catalogs per call (catalog construction in a hot loop = store churn, loft#303).
  rc_flags:   integer not null,   // the race's RF_* ability bitmask
  rc_melee:   integer not null,   // combined race+class skill mods (class on the Angband scale, pre-divided)
  rc_bow:     integer not null,
  rc_stealth: integer not null,
  rc_save:    integer not null,
  rc_hd:      integer not null,   // combined hit-die (race + class)
  rc_xpf:     integer not null,   // combined experience factor % (100 = baseline)
  rc_realm:   text not null,      // the class's casting realm ("none" = no SP/cast)
  rc_spi:     integer not null,   // spell-stat index (stat_index of c_spell_stat; -1 = none)
  shrine_ev:  integer not null,   // pending shrine INTERACT (bumped a MF_SHRINE entity); the view
                                  //   polls sim_shrine_pending + clears — the crystal page opens
  // Statistics — three layers per stat (STR/INT/WIS/DEX/CON/CHR, see stat_index):
  //   stat_max = innate; stat_cur = current (permanent drain lowers, restore returns to max);
  //   stat_tmp/stat_tmp_t = a temporary +/- modifier (good/bad potion) with turns remaining.
  stat_max:   vector<integer> not null,
  stat_cur:   vector<integer> not null,
  stat_tmp:   vector<integer> not null,
  stat_tmp_t: vector<integer> not null,
  // Player-chosen stat growth (never forced): each level-up BANKS one point here; the player
  // spends it whenever they like (sim_raise_stat), deferring until needed. stat_grown_at[i] = the
  // clevel stat i last rose (0 = never), enforcing the once-per-STAT_COOLDOWN-levels cap.
  stat_pts:   integer not null,
  stat_grown_at: vector<integer> not null,
  detect_t:   integer not null,   // monster-detection (see-through-walls) turns remaining
  depth:   integer not null,   // dungeon level (1 = shallowest)
  save_depth: integer not null,   // checkpoint: deepest save-point level reached (respawn target)
  grave_depth: integer not null,  // death-stake grave: depth / hex / gold (0 gold = no grave).
  grave_q:     integer not null,  //   SP keeps one grave (re-death forfeits it); MP would hold a
  grave_r:     integer not null,  //   list (owner-less, persistent) — a later, non-rewrite variant.
  grave_gold:  integer not null,
  boss_slain:  integer not null,  // quest progress: 1 once a set-piece UNIQUE has died (releases the
                                  //   bundle's infestation on the way out). Carried across levels.
  msg_q:   vector<text> not null,  // message-log ring buffer (size MSG_MAX); index-written, never grown
  msg_n:   integer not null,       // total messages ever logged (the ring write head)
  // PLAYER status (the single player today; per-player when MP lands — "they take a player slot").
  para_until:   integer not null,  // paralysed while ticks < this (the floating-eye gaze)
  poison_until: integer not null,  // poisoned while ticks < this, taking poison_dmg HP per tick
  poison_dmg:   integer not null,
  venom_until:  integer not null,  // venom-WARD (antivenin): poison can't apply/tick while ticks < this
  // Unknown items (per GAME, carried across levels): which item TYPES are identified, and each def's
  // shuffled flavour index (the unidentified display). Indexed by catalog def index.
  known:        vector<integer> not null,
  flavour_idx:  vector<integer> not null,
  wseed:   integer not null,   // world seed (per-level gen seed = mix(wseed, depth))
  up_q:    integer not null,   // up-stair hex (player start / arrival from below)
  up_r:    integer not null,
  dn_q:    integer not null,   // down-stair hex
  dn_r:    integer not null,
  rstate:  integer not null,   // drop RNG state
  ninv:    integer not null,   // inventory count
  inv:     vector<integer> not null,   // carried item def indices [0..ninv) (UI = I2)
  eq:      vector<integer> not null,   // equipped item: defidx+1 per SLOT_* slot (0 = empty)
  qs:      vector<integer> not null,   // quick-slots [0..QS_N): bound item defidx+1 (0 = empty)
  wdam:    integer not null,           // cached melee damage (PLAYER_DAM + equipped weapon)
  pac:     integer not null,           // cached armour class (sum equipped i_ac) — feeds HP + DR
  fi_n:    integer not null,   // floor-item count
  fi_q:    vector<integer> not null,   // floor items — hex position [0..fi_n)
  fi_r:    vector<integer> not null,
  fi_gold: vector<integer> not null,   // gold amount (>0 = gold pile, 0 = an item)
  fi_cat:  vector<integer> not null,   // item category (IT_*); -1 for gold
  fi_def:  vector<integer> not null,   // item def index; -1 for gold
  fi_live: vector<integer> not null,   // 1 = on the floor, 0 = collected
  // Per-level persistence (deterministic base + delta): dead-spawn indices captured when you leave
  // a level, replayed on re-entry. Compact fixed blocks indexed by depth (dd_idx[depth*MAX_SPAWNS+k]).
  dd_idx:  vector<integer> not null,
  dd_n:    vector<integer> not null,   // dead count per depth (overwritten each time you leave)
  room_q0: vector<integer> not null,   // room rects (axial) — wall straightener snaps to their
  room_r0: vector<integer> not null,   //   exact rhombus side-lines; empty = pure-smooth fallback
  room_w:  vector<integer> not null,
  room_h:  vector<integer> not null,
}

// ── World queries ────────────────────────────────────────────────────

pub fn tile_at(s: Sim, q: integer, r: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 1;
  }
  tiles = s.tiles;
  ti = (r - s.rmin) * s.lw + (q - s.qmin);
  if ti < len(tiles) { tiles[ti] } else { 1 }
}

pub fn is_wall(s: Sim, q: integer, r: integer) -> boolean {
  tile_at(s, q, r) == 1
}

// Read a stored canonical edge wall directly (edge 0=N,1=NE,2=SE on this hex).
pub fn edge_wall_raw(s: Sim, q: integer, r: integer, edge: integer) -> integer {
  if q < s.qmin || r < s.rmin || q >= s.qmin + s.lw || r >= s.rmin + s.lh {
    return 0;
  }
  ws = s.walls;
  ei = ((r - s.rmin) * s.lw + (q - s.qmin)) * 3 + edge;
  if ei < len(ws) { ws[ei] } else { 0 }
}

// Wall value on the edge leaving (q,r) in direction `dir` (resolves the
// canonical owner: dirs 3,4,5 read the neighbour's edge).
pub fn edge_wall(s: Sim, q: integer, r: integer, dir: integer) -> integer {
  (oq, owr, oe) = canon_edge(q, r, dir);
  edge_wall_raw(s, oq, owr, oe)
}

// Is a single-hex step from (q1,r1) to (q2,r2) blocked? Blocked if the
// target is a solid full-hex wall (or out of bounds), or an edge wall sits
// on the shared edge.
pub fn is_blocked_move(s: Sim, q1: integer, r1: integer, q2: integer, r2: integer) -> boolean {
  if is_wall(s, q2, r2) { return true; }
  bd = neighbor_dir(q1, r1, q2, r2);
  if bd < 0 { return false; }
  edge_wall(s, q1, r1, bd) != 0
}

// Can the player's centre at (fromx,fromy) advance so its probe point lands at
// (tox,toy)?  Returns true if that probe enters a solid hex, an enemy hex, or
// crosses a walled edge.  Used per-axis with the probe offset one radius ahead.
fn pos_blocked(s: Sim, fromx: float, fromy: float, tox: float, toy: float) -> boolean {
  (aq, ar) = px_to_hex(fromx, fromy);
  (bq, br) = px_to_hex(tox, toy);
  if enemy_blocks(s, bq, br) { return true; }
  if aq == bq && ar == br { return is_wall(s, bq, br); }
  is_blocked_move(s, aq, ar, bq, br)
}

fn enemy_blocks(s: Sim, q: integer, r: integer) -> boolean {
  enemies = s.enemies;
  hit = false;
  for eb in 0..len(enemies) {
    e = enemies[eb];
    if e.alive && ((e.cur_q == q && e.cur_r == r) || (e.tgt_q == q && e.tgt_r == r)) {
      hit = true;
    }
  }
  hit
}

// Breadth-first distance field from (pq,pr) over reachable hexes (respecting
// solid hexes AND edge walls via is_blocked_move). flow[idx] = path length to
// the player; FLOW_BIG = unreachable. Recomputed each tick; monsters descend it
// to route around walls (vs. the old greedy step that stuck on corners).
fn compute_flow(s: Sim, pq: integer, pr: integer) -> vector<integer> {
  n = s.lw * s.lh;
  flow: vector<integer> = [];
  for _ in 0..n { flow += [FLOW_BIG]; }
  if pq >= s.qmin && pr >= s.rmin && pq < s.qmin + s.lw && pr < s.rmin + s.lh && !is_wall(s, pq, pr) {
    start = (pr - s.rmin) * s.lw + (pq - s.qmin);
    if start >= 0 && start < len(flow) { flow[start] = 0; }
    frontier: vector<integer> = [];
    frontier += [start];
    head = 0;
    while head < len(frontier) {
      cur = frontier[head] ?? 0;
      head += 1;
      cq = s.qmin + (cur % s.lw ?? 0);
      cr = s.rmin + (cur / s.lw ?? 0);
      cd = flow[cur] ?? FLOW_BIG;
      for fdir in 0..6 {
        (nq, nr) = hex_neighbor(cq, cr, fdir);
        if nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh && !is_blocked_move(s, cq, cr, nq, nr) {
          nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
          if nidx >= 0 && nidx < len(flow) {
            cn = flow[nidx] ?? FLOW_BIG;
            if cn > cd + 1 {
              flow[nidx] = cd + 1;
              frontier += [nidx];
            }
          }
        }
      }
    }
  }
  flow
}

// One step DOWN the flow gradient toward the player (routes around walls);
// never steps onto the player's own hex. Stays put if nothing is closer.
fn flow_step(s: Sim, flow: vector<integer>, eq: integer, er: integer, pq: integer, pr: integer) -> (integer, integer) {
  bq = eq;
  br = er;
  bestd = FLOW_BIG;
  if eq >= s.qmin && er >= s.rmin && eq < s.qmin + s.lw && er < s.rmin + s.lh {
    ci = (er - s.rmin) * s.lw + (eq - s.qmin);
    bestd = flow[ci] ?? FLOW_BIG;
  }
  for sdir in 0..6 {
    (nq, nr) = hex_neighbor(eq, er, sdir);
    if !is_blocked_move(s, eq, er, nq, nr) && !(nq == pq && nr == pr) && nq >= s.qmin && nr >= s.rmin && nq < s.qmin + s.lw && nr < s.rmin + s.lh {
      nidx = (nr - s.rmin) * s.lw + (nq - s.qmin);
      nd = flow[nidx] ?? FLOW_BIG;
      if nd < bestd { bestd = nd; bq = nq; br = nr; }
    }
  }
  (bq, br)
}

// ── Combat ───────────────────────────────────────────────────────────

// Nearest live enemy that is close (adjacent-ish) and ahead of the heading —
// the melee target when pressing forward into it. Returns its index, or -1.
fn front_enemy(s: Sim) -> integer {
  fx = cos(s.heading);
  fy = sin(s.heading);
  reach = HEX_LEN * 1.3;
  best = -1;
  bestd = reach * reach;
  enemies = s.enemies;
  for fe in 0..len(enemies) {
    e = enemies[fe];
    if e.alive {
      (ecx, ecy) = hex_to_px(e.cur_q, e.cur_r);
      rx = ecx - s.px;
      ry = ecy - s.py;
      d2 = rx * rx + ry * ry;
      dot = rx * fx + ry * fy;
      if dot > 0.0 && d2 <= bestd { bestd = d2; best = fe; }
    }
  }
  best
}

// ── Hero progression (XP / level / HP) ───────────────────────────────

// Max HP at a character level. Class-INDEPENDENT by design: every class gets the
// same HP (fair progression — §3a #3). Tankiness is lateral gear, not a class lock:
// heavy/metal armour adds HP% (and raises spell-cost%) in G3. Gentle curve (§3a #2):
// modest per-level growth so a run spans a few×, not 10×+.
fn hero_maxhp(clevel: integer) -> integer {
  HERO_HP_BASE + clevel * HERO_HP_PER_LEVEL
}

// Total XP required to be AT a character level (quadratic growth).
fn xp_for_level(lvl: integer) -> integer {
  if lvl <= 1 { return 0; }
  (lvl - 1) * (lvl - 1) * 10
}

// ── Equipment (G3): wield items; effects feed combat + HP ────────────
// Equipment is lateral progression (§3a #3): a weapon raises melee damage, armour
// adds HP and reduces incoming damage. Derived stats are cached (wdam/pac) and
// refreshed only on equip/unequip/level-up, so combat reads fields — not item_table —
// per hit. (Percentage / typed-resist modifiers + the metal/cloth spell-cost axis
// layer on later; this slice is the wield mechanic + flat weapon/armour effects.)

// Recompute cached weapon damage, armour class, and max HP from the equipped slots.
// Same module as its &-callers (C4). AC feeds BOTH max HP (heavy armour = tanky — the
// fighter's compensation, §3a #3) and damage reduction.
fn refresh_stats(s: &Sim) {
  itbl = game_items();
  eq = s.eq;
  ac = 0;
  for sl in 0..NUM_SLOTS {
    e = eq[sl] ?? 0;
    if e > 0 { ac += item_ac(itbl, e - 1); }
  }
  wd = PLAYER_DAM;
  w = eq[SLOT_WEAPON] ?? 0;
  if w > 0 {
    dd = item_dd(itbl, w - 1);
    ds = item_ds(itbl, w - 1);
    if dd > 0 && ds > 0 { wd += dd * (ds + 1) / 2 ?? 0; }   // average weapon roll
  }
  wd += sim_skill_melee(s);   // passive melee skill (level + STR) sharpens melee damage
  s.wdam = wd;
  s.pac = ac;
  oldmax = s.phpmax;
  newmax = hero_maxhp(s.clevel) + ac + rc_hp_bonus(s);   // the cached race+class hit-die, level-scaled
  if newmax < 1 { newmax = 1; }
  if newmax > oldmax { s.php += newmax - oldmax; }   // donning armour grants the HP
  if s.php > newmax { s.php = newmax; }
  if s.php < 1 { s.php = 1; }
  s.phpmax = newmax;
  // Max SP: realm casters draw from their spell stat (level + stat headroom); realm "none" => 0/0
  // (the sidebar SP row stays the status pip). Mirrors the HP grant-on-increase. Reads the CACHED
  // realm/spell-stat (apply_creation bakes them — no catalog merge in here).
  newsp = 0;
  if s.rc_realm != "none" && s.rc_realm != "" {
    bonus = 0;
    if s.rc_spi >= 0 { bonus = stat_eff(s, s.rc_spi) - HERO_CON; }
    newsp = 2 + s.clevel + bonus;
    if newsp < 1 { newsp = 1; }
  }
  oldsp = s.spmax;
  if newsp > oldsp { s.sp += newsp - oldsp; }
  if s.sp > newsp { s.sp = newsp; }
  if s.sp < 0 { s.sp = 0; }
  s.spmax = newsp;
}

// Reduce an incoming hit by armour class as a never-100% percentage (§3a #2/#3:
// nothing fully negated): dmg * 100 / (100 + ac), floored at 1.
fn apply_dr(dmg: integer, ac: integer) -> integer {
  v = dmg * 100 / (100 + ac) ?? dmg;
  if v < 1 { v = 1; }
  v
}

// Equip the inventory item at index `ii` into its slot; any displaced item returns to
// that inventory slot, else the slot is removed (compacted). Recomputes stats.
pub fn sim_equip(s: &Sim, ii: integer) {
  iv = s.inv;
  if ii < 0 || ii >= s.ninv || ii >= len(iv) { return; }
  defidx = iv[ii] ?? -1;
  if defidx < 0 { return; }
  sim_identify(s, defidx);                  // wielding reveals the kind (rings/amulets) for the game
  itbl = game_items();
  sl = item_slot(itbl, defidx);
  eq = s.eq;
  if sl <= 0 || sl >= len(eq) { return; }   // not wieldable / out of range
  // Rings have TWO locations (L = SLOT_RING, R = SLOT_RING2): fill the first free, else swap the left.
  if sl == SLOT_RING {
    if (eq[SLOT_RING] ?? 0) == 0 { sl = SLOT_RING; }
    else if SLOT_RING2 < len(eq) && (eq[SLOT_RING2] ?? 0) == 0 { sl = SLOT_RING2; }
    else { sl = SLOT_RING; }
  }
  prev = eq[sl] ?? 0;
  if sl < len(eq) { eq[sl] = defidx + 1; }
  if prev > 0 {
    if ii < len(iv) { iv[ii] = prev - 1; }   // swap: displaced item takes the slot
  } else {
    n = s.ninv;
    for k in ii..(n - 1) {
      if k >= 0 && k + 1 < len(iv) { iv[k] = iv[k + 1] ?? -1; }   // remove: shift down
    }
    s.ninv = n - 1;
  }
  refresh_stats(s);
}

// Unequip slot `sl` back to inventory (if room). Recomputes stats.
pub fn sim_unequip(s: &Sim, sl: integer) {
  eq = s.eq;
  if sl <= 0 || sl >= len(eq) { return; }
  e = eq[sl] ?? 0;
  if e == 0 { return; }
  iv = s.inv;
  n = s.ninv;
  if n >= 0 && n < len(iv) {
    iv[n] = e - 1;
    s.ninv = n + 1;
  }
  if sl < len(eq) { eq[sl] = 0; }
  refresh_stats(s);
}

// Seed the class-as-kit starting loadout (BUNDLE.md): a dagger + soft leather armour,
// equipped. A single generic kit for now; per-class kits arrive with classes.
pub fn sim_starting_loadout(s: &Sim) {
  itbl = game_items();
  di = item_index(itbl, "dagger");
  ai = item_index(itbl, "soft_leather_armor");
  eq = s.eq;
  if di >= 0 && SLOT_WEAPON < len(eq) { eq[SLOT_WEAPON] = di + 1; }
  if ai >= 0 && SLOT_BODY < len(eq) { eq[SLOT_BODY] = ai + 1; }
  refresh_stats(s);
}

// ── Kernel player-mutation primitives ────────────────────────────────
// The Player methods (player.loft) wrap these; the actual &Sim mutation lives HERE,
// where cross-module writes are proven (equiptest calls sim_equip across modules). Today
// they act on the single player; when multi-player lands they take a player slot.

// Add an item (by key) to the player's inventory — fixed array + count (C18-safe).
pub fn sim_give_item(s: &Sim, key: text) {
  itbl = game_items();
  idx = item_index(itbl, key);
  if idx >= 0 && s.ninv < INV_MAX {
    n = s.ninv;
    v = s.inv;
    v[n] = idx;
    s.ninv = n + 1;
    sim_qs_autoslot(s, idx);    // first useable item of its kind auto-fills a quick-slot
  }
}

// ── Quick-slots: a uniform 1-9 + Q/E bar over usable items (SLICE: the quick-slot bar) ──
// A slot holds an item DEFIDX+1 (0 = empty), mirroring eq[]. Binding is by def (stable across
// consume/refill); a def lives in at most ONE slot. Auto-slot + manual reslot share sim_qs_bind.

// First inventory index carrying def `defidx`, or -1. (Slot bindings are by def, not inv index,
// so dispatch resolves the def to a live inventory entry here.)
pub fn sim_inv_find(s: Sim, defidx: integer) -> integer {
  iv = s.inv;
  out = -1;
  for i in 0..s.ninv {
    if out < 0 && i < len(iv) {
      if (iv[i] ?? -1) == defidx { out = i; }
    }
  }
  out
}

// Quick-slot k -> bound item defidx (or -1 if empty). The view reads this for name/glyph.
pub fn sim_qs_def(s: Sim, k: integer) -> integer {
  q = s.qs;
  if k < 0 || k >= len(q) { return -1; }
  d1 = q[k] ?? 0;
  if d1 == 0 { return -1; }
  d1 - 1
}

// Slot index currently holding def `defidx`, or -1. (Used to enforce one-slot-per-def.)
fn qs_find(s: Sim, defidx: integer) -> integer {
  q = s.qs;
  out = -1;
  for i in 0..len(q) {
    if out < 0 {
      if (q[i] ?? 0) == defidx + 1 { out = i; }
    }
  }
  out
}

// Bind def `defidx` to quick-slot k (the one primitive behind auto-slot AND manual reslot). A def
// lives in at most one slot, so any prior slot holding it is cleared first (re-bind = move). The
// slot's previous occupant is simply overwritten (unbound). defidx < 0 clears the slot.
pub fn sim_qs_bind(s: &Sim, k: integer, defidx: integer) {
  q = s.qs;
  if k < 0 || k >= len(q) { return; }
  if defidx < 0 { q[k] = 0; return; }
  prev = qs_find(s, defidx);                 // move: clear an existing binding of this def
  if prev >= 0 && prev < len(q) { q[prev] = 0; }
  q[k] = defidx + 1;
}

// Auto-slot a freshly-acquired item by category (SLICE type-routing): a consumable fills the next
// free numeric slot 0..8; a launcher auto-equips + binds active slot Q; ammo is fuel (no slot);
// anything else (worn gear) gets no quick-slot. Idempotent: an already-slotted def is left alone.
pub fn sim_qs_autoslot(s: &Sim, defidx: integer) {
  if defidx < 0 { return; }
  itbl = game_items();
  if item_is_quest(itbl, defidx) { return; } // a quest keepsake is never quick-slotted (inspect-only)
  cat = item_cat(itbl, defidx);
  if qs_find(s, defidx) >= 0 { return; }     // already slotted (e.g. picked up a second of the same)
  if cat == IT_POTION || cat == IT_SCROLL || cat == IT_FOOD {
    q = s.qs;
    free = -1;
    for i in 0..QS_Q {                        // numeric slots 0..8 only (Q/E reserved for actives)
      if free < 0 {
        if (q[i] ?? 0) == 0 { free = i; }
      }
    }
    if free >= 0 { sim_qs_bind(s, free, defidx); }
  }
  if cat == IT_BOW {
    j = sim_inv_find(s, defidx);              // equip the launcher we just picked up...
    if j >= 0 { sim_equip(s, j); }
    sim_qs_bind(s, QS_Q, defidx);             // ...and bind FIRE to active slot Q
  }
}

// Quick-slot k -> the count to show on the bar. For a launcher slot it's the matching ammo carried
// (the quiver); for a consumable it's how many of that def are in inventory. 0 = empty/none left.
pub fn sim_qs_count(s: Sim, k: integer) -> integer {
  defidx = sim_qs_def(s, k);
  if defidx < 0 { return 0; }
  itbl = game_items();
  cat = item_cat(itbl, defidx);
  iv = s.inv;
  n = 0;
  if cat == IT_BOW {
    for i in 0..s.ninv {                      // count arrows/shots/bolts in the quiver
      if i < len(iv) {
        if item_cat(itbl, iv[i] ?? -1) == IT_AMMO { n = n + 1; }
      }
    }
  } else {
    for i in 0..s.ninv {                      // count this consumable's stack
      if i < len(iv) {
        if (iv[i] ?? -1) == defidx { n = n + 1; }
      }
    }
  }
  n
}

// ── Unknown items (the Angband "mystery") ──────────────────────────────────────────────────
// Magic goods (potions/scrolls/wands/staves/rings/amulets) read as a shuffled FLAVOUR ("a Crimson
// Potion") until the KIND is identified — using one (quaff/read/wield) or a Scroll of Identify
// reveals it for the whole GAME. `known[defidx]` = this kind is identified; `flavour_idx[defidx]` =
// its per-game flavour. IF_KNOWN/IF_QUEST items (e.g. the antivenin) skip the system. The mapping +
// known set are assigned once (assign_flavours) and carried across levels/death.

// Has this item KIND been identified this game?
pub fn sim_identified(s: Sim, defidx: integer) -> boolean {
  kv = s.known;
  if defidx < 0 || defidx >= len(kv) { return false; }
  (kv[defidx] ?? 0) != 0
}

// Mark this item KIND identified. Returns true if it was NEWLY revealed (for the "It was …!" line).
pub fn sim_identify(s: &Sim, defidx: integer) -> boolean {
  kv = s.known;
  if defidx < 0 || defidx >= len(kv) { return false; }
  if (kv[defidx] ?? 0) != 0 { return false; }
  kv[defidx] = 1;                            // index-write on a captured field vector persists (C18)
  true
}

// The name to SHOW for item `defidx`: the real name once identified / always-known / not a mystery
// type; otherwise the per-game flavour. The one place the view/messages resolve an item's name.
pub fn sim_item_display_name(s: Sim, defidx: integer) -> text {
  itbl = game_items();
  if defidx < 0 || defidx >= len(itbl) { return ""; }
  d = itbl[defidx];
  cat = d.i_cat;
  if !item_unknown_type(cat) || item_known_flag(itbl, defidx) || sim_identified(s, defidx) {
    return item_name(itbl, defidx);
  }
  fi = s.flavour_idx;
  flavour_name(cat, fi[defidx] ?? 0)
}

// Scroll of Identify (slice behaviour — no per-item prompt yet): reveal the first carried item whose
// KIND is still a mystery. Returns the def identified, or -1 if nothing carried is unknown.
pub fn sim_identify_carried(s: &Sim) -> integer {
  iv = s.inv;
  itbl = game_items();
  for i in 0..s.ninv {
    if i < len(iv) {
      di = iv[i] ?? -1;
      if di >= 0 && di < len(itbl) {
        d = itbl[di];
        if item_unknown_type(d.i_cat) && !item_known_flag(itbl, di) && !sim_identified(s, di) {
          sim_identify(s, di);
          return di;
        }
      }
    }
  }
  -1
}

// Number of item defs in the MERGED catalog (base + bundles) — the view sizes its baked name array
// to this so a quick-slotted BUNDLE item (whose defid sits past the base table) still shows its name.
pub fn sim_item_count() -> integer { len(game_items()) }

// Category (IT_*) of merged-catalog def `defidx`, or -1 if out of range. Lets the view classify a
// quick-slot's bound item (launcher vs consumable) without importing the catalog merge itself.
pub fn sim_item_cat(defidx: integer) -> integer {
  itbl = game_items();
  if defidx < 0 || defidx >= len(itbl) { return -1; }
  d = itbl[defidx];
  d.i_cat
}

// How many item KINDS are identified this game. The view watches this to know when a quick-slot
// name changed (flavour → real) and re-bakes the always-visible bar (it bakes once, not per frame).
pub fn sim_known_count(s: Sim) -> integer {
  kv = s.known;
  n = 0;
  for i in 0..len(kv) { if (kv[i] ?? 0) != 0 { n += 1; } }
  n
}

// SHORT display name for the always-visible quick-slot bar / inventory column: the per-game flavour
// while a mystery, else the short real name (drops the "Category of " prefix). The short sibling of
// sim_item_display_name — same identified/known-flag/not-a-mystery gate.
pub fn sim_item_short_name(s: Sim, defidx: integer) -> text {
  itbl = game_items();
  if defidx < 0 || defidx >= len(itbl) { return ""; }
  d = itbl[defidx];
  cat = d.i_cat;
  if !item_unknown_type(cat) || item_known_flag(itbl, defidx) || sim_identified(s, defidx) {
    return item_short_idx(itbl, defidx);
  }
  fi = s.flavour_idx;
  flavour_name(cat, fi[defidx] ?? 0)
}

// Inventory slot -> item key (for use/inspect routines). "" if empty or out of range.
pub fn sim_inv_key(s: Sim, slot: integer) -> text {
  iv = s.inv;
  if slot < 0 || slot >= s.ninv || slot >= len(iv) { return ""; }
  defidx = iv[slot] ?? -1;
  item_key(game_items(), defidx)
}

// Inventory slot -> the item's display name (for the inventory screen). "" if empty/out of range.
pub fn sim_inv_name(s: Sim, slot: integer) -> text {
  iv = s.inv;
  if slot < 0 || slot >= s.ninv || slot >= len(iv) { return ""; }
  defidx = iv[slot] ?? -1;
  sim_item_display_name(s, defidx)
}
// Description of the carried item in `slot` (the inventory hub's examine line). "" if empty.
pub fn sim_inv_desc(s: Sim, slot: integer) -> text {
  iv = s.inv;
  if slot < 0 || slot >= s.ninv || slot >= len(iv) { return ""; }
  item_desc(game_items(), iv[slot] ?? -1)
}
// Bind the carried item in `inv_slot` to quick-slot `qslot` (the inventory hub's manual reslot).
pub fn sim_inv_bind(s: &Sim, inv_slot: integer, qslot: integer) {
  iv = s.inv;
  if inv_slot < 0 || inv_slot >= s.ninv || inv_slot >= len(iv) { return; }
  sim_qs_bind(s, qslot, iv[inv_slot] ?? -1);
}

// First inventory slot holding item `key`, or -1.
pub fn sim_find_item(s: Sim, key: text) -> integer {
  itbl = game_items();
  target = item_index(itbl, key);
  if target < 0 { return -1; }
  iv = s.inv;
  for i in 0..s.ninv {
    if i < len(iv) && (iv[i] ?? -1) == target { return i; }
  }
  -1
}

// Remove one item from inventory slot `slot` (shift the tail down) — a single-use consume.
pub fn sim_consume_inv(s: &Sim, slot: integer) {
  iv = s.inv;
  n = s.ninv;
  if slot < 0 || slot >= n { return; }
  for k in slot..(n - 1) {
    if k >= 0 && k + 1 < len(iv) { iv[k] = iv[k + 1] ?? -1; }
  }
  s.ninv = n - 1;
}

// Monster detection (see-through-walls) for `turns` ticks; decays in sim_tick.
pub fn sim_reveal_monsters(s: &Sim, turns: integer) { s.detect_t = turns; }
pub fn sim_detect_active(s: Sim) -> boolean { s.detect_t > 0 }

// Equip an item (by key) into its own slot, then refresh derived stats.
pub fn sim_equip_by_key(s: &Sim, key: text) {
  itbl = game_items();
  idx = item_index(itbl, key);
  if idx >= 0 && idx < len(itbl) {
    d = itbl[idx];
    sl = d.i_slot;
    eq = s.eq;
    if sl >= 0 && sl < len(eq) { eq[sl] = idx + 1; }
  }
  refresh_stats(s);
}

// ---- Statistics: three layers (innate max / current / temporary modifier) ----------------
// STR/INT/WIS/DEX/CON/CHR -> vector index. -1 = unknown (the stat ops then no-op).
fn stat_index(stat: text) -> integer {
  if stat == "str" { return 0; }
  if stat == "int" { return 1; }
  if stat == "wis" { return 2; }
  if stat == "dex" { return 3; }
  if stat == "con" { return 4; }
  if stat == "chr" { return 5; }
  -1
}

// The starting stat block (uniform for now; per-class blocks land with the class stat tables).
fn start_stats() -> vector<integer> {
  [HERO_CON, HERO_CON, HERO_CON, HERO_CON, HERO_CON, HERO_CON]
}

// ── Race application (the chosen race's RaceDef modifies the live character) ──────────────────
// The race key lives on the Sim; everything but the STAT BLOCK is derived LIVE from it (skills /
// hit-die / save / flags), so only the stat block needs baking into stat_max (grants mutate that).

// Hit-die HP at the current level from the CACHED combined hit-die (race + class; baked by
// apply_creation): rc_hd>0 => tankier (warrior/half-troll), <0 => frailer (elf). Level-scaled.
fn rc_hp_bonus(s: Sim) -> integer {
  s.rc_hd * (s.clevel + 2) / 2 ?? 0
}

// XP required to BE at level `lvl` for THIS character: the base curve scaled by the CACHED
// combined race × class experience factor (Angband's expfact; 100 = baseline).
fn xp_need(s: Sim, lvl: integer) -> integer {
  xp_for_level(lvl) * s.rc_xpf / 100 ?? 0
}

// A stat is SUSTAINED when the race carries its RF_SUST_* flag — drain simply fails (Angband
// sustains). Only STR/DEX/CON have sustain flags in the vocabulary.
fn stat_sustained(s: Sim, i: integer) -> boolean {
  if i == ST_STR { return (s.rc_flags & RF_SUST_STR) != 0; }
  if i == ST_DEX { return (s.rc_flags & RF_SUST_DEX) != 0; }
  if i == ST_CON { return (s.rc_flags & RF_SUST_CON) != 0; }
  false
}

// Angband class skill numbers ride a 0..40ish scale; our passive skills are small flat bonuses.
// One adapter constant maps between them (tuning knob, §3a: systems faithful, numbers friendly).
CLASS_SKILL_DIV = 6;

// Apply the CREATION choices: bake the race+class STAT BLOCKS onto the uniform base, and CACHE
// every derived number the hot paths read (the wdam/pac idiom — skills/save/xp/regen read fields,
// never re-merging the catalogs per call; catalog churn in a hot loop = store pressure, loft#303).
// Idempotent (re-derives from base), so the crystal's re-spec re-applies cleanly; the catalog
// lookups happen ONLY here.
fn apply_creation(s: &Sim) {
  rd = race_find(race_catalog(), s.race);
  cd = class_find(class_catalog(), s.pclass);
  base = start_stats();
  rmods = [rd.r_str, rd.r_int, rd.r_wis, rd.r_dex, rd.r_con, rd.r_chr];
  cmods = [cd.c_str, cd.c_int, cd.c_wis, cd.c_dex, cd.c_con, cd.c_chr];
  sm = s.stat_max;
  sc = s.stat_cur;
  for i in 0..NUM_STATS {
    v = (base[i] ?? 0) + (rmods[i] ?? 0) + (cmods[i] ?? 0);
    if v < 3 { v = 3; }
    sm[i] = v;
    sc[i] = v;
  }
  s.rc_flags = rd.r_flags;
  s.rc_melee = rd.r_melee + cd.c_melee / CLASS_SKILL_DIV;
  s.rc_bow = rd.r_bow + cd.c_bow / CLASS_SKILL_DIV;
  s.rc_stealth = rd.r_stealth + cd.c_stealth;   // class stealth is already on the small scale
  s.rc_save = rd.r_save + cd.c_save / CLASS_SKILL_DIV;
  s.rc_hd = rd.r_hd + cd.c_hd;
  s.rc_xpf = rd.r_xp * cd.c_xp / 100 ?? 100;
  s.rc_realm = cd.c_realm;
  s.rc_spi = stat_index(cd.c_spell_stat);
  refresh_stats(s);   // CON + hit-dies + realm changed -> recompute max HP and max SP
}

// Choose race / class (creation or the crystal's re-spec): set the key, re-bake, recompute.
pub fn sim_set_race(s: &Sim, key: text) {
  s.race = key;
  apply_creation(s);
}
pub fn sim_set_class(s: &Sim, key: text) {
  s.pclass = key;
  apply_creation(s);
}
pub fn sim_player_race(s: Sim) -> text { s.race }
pub fn sim_player_class(s: Sim) -> text { s.pclass }

// ── The shrine (the spawning crystal's re-spec) ────────────────────────────────────────────
// Bumping a MF_SHRINE entity raises a pending INTERACT (sim_step); the view polls + clears it
// and opens the crystal page. Applying a choice re-derives the character (apply_creation is
// idempotent) and makes them WHOLE — full heal, full mind ("the crystal reshapes you").
// Inventory/equipment unchanged; the class KIT is a new-game grant only (no re-spec farming).
pub fn sim_shrine_pending(s: Sim) -> integer { s.shrine_ev }
pub fn sim_shrine_clear(s: &Sim) { s.shrine_ev = 0; }
pub fn sim_shrine_apply(s: &Sim, kind: text, key: text) {
  if kind == "race" { sim_set_race(s, key); }
  if kind == "class" { sim_set_class(s, key); }
  s.php = s.phpmax;
  s.sp = s.spmax;
  sim_log(s, "The crystal reshapes you.");
}

// Race/class roster accessors for the CHOICE UI (the crystal page) — the view reads the merged
// catalogs only through these (architecture invariant). Page-build only, never per-frame.
pub fn sim_race_count() -> integer { len(race_catalog()) }
pub fn sim_race_key(i: integer) -> text {
  t = race_catalog();
  if i < 0 || i >= len(t) { return ""; }
  rd = t[i];
  rd.r_key
}
pub fn sim_race_name(i: integer) -> text {
  t = race_catalog();
  if i < 0 || i >= len(t) { return ""; }
  rd = t[i];
  rd.r_name
}
pub fn sim_race_desc(i: integer) -> text {
  t = race_catalog();
  if i < 0 || i >= len(t) { return ""; }
  rd = t[i];
  rd.r_desc
}
pub fn sim_class_count() -> integer { len(class_catalog()) }
pub fn sim_class_key(i: integer) -> text {
  t = class_catalog();
  if i < 0 || i >= len(t) { return ""; }
  cd = t[i];
  cd.c_key
}
pub fn sim_class_name(i: integer) -> text {
  t = class_catalog();
  if i < 0 || i >= len(t) { return ""; }
  cd = t[i];
  cd.c_name
}
pub fn sim_class_desc(i: integer) -> text {
  t = class_catalog();
  if i < 0 || i >= len(t) { return ""; }
  cd = t[i];
  cd.c_desc
}
// The class's casting realm ("none" for the unclassed/warrior) — castfx + the view read this.
pub fn sim_player_realm(s: Sim) -> text { s.rc_realm }
// Race ability flags wired to the systems that exist: free-action gates the gaze paralysis; resist-
// poison gates monster venom. (Other RF_* flags wait on their systems — see BUNDLE-MIGRATION.md.)
// All read the CACHED flag bitmask (no catalog merge per query).
pub fn sim_player_free_action(s: Sim) -> boolean { (s.rc_flags & RF_FREE_ACTION) != 0 }
pub fn sim_player_res_poison(s: Sim) -> boolean { (s.rc_flags & RF_RES_POISON) != 0 }

// Effective value of stat i = current + the temporary modifier WHILE it is still active.
fn stat_eff(s: Sim, i: integer) -> integer {
  if i < 0 { return 0; }
  cv = s.stat_cur;
  c = cv[i] ?? 0;
  ttv = s.stat_tmp_t;
  if (ttv[i] ?? 0) > 0 {
    tv = s.stat_tmp;
    c = c + (tv[i] ?? 0);
  }
  c
}

// Permanent GAIN (stat-gain potion / level reward): raise innate max AND current.
pub fn sim_grant_stat(s: &Sim, stat: text, n: integer) {
  i = stat_index(stat);
  if i >= 0 {
    mx = s.stat_max; mx[i] = (mx[i] ?? 0) + n;
    cu = s.stat_cur; cu[i] = (cu[i] ?? 0) + n;
    refresh_stats(s);
  }
}

// Permanent DRAIN (restorable): lower current only, never below 1; innate max is untouched so
// a later restore brings it back.
pub fn sim_drain_stat(s: &Sim, stat: text, n: integer) {
  i = stat_index(stat);
  if i >= 0 {
    if stat_sustained(s, i) { sim_log(s, "Your body resists the drain."); return; }
    cu = s.stat_cur;
    c = (cu[i] ?? 0) - n;
    if c < 1 { c = 1; }
    cu[i] = c;
    refresh_stats(s);
  }
}

// RESTORE a drained stat: current returns to its innate max.
pub fn sim_restore_stat(s: &Sim, stat: text) {
  i = stat_index(stat);
  if i >= 0 {
    mx = s.stat_max;
    cu = s.stat_cur;
    cu[i] = mx[i] ?? 0;
    refresh_stats(s);
  }
}

// TEMPORARY modifier (good potion = +n, bad potion = -n) for `turns` ticks. Last-wins: the
// newest potion overrides any active one (opposite signs cancel). Decays in sim_tick.
pub fn sim_buff_stat(s: &Sim, stat: text, n: integer, turns: integer) {
  i = stat_index(stat);
  if i >= 0 {
    tv = s.stat_tmp; tv[i] = n;
    ttv = s.stat_tmp_t; ttv[i] = turns;
  }
}

// Stat accessors (effective / current / innate) for the view + tests.
pub fn sim_stat(s: Sim, stat: text) -> integer { stat_eff(s, stat_index(stat)) }
pub fn sim_stat_cur(s: Sim, stat: text) -> integer {
  i = stat_index(stat);
  if i < 0 { return 0; }
  v = s.stat_cur; v[i] ?? 0
}
pub fn sim_stat_max(s: Sim, stat: text) -> integer {
  i = stat_index(stat);
  if i < 0 { return 0; }
  v = s.stat_max; v[i] ?? 0
}

// Teach a class skill / saving throw. Placeholders: the per-player skill & save stores land
// with the skill system. Kept so the Player API is stable now (scripts/events written today
// won't change). The args document the shape; they no-op until those fields exist.
pub fn sim_grant_skill(s: &Sim, skill: text, n: integer) {
  if false { s.gold = s.gold + n + len(skill); }   // touch args; no per-player skill store yet
}
pub fn sim_grant_save(s: &Sim, save: text, n: integer) {
  if false { s.gold = s.gold + n + len(save); }     // touch args; no per-player save store yet
}

// Heal the player, clamped to max HP.
pub fn sim_heal(s: &Sim, amount: integer) {
  s.php = s.php + amount;
  if s.php > s.phpmax { s.php = s.phpmax; }
}

// Hurt the player by `amount` of damage of `kind` (physical/fire/cold/poison/…). The
// per-kind resistance/effect handling lands later (the type just documents the shape now);
// today it is generic HP loss + death, mirroring melee.
pub fn sim_damage(s: &Sim, amount: integer, kind: text) {
  dmg = amount;
  if kind == "physical" {
    dmg = apply_dr(amount, s.pac);          // armour soaks physical blows (existing AC DR)
  } else {
    sv = sim_player_save(s);                // a saving throw resists magic/elemental effects
    cut = amount * sv / 100 ?? 0;
    dmg = amount - cut;
    if dmg < 1 { dmg = 1; }                 // never fully negated — save is capped < 100%
  }
  s.php = s.php - dmg;
  if s.php <= 0 { s.php = 0; s.over = true; }
}

// The player's saving throw (% resist for magic/elemental damage). Grows with character
// level, equipped armour (AC), and Constitution — so gearing up and stat upgrades both help.
// Capped below 100% (friendly but fair — never total immunity; §3a).
pub fn sim_player_save(s: Sim) -> integer {
  sv = 5 + s.clevel + s.pac / 4 + stat_eff(s, ST_CON) / 3 + s.rc_save;   // cached race+class bonus
  if sv > 75 { sv = 75; }
  if sv < 0 { sv = 0; }
  sv
}

// The player FAILS a saving throw against an effect (gaze / venom): roll vs save% — higher save
// resists more often. (Early on save is low, so the floating eye is genuinely deadly.)
fn sim_save_fails(s: &Sim) -> boolean {
  sim_roll(s, 0, 99) >= sim_player_save(s)
}

// SP (spell points): pool accessors + the spend gate castfx uses. spmax is derived in
// refresh_stats from the class realm + spell stat; regen rides sim_tick.
pub fn sim_player_sp(s: Sim) -> integer { s.sp }
pub fn sim_player_sp_max(s: Sim) -> integer { s.spmax }
pub fn sim_spend_sp(s: &Sim, n: integer) -> boolean {
  if n > s.sp { return false; }
  s.sp -= n;
  true
}

// PLAYER status queries (the view shows a pip; the step/tick logic gates on these).
pub fn sim_player_paralysed(s: Sim) -> boolean { s.para_until > s.ticks }
pub fn sim_player_poisoned(s: Sim) -> boolean { s.poison_until > s.ticks }
pub fn sim_player_warded(s: Sim) -> boolean { s.venom_until > s.ticks }

// Antivenin: clear venom from the blood AND ward against more for `dur` ticks (the boss-drop escape
// hatch — long enough to climb out through the brood).
pub fn sim_cure_venom(s: &Sim, dur: integer) {
  s.poison_until = 0;
  s.poison_dmg = 0;
  s.venom_until = s.ticks + dur;
}

// Passive MELEE skill — a flat to-damage bonus from character level + effective STR. 0 at the
// baseline (level 1, starting STR), so it never shifts early combat; it grows as you level AND as
// you spend stat points on STR (the stat-choice payoff). refresh_stats folds it into wdam.
pub fn sim_skill_melee(s: Sim) -> integer {
  b = (s.clevel - 1) / 2 + (stat_eff(s, ST_STR) - HERO_CON) + s.rc_melee;   // cached race+class aptitude
  if b < 0 { b = 0; }
  b
}

// Passive STEALTH skill — from character level + effective DEX. 0 at the baseline; it SHRINKS the
// range at which a monster notices you (its effective vision in the awareness check), so a stealthy
// (high-level / high-DEX) character can slip closer before waking sleepers. refresh-free (derived).
pub fn sim_skill_stealth(s: Sim) -> integer {
  b = (s.clevel - 1) / 3 + (stat_eff(s, ST_DEX) - HERO_CON) + s.rc_stealth;   // cached race+class
  if b < 0 { b = 0; }
  b
}

// Passive SHOOTING skill — a flat to-damage bonus for missiles, from level + DEX (Angband shoots
// off DEX). 0 at the baseline; grows with level and DEX-spending. Added to the launched damage.
pub fn sim_skill_shoot(s: Sim) -> integer {
  b = (s.clevel - 1) / 2 + (stat_eff(s, ST_DEX) - HERO_CON) + s.rc_bow;   // cached race+class aptitude
  if b < 0 { b = 0; }
  b
}

// Move the player to hex (q,r) — level placement / arrival / scripted movement.
pub fn sim_teleport(s: &Sim, q: integer, r: integer) {
  (tx, ty) = hex_to_px(q, r);
  s.px = tx;
  s.py = ty;
}

// Blink: teleport the player to a random non-wall hex within `max_d` (Scroll of Phase Door = short,
// Teleportation = long). Tries a handful of random offsets; a no-op if none land (always safe).
pub fn sim_blink(s: &Sim, max_d: integer) {
  (pq, pr) = px_to_hex(s.px, s.py);
  for _ in 0..60 {
    tq = pq + sim_roll(s, 0 - max_d, max_d);
    tr = pr + sim_roll(s, 0 - max_d, max_d);
    d = hex_distance(pq, pr, tq, tr);
    if d >= 1 && d <= max_d && tq >= 1 && tr >= 1 && tq < s.lw - 1 && tr < s.lh - 1 {
      if tile_at(s, tq, tr) != 1 {            // not a wall (floor / stair)
        sim_teleport(s, tq, tr);
        return;
      }
    }
  }
}

// Reveal the whole level on the memory map (Scroll of Magic Mapping). Index-write on the captured
// `seen` vector persists (C18-safe).
pub fn sim_reveal_map(s: &Sim) {
  seen = s.seen;
  for i in 0..len(seen) { seen[i] = 1; }
}

// Turn the player to face hex (q,r) — NPC interactions, scripted events.
pub fn sim_face(s: &Sim, q: integer, r: integer) {
  (tx, ty) = hex_to_px(q, r);
  s.heading = atan2(ty - s.py, tx - s.px);
}

// Radius of the equipped light (its i_power), or 0 if none. Feeds the FOV sight radius
// (a brighter light widens sight) and lets the view size the light cone later.
pub fn sim_light_radius(s: Sim) -> integer {
  l = s.eq[SLOT_LIGHT] ?? 0;
  if l <= 0 { return 0; }
  itbl = game_items();
  defi = l - 1;
  if defi >= 0 && defi < len(itbl) {
    d = itbl[defi];
    return d.i_power;
  }
  0
}

// Award XP and level up while the threshold is met; each level refreshes derived
// stats (max HP grows by the gentle per-level step; current HP gains the delta).
// ── Message log ──────────────────────────────────────────────────────────────────────
// A small ring of game messages (kernel data; the view renders the most recent few). Events across
// the kernel + the item API push lines via sim_log; the view reads them through sim_msg_count /
// sim_msg_at (k=0 = newest). Fixed array + write head — C18-safe (index-write + integer increment on
// a struct field both persist; never grow the vector).
pub fn sim_log(s: &Sim, m: text) {
  q = s.msg_q;
  i = (s.msg_n % MSG_MAX) ?? 0;
  if i >= 0 && i < len(q) { q[i] = m; }
  s.msg_n = s.msg_n + 1;
}
pub fn sim_msg_count(s: Sim) -> integer {
  if s.msg_n < MSG_MAX { return s.msg_n; }
  MSG_MAX
}
// Total messages ever logged (monotonic) — the view watches this to rebake only when it changes.
pub fn sim_msg_total(s: Sim) -> integer { s.msg_n }
// The k-th most-recent message (k = 0 is newest); "" if out of range.
pub fn sim_msg_at(s: Sim, k: integer) -> text {
  c = sim_msg_count(s);
  if k < 0 || k >= c { return ""; }
  q = s.msg_q;
  idx = ((s.msg_n - 1 - k) % MSG_MAX) ?? 0;
  if idx < 0 { idx = idx + MSG_MAX; }
  if idx >= 0 && idx < len(q) { return q[idx] ?? ""; }
  ""
}

pub fn sim_award_xp(s: &Sim, amount: integer) {
  if amount > 0 { s.xp += amount; }
  while s.clevel < MAX_CLEVEL && s.xp >= xp_need(s, s.clevel + 1) {   // race expfact scales the curve
    s.clevel += 1;
    refresh_stats(s);   // max HP grows with level (hero_maxhp); the gained HP is granted
    s.stat_pts += 1;    // BANK a stat-growth point — never auto-spent; the player picks when ready
    sim_log(s, "Welcome to level {s.clevel}!");
  }
}

// Spend a banked stat point on `stat` (player-chosen growth). Succeeds only if a point is banked
// AND the stat is off cooldown (last rose >= STAT_COOLDOWN levels ago). Returns whether it applied,
// so a deferred hoard of points can be timed + spread, but never dumped into one stat.
pub fn sim_raise_stat(s: &Sim, stat: text) -> boolean {
  i = stat_index(stat);
  if i < 0 || s.stat_pts <= 0 { return false; }
  ga = s.stat_grown_at;
  last = ga[i] ?? 0;
  if last != 0 && (s.clevel - last) < STAT_COOLDOWN { return false; }   // on cooldown
  mx = s.stat_max; mx[i] = (mx[i] ?? 0) + 1;
  cu = s.stat_cur; cu[i] = (cu[i] ?? 0) + 1;
  ga[i] = s.clevel;
  s.stat_pts = s.stat_pts - 1;
  refresh_stats(s);
  true
}

// Banked stat-growth points awaiting the player's choice (0 = none pending).
pub fn sim_stat_points(s: Sim) -> integer { s.stat_pts }

// Can the player raise `stat` right now? (a point is banked and the stat is off cooldown) — for
// the level-up choice UI to enable / grey out each stat.
pub fn sim_can_raise_stat(s: Sim, stat: text) -> boolean {
  i = stat_index(stat);
  if i < 0 || s.stat_pts <= 0 { return false; }
  ga = s.stat_grown_at;
  last = ga[i] ?? 0;
  last == 0 || (s.clevel - last) >= STAT_COOLDOWN
}

// ── Loot (gold + item drops) ─────────────────────────────────────────

// Drop-RNG: advance the per-Sim LCG (same module as its caller, so the `&`
// mutation sticks) and return a value in [lo, hi].
pub fn sim_roll(s: &Sim, lo: integer, hi: integer) -> integer {   // pub: castfx rolls spell failure
  if hi <= lo { return lo; }
  s.rstate = (s.rstate * 1103515245 + 12345) & 2147483647;
  lo + (s.rstate % (hi - lo + 1) ?? 0)
}

// Add a floor entry (gold pile if gold>0, else an item with cat/def) by writing
// into the fixed arrays at the count slot — runtime append to a struct field is
// unreliable in loft, so we index-write like `enemies`.
fn add_floor(s: &Sim, q: integer, r: integer, gold: integer, cat: integer, def: integer) {
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fc = s.fi_cat;
  fd = s.fi_def;
  fl = s.fi_live;
  n = s.fi_n;
  if n >= 0 && n < len(fq) && n < len(fr) && n < len(fg) && n < len(fc) && n < len(fd) && n < len(fl) {
    fq[n] = q;
    fr[n] = r;
    fg[n] = gold;
    fc[n] = cat;
    fd[n] = def;
    fl[n] = 1;
    s.fi_n = n + 1;
  }
}

// On a kill: drop a gold pile, and sometimes a depth-appropriate item, at (q,r).
fn drop_loot(s: &Sim, q: integer, r: integer, mlvl: integer) {
  gamt = sim_roll(s, 1, 3) * (mlvl + 1) + sim_roll(s, 0, 4);
  add_floor(s, q, r, gamt, -1, -1);
  if sim_roll(s, 0, 99) < 35 {
    itbl = game_items();
    idx = item_choose_idx(itbl, s.depth, sim_roll(s, 1, 2000000000));
    if idx >= 0 {
      cat = item_cat(itbl, idx);
      add_floor(s, q, r, 0, cat, idx);
    }
  }
}

// Drop a specific item by key on the floor at (q, r) — used for the bundle boss-drop.
fn sim_drop_item(s: &Sim, q: integer, r: integer, key: text) {
  itbl = game_items();
  idx = item_index(itbl, key);
  if idx >= 0 { add_floor(s, q, r, 0, item_cat(itbl, idx), idx); }
}

// A set-piece UNIQUE died: record quest progress, announce it, and — if the active overlay names a
// boss-drop — leave it at the death spot (the escape hatch). One place, called from both kill paths.
fn sim_on_unique_death(s: &Sim, eq: integer, er: integer, ename: text) {
  s.boss_slain = 1;
  sim_log(s, "{ename} falls — its brood breaks loose!");
  if world_has_placement() == 1 {
    bd = world_placement().boss_drop;
    if bd != "" {
      sim_drop_item(s, eq, er, bd);
      sim_log(s, "From its coils spills a vial of antivenin.");
    }
  }
}

// Combat damage multiplier (percent) from the attacker↔defender level gap, capped
// BOTH ways: past ±COMBAT_DELTA_CAP levels the gap stops mattering, so level shifts a
// fight by at most ±(CAP*STEP)% — difficulty is skill, not level (§3a #2). Symmetric:
// mult(a,b) + mult(b,a) == 200. Monsters attack through the SAME function (the mirror).
pub fn combat_mult_pct(att_lvl: integer, def_lvl: integer) -> integer {
  d = att_lvl - def_lvl;
  if d > COMBAT_DELTA_CAP { d = COMBAT_DELTA_CAP; }
  if d < 0 - COMBAT_DELTA_CAP { d = 0 - COMBAT_DELTA_CAP; }
  100 + d * COMBAT_STEP
}

// Apply the level-ratio cap to a base hit, never below 1: you always chip, and nothing
// is ever fully negated (the no-100%-immunity rule, §3a #3).
pub fn capped_dmg(base: integer, att_lvl: integer, def_lvl: integer) -> integer {
  v = base * combat_mult_pct(att_lvl, def_lvl) / 100 ?? 0;
  if v < 1 { v = 1; }
  v
}

// Player hits enemy `idx` for capped melee damage; on a kill, awards XP and drops loot.
fn player_attack(s: &Sim, idx: integer) {
  enemies = s.enemies;
  if idx >= 0 && idx < len(enemies) {
    e = enemies[idx];
    if e.alive {
      e.hp -= capped_dmg(s.wdam, s.clevel, e.mlvl);
      gain = 0;
      if e.hp <= 0 {
        e.alive = false;
        gain = e.xp * e.mlvl / s.clevel ?? 0;
        if gain < 1 { gain = 1; }
        drop_loot(s, e.cur_q, e.cur_r, e.mlvl);
        sim_log(s, "You have slain the {e.name}.");
        if (e.flags & MF_UNIQUE) != 0 { sim_on_unique_death(s, e.cur_q, e.cur_r, e.name); }
      }
      enemies[idx] = e;
      if gain > 0 { sim_award_xp(s, gain); }
    }
  }
}

// Fire the equipped launcher (SLOT_BOW) at the nearest SEEN enemy in range, spending one ammo.
// Damage = ammo dice average * launcher multiplier (i_power) + the shooting skill, then the same
// level-ratio cap as melee (crawler combat is auto-hit-capped, not a to-hit roll). A quick-slot
// (Q/E or 1-9) triggers this; the action itself is input-scheme-agnostic.
// Returns: 0 no launcher, 1 no ammo, 2 no target, 3 hit, 4 kill.
// Auto-aim (shared by the launcher AND attack spells): among SEEN enemies in range, score by
// distance with a frontal bonus — very near wins on distance, but at roughly equal range the one
// more dead-ahead of your heading wins. A mob BEHIND the character (front <= 0) can never be
// targeted. Returns the enemy index, or -1 with nothing in your sights.
fn aim_target(s: Sim) -> integer {
  enemies = s.enemies;
  hx = cos(s.heading);
  hy = sin(s.heading);
  epx = 0.0;                 // pre-declared so the nested tuple-assign below resolves (no nested destructure-decl)
  epy = 0.0;
  target = -1;
  bestscore = (FIRE_RANGE as float) + 100.0;
  for i in 0..len(enemies) {
    e = enemies[i];
    if e.alive && sim_monster_sense(s, i) == SENSE_SEE {
      d = sim_enemy_dist(s, i);
      if d <= FIRE_RANGE {
        (epx, epy) = sim_enemy_pos(s, i);
        dx = epx - s.px;
        dy = epy - s.py;
        ln = sqrt(dx * dx + dy * dy);
        front = 0.0;
        if ln > 0.0 { front = (dx * hx + dy * hy) / ln ?? 0.0; }   // -1 behind .. +1 dead ahead
        if front > 0.0 {                                            // never target what's behind you
          eff = (d as float) - FRONT_AIM * front;
          if eff < bestscore { bestscore = eff; target = i; }
        }
      }
    }
  }
  target
}

// Hurl a magic BOLT (an attack spell's kernel verb): the launcher's auto-aim, no launcher or ammo.
// `dam` is the spell's damage knob (its s_power). Returns 0 = nothing in sights, 3 = hit, 4 = slain.
pub fn sim_bolt(s: &Sim, dam: integer) -> integer {
  target = aim_target(s);
  if target < 0 { return 0; }
  enemies = s.enemies;
  e = enemies[target];
  e.hp -= capped_dmg(dam, s.clevel, e.mlvl);
  ret = 3;
  gain = 0;
  if e.hp <= 0 {
    e.alive = false;
    gain = e.xp * e.mlvl / s.clevel ?? 0;
    if gain < 1 { gain = 1; }
    drop_loot(s, e.cur_q, e.cur_r, e.mlvl);
    sim_log(s, "Your bolt slays the {e.name}.");
    if (e.flags & MF_UNIQUE) != 0 { sim_on_unique_death(s, e.cur_q, e.cur_r, e.name); }
    ret = 4;
  } else {
    sim_log(s, "Your bolt strikes the {e.name}.");
  }
  enemies[target] = e;
  if gain > 0 { sim_award_xp(s, gain); }
  ret
}

pub fn sim_fire(s: &Sim) -> integer {
  bow = s.eq[SLOT_BOW] ?? 0;
  if bow == 0 { return 0; }
  itbl = game_items();
  mult = item_power(itbl, bow - 1);
  iv = s.inv;
  ammo_slot = -1;
  for k in 0..s.ninv {
    if ammo_slot < 0 && k < len(iv) {
      di = iv[k] ?? -1;
      if item_cat(itbl, di) == IT_AMMO { ammo_slot = k; }
    }
  }
  if ammo_slot < 0 { return 1; }
  target = aim_target(s);
  if target < 0 { return 2; }
  enemies = s.enemies;
  ad = iv[ammo_slot] ?? -1;
  avg = item_dd(itbl, ad) * (item_ds(itbl, ad) + 1) / 2 ?? 0;
  base = avg * mult + sim_skill_shoot(s);
  e = enemies[target];
  e.hp -= capped_dmg(base, s.clevel, e.mlvl);
  ret = 3;
  gain = 0;
  if e.hp <= 0 {
    e.alive = false;
    gain = e.xp * e.mlvl / s.clevel ?? 0;
    if gain < 1 { gain = 1; }
    drop_loot(s, e.cur_q, e.cur_r, e.mlvl);
    sim_log(s, "Your shot slays the {e.name}.");
    if (e.flags & MF_UNIQUE) != 0 { sim_on_unique_death(s, e.cur_q, e.cur_r, e.name); }
    ret = 4;
  } else {
    sim_log(s, "Your shot strikes the {e.name}.");
  }
  enemies[target] = e;
  sim_consume_inv(s, ammo_slot);
  if gain > 0 { sim_award_xp(s, gain); }
  ret
}

// Auto-collect any gold pile under the player (called each frame from sim_step).
fn sim_autocollect_gold(s: &Sim) {
  (pq, pr) = px_to_hex(s.px, s.py);
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fl = s.fi_live;
  n = s.fi_n;
  for i in 0..n {
    if (fl[i] ?? 0) == 1 {
      q = fq[i] ?? -999;
      r = fr[i] ?? -999;
      amt = fg[i] ?? 0;
      if q == pq && r == pr && amt > 0 {
        s.gold += amt;
        fl[i] = 0;
      }
    }
  }
}

// Pick up everything under the player ('g'): gold to the purse, items to inventory.
pub fn sim_pickup(s: &Sim) {
  (pq, pr) = px_to_hex(s.px, s.py);
  fq = s.fi_q;
  fr = s.fi_r;
  fg = s.fi_gold;
  fd = s.fi_def;
  fl = s.fi_live;
  iv = s.inv;
  n = s.fi_n;
  for i in 0..n {
    if (fl[i] ?? 0) == 1 {
      q = fq[i] ?? -999;
      r = fr[i] ?? -999;
      if q == pq && r == pr {
        amt = fg[i] ?? 0;
        if amt > 0 {
          s.gold += amt;
          sim_log(s, "You find {amt} gold.");
        } else {
          ni = s.ninv;
          if ni >= 0 && ni < len(iv) {
            di = fd[i] ?? -1;
            iv[ni] = di;
            s.ninv = ni + 1;
            sim_log(s, "You pick up the {sim_item_display_name(s, di)}.");
            sim_qs_autoslot(s, di);    // auto-fill a quick-slot on first pickup of a useable item
          }
        }
        fl[i] = 0;
      }
    }
  }
}

// ── Clock & step ─────────────────────────────────────────────────────

// One world tick: each live enemy commits its move; if adjacent to the player
// it attacks (instead of moving), else it steps toward the player.
// Round to nearest integer (as float), correct for negatives — for cube lerp.
// (`as integer` truncates toward zero, so bias by ±0.5 before truncating.)
fn rnd_f(v: float) -> float {
  base = v + 0.5;
  if v < 0.0 { base = v - 0.5; }
  i = base as integer;
  i as float
}

// Hex line-of-sight: true if no solid hex blocks the line between the two hex
// centres (endpoints excluded). Cube-coordinate interpolation + rounding.
pub fn hex_los(s: Sim, q0: integer, r0: integer, q1: integer, r1: integer) -> boolean {
  n = hex_distance(q0, r0, q1, r1);
  blocked = false;
  if n > 1 {
    x0 = q0;
    z0 = r0;
    y0 = 0 - q0 - r0;
    x1 = q1;
    z1 = r1;
    y1 = 0 - q1 - r1;
    for li in 1..n {
      t = li as float / n as float ?? 0.0;
      fx = x0 as float + (x1 - x0) as float * t;
      fy = y0 as float + (y1 - y0) as float * t;
      fz = z0 as float + (z1 - z0) as float * t;
      rx = rnd_f(fx);
      ry = rnd_f(fy);
      rz = rnd_f(fz);
      dx = abs(rx - fx);
      dy = abs(ry - fy);
      dz = abs(rz - fz);
      if dx > dy && dx > dz {
        rx = 0.0 - ry - rz;
      } else if dy > dz {
        ry = 0.0 - rx - rz;
      } else {
        rz = 0.0 - rx - ry;
      }
      if is_wall(s, rx as integer, rz as integer) { blocked = true; }
    }
  }
  !blocked
}

// ── Field of view (FOV / fog-of-war) ─────────────────────────────────
// DIRECTED light: your sight radius depends on the angle to your heading — full
// VISION_RADIUS straight ahead, falling off to NEAR_RADIUS behind you (a forward-pointed
// lamp), by line of sight, plus an always-visible NEAR_RADIUS bubble. So turning points
// your light — a real choice. `vis` is recomputed each call; `seen` accumulates the
// revealed map (memory; fresh per level → lost on death). The view (or a test) calls
// this; the visibility set is renderer-agnostic (immediate or GPU — RENDER.md).
pub fn sim_compute_fov(s: &Sim) {
  vis = s.vis;
  seen = s.seen;
  // SURFACE DAYLIGHT: depth 0 has NO light radius — open desert under the sky, the player
  // sees to the screen edge all the time (the view merely clips). Everything is lit; the
  // directed-lamp cone below is a DUNGEON thing.
  if s.depth == 0 {
    for di in 0..len(vis) { vis[di] = 1; }
    for dj in 0..len(seen) { seen[dj] = 1; }
    return;
  }
  // Read the scalar bounds into locals once before the hot loop (a small micro-opt). This loop's
  // shape (per-cell tuple-returns like hex_to_px) was the repro that surfaced loft#299 — a parser
  // bug that dropped a thin struct-return's result, fixed in loft2 fc80115 (LOFT_ISSUES C21).
  lw = s.lw;
  lh = s.lh;
  qmin = s.qmin;
  rmin = s.rmin;
  spx = s.px;
  spy = s.py;
  (pq, pr) = px_to_hex(spx, spy);
  hx = cos(s.heading);
  hy = sin(s.heading);
  nearf = NEAR_RADIUS as float;
  // Effective sight radius: the base, WIDENED by a bright equipped light (never reduced).
  // The Everbright Torch (radius 12 > base 10) lets you see further; weak lights don't
  // shrink the base. (The fuller "no light = dark" model is a later step.)
  vr = VISION_RADIUS;
  ll = s.eq[SLOT_LIGHT] ?? 0;
  if ll > 0 {
    litbl = game_items();
    ldi = ll - 1;
    if ldi >= 0 && ldi < len(litbl) {
      ldef = litbl[ldi];
      if ldef.i_power > vr { vr = ldef.i_power; }
    }
  }
  visf = vr as float;
  for gr in 0..lh {
    for gq in 0..lw {
      idx = gr * lw + gq;
      q = qmin + gq;
      r = rmin + gr;
      v = 0;
      d = hex_distance(pq, pr, q, r);
      if d <= NEAR_RADIUS {
        v = 1;                                         // always-visible bubble (your feet)
      } else if d <= vr {
        (cxp, cyp) = hex_to_px(q, r);
        dx = cxp - spx;
        dy = cyp - spy;
        ln = sqrt(dx * dx + dy * dy);
        if ln > 0.0 {
          dot = (dx * hx + dy * hy) / ln ?? 0.0;        // -1 behind .. +1 ahead
          fwd = (dot + 1.0) / 2.0 ?? 0.0;               // 0 behind .. 1 ahead
          eff = nearf + (visf - nearf) * fwd * fwd;     // directed-lamp falloff (forward-biased)
          if (d as float) <= eff && hex_los(s, pq, pr, q, r) { v = 1; }
        }
      }
      if idx >= 0 && idx < len(vis) { vis[idx] = v; }
      if v != 0 && idx >= 0 && idx < len(seen) { seen[idx] = 1; }
    }
  }
}

// Render state of a hex: 2 = visible now, 1 = remembered (seen before), 0 = unseen.
pub fn sim_hex_state(s: Sim, q: integer, r: integer) -> integer {
  gq = q - s.qmin;
  gr = r - s.rmin;
  if gq < 0 || gq >= s.lw || gr < 0 || gr >= s.lh { return 0; }
  idx = gr * s.lw + gq;
  vis = s.vis;
  v = vis[idx] ?? 0;
  if v != 0 { return 2; }
  seen = s.seen;
  sn = seen[idx] ?? 0;
  if sn != 0 { return 1; }
  0
}

// FOV render state at a world position — convenience for the view (enemies/items/walls).
pub fn sim_hex_state_at(s: Sim, wx: float, wy: float) -> integer {
  (q, r) = px_to_hex(wx, wy);
  sim_hex_state(s, q, r)
}

// Line of sight from the player to hex (q,r) — convenience for perception/targeting.
pub fn sim_los_to(s: Sim, q: integer, r: integer) -> boolean {
  (pq, pr) = px_to_hex(s.px, s.py);
  hex_los(s, pq, pr, q, r)
}

// How the player PERCEIVES monster `i` right now — the canonical perception query a full game
// renders + reasons from (the view shows SEEN solid, FELT as a marker, HEARD as a blip). Best
// channel wins: SEE > FEEL > HEAR > NONE. Everything that changes perception plugs in HERE as
// a modifier, never as a view special-case:
//   - the player's lit FOV (sim_hex_state) feeds SEE;
//   - a self-luminous monster (MF_GLOW) is its own light — SEEN in the dark given LOS;
//   - the detect-monsters potion / telepathy (s.detect_t) feeds FEEL (through walls);
//   - an awake monster's noise within HEAR_RADIUS feeds HEAR.
pub fn sim_monster_sense(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return SENSE_NONE; }
  e = enemies[i];
  if !e.alive { return SENSE_NONE; }
  if sim_hex_state(s, e.cur_q, e.cur_r) == 2 { return SENSE_SEE; }   // in the player's lit FOV
  (pq, pr) = px_to_hex(s.px, s.py);
  if (e.flags & MF_GLOW) != 0 && hex_los(s, pq, pr, e.cur_q, e.cur_r) {
    return SENSE_SEE;                                                // glows: no light needed, just LOS
  }
  if s.detect_t > 0 { return SENSE_FEEL; }                          // detection / telepathy modifier
  if e.awake && hex_distance(pq, pr, e.cur_q, e.cur_r) <= HEAR_RADIUS { return SENSE_HEAR; }
  SENSE_NONE
}

// Make monster `i` self-luminous (MF_GLOW) — for glowing monster types, or a "faerie fire"
// style effect that lights one up. Feeds sim_monster_sense's SEE-without-light channel.
pub fn sim_make_glow(s: &Sim, i: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.flags = e.flags | MF_GLOW;
  enemies[i] = e;
}

// Give monster `i` a paralysing gaze (MF_GAZE) — a curse/hex effect, and the test hook for the gaze.
pub fn sim_make_gaze(s: &Sim, i: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.flags = e.flags | MF_GAZE;
  enemies[i] = e;
}

pub fn sim_tick(s: &Sim) {
  s.ticks += 1;
  // Venom bleeds the player each tick (silent — the HP bar shows it; death is logged). The antivenin
  // ward suppresses it.
  if s.poison_until > s.ticks && s.poison_dmg > 0 && s.venom_until <= s.ticks {
    s.php -= s.poison_dmg;
    if s.php <= 0 { s.php = 0; s.over = true; sim_log(s, "The venom stops your heart."); }
  }
  // Natural HP regeneration (Angband: everyone's wounds slowly knit; RF_REGEN — the half-troll —
  // doubles the pace). POISON blocks it entirely (venom keeps the wounds open).
  if !s.over && s.php < s.phpmax && s.poison_until <= s.ticks {
    every = REGEN_EVERY;
    if (s.rc_flags & RF_REGEN) != 0 { every = every / 2 ?? every; }
    if (s.ticks % every ?? 0) == 0 { s.php += 1; }
  }
  // Mana returns over the clock too (casters only — spmax 0 otherwise).
  if !s.over && s.sp < s.spmax {
    if (s.ticks % SP_REGEN_EVERY ?? 0) == 0 { s.sp += 1; }
  }
  // Temporary stat modifiers (good/bad potions) tick down; expired ones stop applying.
  ttv = s.stat_tmp_t;
  for si in 0..NUM_STATS {
    t = ttv[si] ?? 0;
    if t > 0 { ttv[si] = t - 1; }
  }
  if s.detect_t > 0 { s.detect_t = s.detect_t - 1; }   // monster-detection decays
  (pq, pr) = px_to_hex(s.px, s.py);
  flow = compute_flow(s, pq, pr);   // shared by every chasing monster this tick
  pstealth = sim_skill_stealth(s);  // shrinks each monster's wake range this tick
  enemies = s.enemies;
  for et in 0..len(enemies) {
    e = enemies[et];
    if e.alive {
      // Clock-driven speed: bank this tick's energy, spend ENERGY_STEP per action. So a normal
      // monster (speed 10) acts once per tick (keeps pace with the player); a +5 monster banks
      // 15 -> 1 action this tick, 2 the next (1.5x). Leftover energy carries over.
      gain = e.speed;
      if e.stun_until >= s.ticks { gain = 0; }                 // stunned: reeling, banks nothing
      else if e.slow_until >= s.ticks { gain = e.speed / 2; }  // slowed: half pace
      e.energy = e.energy + gain;
      nsteps = e.energy / ENERGY_STEP;
      e.energy = e.energy - nsteps * ENERGY_STEP;
      for _ in 0..nsteps {
        e.cur_q = e.tgt_q;
        e.cur_r = e.tgt_r;
        d = hex_distance(e.cur_q, e.cur_r, pq, pr);
        // Awareness: a sleeping monster wakes when the player is within its
        // vision and in line of sight; once awake it stays awake.
        evis = e.vision - pstealth;        // stealth shrinks how near the player must be to wake it
        if evis < 1 { evis = 1; }          // but it always notices an adjacent / attacking player
        if !e.awake && d <= evis && hex_los(s, e.cur_q, e.cur_r, pq, pr) {
          e.awake = true;
        }
        if e.awake {
          if d <= 1 {
            hit = false;
            if e.dam > 0 {     // 0-melee monsters (the floating eye — its threat is the GAZE) truly
                               // deal no melee; without this the capped-dmg floor gives them 1
              s.php -= apply_dr(capped_dmg(e.dam, e.mlvl, s.clevel), s.pac);  // ratio cap, then armour DR
              sim_log(s, "The {e.name} hits you.");
              hit = true;
              if s.php <= 0 { s.over = true; sim_log(s, "You die."); }
            }
            // GAZE (floating eye): paralyse unless saved. Re-rolled each tick while adjacent — the
            // authentic horror (escapable but lethal). Only the NEW paralysis is announced (no spam).
            if (e.flags & MF_GAZE) != 0 && !s.over && !sim_player_free_action(s) && sim_save_fails(s) {
              was = s.para_until > s.ticks;
              s.para_until = s.ticks + PARA_DUR;
              if !was { sim_log(s, "The {e.name} fixes you with its gaze — you cannot move!"); }
            }
            // POISON (venomous bite): a landed bite can poison, unless warded (antivenin) or saved.
            if (e.flags & MF_POISON) != 0 && hit && !s.over && s.venom_until <= s.ticks && !sim_player_res_poison(s) && sim_save_fails(s) {
              was = s.poison_until > s.ticks;
              s.poison_until = s.ticks + POISON_DUR;
              s.poison_dmg = POISON_DMG;
              if !was { sim_log(s, "The {e.name}'s bite floods you with venom."); }
            }
            e.tgt_q = e.cur_q;
            e.tgt_r = e.cur_r;
          } else if (e.flags & MF_NEVER_MOVE) != 0 {
            e.tgt_q = e.cur_q;         // stationary (molds, eyes): never steps
            e.tgt_r = e.cur_r;
          } else {
            (bq, br) = flow_step(s, flow, e.cur_q, e.cur_r, pq, pr);
            e.tgt_q = bq;
            e.tgt_r = br;
          }
        } else {
          e.tgt_q = e.cur_q;           // asleep: holds position
          e.tgt_r = e.cur_r;
        }
      }
      enemies[et] = e;
    }
  }
}

// Wait: advance one world tick in place (enemies act, the player doesn't move).
pub fn sim_wait(s: &Sim) {
  if !s.over { sim_tick(s); }
}

// Advance one frame.  fwd in {-1,0,1}, turn in {-1,0,1}, dt seconds.
// Reclaim the grave's gold by standing on the death spot at its depth (any character —
// owner-less, no PvP). Called each frame from sim_step.
fn sim_reclaim_grave(s: &Sim) {
  if s.grave_gold <= 0 { return; }
  if s.depth != s.grave_depth { return; }
  (pq, pr) = px_to_hex(s.px, s.py);
  if pq == s.grave_q && pr == s.grave_r {
    s.gold += s.grave_gold;
    s.grave_gold = 0;
  }
}

// Grant gold (quest / reward income; also used by tests).
pub fn sim_grant_gold(s: &Sim, amt: integer) {
  if amt > 0 { s.gold += amt; }
}

pub fn sim_step(s: &Sim, fwd: integer, turn: integer, dt: float) {
  if s.over { return; }
  // PARALYSED: the player can't act, but the world must still advance (the gaze horror — and the
  // MP-shaped invariant that sim_tick never depends on THIS player's volition). Advance the clock at
  // wait pace, FASTER when the player struggles (presses move), so an impatient player fast-forwards
  // the same ticks, not the outcome. The player does not move.
  if s.para_until > s.ticks {
    rate = MOVE_SPEED;
    if fwd != 0 || turn != 0 { rate = MOVE_SPEED * (STRUGGLE_X as float); }
    s.accrued += rate * dt;
    while s.accrued >= HEX_LEN {
      s.accrued -= HEX_LEN;
      sim_tick(s);
    }
    return;
  }
  if turn != 0 {
    s.heading += (turn as float) * TURN_SPEED * dt;
  }
  if fwd != 0 {
    step = (fwd as float) * MOVE_SPEED * dt;
    dx = cos(s.heading) * step;
    dy = sin(s.heading) * step;
    moved_x = 0.0;
    moved_y = 0.0;
    // Axis-separated so the player slides along walls; probe one radius ahead
    // in the direction of travel so the centre halts short of the wall face.
    if dx != 0.0 {
      sxr = if dx > 0.0 { PLAYER_RADIUS } else { 0.0 - PLAYER_RADIUS };
      if !pos_blocked(s, s.px, s.py, s.px + dx + sxr, s.py) {
        s.px += dx;
        moved_x = dx;
      }
    }
    if dy != 0.0 {
      syr = if dy > 0.0 { PLAYER_RADIUS } else { 0.0 - PLAYER_RADIUS };
      if !pos_blocked(s, s.px, s.py, s.px, s.py + dy + syr) {
        s.py += dy;
        moved_y = dy;
      }
    }
    dist = sqrt(moved_x * moved_x + moved_y * moved_y);
    // Pressing forward into an enemy = melee: advance the clock at walking pace
    // even though the player can't move, landing a hit each tick.
    fe = if fwd > 0 { front_enemy(s) } else { -1 };
    sd = abs(step);
    if fe >= 0 && dist < sd { dist = sd; }
    s.accrued += dist;
    while s.accrued >= HEX_LEN {
      s.accrued -= HEX_LEN;
      if fe >= 0 {
        ev = s.enemies;
        e = ev[fe];
        // a SHRINE (the spawning crystal): bumping it INTERACTS — never melee. (Ranged
        // fire can still destroy it; that loss is the player's own choice.)
        if (e.flags & MF_SHRINE) != 0 { s.shrine_ev = 1; }
        else { player_attack(s, fe); }
      }
      sim_tick(s);
    }
  }
  sim_autocollect_gold(s);   // walking over a gold pile picks it up
  sim_reclaim_grave(s);      // standing on your grave reclaims its staked gold
}

// ── Read-only accessors for the view / tests ────────────────────────

pub fn sim_frac(s: Sim) -> float { s.accrued / HEX_LEN }

pub fn sim_player_hex(s: Sim) -> (integer, integer) { px_to_hex(s.px, s.py) }

pub fn sim_enemy_count(s: Sim) -> integer { len(s.enemies) }

// ---- Dungeon persistence: deterministic base + a stored DEATH delta --------------------------
// A level is a pure function of its seed (world_key_seed -> gen), so the layout + surviving
// monsters (at their natural spawns) come free on re-entry. The ONLY thing persisted is what
// diverged: which spawns died. sim_dead_indices extracts that delta; sim_apply_dead replays it
// onto a freshly regenerated level. Round-trip = identity. (Location/HP/effects/taken-items/
// tombstones can join the delta later for deeper persistence — death-only is the cheap default.)
pub fn sim_dead_indices(s: Sim) -> vector<integer> {
  enemies = s.enemies;
  out: vector<integer> = [];
  for i in 0..len(enemies) {
    e = enemies[i];
    if !e.alive { out += [i]; }
  }
  out
}

pub fn sim_apply_dead(s: &Sim, dead: vector<integer>) {
  enemies = s.enemies;
  for k in 0..len(dead) {
    i = dead[k] ?? -1;
    if i >= 0 && i < len(enemies) {
      e = enemies[i];
      e.alive = false;
      enemies[i] = e;
    }
  }
}

// Store a level's death delta into its per-depth block (OVERWRITE — no growth, bounded).
pub fn sim_store_dead(s: &Sim, depth: integer, dead: vector<integer>) {
  if depth < 0 || depth >= DEPTH_MAX { return; }
  di = s.dd_idx;
  dn = s.dd_n;
  base = depth * MAX_SPAWNS;
  cnt = 0;
  for k in 0..len(dead) {
    i = dead[k] ?? -1;
    if i >= 0 && cnt < MAX_SPAWNS && (base + cnt) < len(di) {
      di[base + cnt] = i;
      cnt = cnt + 1;
    }
  }
  if depth >= 0 && depth < len(dn) { dn[depth] = cnt; }
}

// Replay a level's stored death delta onto its freshly regenerated spawns (on re-entry).
pub fn sim_apply_stored_dead(s: &Sim, depth: integer) {
  if depth < 0 || depth >= DEPTH_MAX { return; }
  dn = s.dd_n;
  c = dn[depth] ?? 0;
  di = s.dd_idx;
  enemies = s.enemies;
  base = depth * MAX_SPAWNS;
  for k in 0..c {
    if (base + k) < len(di) {
      i = di[base + k] ?? -1;
      if i >= 0 && i < len(enemies) {
        e = enemies[i];
        e.alive = false;
        enemies[i] = e;
      }
    }
  }
}

pub fn sim_enemy_alive(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  alive = false;
  if i < len(enemies) {
    e = enemies[i];
    alive = e.alive;
  }
  alive
}

pub fn sim_enemy_cur(s: Sim, i: integer) -> (integer, integer) {
  enemies = s.enemies;
  rq = 0;
  rr = 0;
  if i < len(enemies) {
    e = enemies[i];
    rq = e.cur_q;
    rr = e.cur_r;
  }
  (rq, rr)
}

// Smoothly-interpolated enemy world position (cur -> tgt by clock fraction).
pub fn sim_enemy_pos(s: Sim, i: integer) -> (float, float) {
  enemies = s.enemies;
  ex = 0.0;
  ey = 0.0;
  if i < len(enemies) {
    e = enemies[i];
    (acx, acy) = hex_to_px(e.cur_q, e.cur_r);
    (atx, aty) = hex_to_px(e.tgt_q, e.tgt_r);
    f = s.accrued / HEX_LEN;
    ex = acx + (atx - acx) * f;
    ey = acy + (aty - acy) * f;
  }
  (ex, ey)
}

// Set monster i's per-tick energy gain (ENERGY_STEP = normal pace; higher = faster, lower =
// slower). The hook for the speed potion (slow others), a haste/slow-monster effect, and tests.
pub fn sim_set_speed(s: &Sim, i: integer, gain: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.speed = gain;
  enemies[i] = e;
}

// Afflict monster i with a status (ST_SLOW/ST_STUN) for `turns` ticks. The stop tick is
// PRE-CALCULATED (until = ticks + turns) and stored; the status then auto-expires when the
// clock passes it — no per-tick countdown. The hook for spells / thrown potions / the speed potion.
pub fn sim_afflict_enemy(s: &Sim, i: integer, kind: integer, turns: integer) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  until = s.ticks + turns;
  if kind == ST_SLOW { e.slow_until = until; }
  if kind == ST_STUN { e.stun_until = until; }
  enemies[i] = e;
}

// Is monster i currently under status `kind`? (the clock has not yet passed the stored expiry)
pub fn sim_enemy_afflicted(s: Sim, i: integer, kind: integer) -> boolean {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return false; }
  e = enemies[i];
  if kind == ST_SLOW { return e.slow_until >= s.ticks; }
  if kind == ST_STUN { return e.stun_until >= s.ticks; }
  false
}

// Wake or lull monster i (scripted ambush / sleep; tests).
pub fn sim_set_awake(s: &Sim, i: integer, awake: boolean) {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return; }
  e = enemies[i];
  e.awake = awake;
  enemies[i] = e;
}

// Hex distance from the player to monster i (AI / perception / tests). -1 if no such monster.
pub fn sim_enemy_dist(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  if i < 0 || i >= len(enemies) { return -1; }
  e = enemies[i];
  (pq, pr) = px_to_hex(s.px, s.py);
  hex_distance(pq, pr, e.cur_q, e.cur_r)
}

pub fn sim_player_hp(s: Sim) -> integer { s.php }
pub fn sim_player_hp_max(s: Sim) -> integer { s.phpmax }
pub fn sim_over(s: Sim) -> boolean { s.over }

pub fn sim_clevel(s: Sim) -> integer { s.clevel }
pub fn sim_xp(s: Sim) -> integer { s.xp }
pub fn sim_gold(s: Sim) -> integer { s.gold }

// Fraction from the current level toward the next (0..1) — for the XP bar.
pub fn sim_xp_frac(s: Sim) -> float {
  lo = xp_need(s, s.clevel);       // the XP bar tracks the race-scaled curve (expfact)
  hi = xp_need(s, s.clevel + 1);
  f = 0.0;
  if hi > lo {
    f = (s.xp - lo) as float / (hi - lo) as float ?? 0.0;
  }
  if f < 0.0 { f = 0.0; }
  if f > 1.0 { f = 1.0; }
  f
}

pub fn sim_inv_count(s: Sim) -> integer { s.ninv }

// ── Equipment queries (HUD + tests) ──────────────────────────────────
pub fn sim_player_dam(s: Sim) -> integer { s.wdam }   // melee damage (base + weapon)
pub fn sim_player_ac(s: Sim) -> integer { s.pac }     // armour class (HP + damage-reduction)
// Item def index equipped in `slot`, or -1 if empty.
pub fn sim_equipped(s: Sim, slot: integer) -> integer {
  eq = s.eq;
  e = eq[slot] ?? 0;
  if e > 0 { return e - 1; }
  -1
}

// Display name of the item worn in `slot`, or "" if empty (the inventory hub's equipped column).
pub fn sim_equipped_name(s: Sim, slot: integer) -> text {
  d = sim_equipped(s, slot);
  if d < 0 { return ""; }
  sim_item_display_name(s, d)
}
// Damage `raw` would deal after the player's armour DR (never below 1).
pub fn sim_mitigate(s: Sim, raw: integer) -> integer { apply_dr(raw, s.pac) }
pub fn sim_floor_count(s: Sim) -> integer { s.fi_n }

pub fn sim_floor_live(s: Sim, i: integer) -> boolean {
  fl = s.fi_live;
  v = false;
  if i < len(fl) { v = (fl[i] ?? 0) == 1; }
  v
}

// World position of floor item i.
pub fn sim_floor_pos(s: Sim, i: integer) -> (float, float) {
  fq = s.fi_q;
  fr = s.fi_r;
  x = 0.0;
  y = 0.0;
  if i < len(fq) && i < len(fr) {
    q = fq[i] ?? 0;
    r = fr[i] ?? 0;
    (x, y) = hex_to_px(q, r);
  }
  (x, y)
}

pub fn sim_floor_is_gold(s: Sim, i: integer) -> boolean {
  fg = s.fi_gold;
  v = false;
  if i < len(fg) { v = (fg[i] ?? 0) > 0; }
  v
}

pub fn sim_floor_cat(s: Sim, i: integer) -> integer {
  fc = s.fi_cat;
  c = 0;
  if i < len(fc) { c = fc[i] ?? 0; }
  c
}

pub fn sim_enemy_hp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 0;
  if i < len(enemies) { e = enemies[i]; v = e.hp; }
  v
}

pub fn sim_enemy_maxhp(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 1;
  if i < len(enemies) { e = enemies[i]; v = e.maxhp; }
  v
}

// Enemy display colour (0..255), from its monster-DB definition.
pub fn sim_enemy_color(s: Sim, i: integer) -> (integer, integer, integer) {
  enemies = s.enemies;
  ecr = 200;
  ecg = 60;
  ecb = 50;
  if i < len(enemies) { e = enemies[i]; ecr = e.cr; ecg = e.cg; ecb = e.cb; }
  (ecr, ecg, ecb)
}

// Is enemy i awake (has it perceived the player)?
pub fn sim_enemy_awake(s: Sim, i: integer) -> boolean {
  enemies = s.enemies;
  a = false;
  if i < len(enemies) { e = enemies[i]; a = e.awake; }
  a
}

// Monster i's NATIVE dungeon depth (m_depth) — for the slice depth-pool guard + the bestiary UI.
pub fn sim_enemy_mlvl(s: Sim, i: integer) -> integer {
  enemies = s.enemies;
  v = 0;
  if i < len(enemies) { e = enemies[i]; v = e.mlvl; }
  v
}

// Enemy single-char map glyph (e.g. "r", "k", "o").
pub fn sim_enemy_glyph(s: Sim, i: integer) -> text {
  enemies = s.enemies;
  g = "r";
  if i < len(enemies) { e = enemies[i]; g = e.glyph ?? "r"; }
  g
}

// Enemy display name (for the message log).
pub fn sim_enemy_name(s: Sim, i: integer) -> text {
  enemies = s.enemies;
  n = "";
  if i >= 0 && i < len(enemies) { e = enemies[i]; n = e.name ?? ""; }
  n
}

// World-space angle the enemy faces: its current move (cur→tgt), or — when it
// isn't moving — toward the player. Feeds the rotating sprite (the view snaps it
// to the 12-direction model). Hex-locked, so a moving facing is one of 6 dirs.
pub fn sim_enemy_facing(s: Sim, i: integer) -> float {
  enemies = s.enemies;
  a = PI / 2.0;
  if i >= 0 && i < len(enemies) {
    e = enemies[i];
    if e.tgt_q != e.cur_q || e.tgt_r != e.cur_r {
      (cx, cy) = hex_to_px(e.cur_q, e.cur_r);
      (tx, ty) = hex_to_px(e.tgt_q, e.tgt_r);
      a = atan2(ty - cy, tx - cx);
    } else {
      (ecx, ecy) = hex_to_px(e.cur_q, e.cur_r);
      a = atan2(s.py - ecy, s.px - ecx);
    }
  }
  a
}

// ── Construction ─────────────────────────────────────────────────────

pub fn sim_new() -> Sim {
  w = 21;
  h = 21;
  tiles: vector<integer> = [];
  for gr in 0..h {
    for gq in 0..w {
      edge = gq == 0 || gr == 0 || gq == w - 1 || gr == h - 1;
      tiles += [if edge { 1 } else { 0 }];
    }
  }
  // a couple of deterministic interior walls for visual reference
  for wr in 5..13 {
    wi = wr * w + 7;
    if wi < len(tiles) { tiles[wi] = 1; }
  }
  for wq in 9..16 {
    wj = 9 * w + wq;
    if wj < len(tiles) { tiles[wj] = 1; }
  }

  // Demo: a stepped diagonal line of solid hexes (SW corner) — its silhouette
  // should straighten into a clean diagonal wall, showing the wobble-averaging
  // produce an intermediate (non-edge) direction. Off the self-test paths.
  ds_q = [3, 4, 4, 5, 5, 6];
  ds_r = [3, 3, 4, 4, 5, 5];
  for di in 0..len(ds_q) {
    dq = ds_q[di] ?? 0;
    dr = ds_r[di] ?? 0;
    didx = dr * w + dq;
    if didx < len(tiles) { tiles[didx] = 1; }
  }

  // Edge walls: a 3-edge wall stub on hex (12,7), a low barrier you can bump
  // into — demonstrates edge walls alongside the full-hex walls above.
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  ewi = (7 * w + 12) * 3;
  for ee in 0..3 {
    eidx = ewi + ee;
    if eidx < len(walls) { walls[eidx] = 1; }
  }

  (spx, spy) = hex_to_px(10, 10);
  e0 = Enemy { cur_q: 10, cur_r: 16, tgt_q: 10, tgt_r: 16, hp: 8, maxhp: 8, dam: 3,
    xp: 2, mlvl: 1, vision: 8, flags: 0, awake: true, speed: ENERGY_STEP, energy: 0,
    slow_until: 0, stun_until: 0,
    cr: 200, cg: 60, cb: 50, glyph: "r", name: "training rat", alive: true };
  enemies: vector<Enemy> = [e0];

  s = Sim {
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    seen: zeros(w * h), vis: zeros(w * h),
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1), phpmax: hero_maxhp(1), over: false,
    clevel: 1, xp: 0, gold: 0, race: "human", pclass: "", sp: 0, spmax: 0,
    rc_flags: 0, rc_melee: 0, rc_bow: 0, rc_stealth: 0, rc_save: 0,
    rc_hd: 0, rc_xpf: 100, rc_realm: "none", rc_spi: -1, shrine_ev: 0,
    stat_max: start_stats(), stat_cur: start_stats(), stat_tmp: zeros(NUM_STATS), stat_tmp_t: zeros(NUM_STATS),
    stat_pts: 0, stat_grown_at: zeros(NUM_STATS), detect_t: 0,
    depth: 1, wseed: 0, save_depth: 1, up_q: 10, up_r: 10, dn_q: 10, dn_r: 16,
    grave_depth: 0, grave_q: 0, grave_r: 0, grave_gold: 0, boss_slain: 0,
    msg_q: [for _ in 0..MSG_MAX { "" }], msg_n: 0,
    para_until: 0, poison_until: 0, poison_dmg: 0, venom_until: 0,
    rstate: 12345, ninv: 0, inv: zeros(INV_MAX),
    eq: zeros(NUM_SLOTS), qs: zeros(QS_N), wdam: PLAYER_DAM, pac: 0,
    fi_n: 0, fi_q: zeros(FLOOR_MAX), fi_r: zeros(FLOOR_MAX), fi_gold: zeros(FLOOR_MAX),
    fi_cat: zeros(FLOOR_MAX), fi_def: zeros(FLOOR_MAX), fi_live: zeros(FLOOR_MAX),
    dd_idx: zeros(DEPTH_MAX * MAX_SPAWNS), dd_n: zeros(DEPTH_MAX),
    known: zeros(len(game_items())), flavour_idx: zeros(len(game_items())),
    room_q0: [], room_r0: [], room_w: [], room_h: [],   // hand-built level: no rooms → pure smooth
  };
  assign_flavours(s, 12345);   // training stub: a fixed-seed flavour map (real games key off the world seed)
  s
}

// ── Monster placement (Angband get_mon_num) ──────────────────────────

// Self-contained LCG (gen's RNG lives in another module; `&` mutation only
// propagates within a module, so placement keeps its own in `sim`).
struct SimRng { rs: integer not null }

fn srng_seed(seed: integer) -> SimRng { SimRng { rs: (seed & 2147483647) | 1 } }

fn srng(r: &SimRng, lo: integer, hi: integer) -> integer {
  if hi <= lo { return lo; }
  n = (r.rs * 1103515245 + 12345) & 2147483647;
  r.rs = n;
  span = hi - lo + 1;
  lo + (n % span ?? 0)
}

// Monster selection (get_mon_num) lives in monsters.loft as mon_choose —
// iterating the MonsterDef table with a struct fallback SIGSEGVs the interpreter
// from this module, but is fine inside monsters.loft where the type is defined.

// Build a live (asleep) Enemy from a MonsterDef at a hex. (The glyph is guarded
// to "?" — a struct-copy through the selection chain can drop the text field.)
fn mk_enemy(md: MonsterDef, q: integer, r: integer) -> Enemy {
  g = md.m_glyph;
  if len(g) == 0 { g = "?"; }
  Enemy { cur_q: q, cur_r: r, tgt_q: q, tgt_r: r,
    hp: md.m_hp, maxhp: md.m_hp, dam: md.m_dam,
    xp: md.m_xp, mlvl: md.m_depth,
    vision: md.m_vision, flags: md.m_flags, awake: false,
    speed: ENERGY_STEP + md.m_speed, energy: 0,
    slow_until: 0, stun_until: 0,
    cr: md.m_cr, cg: md.m_cg, cb: md.m_cb, glyph: g, name: md.m_name, alive: true }
}

// Is any already-placed enemy on this hex?
fn occupied_hex(enemies: vector<Enemy>, q: integer, r: integer) -> boolean {
  found = false;
  for oi in 0..len(enemies) {
    e = enemies[oi];
    if e.cur_q == q && e.cur_r == r { found = true; }
  }
  found
}

// Is (q,r) solid rock or off-map in this tile array?
fn tile_solid(tiles: vector<integer>, w: integer, h: integer, q: integer, r: integer) -> boolean {
  if q < 0 || r < 0 || q >= w || r >= h { return true; }
  ti = r * w + q;
  solid = true;
  if ti < len(tiles) { solid = (tiles[ti] ?? 1) == 1; }
  solid
}

// Procedural dungeon: rooms + corridors from gen_dungeon (world-keyed seed),
// the player placed in room 0; monsters scattered onto legal floor by the
// Angband placement pass (budget → get_mon_num → start-safe spot → groups).
// Renderer-agnostic — no graphics here.
// Thin wrapper: the common 2-arg entry (tests, the open arena) generates with NO quest progress —
// so a bare sim_new_gen never triggers the bundle's "way out" infestation. The game path
// (sim_descend) passes the carried boss_slain so the brood appears only after the boss dies.
// Per-GAME flavour assignment (the Angband "mystery"): give each unknown-type def a flavour index,
// shuffled per category from the world seed, so the flavour↔kind mapping changes each game. `known`
// stays all-0 (nothing identified yet). Deterministic + self-contained (its own LCG; level-independent
// — keyed on the pure world `seed`, not the per-depth gseed — so descend/respawn see the same map).
fn assign_flavours(s: &Sim, seed: integer) {
  itbl = game_items();
  n = len(itbl);
  fl = s.flavour_idx;                       // captured field vector — index-writes persist (C18)
  cats = [IT_POTION, IT_SCROLL, IT_WAND, IT_STAFF, IT_RING, IT_AMULET];
  for ci in 0..len(cats) {
    cat = cats[ci] ?? 0;
    pool: vector<integer> = [for j in 0..FLAVOUR_POOL { j }];   // a fresh [0..POOL) to shuffle
    // per-category LCG seed: MULTIPLY (Knuth hash) to diffuse the world seed's low bits — adding
    // barely moves it and `| 1` would collapse adjacent seeds onto one map.
    rs = (((seed * 2654435761) ^ ((cat + 1) * 1610612741)) & 2147483647) | 1;
    j = FLAVOUR_POOL - 1;
    while j > 0 {                            // Fisher–Yates
      rs = (rs * 1103515245 + 12345) & 2147483647;
      kk = rs % (j + 1) ?? 0;
      tmp = pool[j] ?? 0;
      pool[j] = pool[kk] ?? 0;
      pool[kk] = tmp;
      j -= 1;
    }
    t = 0;                                   // hand each def of this category the next shuffled flavour
    for i in 0..n {
      if i < len(itbl) {
        m = itbl[i];
        if m.i_cat == cat {
          fl[i] = pool[t % FLAVOUR_POOL ?? 0] ?? 0;
          t += 1;
        }
      }
    }
  }
}

pub fn sim_new_gen(seed: integer, depth: integer) -> Sim {
  sim_new_gen_p(seed, depth, 0)
}

pub fn sim_new_gen_p(seed: integer, depth: integer, infest: integer) -> Sim {
  w = 41;
  h = 41;
  // Per-level gen seed = mix(world seed, depth) so each depth has its own layout.
  gseed = (seed ^ world_key_seed(1, 1, depth)) & 2147483647;
  lvl = gen_dungeon(gseed, w, h, 24);   // more tries: overlap-rejection thins them to distinct rooms
  tiles = lvl.g_tiles;
  if depth == 0 {                          // the desert surface: an open, unended expanse
    for ti0 in 0..len(tiles) { tiles[ti0] = 0; }
  }
  walls: vector<integer> = [for _ in 0..(w * h * 3) { 0 }];
  rqs = lvl.g_rq;
  rrs = lvl.g_rr;
  rq0s = lvl.g_rq0;
  rr0s = lvl.g_rr0;
  rws = lvl.g_rw;
  rhs = lvl.g_rh;
  nrm = len(rqs);

  // Player in the first room.
  pq = w / 2;
  pr = h / 2;
  if nrm > 0 {
    pq = rqs[0] ?? (w / 2);
    pr = rrs[0] ?? (h / 2);
  }
  if depth == 0 { pq = w / 2; pr = h / 2; }   // surface: stand at the centre of the open desert
  (spx, spy) = hex_to_px(pq, pr);

  // Collect legal floor far from the player start, then sample the budget from
  // it directly (robust even when open floor is a small fraction of the map).
  table = monster_table();
  rng = srng_seed((gseed ^ 20771) & 2147483647);
  safe = 8;                             // keep spawns this far from the start
  candq: vector<integer> = [];
  candr: vector<integer> = [];
  for ccr in 1..(h - 1) {
    for ccq in 1..(w - 1) {
      if !tile_solid(tiles, w, h, ccq, ccr) && hex_distance(ccq, ccr, pq, pr) >= safe {
        candq += [ccq];
        candr += [ccr];
      }
    }
  }
  ncand = len(candq);
  budget = 10 + srng(rng, 0, 8);   // ~10–18
  if depth == 0 { budget = 0; }    // empty desert — no dungeon spawns (the crystal knot is step 3)
  if budget > ncand { budget = ncand; }
  enemies: vector<Enemy> = [];
  placed = 0;
  guard = 0;
  // Dedup is handled by occupied_hex (re-picking a taken cell just retries) —
  // a `used` marker vector built by comprehension read back null here.
  while placed < budget && guard < ncand * 4 + 100 {
    guard += 1;
    if ncand > 0 {
      k = srng(rng, 0, ncand - 1);
      sq = candq[k] ?? 1;
      sr = candr[k] ?? 1;
      if !occupied_hex(enemies, sq, sr) {
        eff = depth;
        if srng(rng, 0, 24) == 0 { eff = depth + srng(rng, 1, 4); }   // out-of-depth
        md = mon_choose(table, eff, srng(rng, 0, 2000000000));
        if md.m_hp > 0 {
          enemies += [mk_enemy(md, sq, sr)];
          placed += 1;
          if (md.m_flags & MF_GROUP) != 0 {
            gsz = srng(rng, 2, 4);
            for gk in 0..gsz {
              if placed < budget {
                (gq, gr) = hex_neighbor(sq, sr, gk % 6 ?? 0);
                if !tile_solid(tiles, w, h, gq, gr) && hex_distance(gq, gr, pq, pr) >= safe && !occupied_hex(enemies, gq, gr) {
                  enemies += [mk_enemy(md, gq, gr)];
                  placed += 1;
                }
              }
            }
          }
        }
      }
    }
  }

  // The surface's spawning crystal + its knot (SLICE step 3, rough v1: pre-placed, no runtime
  // growth). A stationary crystal a few steps west of the start, ringed by a small knot of weak
  // (depth-1) monsters it has "spawned" — the entrance is to the east, so the player chooses to
  // engage the crystal or head straight in.
  if depth == 0 {
    ctbl = monster_table();
    cx = pq - 6;
    cy = pr;
    cd = mon_find(ctbl, "spawn_crystal");
    if cd.m_hp > 0 {
      enemies += [mk_enemy(cd, cx, cy)];
      for gk in 0..4 {
        (gq, gr) = hex_neighbor(cx, cy, gk);
        wk = mon_choose(ctbl, 1, (gseed ^ ((gk + 1) * 2654435761)) & 2147483647);
        if wk.m_hp > 0 && !tile_solid(tiles, w, h, gq, gr) && !occupied_hex(enemies, gq, gr) {
          enemies += [mk_enemy(wk, gq, gr)];
        }
      }
    }
  }

  // Stairs: up at the player start, down at the farthest reachable floor hex.
  dnq = pq;
  dnr = pr;
  bestdd = -1;
  for si in 0..ncand {
    if si < ncand {
      cq = candq[si] ?? pq;
      cr = candr[si] ?? pr;
      dd = hex_distance(cq, cr, pq, pr);
      if dd > bestdd { bestdd = dd; dnq = cq; dnr = cr; }
    }
  }
  if depth == 0 { dnq = pq + 3; dnr = pr; }   // surface: the dungeon entrance sits a few steps east
  ti_up = pr * w + pq;
  if depth != 0 && ti_up >= 0 && ti_up < len(tiles) { tiles[ti_up] = 3; }   // no up-stair on the surface
  ti_dn = dnr * w + dnq;
  if ti_dn >= 0 && ti_dn < len(tiles) { tiles[ti_dn] = 2; }

  // ── World-bundle PLACEMENT (the engine executor; the rules + content are bundle-side) ──────────
  // The active overlay (world_place_gen, generated from bundles/desert_surprise) decides; we stamp.
  // Mutating the LOCAL enemies vector + tiles here is C18/C4-safe (still construction-time, same
  // module). Deterministic, so re-entry regenerates identically.
  if world_has_placement() == 1 {
    pl = world_placement();
    gm = game_monsters();          // merged catalog (base + bundle) — for the by-key boss/guard lookups
    // SET-PIECE: stamp the configured stencil around the stair-down at its depth (the boss gates it).
    if depth == pl.setpiece_depth {
      stl = world_stencils();
      rad = 0; bkey = ""; gkey = ""; gnum = 0;
      for si in 0..len(stl) {
        if si < len(stl) {
          st = stl[si];
          if st.sk == pl.setpiece_stencil && st.shape == "round" {
            rad = st.radius; bkey = st.boss; gkey = st.guard; gnum = st.guards;
          }
        }
      }
      if rad > 0 {
        span = 2 * rad + 1;
        for ry in 0..span {
          for rx in 0..span {
            tq2 = dnq + rx - rad;
            tr2 = dnr + ry - rad;
            if tq2 >= 1 && tr2 >= 1 && tq2 < w - 1 && tr2 < h - 1 {
              if hex_distance(tq2, tr2, dnq, dnr) <= rad {
                ti2 = tr2 * w + tq2;
                if ti2 >= 0 && ti2 < len(tiles) { tiles[ti2] = 0; }
              }
            }
          }
        }
        if ti_dn >= 0 && ti_dn < len(tiles) { tiles[ti_dn] = 2; }   // re-stamp the stair we carved over
        (bq, br) = hex_neighbor(dnq, dnr, 0);
        bd = mon_find(gm, bkey);
        if bd.m_hp > 0 && !tile_solid(tiles, w, h, bq, br) && !occupied_hex(enemies, bq, br) {
          enemies += [mk_enemy(bd, bq, br)];
        }
        gd = mon_find(gm, gkey);
        if gd.m_hp > 0 {
          for gki in 0..gnum {
            (gq, gr) = hex_neighbor(bq, br, gki % 6 ?? 0);
            if !tile_solid(tiles, w, h, gq, gr) && !occupied_hex(enemies, gq, gr) && hex_distance(gq, gr, pq, pr) >= 2 {
              enemies += [mk_enemy(gd, gq, gr)];
            }
          }
        }
      }
    }
    // INFESTATION: once the set-piece boss has died (infest carried in), flood the way OUT — the
    // brood thickens toward the surface. Deterministic placement onto the level's floor candidates.
    if infest == 1 && pl.infest_trigger == "boss_slain" {
      icount = 0;
      if depth == 1 { icount = pl.infest_d1; }
      if depth == 2 { icount = pl.infest_d2; }
      if icount > 0 && ncand > 0 {
        sa = mon_find(gm, pl.infest_a);
        sb = mon_find(gm, pl.infest_b);
        iplaced = 0; ig = 0;
        while iplaced < icount && ig < ncand * 4 + 100 {
          ig += 1;
          kk = (((gseed ^ ((ig + 1) * 2654435761)) & 2147483647) % ncand) ?? 0;
          sq2 = candq[kk] ?? 1;
          sr2 = candr[kk] ?? 1;
          if !occupied_hex(enemies, sq2, sr2) {
            md2 = sa;
            if (iplaced % 2 ?? 0) == 1 { md2 = sb; }
            if md2.m_hp > 0 { enemies += [mk_enemy(md2, sq2, sr2)]; iplaced += 1; }
          }
        }
      }
    }
  }

  s = Sim {
    lw: w, lh: h, qmin: 0, rmin: 0, tiles: tiles, walls: walls,
    seen: zeros(w * h), vis: zeros(w * h),
    px: spx, py: spy, heading: PI / 2.0,
    accrued: 0.0, ticks: 0, enemies: enemies,
    php: hero_maxhp(1), phpmax: hero_maxhp(1), over: false,
    clevel: 1, xp: 0, gold: 0, race: "human", pclass: "", sp: 0, spmax: 0,
    rc_flags: 0, rc_melee: 0, rc_bow: 0, rc_stealth: 0, rc_save: 0,
    rc_hd: 0, rc_xpf: 100, rc_realm: "none", rc_spi: -1, shrine_ev: 0,
    stat_max: start_stats(), stat_cur: start_stats(), stat_tmp: zeros(NUM_STATS), stat_tmp_t: zeros(NUM_STATS),
    stat_pts: 0, stat_grown_at: zeros(NUM_STATS), detect_t: 0,
    depth: depth, wseed: seed, save_depth: depth, up_q: pq, up_r: pr, dn_q: dnq, dn_r: dnr,
    grave_depth: 0, grave_q: 0, grave_r: 0, grave_gold: 0, boss_slain: 0,
    msg_q: [for _ in 0..MSG_MAX { "" }], msg_n: 0,
    para_until: 0, poison_until: 0, poison_dmg: 0, venom_until: 0,
    rstate: (gseed ^ 99173) & 2147483647, ninv: 0, inv: zeros(INV_MAX),
    eq: zeros(NUM_SLOTS), qs: zeros(QS_N), wdam: PLAYER_DAM, pac: 0,
    fi_n: 0, fi_q: zeros(FLOOR_MAX), fi_r: zeros(FLOOR_MAX), fi_gold: zeros(FLOOR_MAX),
    fi_cat: zeros(FLOOR_MAX), fi_def: zeros(FLOOR_MAX), fi_live: zeros(FLOOR_MAX),
    dd_idx: zeros(DEPTH_MAX * MAX_SPAWNS), dd_n: zeros(DEPTH_MAX),
    known: zeros(len(game_items())), flavour_idx: zeros(len(game_items())),
    room_q0: rq0s, room_r0: rr0s, room_w: rws, room_h: rhs,
  };
  assign_flavours(s, seed);  // per-GAME flavour map from the world seed (descend/respawn carry it forward)
  sim_starting_loadout(s);   // every new character starts with its class kit (§3a #4)
  // World-bundle QUEST GRANT: hand the player the bundle's keepsake on its quest depth (the surface).
  // Only the genuine start sticks — descending overwrites the inventory with the carried one.
  if world_has_placement() == 1 {
    qp = world_placement();
    if depth == qp.quest_depth && qp.quest_item != "" {
      sim_give_item(s, qp.quest_item);
      sim_log(s, "{sim_item_display_name(s, item_index(game_items(), qp.quest_item))} is pressed into your hand.");
    }
  }
  s
}

// Move between levels: dir +1 descends, -1 ascends (clamped to depth >= 1).
// Regenerates the destination deterministically from (wseed, new depth), carries
// the player's HP, and places them on the arrival stair (down → the new level's
// up-stair, which is where sim_new_gen already drops the player; up → its
// down-stair).
// A level is a save point at depths 1, 1+SAVE_INTERVAL, … (the home/bed is depth 1).
fn is_save_depth(d: integer) -> integer {
  if (d % SAVE_INTERVAL ?? 0) == 1 { return 1; }
  0
}

pub fn sim_descend(s: Sim, dir: integer) -> Sim {
  nd = s.depth + dir;
  if nd < 1 { nd = 1; }
  ns = sim_new_gen_p(s.wseed, nd, s.boss_slain);   // carry quest progress so the way-out infestation fires
  // Per-level persistence: carry the delta store, record the level we're leaving (its dead
  // spawns), then replay the destination depth's stored deaths onto its fresh spawns. A
  // never-visited depth has an empty block, so this is a no-op and generation is unchanged.
  ns.dd_idx = s.dd_idx;
  ns.dd_n = s.dd_n;
  sim_store_dead(ns, s.depth, sim_dead_indices(s));
  sim_apply_stored_dead(ns, nd);
  ns.php = s.php;
  ns.phpmax = s.phpmax;
  ns.over = s.over;
  ns.clevel = s.clevel;   // carry the hero across levels
  ns.xp = s.xp;
  ns.gold = s.gold;
  ns.race = s.race;       // the chosen race + class travel with the character
  ns.pclass = s.pclass;
  ns.sp = s.sp;           // the mana pool persists across levels (like HP)
  ns.spmax = s.spmax;
  ns.rc_flags = s.rc_flags;     // the baked race+class cache travels too (apply_creation's output)
  ns.rc_melee = s.rc_melee;
  ns.rc_bow = s.rc_bow;
  ns.rc_stealth = s.rc_stealth;
  ns.rc_save = s.rc_save;
  ns.rc_hd = s.rc_hd;
  ns.rc_xpf = s.rc_xpf;
  ns.rc_realm = s.rc_realm;
  ns.rc_spi = s.rc_spi;
  ns.stat_max = s.stat_max;     // carry the stat block: innate + current + active temp mods
  ns.stat_cur = s.stat_cur;
  ns.stat_tmp = s.stat_tmp;
  ns.stat_tmp_t = s.stat_tmp_t;
  ns.stat_pts = s.stat_pts;             // carry banked stat points + their cooldowns across levels
  ns.stat_grown_at = s.stat_grown_at;
  ns.detect_t = s.detect_t;     // detection keeps ticking down across a level change
  ns.inv = s.inv;         // carry the inventory; floor items stay on their level
  ns.ninv = s.ninv;
  ns.eq = s.eq;           // carry equipment + its cached effects across levels
  ns.qs = s.qs;           // carry the quick-slot bindings across levels (like inventory)
  ns.wdam = s.wdam;
  ns.pac = s.pac;
  ns.rstate = s.rstate;
  ns.heading = s.heading;
  ns.save_depth = s.save_depth;                                          // carry the checkpoint
  if is_save_depth(nd) != 0 && nd > ns.save_depth { ns.save_depth = nd; }  // advance at save points
  ns.grave_depth = s.grave_depth;   // carry the death-stake grave across levels
  ns.grave_q = s.grave_q;
  ns.grave_r = s.grave_r;
  ns.grave_gold = s.grave_gold;
  ns.boss_slain = s.boss_slain;     // carry quest progress (gates the infestation on the way out)
  ns.msg_q = s.msg_q;               // the message log is continuous across levels
  ns.msg_n = s.msg_n;
  ns.known = s.known;               // identifications + the per-game flavour map carry across levels
  ns.flavour_idx = s.flavour_idx;
  if dir > 0 { sim_log(ns, "You descend to depth {nd}."); }
  if dir < 0 { sim_log(ns, "You climb to depth {nd}."); }
  if dir < 0 {
    (ax, ay) = hex_to_px(ns.dn_q, ns.dn_r);
    ns.px = ax;
    ns.py = ay;
  }
  ns
}

// Respawn after death — NOT permadeath (§3a #5): rebuild the last save-point level and
// keep the character (level/XP/gold/items/equipment), full-healed. The dive is lost (the
// save-point level regenerates; the dungeon state explored since is discarded).
pub fn sim_respawn(s: Sim) -> Sim {
  rs = sim_new_gen_p(s.wseed, s.save_depth, s.boss_slain);
  rs.clevel = s.clevel;
  rs.xp = s.xp;
  rs.race = s.race;             // race + class persist through death (identity)
  rs.pclass = s.pclass;
  rs.rc_flags = s.rc_flags;     // the baked race+class cache survives with them
  rs.rc_melee = s.rc_melee;
  rs.rc_bow = s.rc_bow;
  rs.rc_stealth = s.rc_stealth;
  rs.rc_save = s.rc_save;
  rs.rc_hd = s.rc_hd;
  rs.rc_xpf = s.rc_xpf;
  rs.rc_realm = s.rc_realm;
  rs.rc_spi = s.rc_spi;
  rs.stat_max = s.stat_max;     // keep innate stats + any permanent drain across death;
  rs.stat_cur = s.stat_cur;     // temporary modifiers reset (fresh from sim_new_gen) on respawn
  rs.stat_pts = s.stat_pts;             // banked stat points + cooldowns survive death (progression)
  rs.stat_grown_at = s.stat_grown_at;
  // Souls stake: leave GRAVE_PCT% of gold as a grave at the death spot. SP keeps one
  // grave, so a fresh death forfeits any prior one (MP would append — §3a #5).
  drop = s.gold * GRAVE_PCT / 100 ?? 0;
  rs.gold = s.gold - drop;
  (dq, dr) = px_to_hex(s.px, s.py);
  rs.grave_depth = s.depth;
  rs.grave_q = dq;
  rs.grave_r = dr;
  rs.grave_gold = drop;
  rs.inv = s.inv;
  rs.ninv = s.ninv;
  rs.eq = s.eq;
  rs.qs = s.qs;           // quick-slot bindings survive death (kept like inventory/equipment)
  rs.boss_slain = s.boss_slain;   // quest progress survives death (the brood stays loose)
  rs.msg_q = s.msg_q;             // the log persists through death
  rs.msg_n = s.msg_n;
  rs.known = s.known;             // what you've identified survives death (the mapping is per-game)
  rs.flavour_idx = s.flavour_idx;
  sim_log(rs, "You wake at the last shrine, your wounds knit.");
  rs.wdam = s.wdam;
  rs.pac = s.pac;
  rs.phpmax = s.phpmax;
  rs.php = s.phpmax;          // full heal on respawn
  rs.spmax = s.spmax;
  rs.sp = s.spmax;            // and a full mind
  rs.save_depth = s.save_depth;
  rs.over = false;
  rs
}

pub fn sim_depth(s: Sim) -> integer { s.depth }
pub fn sim_save_depth(s: Sim) -> integer { s.save_depth }   // checkpoint depth (respawn target)
pub fn sim_grave_gold(s: Sim) -> integer { s.grave_gold }   // gold staked on the grave (0 = none)
pub fn sim_grave_depth(s: Sim) -> integer { s.grave_depth } // depth the grave is on
pub fn sim_grave_q(s: Sim) -> integer { s.grave_q }         // grave hex (for the view marker)
pub fn sim_grave_r(s: Sim) -> integer { s.grave_r }

// Tile under the player: 2 = down-stair, 3 = up-stair, else floor/wall.
pub fn sim_stair_under(s: Sim) -> integer {
  (pq, pr) = px_to_hex(s.px, s.py);
  tile_at(s, pq, pr)
}
// (sim_player_hex — the player's current hex, used by the walk-onto-stairs
//  edge-trigger — already defined above near the enemy/FOV accessors.)

pub fn sim_down_hex(s: Sim) -> (integer, integer) { (s.dn_q, s.dn_r) }
pub fn sim_up_hex(s: Sim) -> (integer, integer) { (s.up_q, s.up_r) }
