use sim;
use player;
use naga_antivenin;
use potion_detect_monsters;

pub fn bundle_item_effect(s: &Sim, p: Player, key: text) -> boolean {
  if key == "naga_antivenin" { naga_antivenin::apply(s, p); return true; }
  if key == "potion_detect_monsters" { potion_detect_monsters::apply(s, p); return true; }
  false
}
