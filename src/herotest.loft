// herotest — headless checks for H1 (hero progression): awarding XP levels the
// hero up, growing max HP and healing the gained amount; killing a monster in
// combat awards XP. Deterministic.

use sim;

fn main() {
  println("=== story hero test (XP + level-up) ===");
  s = sim_new();
  cl0 = sim_clevel(s);            // 1
  hp0max = sim_player_hp_max(s);  // hero_maxhp(1) — class-uniform
  before_hp = sim_player_hp(s);   // full at start
  xp0 = sim_xp(s);                // 0

  // L2 needs 10 xp, L3 40, L4 90 -> 100 xp reaches level 4 (3 level-ups -> 3 banked stat points).
  sim_award_xp(s, 100);
  cl1 = sim_clevel(s);
  hp1max = sim_player_hp_max(s);
  hp1 = sim_player_hp(s);
  xp1 = sim_xp(s);

  ok_levels = cl1 > cl0;
  ok_hpgrow = hp1max > hp0max;
  ok_hpup = hp1 > before_hp;       // the per-level max-HP gain is granted to current HP
  ok_xp = xp1 == 100;

  // Player-chosen stat growth: leveling BANKS one point per level (never forced); the player
  // spends them, capped once per STAT_COOLDOWN levels per stat (so no dumping one stat).
  pts0 = sim_stat_points(s);       // 3 banked from leveling 1->4
  str_b = sim_stat_max(s, "str");
  r1 = sim_raise_stat(s, "str");   // banked + off cooldown -> applies
  r2 = sim_raise_stat(s, "str");   // just rose this level -> on cooldown, refused
  r3 = sim_raise_stat(s, "dex");   // a different stat -> applies
  ok_choice = pts0 == 3 && r1 && !r2 && r3 && sim_stat_max(s, "str") == str_b + 1 && sim_stat_points(s) == 1;

  // Combat awards XP: charge and kill the trivial-map enemy (re-aim each frame so the
  // charge homes in on the moving enemy — coordinate-agnostic, like combattest).
  s2 = sim_new();
  for _ in 0..600 {
    if sim_enemy_alive(s2, 0) {
      (epx, epy) = sim_enemy_pos(s2, 0);
      s2.heading = atan2(epy - s2.py, epx - s2.px);
    }
    sim_step(s2, 1, 0, 0.016);
  }
  dead = !sim_enemy_alive(s2, 0);
  killxp = sim_xp(s2);
  ok_killxp = dead && killxp > 0;

  println("level {cl0}->{cl1}  maxhp {hp0max}->{hp1max}  hp {before_hp}->{hp1}  xp {xp0}->{xp1}");
  println("combat-xp: enemy-dead={dead} xp={killxp}");
  println("banked-pts={pts0} raise(str,str,dex)={r1}/{r2}/{r3} -> pts-left={sim_stat_points(s)}");
  println("leveled={ok_levels} hp-grew={ok_hpgrow} hp-up={ok_hpup} stat-choice={ok_choice} xp-tracked={ok_xp} kill-awards-xp={ok_killxp}");
  if ok_levels && ok_hpgrow && ok_hpup && ok_choice && ok_xp && ok_killxp {
    println("=== HERO OK ===");
  } else {
    println("=== FAIL ===");
  }
}
