// genbundles — scan bundles/*/bundle.json and (re)generate the loft registries
// that wire them in (BUNDLE.md § Game-start coherence). Stdlib only
// (files/json/text); the crawler root comes from $PWD (relative paths resolve
// from the SCRIPT dir in loft). BOTH a module and a program:
//
//     loft --interpret src/genbundles.loft           (= make bundles)
//     use genbundles; regen_bundles();               (K5: the RUNNING game calls it
//                                                     before stop() — "next world")
//
// Output is BYTE-IDENTICAL to the python generator (the port's golden test).
// Every system is cut up into bundles; a bundle's "kind" decides which registry
// it feeds, so the game never references a bundle directly. See BUNDLE.md.

// ── tiny json helpers (missing field -> default) ──

fn jtext(v: JsonValue, name: text, def: text) -> text {
  f = v.field(name);
  if f.kind() == "JString" { return f.as_text(); }
  def
}

fn jint(v: JsonValue, name: text, def: integer) -> integer {
  f = v.field(name);
  // whole numbers report "JInteger" (loft 2026.7.x); "JNumber" is the pre-split
  // spelling and still covers a JSON float written where an integer is expected.
  k = f.kind();
  if k == "JInteger" || k == "JNumber" { return f.as_long(); }
  def
}

fn jhas(v: JsonValue, name: text) -> boolean {
  v.field(name).kind() != "JNull"
}

// dict.fromkeys-style dedup, first occurrence wins.
fn dedup(v: vector<text>) -> vector<text> {
  out: vector<text> = [];
  for i in 0..len(v) {
    x = v[i] ?? "";
    found = false;
    for j in 0..len(out) {
      if (out[j] ?? "") == x { found = true; }
    }
    if !found { out += [x]; }
  }
  out
}

// The catalog-merge concat the def aggregators share: one `use`d module's defs
// appended into the running table.
fn concat_lines(m: text, getter: text, nl: text) -> text {
  o = "  s_{m} = {m}::{getter}();{nl}";
  o + `  for i in 0..len(s_{m}) {{ if i < len(s_{m}) {{ t += [s_{m}[i]]; }} }}{nl}`
}

// ── the seven generators (each mirrors its python twin line for line) ──

fn gen_characters(root: text, chars: vector<JsonValue>, nl: text) -> integer {
  o = "// GENERATED by tools/gen_bundles.loft — DO NOT EDIT BY HAND.{nl}";
  o += `// Pointers to the kind:"character" bundles discovered under bundles/*/bundle.json. Loose{nl}`;
  o += "// coupling: drop a bundle dir, run `make bundles`, and it is wired here. See BUNDLE.md.{nl}";
  o += "use sim;{nl}use player;{nl}";
  for i in 0..len(chars) {
    b = chars[i];
    if b != null {
      m0 = jtext(b, "module", "");
      o += "use {m0};{nl}";
    }
  }
  o += "{nl}// Activate a character bundle by key for the active player — runs its load-script.{nl}";
  o += `pub fn bundle_activate(s: &Sim, key: text) {{{nl}  p = player_new(0);{nl}`;
  for i in 0..len(chars) {
    b = chars[i];
    if b != null {
      k = jtext(b, "key", "");
      m = jtext(b, "module", "");
      e = jtext(b, "entry", "");
      o += `  if key == "{k}" {{ {m}::{e}(s, p); }}{nl}`;
    }
  }
  o += `}}{nl}{nl}// The keys of every available character bundle (for a class-select screen, later).{nl}`;
  o += `pub fn bundle_keys() -> vector<text> {{{nl}`;
  inner = "";
  for i in 0..len(chars) {
    b = chars[i];
    if b != null {
      if len(inner) > 0 { inner += ", "; }
      ik = jtext(b, "key", "");
      inner += `"{ik}"`;
    }
  }
  o += "  [{inner}]{nl}";
  o += `}}{nl}{nl}pub fn bundle_name(key: text) -> text {{{nl}`;
  for i in 0..len(chars) {
    b = chars[i];
    if b != null {
      bk = jtext(b, "key", "");
      bn = jtext(b, "name", "");
      o += `  if key == "{bk}" {{ return "{bn}"; }}{nl}`;
    }
  }
  o += `  ""{nl}}}{nl}`;
  file("{root}/src/bundles.loft").write(o);
  len(chars)
}

fn gen_world(root: text, world: vector<JsonValue>, nl: text) -> integer {
  // python folds across bundles: the LAST rooms.connect / depth section wins
  // whole; missing keys of the final section default at emit time.
  cmode = "corridors";
  cgraph = "chain";
  cloops = 0;
  dstart = 1;
  dmax = 50;
  nrooms = 0;
  body = "";
  for i in 0..len(world) {
    b = world[i];
    if b != null {
      sec = b.field("rooms");
      if sec.kind() == "JObject" {
        if jhas(sec, "connect") {
          c = sec.field("connect");
          cmode = jtext(c, "mode", "corridors");
          cgraph = jtext(c, "graph", "chain");
          cloops = jint(c, "extra_loops", 0);
        }
        lst = sec.field("list");
        if lst.kind() == "JArray" {
          for ri in 0..lst.len() {
            r = lst.item(ri);
            rk = jtext(r, "key", "");
            rsh = jtext(r, "shape", "");
            rw1 = jint(r, "w_min", 0);
            rw2 = jint(r, "w_max", 0);
            rh1 = jint(r, "h_min", 0);
            rh2 = jint(r, "h_max", 0);
            rwt = jint(r, "weight", 0);
            body += `  t += [RoomDef {{ rk: "{rk}", shape: "{rsh}", `;
            body += "w_min: {rw1}, w_max: {rw2}, ";
            body += "h_min: {rh1}, h_max: {rh2}, weight: {rwt} }}];{nl}";
            nrooms += 1;
          }
        }
      }
      if jhas(b, "depth") {
        d = b.field("depth");
        dstart = jint(d, "start", 1);
        dmax = jint(d, "max", 50);
      }
    }
  }
  o = "// GENERATED by tools/gen_bundles.loft — DO NOT EDIT BY HAND.{nl}";
  o += `// Room registry from the rooms section of the kind:"world" bundles (bundles/*/bundle.json){nl}`;
  o += "// — the default room set and the way corridors connect them. Consumed by gen.loft. See BUNDLE.md.{nl}";
  o += `pub struct RoomDef {{{nl}  rk: text, shape: text,{nl}`;
  o += "  w_min: integer not null, w_max: integer not null,{nl}";
  o += "  h_min: integer not null, h_max: integer not null,{nl}";
  o += "  weight: integer not null,{nl}";
  o += `}}{nl}{nl}pub fn room_table() -> vector<RoomDef> {{{nl}  t: vector<RoomDef> = [];{nl}`;
  o += body;
  o += `  t{nl}}}{nl}{nl}// How rooms connect to each other (the corridor model).{nl}`;
  o += `pub fn room_connect_mode() -> text {{ "{cmode}" }}{nl}`;
  o += `pub fn room_connect_graph() -> text {{ "{cgraph}" }}{nl}`;
  o += `pub fn room_connect_loops() -> integer {{ {cloops} }}{nl}{nl}`;
  o += "// The dungeon depth range this place provides; start = the default (shallowest) entry,{nl}";
  o += "// max = deepest. The actual entry depth is a parameter, so a more dangerous top area{nl}";
  o += "// can link in and start deeper (any level in [start, max]).{nl}";
  o += `pub fn world_depth_start() -> integer {{ {dstart} }}{nl}`;
  o += `pub fn world_depth_max() -> integer {{ {dmax} }}{nl}`;
  file("{root}/src/rooms_gen.loft").write(o);
  nrooms
}

fn gen_world_defs(root: text, world: vector<JsonValue>, nl: text) -> (integer, integer) {
  emods: vector<text> = [];
  imods: vector<text> = [];
  for i in 0..len(world) {
    b = world[i];
    if b != null {
      em = jtext(b, "enemies", "");
      if len(em) > 0 { emods += [em]; }
      im = jtext(b, "items", "");
      if len(im) > 0 { imods += [im]; }
    }
  }
  o = "// GENERATED by tools/gen_bundles.loft — DO NOT EDIT BY HAND.{nl}";
  o += `// Aggregates the definition sections (enemies()/items()) of the kind:"world" bundles so the{nl}`;
  o += "// catalog merge (catalog.loft) can fold them into the game tables. The content lives in the{nl}";
  o += "// bundle (bundles/<name>/...); this is just one `use` + concat per module. See BUNDLE.md.{nl}";
  o += "use monsters;{nl}use items;{nl}";
  both = emods + imods;
  all = dedup(both);
  for i in 0..len(all) {
    ax = all[i] ?? "";
    o += "use {ax};{nl}";
  }
  o += `{nl}pub fn bundle_monsters() -> vector<MonsterDef> {{{nl}  t: vector<MonsterDef> = [];{nl}`;
  for i in 0..len(emods) { o += concat_lines(emods[i] ?? "", "monster_defs", nl); }
  o += `  t{nl}}}{nl}{nl}pub fn bundle_items() -> vector<ItemDef> {{{nl}  t: vector<ItemDef> = [];{nl}`;
  for i in 0..len(imods) { o += concat_lines(imods[i] ?? "", "item_defs", nl); }
  o += `  t{nl}}}{nl}`;
  file("{root}/src/bundle_defs.loft").write(o);
  (len(emods), len(imods))
}

fn gen_world_place(root: text, world: vector<JsonValue>, nl: text) -> (integer, integer) {
  smods: vector<text> = [];
  pmods: vector<text> = [];
  for i in 0..len(world) {
    b = world[i];
    if b != null {
      sm = jtext(b, "stencils", "");
      if len(sm) > 0 { smods += [sm]; }
      pm = jtext(b, "placement", "");
      if len(pm) > 0 { pmods += [pm]; }
    }
  }
  o = "// GENERATED by tools/gen_bundles.loft — DO NOT EDIT BY HAND.{nl}";
  o += `// Forwards the stencils()/placement() of the kind:"world" bundles to the engine placer{nl}`;
  o += "// (sim.loft). The room templates + placement rules live in the bundle; see BUNDLE.md.{nl}";
  o += "use worldtypes;{nl}";
  both = smods + pmods;
  all = dedup(both);
  for i in 0..len(all) {
    ax = all[i] ?? "";
    o += "use {ax};{nl}";
  }
  o += `{nl}pub fn world_stencils() -> vector<RoomStencil> {{{nl}  t: vector<RoomStencil> = [];{nl}`;
  for i in 0..len(smods) { o += concat_lines(smods[i] ?? "", "room_stencils", nl); }
  o += `  t{nl}}}{nl}{nl}`;
  if len(pmods) > 0 {
    o += `pub fn world_has_placement() -> integer {{ 1 }}{nl}`;
    pm0 = pmods[0] ?? "";
    o += `pub fn world_placement() -> Placement {{ {pm0}::place_rules() }}{nl}`;
  } else {
    o += `pub fn world_has_placement() -> integer {{ 0 }}{nl}`;
    o += `pub fn world_placement() -> Placement {{{nl}`;
    o += `  Placement {{ setpiece_stencil: "", setpiece_depth: 0, boss_drop: "", quest_item: "", quest_depth: 0,{nl}`;
    o += `    infest_trigger: "", infest_a: "", infest_b: "", infest_d1: 0, infest_d2: 0 }}{nl}`;
    o += `}}{nl}`;
  }
  file("{root}/src/world_place_gen.loft").write(o);
  (len(smods), len(pmods))
}

fn gen_race_defs(root: text, races: vector<JsonValue>, nl: text) -> integer {
  rmods: vector<text> = [];
  for i in 0..len(races) {
    b = races[i];
    if b != null {
      rm = jtext(b, "race", "");
      if len(rm) > 0 { rmods += [rm]; }
    }
  }
  o = "// GENERATED by tools/gen_bundles.loft -- DO NOT EDIT BY HAND.{nl}";
  o += `// Aggregates the race_defs() of the kind:"race" bundles (one race per bundle) so the catalog{nl}`;
  o += "// merge (catalog.loft) can fold them into race_catalog(). Content lives in bundles/<race>/;{nl}";
  o += "// this is just one `use` + concat per module. See BUNDLE.md.{nl}";
  o += "use races;{nl}";
  all = dedup(rmods);
  for i in 0..len(all) {
    ax = all[i] ?? "";
    o += "use {ax};{nl}";
  }
  o += `{nl}pub fn bundle_races() -> vector<RaceDef> {{{nl}  t: vector<RaceDef> = [];{nl}`;
  for i in 0..len(rmods) {
    m = rmods[i] ?? "";
    // def fn is uniquely named <module>_race_defs() — same fn name across modules
    // collides as a duplicate global symbol on the NATIVE/WASM backend (E0428).
    o += concat_lines(m, "{m}_race_defs", nl);
  }
  o += `  t{nl}}}{nl}`;
  file("{root}/src/race_defs_gen.loft").write(o);
  len(rmods)
}

fn gen_class_defs(root: text, chars: vector<JsonValue>, nl: text) -> integer {
  cmods: vector<text> = [];
  for i in 0..len(chars) {
    b = chars[i];
    if b != null {
      cm = jtext(b, "class", "");
      if len(cm) > 0 { cmods += [cm]; }
    }
  }
  o = "// GENERATED by tools/gen_bundles.loft -- DO NOT EDIT BY HAND.{nl}";
  o += `// Aggregates the class defs of the kind:"character" bundles (one class per bundle) so the{nl}`;
  o += "// catalog merge (catalog.loft) can fold them into class_catalog(). See BUNDLE.md.{nl}";
  o += "use classes;{nl}";
  all = dedup(cmods);
  for i in 0..len(all) {
    ax = all[i] ?? "";
    o += "use {ax};{nl}";
  }
  o += `{nl}pub fn bundle_classes() -> vector<ClassDef> {{{nl}  t: vector<ClassDef> = [];{nl}`;
  for i in 0..len(cmods) {
    m = cmods[i] ?? "";
    o += concat_lines(m, "{m}_defs", nl);
  }
  o += `  t{nl}}}{nl}`;
  file("{root}/src/class_defs_gen.loft").write(o);
  len(cmods)
}

fn gen_spell_defs(root: text, owners: vector<JsonValue>, bundle_dirs: vector<text>, nl: text) -> (integer, integer) {
  smods: vector<text> = [];
  for i in 0..len(owners) {
    b = owners[i];
    if b != null {
      sm = jtext(b, "spells", "");
      if len(sm) > 0 { smods += [sm]; }
    }
  }
  // discover each module's fx_* effect routines from its bundle-side source
  fx_mod: vector<text> = [];
  fx_id: vector<text> = [];
  for i in 0..len(smods) {
    m = smods[i] ?? "";
    for di in 0..len(bundle_dirs) {
      bd = bundle_dirs[di] ?? "";
      mp = "{bd}/{m}.loft";
      if exists(mp) {
        // content()+split, NOT lines(): sequential .lines() reads return empty
        // after the first file (filed upstream — found by this scanner)
        lns = file(mp).content().split_text(nl);
        for li in 0..len(lns) {
          ln = trim(lns[li] ?? "");
          if ln.starts_with_at(0, "pub fn fx_") {
            par = ln.find("(");
            if par != null && par > 10 {
              fx_mod += [m];
              fx_id += [ln[10..par]];
            }
          }
        }
      }
    }
  }
  o = "// GENERATED by tools/gen_bundles.loft -- DO NOT EDIT BY HAND.{nl}";
  o += `// Spell defs + the effect-id -> routine dispatch, aggregated from the "spells" section of{nl}`;
  o += "// the owning class/race bundles. The engine never names a spell; bundles ship def AND{nl}";
  o += "// routine (the routine-by-id seam -- SCRIPTING.md). See BUNDLE.md.{nl}";
  o += "use sim;{nl}use player;{nl}use spells;{nl}";
  all = dedup(smods);
  for i in 0..len(all) {
    ax = all[i] ?? "";
    o += "use {ax};{nl}";
  }
  o += `{nl}pub fn bundle_spells() -> vector<SpellDef> {{{nl}  t: vector<SpellDef> = [];{nl}`;
  for i in 0..len(smods) {
    m = smods[i] ?? "";
    o += concat_lines(m, "{m}_defs", nl);
  }
  o += `  t{nl}}}{nl}{nl}`;
  o += `pub fn spell_effect(s: &Sim, p: Player, effect: text, power: integer) -> boolean {{{nl}`;
  for i in 0..len(fx_mod) {
    fm = fx_mod[i] ?? "";
    fi = fx_id[i] ?? "";
    o += `  if effect == "{fi}" {{ return {fm}::fx_{fi}(s, p, power); }}{nl}`;
  }
  o += `  false{nl}}}{nl}`;
  file("{root}/src/spell_defs_gen.loft").write(o);
  (len(smods), len(fx_mod))
}

// Re-scan + regenerate everything; returns the one-line summary ("" = no root).
pub fn regen_bundles() -> text {
  root = env_variable("PWD") ?? "";
  if !exists("{root}/bundles") {
    return "";
  }
  two = `x
y`;
  nl = two[1..2];   // a clean newline constant (raw literals strip a LEADING one)

  // discover + parse every bundle manifest, sorted by path (deterministic output)
  dirs: vector<text> = [];
  entries = file("{root}/bundles").files();
  for i in 0..len(entries) {
    e = entries[i];
    if e != null {
      if exists("{e.path}/bundle.json") { dirs += [e.path]; }
    }
  }
  sort(dirs);
  bundles: vector<JsonValue> = [];
  for i in 0..len(dirs) {
    dp = dirs[i] ?? "";
    bundles += [json_parse(file("{dp}/bundle.json").content())];
  }

  chars: vector<JsonValue> = [];
  world: vector<JsonValue> = [];
  races: vector<JsonValue> = [];
  keys = "";
  for i in 0..len(bundles) {
    b = bundles[i];
    if b != null {
      k = jtext(b, "kind", "");
      if k == "character" {
        chars += [b];
        if len(keys) > 0 { keys += ", "; }
        keys += jtext(b, "key", "");
      }
      if k == "world" { world += [b]; }
      if k == "race" { races += [b]; }
    }
  }

  nc = gen_characters(root, chars, nl);
  nr = gen_world(root, world, nl);
  (ne, ni) = gen_world_defs(root, world, nl);
  (ns, npl) = gen_world_place(root, world, nl);
  nra = gen_race_defs(root, races, nl);
  ncl = gen_class_defs(root, chars, nl);
  owners = chars + races;
  (nsp, nfx) = gen_spell_defs(root, owners, dirs, nl);
  nifx = gen_item_fx(root, dirs, nl);
  "gen_bundles: {nc} character bundle(s) -> src/bundles.loft ({keys}); {nr} room type(s) -> src/rooms_gen.loft; {ne} enemy + {ni} item def module(s) -> src/bundle_defs.loft; {ns} stencil + {npl} placement module(s) -> src/world_place_gen.loft; {nra} race bundle(s) -> src/race_defs_gen.loft; {ncl} class def(s) -> src/class_defs_gen.loft; {nsp} spell module(s)/{nfx} effect(s) -> src/spell_defs_gen.loft; {nifx} item effect(s) -> src/item_fx_gen.loft"
}

// The ITEM half of the routine-by-id seam, exactly as gen_spell_defs does the spell half.
// A bundle that ships a usable item ships its ROUTINE beside the def, one file per item.
// This scans bundles/<b>/items/ and emits the dispatch,
// so the engine never names a bundle item to run its effect (BUNDLE.md standing check).
//
// Its own file rather than an arm of bundle_defs.loft: the dispatch needs `sim` and `player`,
// and bundle_defs is reached from catalog, which sim itself imports — importing sim there
// would close a cycle. spell_defs_gen sits apart for the same reason.
fn gen_item_fx(root: text, bundle_dirs: vector<text>, nl: text) -> integer {
  // THE CONVENTION IS ALREADY IN THE TREE, so this scans rather than invents one: a usable
  // bundle item's script is `bundles/<b>/items/<item_key>.loft` exposing `pub fn apply` —
  // the shape bundles/explorer/items/potion_detect_monsters.loft has always had. The FILE
  // NAME is the item key, so nothing has to restate it and the two cannot drift.
  //
  // It cannot live in the bundle's item-DEFS module: that one is reached from bundle_defs
  // <- catalog <- sim, so importing sim for the effect would close a cycle. The separate
  // per-item file is what keeps the def side dependency-free.
  fx_key: vector<text> = [];
  paths: vector<text> = [];
  for di in 0..len(bundle_dirs) {
    bd = bundle_dirs[di] ?? "";
    idir = "{bd}/items";
    if exists(idir) {
      // collect every path FIRST, then read: a file read used to invalidate a live
      // directory listing (LOFT-HANDOFF H6, fixed upstream — the order costs nothing)
      ents = file(idir).files();
      for ei in 0..len(ents) {
        e = ents[ei];
        if e != null {
          p = e.path;
          if len(p) > len(bd) + 12 && p[len(p) - 5..len(p)] == ".loft" {
            paths += [p];
            fx_key += [p[len(bd) + 7..len(p) - 5]];
          }
        }
      }
    }
  }
  fx_mod: vector<text> = [];
  keys: vector<text> = [];
  for i in 0..len(paths) {
    pp = paths[i] ?? "";
    kk = fx_key[i] ?? "";
    if file(pp).content().find("pub fn apply(") != null {
      fx_mod += [kk];      // module name == file stem == item key
      keys += [kk];
    }
  }
  fx_key = keys;
  o = "// GENERATED by tools/gen_bundles.loft -- DO NOT EDIT BY HAND.{nl}";
  o += "// The item-key -> routine dispatch for BUNDLE items that are usable. A bundle ships the{nl}";
  o += "// def AND the routine: bundles/<b>/items/<item_key>.loft exposing `pub fn apply`, where{nl}";
  o += "// the FILE NAME is the key -- so the engine names neither. Engine-owned item effects{nl}";
  o += "// live in itemeffects.loft. See BUNDLE.md + SCRIPTING.md.{nl}";
  o += "use sim;{nl}use player;{nl}";
  all = dedup(fx_mod);
  for i in 0..len(all) {
    ax = all[i] ?? "";
    o += "use {ax};{nl}";
  }
  o += `{nl}pub fn bundle_item_effect(s: &Sim, p: Player, key: text) -> boolean {{{nl}`;
  for i in 0..len(fx_mod) {
    fm = fx_mod[i] ?? "";
    fk = fx_key[i] ?? "";
    o += `  if key == "{fk}" {{ {fm}::apply(s, p); return true; }}{nl}`;
  }
  o += `  false{nl}}}{nl}`;
  file("{root}/src/item_fx_gen.loft").write(o);
  len(fx_mod)
}

fn main() {
  msg = regen_bundles();
  if len(msg) > 0 { println(msg); }
  else { println("gen_bundles: no bundles/ under PWD — run from the crawler root"); }
}
