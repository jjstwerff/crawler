// itemfx — the "use an item" verb + the effect dispatch (the use potion/scroll/food routine).
//
// LAYERING: this sits in the API layer, ABOVE the kernel (it calls sim_* accessors to read the
// inventory and consume the item) and it drives effects through the Player API (player.loft) +
// per-item scripts. The view calls use_item() on a use-key; the kernel never imports this.
//
// EFFECTS are scripts: a DEFAULT effect (cure potions heal by their i_power — data-driven) or a
// CUSTOM script that ships with the item inside its bundle (the Explorer's detect-monsters
// potion → bundles/explorer/items/). This hand-written dispatch is the precursor to a scanned
// gen_items.py index (one arm per usable item, exactly like the bundles index).
use sim;
use items;
use catalog;   // game_items() — the merged catalog (engine + bundle items)
use player;
use potion_detect_monsters;

// Use the consumable in inventory slot `slot`: run its effect, then consume one on success.
// Returns whether anything happened (so the view can message "nothing happens" otherwise).
pub fn use_item(s: &Sim, slot: integer) -> boolean {
  key = sim_inv_key(s, slot);
  if key == "" { return false; }
  nm = sim_inv_name(s, slot);
  p = player_new(0);
  fired = item_effect(s, p, key);
  if fired {
    gi = game_items();
    c = item_cat(gi, item_index(gi, key));
    verb = "use";
    if c == IT_POTION { verb = "quaff"; }
    if c == IT_SCROLL { verb = "read"; }
    if c == IT_FOOD { verb = "eat"; }
    sim_log(s, "You {verb} the {nm}.");
    sim_consume_inv(s, slot);
  }
  fired
}

// Press a quick-slot: dispatch the slot's bound item to the right verb (this is the input layer
// over use_item + sim_fire, kept here because use_item lives above the kernel). Returns:
//   0 = nothing happened (empty slot, no ammo/no target, or none of the item left)
//   1 = a consumable was used
//   2 = the launcher fired (hit or kill)
pub fn use_slot(s: &Sim, k: integer) -> integer {
  defidx = sim_qs_def(s, k);
  if defidx < 0 { return 0; }                 // empty slot -> no-op
  cat = item_cat(game_items(), defidx);
  if cat == IT_BOW {
    fr = sim_fire(s);                          // launcher: auto-aim + consume ammo (kernel)
    if fr == 0 { sim_log(s, "You have no launcher readied."); }
    if fr == 1 { sim_log(s, "You are out of ammunition."); }
    if fr == 2 { sim_log(s, "Nothing is in your sights."); }
    if fr >= 3 { return 2; }
    return 0;
  }
  j = sim_inv_find(s, defidx);                 // consumable: resolve the binding to a live inv entry
  if j < 0 { sim_log(s, "You have none left."); return 0; }   // bound but none carried
  if use_item(s, j) { return 1; }
  sim_log(s, "Nothing happens.");              // an item whose effect is not built yet (still honest)
  0
}

// Effect dispatch by item key. Cure/heal potions restore HP by their i_power (data-driven); scrolls
// blink / map / etc.; the Explorer's detect-monsters potion runs its CUSTOM script. Effects use the
// Player API + the kernel verbs; unhandled keys return false -> the caller says "Nothing happens."
fn item_effect(s: &Sim, p: Player, key: text) -> boolean {
  if key == "potion_cure_light" || key == "potion_cure_serious" || key == "potion_healing" {
    itbl = game_items();
    p.heal(s, item_power(itbl, item_index(itbl, key)));   // heal amount = i_power
    return true;
  }
  if key == "potion_restore" {                            // Restoration: undo any stat drain
    p.restore_stat(s, "str"); p.restore_stat(s, "int"); p.restore_stat(s, "wis");
    p.restore_stat(s, "dex"); p.restore_stat(s, "con"); p.restore_stat(s, "chr");
    return true;
  }
  if key == "potion_detect_monsters" {
    potion_detect_monsters::apply(s, p);   // custom script (bundles/explorer/items/)
    return true;
  }
  if key == "scroll_phase_door" { sim_blink(s, 5); return true; }    // short random blink
  if key == "scroll_teleport"   { sim_blink(s, 40); return true; }   // long-range escape
  if key == "scroll_magic_mapping" { sim_reveal_map(s); return true; }
  false
}
