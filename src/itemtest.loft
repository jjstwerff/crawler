// itemtest — headless checks for I1 (loot): killing a monster drops loot (a gold
// pile, sometimes an item); walking over gold auto-collects it; 'g' (sim_pickup)
// grabs items under the player. Deterministic.

use sim;

fn main() {
  println("=== story item test (gold + drops + pickup) ===");
  s = sim_new();
  sim_seed_rolls(s, 2);   // pin the roll stream to a seed whose kill drops gold AND an item
  for _ in 0..600 {            // charge + kill, re-aiming each frame (coordinate-agnostic)
    if sim_enemy_alive(s, 0) {
      (epx, epy) = sim_enemy_pos(s, 0);
      s.heading = atan2(epy - s.py, epx - s.px);
    }
    sim_step(s, 1, 0, 0.016);
  }

  dead = !sim_enemy_alive(s, 0);
  fc = sim_floor_count(s);          // total drops created (gold + any item)
  dropped = fc > 0;

  // Walk onto the first drop: sim_step auto-collects gold, 'g' (sim_pickup) the item.
  (fx, fy) = sim_floor_pos(s, 0);
  s.px = fx;
  s.py = fy;
  sim_step(s, 0, 0, 0.016);         // autocollect runs every step -> gold
  gold = sim_gold(s);
  sim_pickup(s);                    // grab the item under the player
  inv = sim_inv_count(s);

  println("enemy-dead={dead} drops={fc} gold-after-walk={gold} inv-after-g={inv}");
  ok = dead && dropped && gold > 0 && inv > 0;
  if ok {
    println("=== ITEM OK ===");
  } else {
    println("=== FAIL ===");
  }
}
