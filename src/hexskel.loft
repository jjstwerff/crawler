// hexskel — plan #9 T4: the SKELETON.
//
// This is the first graph in the whole system. Everything before it was a field: a value
// per cell, per edge, per chunk. A tree's branch structure is not a field and cannot be
// fitted like one — the roof matcher recovers a cone by solving for five parameters, but a
// skeleton has a variable number of nodes and no amount of least-squares will produce one.
//
// It is derived, not authored, and the derivation is a shortest-path tree from the trunk to
// every cell of its own crown:
//
//   * I-REACH       every crown cell has a path to its trunk
//   * I-NOTRESPASS  that path uses only cells of its own tree
//
// I-NOTRESPASS holds by construction here — the search never leaves the label — but it is
// checked anyway, because the check is what protects the invariant when a later phase
// starts moving nodes off their cells.
//
// The paths are then CONTRACTED into branch segments. That is not tidying: a per-cell path
// on a hex grid can only ever step in six directions, so cards hung on raw path nodes would
// snap between six angles and jitter as the crown changed. A contracted segment runs from
// one fork to the next and carries a direction free of the grid — which is what T9's
// branch-aligned cards need, and the same "recover runs, never emit per-cell geometry"
// discipline as the 2D boundary matcher.
use hexform;
use hexcanopy;

pub const NODE_PLAIN = 0;
pub const NODE_FORK  = 1;
pub const NODE_TIP   = 2;
pub const NODE_ROOT  = 3;

pub struct Skeleton {
  sk_q:     vector<integer>,
  sk_r:     vector<integer>,
  sk_par:   vector<integer>,   // parent node index, -1 at the root
  sk_depth: vector<integer>,   // cells from the trunk
  sk_load:  vector<integer>,   // crown cells carried, including itself — T5's pipe input
  sk_kind:  vector<integer>,
  sk_n:     integer,
  sk_id:    integer,           // which tree
}

pub fn skeleton_new(id: integer) -> Skeleton {
  a: vector<integer> = []; b: vector<integer> = []; c: vector<integer> = [];
  d: vector<integer> = []; e: vector<integer> = []; f: vector<integer> = [];
  Skeleton { sk_q: a, sk_r: b, sk_par: c, sk_depth: d, sk_load: e, sk_kind: f,
             sk_n: 0, sk_id: id }
}

// Shortest-path tree from the trunk through cells of this tree only.
//
// Breadth-first, so the parent of every node lies one cell nearer the trunk — which makes
// the node order itself a topological order, and lets the load be accumulated in one
// reverse sweep instead of a recursion.
// A branch may only form where the tree can actually put one.
//
// Two rules, and they turn out to be the same rule.
//
// 1. A plain breadth-first tree ties constantly, and resolving those ties by neighbour
//    order sends every shortest path straight down a lattice direction. The load then
//    concentrates on six spokes and the mesh threshold, which selects on load, renders the
//    tree's major branches as six perfectly straight radials — a grid artefact in the most
//    visible part of the tree (found by T10). Giving each cell a small deterministic cost
//    makes the cheapest path meander instead, and the ties disappear.
//
// 2. A real tree cannot put an unlimited number of branches at one height. Branches come in
//    WHORLS — a few per season — and further branches can only form later, which means
//    higher up, as the leader extends. So each height band carries a budget, and once it is
//    spent a new branch has to attach in another band.
//
// Rule 2 is also what finishes off rule 1: with six candidate directions and a budget of
// three or four, some must be deferred to another whorl, so the branches stagger instead of
// radiating. That is phyllotaxis, and it is the reason real trees do not look six-fold.
pub const WHORL_DZ   = 1.6;    // height band, world units
pub const WHORL_MAX  = 4;      // branches that may form in one band

fn cell_cost(k: integer, m: integer) -> integer {
  // 10 is the base step; the jitter is small enough never to reorder true distance by more
  // than one step, but large enough to break the exact ties that caused the spokes.
  10 + ((hash01(k, m, 7) * 6.0) as integer)
}

pub fn skeleton_grow(t: Trees, i: integer, s: HexSet, lb: Labels,
                     top: Heights, kmax: integer) -> Skeleton {
  id = t.tr_id[i] ?? 0;
  sk = skeleton_new(id);
  cap = hexset_w(s) * hexset_h(s);
  for j in 0..cap {
    sk.sk_q += [0]; sk.sk_r += [0]; sk.sk_par += [-1];
    sk.sk_depth += [0]; sk.sk_load += [1]; sk.sk_kind += [NODE_PLAIN];
  }
  // per-cell working state, indexed like the chunk
  dist = labels_new(hexset_q0(s), hexset_r0(s), hexset_w(s), hexset_h(s));
  nodeof = labels_new(hexset_q0(s), hexset_r0(s), hexset_w(s), hexset_h(s));
  vis = hexset_chunk(hexset_q0(s), hexset_r0(s), hexset_w(s), hexset_h(s));

  rq = 0; rr = 0; found = false; bestd = 1000000000;
  for r in hexset_r0(s)..hexset_r0(s) + hexset_h(s) {
    for q in hexset_q0(s)..hexset_q0(s) + hexset_w(s) {
      if hexset_get(s, q, r) && label_get(lb, q, r) == id {
        dd = crown_q2(t, i, lattice_k(q, r), lattice_m(q, r));
        if dd < bestd { bestd = dd; rq = q; rr = r; found = true; }
      }
    }
  }
  if !found { return sk; }

  // how many branches have already formed in each height band
  bands: vector<integer> = [];
  for j in 0..64 { bands += [0]; }
  kids: vector<integer> = [];
  for j in 0..cap { kids += [0]; }

  sk.sk_q[0] = rq; sk.sk_r[0] = rr; sk.sk_par[0] = -1;
  sk.sk_depth[0] = 0; sk.sk_kind[0] = NODE_ROOT;
  sk.sk_n = 1;
  hexset_set(vis, rq, rr, true);
  label_set(dist, rq, rr, 0);
  label_set(nodeof, rq, rr, 0);

  // Grow by repeatedly taking the cheapest reachable cell — Prim/Dijkstra rather than BFS.
  more = true;
  while more {
    more = false;
    bq = 0; br = 0; bp = -1; bc = 2000000000;
    for r in hexset_r0(s)..hexset_r0(s) + hexset_h(s) {
      for q in hexset_q0(s)..hexset_q0(s) + hexset_w(s) {
        if hexset_get(s, q, r) && label_get(lb, q, r) == id && !hexset_get(vis, q, r) {
          // the cheapest attached neighbour that is ALLOWED to carry another branch
          cc = 2000000000; pp = -1;
          for d in 0..6 {
            nq = nb_q(q, r, d);
            nr = nb_r(q, r, d);
            if hexset_get(vis, nq, nr) && label_get(lb, nq, nr) == id {
              pn = label_get(nodeof, nq, nr);
              base = label_get(dist, nq, nr);
              pen = 0;
              // attaching here would start a NEW branch off that node
              if (kids[pn] ?? 0) >= 1 && kmax > 0 {
                zb = height_get(top, nq, nr) / WHORL_DZ ?? 0.0;
                bi = zb as integer;
                if bi < 0 { bi = 0; }
                if bi > 63 { bi = 63; }
                if (bands[bi] ?? 0) >= kmax { pen = 400; }   // band full: strongly discouraged
              }
              cst = base + cell_cost(lattice_k(q, r), lattice_m(q, r)) + pen;
              if cst < cc { cc = cst; pp = pn; bq = q; br = r; }
            }
          }
          if pp >= 0 && cc < bc { bc = cc; bp = pp; }
        }
      }
    }
    // re-find the winner's coordinates (bq/br above may have been overwritten by a later
    // candidate that did not win) — one more sweep, cheap at these sizes
    if bp >= 0 {
      wq = 0; wr = 0; wc = 2000000000; wp = -1;
      for r in hexset_r0(s)..hexset_r0(s) + hexset_h(s) {
        for q in hexset_q0(s)..hexset_q0(s) + hexset_w(s) {
          if hexset_get(s, q, r) && label_get(lb, q, r) == id && !hexset_get(vis, q, r) {
            cc = 2000000000; pp = -1;
            for d in 0..6 {
              nq = nb_q(q, r, d);
              nr = nb_r(q, r, d);
              if hexset_get(vis, nq, nr) && label_get(lb, nq, nr) == id {
                pn = label_get(nodeof, nq, nr);
                base = label_get(dist, nq, nr);
                pen = 0;
                if (kids[pn] ?? 0) >= 1 && kmax > 0 {
                  zb = height_get(top, nq, nr) / WHORL_DZ ?? 0.0;
                  bi = zb as integer;
                  if bi < 0 { bi = 0; }
                  if bi > 63 { bi = 63; }
                  if (bands[bi] ?? 0) >= kmax { pen = 400; }
                }
                cst = base + cell_cost(lattice_k(q, r), lattice_m(q, r)) + pen;
                if cst < cc { cc = cst; pp = pn; }
              }
            }
            if pp >= 0 && cc < wc { wc = cc; wp = pp; wq = q; wr = r; }
          }
        }
      }
      if wp >= 0 && sk.sk_n < cap {
        n = sk.sk_n;
        sk.sk_q[n] = wq; sk.sk_r[n] = wr;
        sk.sk_par[n] = wp;
        sk.sk_depth[n] = (sk.sk_depth[wp] ?? 0) + 1;
        sk.sk_kind[n] = NODE_PLAIN;
        sk.sk_n = n + 1;
        hexset_set(vis, wq, wr, true);
        label_set(dist, wq, wr, wc);
        label_set(nodeof, wq, wr, n);
        // a second child on a node is a new branch: spend that band's budget
        if (kids[wp] ?? 0) >= 1 && kmax > 0 {
          zb = height_get(top, sk.sk_q[wp] ?? 0, sk.sk_r[wp] ?? 0) / WHORL_DZ ?? 0.0;
          bi = zb as integer;
          if bi < 0 { bi = 0; }
          if bi > 63 { bi = 63; }
          bands[bi] = (bands[bi] ?? 0) + 1;
        }
        kids[wp] = (kids[wp] ?? 0) + 1;
        more = true;
      }
    }
  }

  for j in 0..sk.sk_n { sk.sk_load[j] = 1; }
  j = sk.sk_n - 1;
  while j > 0 {
    p = sk.sk_par[j] ?? -1;
    if p >= 0 { sk.sk_load[p] = (sk.sk_load[p] ?? 0) + (sk.sk_load[j] ?? 0); }
    j = j - 1;
  }
  kc: vector<integer> = [];
  for j in 0..sk.sk_n { kc += [0]; }
  for j in 1..sk.sk_n {
    p = sk.sk_par[j] ?? -1;
    if p >= 0 { kc[p] = (kc[p] ?? 0) + 1; }
  }
  for j in 0..sk.sk_n {
    k = kc[j] ?? 0;
    if j == 0 { sk.sk_kind[j] = NODE_ROOT; }
    else {
      if k == 0 { sk.sk_kind[j] = NODE_TIP; }
      else { if k >= 2 { sk.sk_kind[j] = NODE_FORK; } else { sk.sk_kind[j] = NODE_PLAIN; } }
    }
  }
  sk
}

// The plain form: least-cost growth, no whorl budget.  Kept so every existing call site
// gets the spoke fix without also taking on the height limit.
pub fn skeleton_build(t: Trees, i: integer, s: HexSet, lb: Labels) -> Skeleton {
  flat = heights_new(hexset_q0(s), hexset_r0(s), hexset_w(s), hexset_h(s));
  skeleton_grow(t, i, s, lb, flat, 0)
}

pub fn node_x(sk: Skeleton, j: integer) -> float {
  ((lattice_k(sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0)) as float) * 0.8660254037844386
}
pub fn node_y(sk: Skeleton, j: integer) -> float {
  ((lattice_m(sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0)) as float) * 0.5
}

// ── CONTRACTED BRANCHES ─────────────────────────────────────────────────────
//
// A segment runs from a fork (or the root) out to the next fork or tip.  Its direction is
// taken end-to-end, so it is free of the six-way grid the path had to walk.
pub struct Branches {
  br_a:    vector<integer>,   // node index this segment starts at
  br_b:    vector<integer>,   // node index it ends at
  br_dx:   vector<float>,
  br_dy:   vector<float>,
  br_len:  vector<float>,
  br_load: vector<integer>,   // crown cells beyond its end — the pipe-model input
  br_n:    integer,
}

pub fn branches_new() -> Branches {
  a: vector<integer> = []; b: vector<integer> = []; c: vector<float> = [];
  d: vector<float> = []; e: vector<float> = []; f: vector<integer> = [];
  Branches { br_a: a, br_b: b, br_dx: c, br_dy: d, br_len: e, br_load: f, br_n: 0 }
}

pub fn branches_extract(sk: Skeleton) -> Branches {
  br = branches_new();
  for j in 1..sk.sk_n {
    k = sk.sk_kind[j] ?? 0;
    if k == NODE_FORK || k == NODE_TIP {
      // walk back to the nearest fork or the root — that is where this segment began
      a = sk.sk_par[j] ?? -1;
      while a > 0 && (sk.sk_kind[a] ?? 0) == NODE_PLAIN { a = sk.sk_par[a] ?? -1; }
      if a < 0 { a = 0; }
      dx = node_x(sk, j) - node_x(sk, a);
      dy = node_y(sk, j) - node_y(sk, a);
      ln = sqrt(dx * dx + dy * dy) ?? 0.0;
      ux = 0.0; uy = 0.0;
      if ln > 0.000001 { ux = dx / ln ?? 0.0; uy = dy / ln ?? 0.0; }
      br.br_a += [a]; br.br_b += [j];
      br.br_dx += [ux]; br.br_dy += [uy];
      br.br_len += [ln];
      br.br_load += [sk.sk_load[j] ?? 0];
      br.br_n = br.br_n + 1;
    }
  }
  br
}

// ── THE INVARIANTS, CHECKED RATHER THAN ASSUMED ─────────────────────────────

// I-NOTRESPASS: how many nodes sit on a cell this tree does not own.
pub fn skeleton_trespass(sk: Skeleton, lb: Labels) -> integer {
  n = 0;
  for j in 0..sk.sk_n {
    if label_get(lb, sk.sk_q[j] ?? 0, sk.sk_r[j] ?? 0) != sk.sk_id { n = n + 1; }
  }
  n
}

// Is the parent structure a tree at all: one root, and every parent strictly nearer?
pub fn skeleton_wellformed(sk: Skeleton) -> boolean {
  roots = 0;
  okf = true;
  for j in 0..sk.sk_n {
    p = sk.sk_par[j] ?? -1;
    if p < 0 { roots = roots + 1; }
    else {
      if p >= j { okf = false; }
      if (sk.sk_depth[p] ?? 0) + 1 != (sk.sk_depth[j] ?? 0) { okf = false; }
    }
  }
  okf && roots == 1
}

// ── T5: PIPE-MODEL RADII, AND THE MESH/CARD SPLIT ───────────────────────────
//
// Shinozaki's pipe model: a stem's cross-sectional AREA is proportional to the leaf area it
// supports.  T4 already carries that number — `sk_load`, the crown cells beyond a node — so
// the radius is one square root away and nothing about it is chosen:
//
//     area = PIPE_K^2 * load        radius = PIPE_K * sqrt(load)
//
// DA VINCI'S RULE IS NOT AN EXTRA LAW.  T4 gives load(parent) = 1 + sum of child loads, so
//
//     area(parent) = area(its own cell) + sum of child areas       -- exact, by construction
//
// and the familiar "sum of child^2 = parent^2" is that with the node's own foliage dropped:
//
//     sum(child^2)/parent^2 = (load - 1)/load
//
// which is 0.99 at load 100 and 0.50 at load 2.  So the rule is asymptotically exact on
// thick branches and wrong in the twigs — which is what real trees do, and our discrete
// form says exactly how wrong: one cell's worth.
pub const PIPE_K = 0.06;

pub fn node_radius(sk: Skeleton, j: integer, k: float) -> float {
  k * (sqrt(((sk.sk_load[j] ?? 0) as float)) ?? 0.0)
}

// The load at which a branch is still worth meshing, from the thinnest radius worth
// drawing as a solid: N = (r_min / k)^2.  The artist picks a VISUAL threshold; the geometry
// picks which branches meet it.  That is the whole of the mesh/card split.
pub fn mesh_load_min(r_min: float, k: float) -> integer {
  x = r_min / k ?? 0.0;
  n = (x * x) as integer;
  if n < 1 { n = 1; }
  n
}

pub fn mesh_nodes(sk: Skeleton, nmin: integer) -> integer {
  n = 0;
  for j in 0..sk.sk_n { if (sk.sk_load[j] ?? 0) >= nmin { n = n + 1; } }
  n
}

// The meshed part must be a CONNECTED subtree containing the root — a meshed branch
// hanging off a carded one would be a floating stick.  It is guaranteed, not enforced:
// load(parent) = 1 + sum of child loads > load(child), so load falls strictly away from the
// root, and any threshold on it selects a subtree containing the root.  This checks the
// theorem rather than relying on it.
pub fn mesh_connected(sk: Skeleton, nmin: integer) -> boolean {
  okc = true;
  for j in 1..sk.sk_n {
    if (sk.sk_load[j] ?? 0) >= nmin {
      p = sk.sk_par[j] ?? -1;
      if p < 0 { okc = false; }
      else { if (sk.sk_load[p] ?? 0) < nmin { okc = false; } }
    }
  }
  okc
}

// ── T8: WHEN A CROWN IS A FIELD, AND WHEN IT IS AN OBJECT ───────────────────
//
// Plan #5 found two boundaries of the field model — a resolution floor (a spiral stair too
// tight to lay one tread) and a slope ceiling (a dome too steep for a per-cell height).
// A canopy has its own instance of the floor, and it is sharper than a cell count.
//
// A crown is worth deriving when its skeleton has BRANCH STRUCTURE, and branch structure
// means at least one fork below the root. Every node at depth 1 is a direct child of the
// trunk, so a fork requires depth >= 2 — the crown must reach at least TWO cells from the
// trunk. On the lattice a neighbour is sqrt(3) away, so:
//
//     FIELD  when  R > 2*sqrt(3) = 3.464          OBJECT below it
//
// Measured across a radius sweep: at R = 2.65 a crown is 7 cells, 0 forks, depth 1 — a star
// of twigs, with two distinct loads in the whole tree, and nothing the pipe model or the
// card layer can use. At R = 3.61 it is 19 cells, 4 forks, depth 2, five distinct loads,
// and every downstream phase has something to work with.
//
// Below the floor the right emission is a single OBJECT — one card or one small mesh, as
// for a sapling or a domestic spiral stair. Not an error: a different representation.
pub fn canopy_floor_radius() -> float { 3.4641016151377544 }

// Does this skeleton carry branch structure at all?
pub fn skeleton_resolves(sk: Skeleton) -> boolean {
  for j in 0..sk.sk_n {
    if (sk.sk_kind[j] ?? 0) == NODE_FORK { return true; }
  }
  false
}

pub fn skeleton_depth(sk: Skeleton) -> integer {
  d = 0;
  for j in 0..sk.sk_n { if (sk.sk_depth[j] ?? 0) > d { d = sk.sk_depth[j] ?? 0; } }
  d
}

// ── T9: AXES, AND THE CARDS HUNG ON THEM ────────────────────────────────────
//
// `branches_extract` cuts a segment at every fork, which is right for structure and wrong
// for direction: inter-fork runs are short, so the headings they yield stay close to the
// six the grid can step in. T4 measured 9 of 36 ten-degree bins and flagged it.
//
// The fix is to contract THROUGH forks along the DOMINANT-LOAD child. The heaviest chain
// from the trunk is the main axis; anything branching off it starts a new axis. That is
// what a tree actually looks like — one bole with laterals, not a uniform binary tree — and
// the longer runs carry headings the grid never had to represent.
pub fn dominant_child(sk: Skeleton, j: integer) -> integer {
  best = -1;
  bl = -1;
  for c in 1..sk.sk_n {
    if (sk.sk_par[c] ?? -1) == j {
      L = sk.sk_load[c] ?? 0;
      if L > bl { bl = L; best = c; }
    }
  }
  best
}

// An axis starts at the root, or at any node that is NOT its parent's dominant child, and
// runs to a tip by always taking the dominant child.
pub fn axes_extract(sk: Skeleton) -> Branches {
  br = branches_new();
  for j in 0..sk.sk_n {
    p = sk.sk_par[j] ?? -1;
    starts = false;
    if p < 0 { starts = true; }
    else { if dominant_child(sk, p) != j { starts = true; } }
    if starts {
      e = j;
      nxt = dominant_child(sk, e);
      while nxt >= 0 { e = nxt; nxt = dominant_child(sk, e); }
      if e != j {
        dx = node_x(sk, e) - node_x(sk, j);
        dy = node_y(sk, e) - node_y(sk, j);
        ln = sqrt(dx * dx + dy * dy) ?? 0.0;
        ux = 0.0; uy = 0.0;
        if ln > 0.000001 { ux = dx / ln ?? 0.0; uy = dy / ln ?? 0.0; }
        br.br_a += [j]; br.br_b += [e];
        br.br_dx += [ux]; br.br_dy += [uy];
        br.br_len += [ln];
        br.br_load += [sk.sk_load[j] ?? 0];
        br.br_n = br.br_n + 1;
      }
    }
  }
  br
}

// How many distinct headings a set of segments occupies, in `bins` equal wedges.  This is
// the number that decides whether cards will jitter: a raw per-cell path can occupy at most
// SIX, whatever the bin count.
pub fn heading_bins(br: Branches, bins: integer) -> integer {
  hit: vector<integer> = [];
  for j in 0..bins { hit += [0]; }
  for j in 0..br.br_n {
    a = atan2(br.br_dy[j] ?? 0.0, br.br_dx[j] ?? 0.0);
    b = ((a + 3.141592653589793) / (6.283185307179586 / (bins as float) ?? 1.0) ?? 0.0) as integer;
    if b < 0 { b = 0; }
    if b >= bins { b = bins - 1; }
    hit[b] = 1;
  }
  n = 0;
  for j in 0..bins { n = n + (hit[j] ?? 0); }
  n
}

// ── CARDS ───────────────────────────────────────────────────────────────────
//
// Below the mesh threshold a branch becomes a semi-filled card carrying a pre-drawn spray
// of leaves. A card cannot face the camera — the branch drawn on it would swing round with
// it — so each is oriented by the branch it hangs on.
//
// A card is placed at a deterministic SUB-CELL position, not at its cell's centre, and that
// is what makes its heading continuous. Centre-to-centre directions are lattice vectors, and
// with only a few dozen of them in a radially symmetric crown they cluster on the six
// directions the grid steps in. Offsetting inside the cell removes the quantisation
// entirely — and does so without any smoothing pass, because the jitter is what real
// foliage has anyway.
//
// The offset is a hash of the cell, so the same world always renders the same tree.
fn hash01(k: integer, m: integer, salt: integer) -> float {
  h = k * 73856093 + m * 19349663 + salt * 83492791;
  h = h % 1000003;
  if h < 0 { h = 0 - h; }
  ((h % 10000) as float) / 10000.0 ?? 0.0
}

pub struct Cards {
  cd_x:    vector<float>,
  cd_y:    vector<float>,
  cd_z:    vector<float>,
  cd_dx:   vector<float>,     // branch-aligned, never camera-facing
  cd_dy:   vector<float>,
  cd_size: vector<float>,
  cd_q:    vector<integer>,
  cd_r:    vector<integer>,
  cd_n:    integer,
}

pub fn cards_new() -> Cards {
  a: vector<float> = []; b: vector<float> = []; c: vector<float> = [];
  d: vector<float> = []; e: vector<float> = []; f: vector<float> = [];
  g: vector<integer> = []; h: vector<integer> = [];
  Cards { cd_x: a, cd_y: b, cd_z: c, cd_dx: d, cd_dy: e, cd_size: f,
          cd_q: g, cd_r: h, cd_n: 0 }
}

// Where a node's card actually sits: its cell, displaced within it.
pub fn card_pos_x(sk: Skeleton, j: integer, jitter: float) -> float {
  q = sk.sk_q[j] ?? 0;
  r = sk.sk_r[j] ?? 0;
  node_x(sk, j) + (hash01(lattice_k(q, r), lattice_m(q, r), 1) - 0.5) * jitter
}
pub fn card_pos_y(sk: Skeleton, j: integer, jitter: float) -> float {
  q = sk.sk_q[j] ?? 0;
  r = sk.sk_r[j] ?? 0;
  node_y(sk, j) + (hash01(lattice_k(q, r), lattice_m(q, r), 2) - 0.5) * jitter
}

// One card per node too thin to mesh, oriented along its own branch and sitting inside the
// canopy interval at its cell.
pub fn cards_place(sk: Skeleton, top: Heights, base: Heights,
                   nmin: integer, jitter: float) -> Cards {
  cd = cards_new();
  for j in 0..sk.sk_n {
    if (sk.sk_load[j] ?? 0) < nmin {
      q = sk.sk_q[j] ?? 0;
      r = sk.sk_r[j] ?? 0;
      px = card_pos_x(sk, j, jitter);
      py = card_pos_y(sk, j, jitter);
      // A card is a SPRAY at the outer end of a branch, and a spray points outward — so
      // its heading is taken from the trunk to the card, not from the last path step.
      // Both are continuous once the card is offset within its cell; measured over the
      // same 81 cards, outward gives 34 of 36 heading bins, the local parent-to-child
      // step gives 21, and a blend of the two 29. Outward is both the richest and the
      // one that describes what is drawn on the card.
      dx = px - node_x(sk, 0);
      dy = py - node_y(sk, 0);
      ln = sqrt(dx * dx + dy * dy) ?? 0.0;
      ux = 1.0; uy = 0.0;
      if ln > 0.000001 { ux = dx / ln ?? 0.0; uy = dy / ln ?? 0.0; }
      zb = height_get(base, q, r);
      zt = height_get(top, q, r);
      cd.cd_x += [px]; cd.cd_y += [py];
      cd.cd_z += [zb + (zt - zb) * (0.25 + 0.5 * hash01(lattice_k(q, r), lattice_m(q, r), 3))];
      cd.cd_dx += [ux]; cd.cd_dy += [uy];
      cd.cd_size += [zt - zb];
      cd.cd_q += [q]; cd.cd_r += [r];
      cd.cd_n = cd.cd_n + 1;
    }
  }
  cd
}

pub fn cards_heading_bins(cd: Cards, bins: integer) -> integer {
  hit: vector<integer> = [];
  for j in 0..bins { hit += [0]; }
  for j in 0..cd.cd_n {
    a = atan2(cd.cd_dy[j] ?? 0.0, cd.cd_dx[j] ?? 0.0);
    b = ((a + 3.141592653589793) / (6.283185307179586 / (bins as float) ?? 1.0) ?? 0.0) as integer;
    if b < 0 { b = 0; }
    if b >= bins { b = bins - 1; }
    hit[b] = 1;
  }
  n = 0;
  for j in 0..bins { n = n + (hit[j] ?? 0); }
  n
}

// ── T10: I-OPACITY ──────────────────────────────────────────────────────────
//
// The canopy is DRAWN as a stack of semi-filled cards and SIMULATED as a volume that
// sight, light and sound pass through. Those are two different computations of the same
// physical thing, and if they disagree the canopy looks dense while being transparent, or
// the reverse — a discrepancy invisible from inside either layer.
//
// The physics is Beer-Lambert. A ray crossing canopy path-length L transmits
//
//     T_field = exp(-k * L)
//
// while the cards it meets transmit the product of their own transparencies. With one card
// per cell, the number of cards a ray meets is proportional to the length it spends in
// canopy:
//
//     N = c * L        ->    T_cards = (1-a)^(c*L)
//
// so the two agree exactly when
//
//     k = -c * ln(1-a)
//
// `c` is not a tuning constant: it is a property of the grid and the card layout, so it is
// MEASURED here rather than chosen, and `k` follows from whatever alpha the art uses.
pub fn cards_mark(cd: Cards, marks: Labels) {
  for j in 0..cd.cd_n { label_set(marks, cd.cd_q[j] ?? 0, cd.cd_r[j] ?? 0, 1); }
}

// Path length the ray spends inside the canopy volume.
pub fn ray_canopy_length(lb: Labels, top: Heights, base: Heights,
                         x0: float, y0: float, z0: float,
                         x1: float, y1: float, z1: float) -> float {
  dx = x1 - x0; dy = y1 - y0; dz = z1 - z0;
  total = sqrt(dx * dx + dy * dy + dz * dz) ?? 0.0;
  n = 2000;
  step = total / (n as float) ?? 0.0;
  acc = 0.0;
  for i in 0..n {
    t = ((i as float) + 0.5) / (n as float) ?? 0.0;
    px = x0 + dx * t; py = y0 + dy * t; pz = z0 + dz * t;
    (cq, cr) = hex_at(px, py);
    if label_get(lb, cq, cr) >= 0 {
      if pz >= height_get(base, cq, cr) && pz <= height_get(top, cq, cr) { acc = acc + step; }
    }
  }
  acc
}

// How many CARDS the ray actually meets: cells carrying a card, entered while the ray is
// inside that cell's canopy interval.
pub fn ray_card_count(marks: Labels, top: Heights, base: Heights,
                      x0: float, y0: float, z0: float,
                      x1: float, y1: float, z1: float) -> integer {
  dx = x1 - x0; dy = y1 - y0; dz = z1 - z0;
  n = 2000;
  hits = 0;
  pq = -99999; pr = -99999;
  for i in 0..n {
    t = ((i as float) + 0.5) / (n as float) ?? 0.0;
    px = x0 + dx * t; py = y0 + dy * t; pz = z0 + dz * t;
    (cq, cr) = hex_at(px, py);
    if cq != pq || cr != pr {
      if label_get(marks, cq, cr) == 1 {
        if pz >= height_get(base, cq, cr) && pz <= height_get(top, cq, cr) { hits = hits + 1; }
      }
      pq = cq; pr = cr;
    }
  }
  hits
}

// The extinction coefficient that makes the drawn canopy and the simulated one agree.
pub fn extinction_for(c: float, alpha: float) -> float {
  0.0 - c * (ln(1.0 - alpha) ?? 0.0)
}
