// --- Input as values: one `Event` per host input, in arrival order ---

// 
// A window's `events()` answers what arrived since its last poll as a vector of `Event`s, oldest
// first.  Each variant carries its own fields, so nothing is latched and nothing is read through
// a separate accessor: `match ev { KeyDown { key, mods, repeat } => …, Text { content } => … }`.
// `key` is a KEY_* code (ASCII lower-cased for a character key), `mods` a MOD_* bitmask,
// `button` 1 = left, 2 = right, 4 = middle, `delta` positive scrolls up, positions are pixels
// from the window's top-left corner.
pub enum Event {
  KeyDown { pub key: integer, pub mods: integer, pub repeat: boolean },
  KeyUp { pub key: integer, pub mods: integer },
  Text { pub content: text },
  MouseDown { pub button: integer, pub x: float, pub y: float },
  MouseUp { pub button: integer, pub x: float, pub y: float },
  MouseMove { pub x: float, pub y: float },
  Wheel { pub delta: integer, pub x: float, pub y: float },
  TouchBegin { pub id: integer, pub x: float, pub y: float },
  TouchMove { pub id: integer, pub x: float, pub y: float },
  TouchEnd { pub id: integer, pub x: float, pub y: float },
  Resize { pub width: integer, pub height: integer },
}

// --- Windows as values: the OS window and its GL context, closed when it dies ---

// An open window.  `close` ends it early; otherwise it closes when its owner dies.
pub struct Window {
  handle: integer,
}

// Open a window of `width` x `height` pixels titled `title`, with an OpenGL 3.3 core context
// current on this thread.  Null when no window can open here.
pub fn open_window(width: integer, height: integer, title: text) -> Window?

// Open a borderless window covering the screen; read its size with `width()` and `height()`.
pub fn open_fullscreen(title: text) -> Window?

// Take the window's pending input and apply a resize; false once the window was asked to close
// (or was closed).  Call once per frame, then read `events()`.
pub fn poll(self: const Window) -> boolean

// What arrived since the previous `events()`, oldest first.
pub fn events(self: const Window) -> vector<Event>

// Whether key `key` (a KEY_* code) is held down, as of the last `poll`.
pub fn key_down(self: const Window, key: integer) -> boolean

// The pointer's position in pixels from the window's top-left corner, as of the last `poll`.
pub fn mouse_x(self: const Window) -> float

// And its vertical position.
pub fn mouse_y(self: const Window) -> float

// The mouse buttons held down: 1 left, 2 right, 4 middle, or'ed together.
pub fn mouse_buttons(self: const Window) -> integer

// Clear the frame to `color` (packed 0xAARRGGBB, as `rgba` packs it) and the depth buffer.
pub fn clear(self: const Window, color: integer)

// Present the frame.  Its alpha is forced opaque first, so a compositor never shows through it.
pub fn swap(self: const Window)

// The drawable's size in pixels; it follows a resize at `poll`.
pub fn width(self: const Window) -> integer

// And its height.
pub fn height(self: const Window) -> integer

// The frame drawn so far, as a canvas — read it after the draws and before `swap`.
pub fn capture(self: const Window) -> Canvas

// Close the window now.  Its death later does nothing more.
pub fn close(self: Window)

// --- Shaders and GPU meshes: a window's GL objects, deleted when they die ---

// A linked GLSL program.
pub struct Shader {
  handle: integer,
}

// Compile and link a GLSL 3.30 program for this window.  Null when either stage does not compile
// or the program does not link; the driver's log says why, on stderr.
pub fn shader(self: const Window, vertex: text, fragment: text) -> Shader?

// Set uniform `name` of this shader; a name the program does not use is ignored.
pub fn set_float(self: const Shader, name: text, v: float)

// A `vec2` uniform.
pub fn set_vec2(self: const Shader, name: text, x: float, y: float)

// A `vec3` uniform.
pub fn set_vec3(self: const Shader, name: text, x: float, y: float, z: float)

// A `vec4` uniform.
pub fn set_vec4(self: const Shader, name: text, x: float, y: float, z: float, w: float)

// A `mat4` uniform from 16 floats, column-major; fewer than 16 is ignored.
pub fn set_mat4(self: const Shader, name: text, m: const vector<float>)

// An `int` (or sampler) uniform.
pub fn set_int(self: const Shader, name: text, v: integer)

// Vertices on the GPU, `stride` floats each: position (location 0); from 6 floats a normal (1);
// at exactly 8 a texture coordinate (2); from 10 a colour, RGBA (2); from 14 an anchor (3) and a
// birth time (4).
pub struct GpuMesh {
  handle: integer,
}

// Upload `data` as a mesh of `len(data) / stride` vertices.
pub fn upload(self: const Window, data: const vector<single>, stride: integer) -> GpuMesh

// Draw every vertex of this mesh as triangles with `shader`.
pub fn draw(self: const GpuMesh, shader: const Shader)

// Draw every vertex of this mesh as `mode`: `DRAW_TRIANGLES`, `DRAW_LINES` or `DRAW_POINTS`.
pub fn draw_mode(self: const GpuMesh, shader: const Shader, mode: integer)

// Replace the vertices, in the same layout; the count follows `len(data) / stride`.  For data that
// changes every frame.
pub fn update(self: const GpuMesh, data: const vector<single>)

// Give the mesh an index list (a second call replaces the first); `draw_indexed` then draws the
// vertices it names, in its order.
pub fn indices(self: const GpuMesh, list: const vector<integer>)

// Draw the vertices the index list names, as `mode`.
pub fn draw_indexed(self: const GpuMesh, shader: const Shader, mode: integer)

// Draw the mesh's triangles `count` times; attributes fed by `instance_attrib` advance once per
// copy.
pub fn draw_instanced(self: const GpuMesh, shader: const Shader, count: integer)

// Feed attribute `location` (use 5 and up: the vertex layout takes 0-4) from `instances`, once per
// copy: `components` floats at `offset` floats into each record of `stride` floats.
pub fn instance_attrib( self: const GpuMesh, instances: const InstanceBuffer, location: integer, components: integer, stride: integer, offset: integer )

// Floats read once per drawn copy of a mesh — a position, a colour — through `instance_attrib`.
pub struct InstanceBuffer {
  handle: integer,
}

// Upload per-copy data, for a mesh to read through `instance_attrib`.
pub fn instances(self: const Window, data: const vector<single>) -> InstanceBuffer

// Replace the data; meshes reading it see the new values at their next draw.
pub fn update(self: const InstanceBuffer, data: const vector<single>)

// --- Render state: what the next draws do with depth, blending, faces and the frame's area ---

// Turn a capability on: `GL_DEPTH_TEST`, `GL_BLEND`, `GL_CULL_FACE` or `GL_SCISSOR_TEST`.
pub fn enable(self: const Window, cap: integer)

// And off.
pub fn disable(self: const Window, cap: integer)

// Whether `GL_DEPTH_TEST`, `GL_BLEND`, `GL_CULL_FACE` or `GL_SCISSOR_TEST` is on — for a pass that
// changes one and hands the window back as it found it.  A window opens with depth testing on.
pub fn enabled(self: const Window, cap: integer) -> boolean

// How a blended draw combines with the frame: `w.blend(BLEND_SRC_ALPHA, BLEND_ONE_MINUS_SRC_ALPHA)`.
pub fn blend(self: const Window, src: integer, dst: integer)

// Which faces `GL_CULL_FACE` drops: 0 the back (counter-clockwise is the front), 1 the front.
pub fn cull(self: const Window, face: integer)

// Whether draws write the depth buffer (they still test it while `GL_DEPTH_TEST` is on).
pub fn depth_write(self: const Window, on: boolean)

// The rectangle draws map onto, origin bottom-left.  `poll` resets it to the whole window on a
// resize.
pub fn viewport(self: const Window, x: integer, y: integer, width: integer, height: integer)

// The rectangle `GL_SCISSOR_TEST` clips to, origin bottom-left.
pub fn scissor(self: const Window, x: integer, y: integer, width: integer, height: integer)

// Wait until every draw so far has finished.  A stall: for a test or a screenshot, not a frame.
pub fn finish(self: const Window)

// The width of lines drawn with `DRAW_LINES`.
pub fn line_width(self: const Window, width: float)

// The size of points drawn with `DRAW_POINTS`.
pub fn point_size(self: const Window, size: float)

// --- Textures and framebuffers: images on the GPU, and drawing into them ---

// An image on the GPU: colour (RGBA, 8 bits a channel) or depth (32-bit float).
pub struct Texture {
  handle: integer,
}

// An empty colour texture, filtered linearly — a render target.
pub fn texture(self: const Window, width: integer, height: integer) -> Texture

// An empty depth texture, filtered to the nearest texel and clamped at its edges — the depth of a
// render target, or a shadow map.
pub fn depth_texture(self: const Window, width: integer, height: integer) -> Texture

// A colour texture holding a canvas's pixels, filtered linearly and clamped at its edges.  The
// canvas's row 0 is the texture's row 0, which GL places at the bottom (texture coordinate 0).
pub fn texture_from(self: const Window, image: const Canvas) -> Texture

// Its width in texels.
pub fn width(self: const Texture) -> integer

// And its height.
pub fn height(self: const Texture) -> integer

// Replace the region at (`x`, `y`) — origin bottom-left — with a canvas's pixels.
pub fn put(self: const Texture, x: integer, y: integer, image: const Canvas)

// Sample the nearest texel (pixel art), or interpolate between texels (the default).
pub fn filter(self: const Texture, nearest: boolean)

// Build mipmaps from the current pixels and minify through them; call again after `put`.
pub fn mipmaps(self: const Texture)

// Bind to texture unit `unit`; a `sampler2D` uniform set to `unit` then reads it.
pub fn bind(self: const Texture, unit: integer)

// A target for draws other than the window: textures attached as its colour and depth.
pub struct Framebuffer {
  handle: integer,
}

// An empty framebuffer; attach textures before drawing into it.
pub fn framebuffer(self: const Window) -> Framebuffer

// Attach `t`: a depth texture as the depth buffer, a colour texture as the colour.  With only a
// depth texture the framebuffer draws no colour (a depth-only pass).
pub fn attach(self: const Framebuffer, t: const Texture)

// Draw into `target` from now on — set the viewport to its size.  Dropping the framebuffer that
// is the target sends the draws back to the window.
pub fn render_to(self: const Window, target: const Framebuffer)

// Draw into the window again.
pub fn render_to_window(self: const Window)

// Load a PNG file as a colour texture (filtered linearly, clamped at its edges), its top row at
// texture coordinate 0 as a canvas uploads.  Any PNG colour type loads; 16-bit channels keep their
// high byte.  A relative path resolves against the program's own directory, as `load_font`'s.
// Null when the file is missing or is not a PNG this decoder reads.
pub fn load_texture(self: const Window, path: text) -> Texture?

// `content` drawn with `font` at `size` pixels to the em, in `color`, as a texture: the text with
// 2 pixels of transparent margin around it — what 0.9's `create_text_texture` made, for
// `Painter.image`.
pub fn text_texture(self: const Window, font: const Font, content: text, size: float, color: integer) -> Texture

// Two triangles covering the whole target: a `vec2` position at location 0 and a `vec2` texture
// coordinate at location 1 — for a post-processing pass, or to show a texture.
pub fn quad(self: const Window) -> GpuMesh

// --- 2D drawing on a window: rectangles, images and sprites at pixel positions ---

// Shaders and a unit quad for drawing at pixel positions.
pub struct Painter {
  flat: Shader,
  tex: Shader,  // The textured-quad shader and the unit quad, for a program that draws its own textured quad through them (`uMVP`, `uTex`).
  quad: GpuMesh,
  proj: vector<float>,
}

// A painter for this window, sized to it.  Null when its shaders do not compile.
pub fn painter(self: const Window) -> Painter?

// Draw for a target of `width` x `height` pixels from now on — after a `Resize`.
pub fn resize(self: Painter, width: integer, height: integer)

// A filled rectangle at (x, y) of `w` x `h` pixels, channels 0.0-1.0; the alpha blends where the
// window has `GL_BLEND` on.
pub fn rect( self: const Painter, x: float, y: float, w: float, h: float, r: float, g: float, b: float, a: float )

// A texture stretched over (x, y) of `w` x `h` pixels; fully transparent texels are not drawn.
pub fn image(self: const Painter, t: const Texture, x: float, y: float, w: float, h: float)

// Sprite `index` of `sheet` over (x, y) of `w` x `h` pixels.
pub fn sprite( self: const Painter, sheet: const Sprites, x: float, y: float, w: float, h: float, index: integer )

// A canvas atlas on the GPU, cut into a grid of `cols` x `rows` sprites; sprite 0 is the top left,
// counting along the rows.
pub struct Sprites {
  texture: Texture,
  shader: Shader,
  quad: GpuMesh,
  const cols: integer,
  const rows: integer,
}

// Upload `atlas` as a sprite sheet of `cols` x `rows` cells.  Null when its shader does not
// compile.
pub fn sprites(self: const Window, atlas: const Canvas, cols: integer, rows: integer) -> Sprites?

// Draw sprite `index` through `mvp`, which maps the unit quad onto the target (16 floats,
// column-major).
pub fn draw(self: const Sprites, mvp: const vector<float>, index: integer)

// A mesh in groups, each re-uploaded on its own: after an edit only the groups whose geometry
// changed go to the GPU again (`upsert`), every other keeps its buffer.  All groups share one
// vertex layout (`stride` floats) and one draw mode.  Each group records its world XZ bounds.
pub struct GroupMeshes {
  slots: hash<GroupSlot[gk]>,
  meshes: vector<GpuMesh>,
  const stride: integer,
  const mode: integer,
}

// An empty set for vertices of `stride` floats, drawn as `mode` (`DRAW_TRIANGLES`, …).
pub fn group_meshes(stride: integer, mode: integer) -> GroupMeshes

// Upload group `gk`'s vertices — a new group, or new geometry for one already there (its buffer is
// reused).  No vertices empties the group.
pub fn upsert( self: GroupMeshes, w: const Window, gk: integer, verts: const vector<single>, min_x: single, min_z: single, max_x: single, max_z: single )

// Whether group `gk` has been uploaded.
pub fn has(self: const GroupMeshes, gk: integer) -> boolean

// How many groups the set holds.
pub fn count(self: const GroupMeshes) -> integer

// Draw every group with `shader`.
pub fn draw_all(self: const GroupMeshes, shader: const Shader)

// --- Event tags, modifiers and the named keys ---

// The tag of each `Event` variant, as the shim queues it (`Window.events()` decodes them).
pub const EV_NONE = 0

pub const EV_KEY_DOWN = 1

pub const EV_KEY_UP = 2

pub const EV_TEXT = 3

pub const EV_MOUSE_DOWN = 4

pub const EV_MOUSE_UP = 5

pub const EV_MOUSE_MOVE = 6

pub const EV_WHEEL = 7

pub const EV_TOUCH_BEGIN = 8

pub const EV_TOUCH_MOVE = 9

pub const EV_TOUCH_END = 10

pub const EV_RESIZE = 11

// Modifier bits, or'ed in an event's `mods`.
pub const MOD_SHIFT = 1

pub const MOD_CTRL = 2

pub const MOD_ALT = 4

pub const MOD_SUPER = 8

// More named keys.
pub const KEY_ENTER = 13

pub const KEY_BACKSPACE = 8

pub const KEY_DELETE = 147

pub const KEY_INSERT = 148

pub const KEY_HOME = 149

pub const KEY_END = 150

pub const KEY_PAGEUP = 151

pub const KEY_PAGEDOWN = 152

// --- Fonts: a TrueType face as a value the caller holds ---

// A TrueType face.  Obtain one from `load_font`; its fields are the font's own numbers, in font
// units (`units_per_em` of them to the em).
pub struct Font {
  units_per_em: integer,
  ascender: integer,
  descender: integer,
  line_gap: integer,
  advances: vector<integer>,
  cmap: vector<CmapRange>,
  kern: hash<KernPair[key]>,
  data: vector<u8>,  // The whole file, kept for the glyph outlines a rasterizer reads.
}

// Read a TrueType font file.  Null when the file is missing or is not a TrueType font.
// A relative path resolves against the program's own directory (`source_dir()`), as
// `gl_load_font` does, so a bundled font travels with the program.
pub fn load_font(path: text) -> Font?

// The width of `content` in pixels at `size` pixels to the em: each glyph's advance plus the
// kerning between neighbours, as text drawn at that size lays out.
pub fn measure(self: const Font, content: text, size: float) -> float

// The distance in pixels from the baseline up to the top of the glyphs at `size` pixels to the
// em.  Text drawn top-anchored at `y` has its baseline at `y + ascent(size)`.
pub fn ascent(self: const Font, size: float) -> float

// The distance in pixels from one baseline to the next at `size` pixels to the em: ascent,
// descent and line gap, rounded up to whole pixels.
pub fn line_height(self: const Font, size: float) -> integer

// --- Glyph outlines and coverage: text rasterized in loft ---

// The coverage of one glyph at one size: `width` x `height` bytes 0-255 from its top-left, placed
// `xmin` right of the pen and its bottom `ymin` above the baseline.
pub struct Glyph {
  xmin: integer,
  ymin: integer,
  width: integer,
  height: integer,
  advance: single,
  coverage: vector<u8>,
}

// The coverage of character `c` at `size` pixels to the em.
pub fn rasterize(self: const Font, c: character, size: float) -> Glyph

// `content` as one coverage bitmap, `width` x `height` from its top-left: glyphs on one baseline
// (`ascent` down), each kerned against the one before it — the layout 0.9 drew text with.
pub fn rasterize_text(self: const Font, content: text, size: float) -> Glyph

// Draw `content` with `font` at `size` pixels to the em, its top-left at (x, y), blending `color`
// by each pixel's coverage.
pub fn draw_text( self: Canvas, font: const Font, content: text, size: float, x: integer, y: integer, color: integer )
