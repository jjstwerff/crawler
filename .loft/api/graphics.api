pub fn gl_mouse_y() -> float

// Mouse button bitmask: 1=left, 2=right, 4=middle.
pub fn gl_mouse_button() -> integer

// Scroll-wheel delta accumulated since the last call (positive = up).
// Reset on read.  Use per-frame to drive the editor's `InputState.in_wheel`
// or any other scroll-driven UI.  Pixel-delta trackpad scrolling is
// quantised at 20 px/line.
pub fn gl_mouse_wheel() -> integer

// --- Input events (Gap 01): an ordered, drained-per-frame event queue ---

// Pop the next queued input event and latch it; returns its EV_* tag, or
// EV_NONE when the queue is drained.  Call after gl_poll_events().
pub fn gl_next_event() -> integer

// Named/keycode of the latched key event (the KEY_* constants).
pub fn gl_event_key() -> integer

// Modifier bitmask of the latched event (MOD_SHIFT | MOD_CTRL | MOD_ALT | MOD_SUPER).
pub fn gl_event_mods() -> integer

// True if the latched key-down is an auto-repeat.
pub fn gl_event_repeat() -> boolean

// UTF-8 text of the latched EV_TEXT event ("" otherwise).
pub fn gl_event_text() -> text

// X position (pixels) of the latched mouse/touch event; width for EV_RESIZE.
pub fn gl_event_x() -> float

// Y position (pixels) of the latched mouse/touch event; height for EV_RESIZE.
pub fn gl_event_y() -> float

// Button of the latched mouse event (1=left, 2=right, 4=middle).
pub fn gl_event_button() -> integer

// Wheel delta of the latched EV_WHEEL event (positive = up).
pub fn gl_event_wheel() -> integer

// Stable finger id of the latched EV_TOUCH_* event.
pub fn gl_event_touch_id() -> integer

// --- Text rendering (GL3) ---

// Load a font from a file path. Returns a font handle (>= 0) or null on error.
pub fn gl_load_font(path: text) -> integer

// Measure text width in pixels at the given font size.
pub fn gl_measure_text(font: integer, content: text, size: float) -> float

// Return the line height in pixels for a font at the given size.
pub fn gl_text_height(font: integer, size: float) -> integer

// @P340: return the font ASCENT in pixels (baseline -> top of glyphs) from the
// font's real metrics.  gl_draw_text(x, y) anchors by the TOP, placing the
// baseline at y + gl_font_ascent(font, size); to baseline-align mixed sizes,
// draw each at y = baseline - gl_font_ascent(font, size_i).
pub fn gl_font_ascent(font: integer, size: float) -> float

pub fn draw_text(self: Canvas, font: integer, content: text, size: float,

