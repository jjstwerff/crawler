// Load a font from a file path. Returns a font handle (>= 0) or null on error.
// 
// #255: a RELATIVE path resolves against the program's OWN directory
// (`source_dir()` — the source dir under `--interpret`, the executable's dir
// under `--native`), so a bundled font travels with the program and loads
// regardless of the launch directory (the symptom #255 hit: a font addressed
// relative to the source missed under `--native`, which runs from a temp dir,
// and text rendered invisible).  An ABSOLUTE path is used verbatim.  This
// matches loft's program-relative file-I/O default (`file()` / `read_file`).
pub fn gl_load_font(path: text) -> integer

// Measure text width in pixels at the given font size.
pub fn gl_measure_text(font: integer, content: text, size: float) -> float

// Return the line height in pixels for a font at the given size.
pub fn gl_text_height(font: integer, size: float) -> integer

// @P340: return the font ASCENT in pixels (baseline -> top of glyphs) from the
// font's real metrics.  gl_draw_text(x, y) anchors by the TOP, placing the
// baseline at y + gl_font_ascent(font, size); to baseline-align mixed sizes,
// draw each at y = baseline - gl_font_ascent(font, size_i).
pub fn gl_font_ascent(font: integer, size: float) -> float

// Rasterise text into the canvas at (x, y), anchored by the TOP-left.
// 
// ⚠ NEEDS THE NATIVE RASTERISER, so this is one of the canvas routines that
// does NOT work headless: without it the call is a no-op and the canvas keeps
// whatever was under the text.  `text2d` exists for exactly that case — it
// carries a baked face and draws through `set_pixel`, so text always appears.
pub fn draw_text(self: Canvas, font: integer, content: text, size: float, dt_x: integer, dt_y: integer, color: integer)

// --- Textures (GL5.5) ---

// Load an image file (PNG, JPG) and upload it as a GL texture.
// Returns the texture ID (0 on failure).
pub fn gl_load_texture(path: text) -> integer

// Upload Canvas pixel data as a GL texture. Returns the texture ID.
// Converts 0xAARRGGBB packed integers to RGBA bytes for OpenGL.
pub fn gl_upload_canvas(data: const vector<integer>, width: integer, height: integer) -> integer

// Bind a texture to a texture unit (0-based) for rendering.
pub fn gl_bind_texture(texture_id: integer, unit: integer)

// Delete a texture.
pub fn gl_delete_texture(texture_id: integer)

// --- GPU resource cleanup ---

// Delete a shader program.
pub fn gl_delete_shader(program: integer)

// Delete a vertex array object.
pub fn gl_delete_vao(vao: integer)

// Delete a framebuffer object.
pub fn gl_delete_framebuffer(fbo: integer)

// A sprite sheet backed by a Canvas atlas uploaded as a GL texture.
// Sprites are arranged in a grid of `ss_cols` x `ss_rows` cells.
pub struct SpriteSheet {
  const ss_tex: integer,  // GL texture handle
  const ss_shader: integer,  // textured quad shader
  const ss_vao: integer,  // unit quad VAO (shared)
  const ss_cols: integer,
  const ss_rows: integer,
  const ss_cell_w: integer,
  const ss_cell_h: integer,
}

// Create a sprite sheet from a Canvas atlas.
// The canvas is divided into a grid of `cols` x `rows` cells.
// Sprite index 0 is top-left, incrementing left-to-right then top-to-bottom.
pub fn create_sprite_sheet(atlas: const Canvas, cols: integer, rows: integer, vao: integer) -> SpriteSheet

// Draw sprite at `index` (0-based, row-major).
// `mvp` is the pre-multiplied projection * model matrix (16 singles).
// The caller builds the MVP for the desired screen position and size.
pub fn draw_sprite(sheet: const SpriteSheet, mvp: const vector<float>, sp_idx: integer)

// A 2D painter bundling shaders, a unit-quad VAO, and an orthographic
// projection. Create once per window with `create_painter_2d`, then use
// `draw_rect_at`, `draw_sprite_at`, and `draw_texture_at` to render.
pub struct Painter2D {
  p2_flat: integer,  // flat color shader
  p2_tex: integer,  // textured quad shader (V-flipped)
  p2_vao: integer,  // shared unit-quad VAO
  p2_proj: vector<float>,  // orthographic projection (16 floats)
}

// Create a Painter2D for a window of size `screen_w` x `screen_h`.
// Compiles the flat and textured shaders, uploads the unit-quad VAO, and
// builds an orthographic projection with the origin at the top-left.
// Call once after `gl_create_window`.
pub fn create_painter_2d(screen_w: float, screen_h: float) -> Painter2D

// Return the unit-quad VAO owned by the painter, so it can be shared with
// `create_sprite_sheet` instead of uploading a second copy.
pub fn painter_vao(self: const Painter2D) -> integer

// Draw a filled rectangle at screen position (x, y) with size (w, h).
// Colour channels are in 0.0..1.0. Uses the painter's flat-color shader.
pub fn draw_rect_at(painter: const Painter2D, x: float, y: float, w: float, h: float, r: float, g: float, b: float, a: float)

// Draw a sprite from `sheet` at screen position (x, y) with size (w, h).
// `sp_idx` is the 0-based sprite index (row-major) in the sheet.
// This is a one-liner replacement for `make_mvp` + `draw_sprite`.
pub fn draw_sprite_at(sheet: const SpriteSheet, painter: const Painter2D, x: float, y: float, w: float, h: float, sp_idx: integer)

// Draw an arbitrary GL texture as a screen-space quad at (x, y, w, h).
// Uses the painter's textured shader, which flips V to match canvas origin.
// Suitable for textures created with `create_text_texture` or `gl_upload_canvas`.
pub fn draw_texture_at(painter: const Painter2D, tex: integer, x: float, y: float, w: float, h: float)

// Rasterize `content` with `font` at `size` pixels, upload the glyph bitmap
// as a GL texture, and return the texture ID. The texture is sized to fit
// the measured text plus a small padding; pair with `draw_texture_at` to
// render. Caller owns the texture — call `gl_delete_texture` when done.
// Returns 0 if the text cannot be measured.
pub fn create_text_texture(font: integer, content: text, size: float, color: integer) -> integer

// --- G5: Audio ---

// Load an audio clip (WAV or OGG). Returns handle (>= 0) or null on failure.
pub fn audio_load(path: text) -> integer

// Play a loaded clip.  Returns a playback handle, or -1 when it will not play.
// 
// `volume` is 0.0-1.0, `looping` repeats the clip until it is stopped, `pan`
// places it across the stereo field (-1 left, 0 centre, 1 right), and `start`
// begins that many seconds in.  Everything past `volume` has a default, so an
// existing `audio_play(clip, 0.8)` keeps meaning what it meant.
// 
// `start` skips into the FIRST pass only: a looping clip then repeats whole,
// which is what a browser's `start(when, offset)` with `loop` does.
// 
// A handle is never handed out twice.  When a clip finishes its slot is reused,
// but the handle carries which use it belongs to, so an `audio_stop` on a
// finished sound stops nothing instead of stopping whatever took its place.
pub fn audio_play(clip: integer, volume: float, looping: boolean = false, pan: float = 0.0, start: float = 0.0) -> integer

// Stop a playing clip by its playback handle.
pub fn audio_stop(sink: integer)

// Stop every playing clip — a pause menu, a scene change, a game over.
pub fn audio_stop_all()

// Set volume of a playing clip (0.0-1.0).
pub fn audio_set_volume(sink: integer, volume: float)

// Move a playing clip across the stereo field: -1 left, 0 centre, 1 right.
// 
// The law is Web Audio's `StereoPannerNode`, equal-power for a mono clip: a
// sweep holds its loudness through the middle rather than dipping.  A stereo
// clip is narrowed toward the near side rather than having the far one muted.
pub fn audio_set_pan(sink: integer, pan: float)

// Jump a playing clip to `seconds` from its start.  Answers whether it moved.
// 
// A LOOPING clip cannot seek — repeating needs a buffered source, which has no
// earlier position to go back to — and this answers false rather than leaving
// the caller believing a jump happened.
pub fn audio_seek(sink: integer, seconds: float) -> boolean

// Play raw PCM samples (mono, values -1.0 to 1.0) at the given sample rate.
// Returns playback handle, or null on failure.
pub fn audio_play_raw(samples: vector<single>, sample_rate: integer, volume: float) -> integer

// --- Procedural audio synthesis (chiptune) ---

// Short percussive beep — brick hit, UI click.
pub fn sfx_beep(sb_freq: single, sb_dur: single, sb_vol: single) -> integer

// Descending tone — life lost, negative event.
pub fn sfx_descend(sd_f0: single, sd_f1: single, sd_dur: single, sd_vol: single) -> integer

// Rising chirp — pickup collected, positive event.
pub fn sfx_chirp(sc_f0: single, sc_f1: single, sc_dur: single, sc_vol: single) -> integer

// White noise burst — percussion, explosion, brick break.
pub fn sfx_noise(sn_dur: single, sn_vol: single) -> integer

// Paddle bounce — low square wave thud with pitch drop.
pub fn sfx_bounce(sp_freq: single, sp_vol: single) -> integer

## src/render.loft

// A window with the 3D renderer's GL state: its size, the PBR and shadow shaders, the
// shadow-map framebuffer and texture, and the vertex arrays `upload_scene` filled.
// `create_renderer` makes one.
pub struct Renderer {
  const width: integer,
  const height: integer,
  const pbr_shader: integer,
  const shadow_shader: integer,
  const shadow_fbo: integer,
  const shadow_tex: integer,
  const shadow_size: integer,
  const start_tick: integer,
  const vaos: vector<integer>,  // const: contents grown via `+=` in upload_scene
  const vert_counts: vector<integer>,  // const: contents grown via `+=` in upload_scene
  uploaded: boolean,  // not const: genuinely reassigned (`self.uploaded = true`)
}

// Create a renderer with a window.  Compiles built-in shaders, allocates
// shadow map FBO.  Returns null on failure (no display).
pub fn create_renderer(rw: integer, rh: integer, title: text) -> Renderer

// Seconds since the renderer was created.
pub fn elapsed(self: const Renderer) -> float

// Upload all meshes in the scene to GPU VAOs.
pub fn upload_scene(self: Renderer, sc: const scene::Scene)

// Render one frame's 3D passes WITHOUT swapping buffers.  Callers
// that want to draw a 2D overlay between the 3D pass and the swap
// (e.g. the native Moros editor's panel) use this variant and
// invoke `graphics::gl_swap_buffers()` themselves after their
// overlay renders.  Returns false when close requested.
// 
// Introduced by Initiative 03 Phase 3b (native moros editor
// panel overlay).  The existing `render_frame` wrapper below
// preserves backward compatibility with every current caller.
pub fn render_frame_no_swap(self: Renderer, sc: const scene::Scene, cam: const scene::Camera) -> boolean

// Render one frame (3D passes + buffer swap).  Convenience wrapper
// for callers that don't need a 2D overlay between the 3D pass and
// the swap — brick-buster, 24-renderer-demo, and every other current
// consumer.  Returns false when close requested.
pub fn render_frame(self: Renderer, sc: const scene::Scene, cam: const scene::Camera) -> boolean

// Convenience: render loop until close.
pub fn render_loop(self: Renderer, sc: const scene::Scene, cam: const scene::Camera)

// Destroy GPU resources and close the window.
pub fn destroy(self: Renderer)
