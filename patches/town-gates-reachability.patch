+// Surface terrain kind at (q,r) — the STORED form (kind + 1, 0 = dungeon/none), as the level
+// arrays hold it. Read-only; the siting scans read the same array directly because they run
+// before a `Sim` exists, and a gate that wants to ask "is there rock beside this hex" needs
+// the answer through the Sim.
+pub fn sim_terrain_at(s: Sim, q: integer, r: integer) -> integer {
+  if q < 0 || r < 0 || q >= s.lw || r >= s.lh { return 0; }
+  ti = r * s.lw + q;
+  if ti < len(s.tkind) { return s.tkind[ti] ?? 0; }
+  0
