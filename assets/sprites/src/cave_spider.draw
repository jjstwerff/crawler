# CAVE SPIDER — dark silhouette + eye-glints (alive, not a still). top-down, FRONT=UP.
# Transparent base (tools/draw.py `Background transparent`): AA -> alpha, and the
# bright eye catchlights survive (real pixels, no colour-key). Engine rotates (12-dir)
# + scales. Source for assets/sprites/cave_spider.png.
size 256x256
Background transparent

# 8 jointed, tapered legs (silhouette)
name legL1
Poly (0.44,0.40)@7 (0.24,0.27)@3 (0.11,0.29)@1.5 stroke=26,28,36
name legL2
Poly (0.44,0.42)@7 (0.19,0.37)@3 (0.05,0.39)@1.5 stroke=26,28,36
name legL3
Poly (0.44,0.45)@7 (0.19,0.49)@3 (0.05,0.56)@1.5 stroke=26,28,36
name legL4
Poly (0.45,0.48)@7 (0.24,0.57)@3 (0.13,0.68)@1.5 stroke=26,28,36
name legR1
Poly (0.56,0.40)@7 (0.76,0.27)@3 (0.89,0.29)@1.5 stroke=26,28,36
name legR2
Poly (0.56,0.42)@7 (0.81,0.37)@3 (0.95,0.39)@1.5 stroke=26,28,36
name legR3
Poly (0.56,0.45)@7 (0.81,0.49)@3 (0.95,0.56)@1.5 stroke=26,28,36
name legR4
Poly (0.55,0.48)@7 (0.76,0.57)@3 (0.87,0.68)@1.5 stroke=26,28,36

# body — abdomen (rear) + cephalothorax (front/up)
name abdomen
Circle (0.5,0.60) r=0.17 rgb=26,28,36
name cephalothorax
Circle (0.5,0.42) r=0.105 rgb=26,28,36

# fangs — points in the silhouette, projecting up past the head front
name fangs
Poly (0.470,0.270) (0.452,0.358) (0.487,0.352) rgb=26,28,36
Poly (0.530,0.270) (0.548,0.358) (0.513,0.352) rgb=26,28,36

# eye-glints — bright catchlights (alive); a spider's eyes reflect light
name eyes
Circle (0.478,0.388) r=0.015 rgb=236,239,249
Circle (0.522,0.388) r=0.015 rgb=236,239,249
Circle (0.460,0.404) r=0.009 rgb=205,210,226
Circle (0.540,0.404) r=0.009 rgb=205,210,226
