# UP-STAIR ('<') — frontal staircase ASCENDING toward light. Per-step (discrete) tone:
# each tread is ONE solid value, stepping LIGHTER toward the top (to white), fan widening
# upward. Each step = light tread + a CONSTANT-DARK riser (the shadowed front face) with a
# transparent GAP above it, so the light/dark banding reads as separate steps (not a
# funnel). Dark risers carry contrast on the light floor. Transparent base.
size 256x256
Background transparent

# step 0 (bottom, narrowest, darkest tread)
name s0_tread
Poly (0.360,0.786) (0.640,0.786) (0.640,0.846) (0.360,0.846) rgb=120,119,124
name s0_riser
Poly (0.360,0.846) (0.640,0.846) (0.640,0.880) (0.360,0.880) rgb=48,47,52
# step 1
name s1_tread
Poly (0.306,0.668) (0.694,0.668) (0.694,0.728) (0.306,0.728) rgb=146,145,150
name s1_riser
Poly (0.306,0.728) (0.694,0.728) (0.694,0.762) (0.306,0.762) rgb=48,47,52
# step 2
name s2_tread
Poly (0.252,0.550) (0.748,0.550) (0.748,0.610) (0.252,0.610) rgb=174,173,178
name s2_riser
Poly (0.252,0.610) (0.748,0.610) (0.748,0.644) (0.252,0.644) rgb=48,47,52
# step 3
name s3_tread
Poly (0.198,0.432) (0.802,0.432) (0.802,0.492) (0.198,0.492) rgb=200,199,204
name s3_riser
Poly (0.198,0.492) (0.802,0.492) (0.802,0.526) (0.198,0.526) rgb=48,47,52
# step 4
name s4_tread
Poly (0.144,0.314) (0.856,0.314) (0.856,0.374) (0.144,0.374) rgb=226,225,229
name s4_riser
Poly (0.144,0.374) (0.856,0.374) (0.856,0.408) (0.144,0.408) rgb=48,47,52
# step 5 (top, widest, white — the bright opening above)
name s5_tread
Poly (0.090,0.196) (0.910,0.196) (0.910,0.256) (0.090,0.256) rgb=249,249,252
name s5_riser
Poly (0.090,0.256) (0.910,0.256) (0.910,0.290) (0.090,0.290) rgb=52,51,56
