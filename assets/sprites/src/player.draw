# PLAYER ('@') — the adventurer, top-down, FRONT=UP. The most-seen sprite in the game:
# must POP against floor + monsters — the BLUE cloak is the only blue in the world.
# Clothed = colour doctrine. Sword drawn forward-right (the attack means), round shield
# on the left arm, steel pauldrons, hair seen from above. Slight foreshortening: the
# shoulders/cloak dominate (we look down on a standing person).
# Source for assets/sprites/player.png.
size 256x256
Background transparent

# the cloak — a broad teardrop falling behind the shoulders (the silhouette base)
name cloak
Circle (0.50,0.52) r=0.205 rgb=46,66,108
Poly (0.335,0.56) (0.665,0.56) (0.575,0.88) (0.425,0.88) rgb=46,66,108
# cloak hem shadow
Poly (0.45,0.84) (0.55,0.84) (0.535,0.885) (0.465,0.885) rgb=32,46,78

# the shield — a round rim on the LEFT arm (steel ring, wooden boss)
name shield
Circle (0.295,0.475) r=0.110 rgb=140,144,152
Circle (0.295,0.475) r=0.082 rgb=110,80,48
Circle (0.295,0.475) r=0.028 rgb=140,144,152

# shoulders/pauldrons — two steel masses over the cloak
name pauldrons
Circle (0.392,0.418) r=0.072 rgb=128,132,142
Circle (0.608,0.418) r=0.072 rgb=128,132,142

# the torso between them — leather chest seen from above
name torso
Circle (0.50,0.43) r=0.085 rgb=96,70,44

# the sword — drawn, pointing forward-right past the shoulder (steel + edge)
name sword_arm
Poly (0.595,0.40)@9 (0.665,0.33)@6 stroke=150,116,82
name blade
Poly (0.652,0.345) (0.685,0.31) (0.78,0.115) (0.745,0.10) (0.638,0.315) rgb=188,192,202
name guard
Line (0.628,0.305) - (0.694,0.345) w=5

# the head — hair from above, over the torso (one clean dark-brown crown)
name head
Circle (0.50,0.35) r=0.078 rgb=76,50,30
